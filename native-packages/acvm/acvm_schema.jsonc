// acvm_schema.jsonc — the ACVM circuit-execution IPC service, human-authored.
// Owns the wire contract shared by the Rust server (in native-packages/acvm/rust,
// linking the noir submodule's acvm lib) and the generated TS client (@aztec/acvm-sim).
{
  "service": "Acvm",

  // This service makes outbound (reverse-channel) calls: a Brillig foreign call (oracle) is resolved
  // by calling out to a resolver service. Emits the wasm `host_call` import + `host_call_bytes` in the
  // generated Rust FFI (see --server-ffi); native resolves via a real ipc-runtime client instead.
  "reverseChannel": true,

  // 32-byte canonical field element (big-endian), matching acir's FieldElement
  // msgpack `bin` encoding.
  "aliases": {
    "Fr": "bin32"
  },

  // A single (witness index -> field value) entry. The witness map crosses the
  // wire as an array of these (the schema has no map type; mirrors wsdb's use of
  // struct arrays).
  "types": {
    "WitnessEntry": {
      "index": "u32",
      "value": "Fr"
    },

    // A raw (undecoded) assertion payload from a failed constraint: an ABI error selector plus the
    // field-element data to be decoded against it. Mirrors acvm's `RawAssertionPayload`; selector and
    // data cross the wire as strings (selector = decimal u64, data = 0x-hex) to match acvm_js's
    // `rawAssertionPayload` shape that yarn-project's error resolution consumes.
    "RawAssertionPayload": {
      "selector": "string",
      "data": "string[]"
    },

    // A structured ACIR *execution* failure (assertion failed / brillig trap), as opposed to a
    // transport/protocol error. Carried on the response's `failure` field (see ExecuteProgram) rather
    // than the IPC error channel, so the client can reconstruct an acvm_js-shaped `ExecutionError`
    // (message + call stack + payload + function ids) for source-mapping.
    "ExecutionFailure": {
      "message": "string",
      // Opcode locations of the failing constraint, innermost last, each formatted as acvm's
      // `OpcodeLocation` Display (e.g. "0" or "3.5" for brillig). Absent when unresolved.
      "callStack": "string[]?",
      "rawAssertionPayload": "RawAssertionPayload?",
      "acirFunctionId": "u32?",
      "brilligFunctionId": "u32?"
    }
  },

  // Error variant shared by every command.
  "error": { "message": "string" },

  "commands": {
    // Execute a compiled ACIR program against an initial witness and return the
    // solved witness. `bytecode` is the raw ACIR blob exactly as produced by
    // `Program::serialize_program` (self-describing msgpack with a leading format
    // byte), decoded server-side by `Program::deserialize_program`. Brillig foreign
    // calls (oracles) are resolved over the reverse channel (see `reverseChannel`).
    "ExecuteProgram": {
      "request": {
        "bytecode": "bytes",
        "initialWitness": "WitnessEntry[]"
      },
      "response": {
        "witness": "WitnessEntry[]",
        // The subset of `witness` at the circuit's `return_values` indices, in index order. Mirrors
        // acvm_js's `executeCircuitWithReturnWitness`, which yarn-project's user-circuit path consumes
        // as `returnWitness`.
        "returnWitness": "WitnessEntry[]",
        // Present iff ACIR execution failed (assertion/brillig trap). When set, `witness`/`returnWitness`
        // are empty and the client raises a structured error instead of returning a witness. Transport
        // and protocol errors (bad bytecode, unsupported program, no resolver) still use the error channel.
        "failure": "ExecutionFailure?"
      }
    }
  }
}
