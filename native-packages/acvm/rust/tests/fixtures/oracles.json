{"artifact_version":1,"noir_version":"1.0.0-rc.5+0f759ffe9176ffbbe7f67b159ac2c3202e0748a0","hash":"89327631847112859","abi":{"abi_version":1,"parameters":[{"name":"x","type":{"kind":"field"},"visibility":"private"},{"name":"xs","type":{"kind":"array","length":3,"type":{"kind":"field"}},"visibility":"private"}],"return_type":{"abi_type":{"kind":"field"},"visibility":"public"},"error_types":{}},"bytecode":"","debug_symbols":"","file_map":{"54":{"source":"#[oracle(double)]\nunconstrained fn double_oracle(x: Field) -> Field {}\n\n#[oracle(sum_and_reverse)]\nunconstrained fn sum_and_reverse_oracle(xs: [Field; 3]) -> (Field, [Field; 3]) {}\n\nunconstrained fn double(x: Field) -> Field {\n    double_oracle(x)\n}\n\nunconstrained fn sum_and_reverse(xs: [Field; 3]) -> (Field, [Field; 3]) {\n    sum_and_reverse_oracle(xs)\n}\n\nfn main(x: Field, xs: [Field; 3]) -> pub Field {\n    // Safety: constrained below.\n    let doubled = unsafe { double(x) };\n    assert(doubled == x + x);\n    // Safety: constrained below.\n    let (sum, reversed) = unsafe { sum_and_reverse(xs) };\n    assert(sum == xs[0] + xs[1] + xs[2]);\n    for i in 0..3 {\n        assert(reversed[i] == xs[2 - i]);\n    }\n    doubled + sum\n}\n","path":"/mnt/user-data/charlie/aztec-repos/ipc-sentinel-worktrees/acvm-package/native-packages/acvm/rust/tests/programs/oracles/src/main.nr","function_locations":[{"start":68,"name":"double_oracle"},{"start":178,"name":"sum_and_reverse_oracle"},{"start":225,"name":"double"},{"start":323,"name":"sum_and_reverse"},{"start":406,"name":"main"}]}}}