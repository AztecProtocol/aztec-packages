// The files a wasm build of the Kv service keeps its database in. A wasm module has no file system,
// so its SQLite VFS calls the host's `files` host-call target with these commands, and the host
// answers from wherever it keeps files: OPFS in a browser (@aztec-labs/kv-store keeps the format of
// SQLite's opfs-sahpool VFS), the file system or memory elsewhere. Native builds use the file
// system directly and never call it.
//
// Paths are SQLite's: the database's, and its journal's (the database's path with "-journal").
{
  "service": "Files",

  "error": { "message": "string" },

  "commands": {
    // Opens a file, creating it if `flags` has SQLITE_OPEN_CREATE (sqlite3.h's open flags, which
    // also say which kind of file it is). The handle names it until Close.
    "Open": {
      "request": { "path": "string", "flags": "u32" },
      "response": { "handle": "u32" }
    },
    "Close": {
      "request": { "handle": "u32" },
      "response": {}
    },
    // Up to `length` bytes from `offset`: fewer when the file ends first.
    "Read": {
      "request": { "handle": "u32", "offset": "u64", "length": "u32" },
      "response": { "data": "bytes" }
    },
    // Writes at `offset`, extending the file if need be.
    "Write": {
      "request": { "handle": "u32", "offset": "u64", "data": "bytes" },
      "response": {}
    },
    "Truncate": {
      "request": { "handle": "u32", "size": "u64" },
      "response": {}
    },
    "Size": {
      "request": { "handle": "u32" },
      "response": { "size": "u64" }
    },
    // Makes the file's writes durable.
    "Sync": {
      "request": { "handle": "u32" },
      "response": {}
    },
    // Removes the file, if it exists.
    "Remove": {
      "request": { "path": "string" },
      "response": {}
    },
    "Exists": {
      "request": { "path": "string" },
      "response": { "exists": "bool" }
    }
  }
}
