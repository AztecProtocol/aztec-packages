+#[test]
+fn inliner_binds_args_to_temps_on_param_name_collision() {
+    let src = r#"
+    fn main(x: Field) -> pub Field {
+        let a = x + 1;
+        // `a` is also the name of f's first parameter: binding `let a = a + 2`
+        // then `let b = a * 3` would make `b` read the wrong `a` as printed.
+        f(a + 2, a * 3)
