+/// Ids of all functions reachable from the program's entry points through
+/// any function reference (calls or function values).
+fn reachable_functions(program: &Program) -> HashSet<u32> {
+    let mut reachable: HashSet<u32> = HashSet::new();
+    let mut queue: Vec<u32> = Vec::new();
+
+    let enqueue = |id: u32, reachable: &mut HashSet<u32>, queue: &mut Vec<u32>| {
+        if reachable.insert(id) {
+            queue.push(id);
+        }
+    };
+
+    enqueue(Program::main_id().0, &mut reachable, &mut queue);
+    for function in &program.functions {
+        if function.is_entry_point {
+            enqueue(function.id.0, &mut reachable, &mut queue);
+        }
+    }
+
+    while let Some(id) = queue.pop() {
+        let Some(function) = program.functions.get(id as usize) else { continue };
+        let mut referenced = Vec::new();
+        visit_expr(&function.body, &mut |expr| {
+            if let Expression::Ident(ident) = expr
+                && let Definition::Function(func_id) = &ident.definition
+            {
+                referenced.push(func_id.0);
+            }
+            true
+        });
+        for func_id in referenced {
+            enqueue(func_id, &mut reachable, &mut queue);
+        }
+    }
+    reachable
+}
