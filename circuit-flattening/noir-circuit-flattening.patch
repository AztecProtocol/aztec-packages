diff --git a/compiler/noirc_frontend/src/monomorphization/inliner.rs b/compiler/noirc_frontend/src/monomorphization/inliner.rs
new file mode 100644
index 000000000..ba0eacbe2
--- /dev/null
+++ b/compiler/noirc_frontend/src/monomorphization/inliner.rs
@@ -0,0 +1,409 @@
+//! Inlines calls between monomorphized functions, producing a program whose
+//! constrained call tree is flattened into (mostly) one function body. The
+//! result is semantically identical to the input — it still compiles through
+//! SSA to the same circuit — but the output is meant to be printed (see
+//! `AstPrinter`) for whole-circuit review in one place.
+//!
+//! What gets inlined: a direct call `f(args)` inside a constrained function,
+//! when `f` is constrained, has inline type `Inline`/`InlineAlways`, and
+//! either is called from at most one constrained call site or has a small
+//! body. Calls to unconstrained functions are never inlined (nothing inside
+//! them emits constraints — they must remain visibly separate), and
+//! `Fold`/`NoPredicates`/`InlineNever` functions are compilation-unit
+//! boundaries the SSA pipeline also respects.
+//!
+//! Each inlined call becomes a block:
+//! ```text
+//! {
+//!     let __inline__f = ();      // marker; printers may render as a comment
+//!     let param_a = arg_a;
+//!     let param_b = arg_b;
+//!     <f's body>
+//! }
+//! ```
+//! Every binder in the cloned body (parameters, lets, loop indices, match
+//! bindings) is renumbered with fresh `LocalId`s/`IdentId`s so duplicated
+//! bodies cannot collide. If an argument expression mentions a name equal to
+//! one of the callee's parameter names, all arguments are first bound to
+//! `__arg_N` temporaries so the printed text cannot read as capturing the
+//! wrong variable.
+
+use std::collections::{HashMap, HashSet};
+
+use super::ast::{
+    Definition, Expression, Ident, IdentId, InlineType, Let, Literal, LocalId, Parameters, Program,
+};
+use super::visitor::{visit_expr, visit_expr_be, visit_expr_be_mut, visit_expr_mut};
+
+/// Functions called from more than one constrained call site are only inlined
+/// if their body has at most this many expression nodes.
+const SMALL_BODY_NODES: usize = 80;
+
+/// Prefix of the unit `let` inserted at the top of every inlined block.
+/// Printers may render such lets as provenance comments.
+pub const INLINE_MARKER_PREFIX: &str = "__inline__";
+
+pub fn inline_program(program: &mut Program, exclude_by_name: &HashSet<String>) {
+    Inliner::new(program, exclude_by_name).run(program);
+}
+
+struct Inliner {
+    next_local_id: u32,
+    next_ident_id: u32,
+    /// Functions that may be inlined into their callers.
+    eligible: HashSet<u32>,
+    /// Name, parameters, and final (already fully inlined) body of each
+    /// eligible function, snapshotted once the function has been processed.
+    snapshots: HashMap<u32, (String, Parameters, Expression)>,
+}
+
+impl Inliner {
+    fn new(program: &Program, exclude_by_name: &HashSet<String>) -> Self {
+        let (next_local_id, next_ident_id) = next_fresh_ids(program);
+        let eligible = eligible_functions(program, exclude_by_name);
+        Inliner { next_local_id, next_ident_id, eligible, snapshots: HashMap::new() }
+    }
+
+    fn fresh_local_id(&mut self) -> LocalId {
+        let id = LocalId(self.next_local_id);
+        self.next_local_id += 1;
+        id
+    }
+
+    fn fresh_ident_id(&mut self) -> IdentId {
+        let id = IdentId(self.next_ident_id);
+        self.next_ident_id += 1;
+        id
+    }
+
+    fn run(&mut self, program: &mut Program) {
+        // Process callees before callers so that a snapshot taken of an
+        // eligible function is already fully inlined. Constrained Noir
+        // forbids recursion, so the constrained call graph is a DAG.
+        for index in post_order(program) {
+            if program.functions[index].unconstrained {
+                continue;
+            }
+            let mut body = std::mem::replace(
+                &mut program.functions[index].body,
+                Expression::Literal(Literal::Unit),
+            );
+            self.inline_calls(&mut body);
+            program.functions[index].body = body;
+
+            let function = &program.functions[index];
+            if self.eligible.contains(&function.id.0) {
+                self.snapshots.insert(
+                    function.id.0,
+                    (function.name.clone(), function.parameters.clone(), function.body.clone()),
+                );
+            }
+        }
+    }
+
+    /// Replace every eligible direct call in the expression with a block that
+    /// binds the arguments and evaluates the callee's (renumbered) body.
+    fn inline_calls(&mut self, expr: &mut Expression) {
+        visit_expr_mut(expr, &mut |expr| {
+            let Expression::Call(call) = expr else { return true };
+            let Expression::Ident(Ident { definition: Definition::Function(callee_id), .. }) =
+                call.func.as_ref()
+            else {
+                return true;
+            };
+            if !self.snapshots.contains_key(&callee_id.0) {
+                return true;
+            }
+            let callee_id = callee_id.0;
+            let arguments = std::mem::take(&mut call.arguments);
+            *expr = self.build_inline_block(callee_id, arguments);
+            // Descend into the replacement: argument expressions may contain
+            // further eligible calls. The cloned body is already inlined, so
+            // revisiting it finds nothing more to do.
+            true
+        });
+    }
+
+    fn build_inline_block(&mut self, callee_id: u32, arguments: Vec<Expression>) -> Expression {
+        let (callee_name, parameters, mut body) = self.snapshots[&callee_id].clone();
+
+        let mut statements = Vec::with_capacity(arguments.len() * 2 + 2);
+        statements.push(Expression::Let(Let {
+            id: self.fresh_local_id(),
+            mutable: false,
+            name: format!("{INLINE_MARKER_PREFIX}{callee_name}"),
+            expression: Box::new(Expression::Literal(Literal::Unit)),
+        }));
+
+        // If any argument expression mentions a name that collides with a
+        // parameter name, the printed `let param = arg;` sequence could read
+        // as capturing the freshly-bound parameter instead of the caller's
+        // variable. Semantics would still be correct (ids, not names, bind),
+        // but the printed program would lie — so route all arguments through
+        // uniquely-named temporaries in that case.
+        let param_names: HashSet<&str> =
+            parameters.iter().map(|(_, _, name, _, _)| name.as_str()).collect();
+        let needs_arg_temps = arguments.iter().any(|arg| {
+            let mut found = false;
+            visit_expr(arg, &mut |expr| {
+                if let Expression::Ident(ident) = expr
+                    && param_names.contains(ident.name.as_str())
+                {
+                    found = true;
+                }
+                true
+            });
+            found
+        });
+
+        // Bind each parameter under a fresh id; remember the mapping so the
+        // body can be renumbered to match.
+        let mut id_map: HashMap<LocalId, LocalId> = HashMap::new();
+        if needs_arg_temps {
+            let temps: Vec<(LocalId, String)> = arguments
+                .into_iter()
+                .enumerate()
+                .map(|(i, arg)| {
+                    let id = self.fresh_local_id();
+                    let name = format!("__arg_{i}");
+                    statements.push(Expression::Let(Let {
+                        id,
+                        mutable: false,
+                        name: name.clone(),
+                        expression: Box::new(arg),
+                    }));
+                    (id, name)
+                })
+                .collect();
+            for ((old_id, mutable, name, typ, _), (temp_id, temp_name)) in
+                parameters.into_iter().zip(temps)
+            {
+                let new_id = self.fresh_local_id();
+                id_map.insert(old_id, new_id);
+                let temp_ident = Expression::Ident(Ident {
+                    location: None,
+                    definition: Definition::Local(temp_id),
+                    mutable: false,
+                    name: temp_name,
+                    typ,
+                    id: self.fresh_ident_id(),
+                });
+                statements.push(Expression::Let(Let {
+                    id: new_id,
+                    mutable,
+                    name,
+                    expression: Box::new(temp_ident),
+                }));
+            }
+        } else {
+            for ((old_id, mutable, name, _typ, _), arg) in parameters.into_iter().zip(arguments) {
+                let new_id = self.fresh_local_id();
+                id_map.insert(old_id, new_id);
+                statements.push(Expression::Let(Let {
+                    id: new_id,
+                    mutable,
+                    name,
+                    expression: Box::new(arg),
+                }));
+            }
+        }
+
+        self.renumber(&mut body, &mut id_map);
+        statements.push(body);
+
+        Expression::Block(statements)
+    }
+
+    /// Give every binder in the expression a fresh `LocalId` (seeding from the
+    /// provided parameter map) and every identifier a fresh `IdentId`,
+    /// rewriting all uses to match.
+    fn renumber(&mut self, expr: &mut Expression, id_map: &mut HashMap<LocalId, LocalId>) {
+        // First pass: renumber every binder, recording the mapping.
+        visit_expr_be_mut(
+            expr,
+            &mut |expr| {
+                match expr {
+                    Expression::Let(let_expr) => {
+                        let new_id = self.fresh_local_id();
+                        id_map.insert(let_expr.id, new_id);
+                        let_expr.id = new_id;
+                    }
+                    Expression::For(for_expr) => {
+                        let new_id = self.fresh_local_id();
+                        id_map.insert(for_expr.index_variable, new_id);
+                        for_expr.index_variable = new_id;
+                    }
+                    Expression::Match(match_expr) => {
+                        let bindings =
+                            match_expr.cases.iter_mut().flat_map(|case| case.arguments.iter_mut());
+                        for (id, _) in bindings {
+                            let new_id = self.fresh_local_id();
+                            id_map.insert(*id, new_id);
+                            *id = new_id;
+                        }
+                    }
+                    _ => {}
+                }
+                (true, ())
+            },
+            &mut |_, ()| {},
+            &mut |_| {},
+        );
+
+        // Second pass: rewrite uses. A local absent from the map would mean a
+        // use of a variable not bound in this function, which a well-formed
+        // monomorphized body cannot contain; it is left untouched defensively.
+        visit_expr_be_mut(
+            expr,
+            &mut |expr| {
+                if let Expression::Match(match_expr) = expr
+                    && let Some(new_id) = id_map.get(&match_expr.variable_to_match.0)
+                {
+                    match_expr.variable_to_match.0 = *new_id;
+                }
+                (true, ())
+            },
+            &mut |_, ()| {},
+            &mut |ident| {
+                if let Definition::Local(id) = &mut ident.definition
+                    && let Some(new_id) = id_map.get(id)
+                {
+                    *id = *new_id;
+                }
+                ident.id = self.fresh_ident_id();
+            },
+        );
+    }
+}
+
+/// The smallest `LocalId` and `IdentId` not used anywhere in the program.
+fn next_fresh_ids(program: &Program) -> (u32, u32) {
+    let max_local = std::cell::Cell::new(0u32);
+    let max_ident = std::cell::Cell::new(0u32);
+    let see_local = |id: u32| max_local.set(max_local.get().max(id + 1));
+
+    for function in &program.functions {
+        for (id, _, _, _, _) in &function.parameters {
+            see_local(id.0);
+        }
+        visit_expr_be(
+            &function.body,
+            &mut |expr| {
+                match expr {
+                    Expression::Let(let_expr) => see_local(let_expr.id.0),
+                    Expression::For(for_expr) => see_local(for_expr.index_variable.0),
+                    Expression::Match(match_expr) => {
+                        see_local(match_expr.variable_to_match.0.0);
+                        for case in &match_expr.cases {
+                            for (id, _) in &case.arguments {
+                                see_local(id.0);
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+                (true, ())
+            },
+            &mut |_, ()| {},
+            &mut |ident| {
+                max_ident.set(max_ident.get().max(ident.id.0 + 1));
+                if let Definition::Local(id) = ident.definition {
+                    see_local(id.0);
+                }
+            },
+        );
+    }
+    (max_local.get(), max_ident.get())
+}
+
+/// Which functions may be inlined into their callers: constrained,
+/// inlineable by attribute, not an entry point, and either called from at
+/// most one constrained call site or small.
+fn eligible_functions(program: &Program, exclude_by_name: &HashSet<String>) -> HashSet<u32> {
+    let mut call_counts: HashMap<u32, usize> = HashMap::new();
+    for function in &program.functions {
+        if function.unconstrained {
+            continue;
+        }
+        visit_expr(&function.body, &mut |expr| {
+            if let Expression::Call(call) = expr
+                && let Expression::Ident(Ident { definition: Definition::Function(callee), .. }) =
+                    call.func.as_ref()
+            {
+                *call_counts.entry(callee.0).or_default() += 1;
+            }
+            true
+        });
+    }
+
+    program
+        .functions
+        .iter()
+        .filter(|function| {
+            !function.unconstrained
+                && !function.is_entry_point
+                && function.id != Program::main_id()
+                && !exclude_by_name.contains(&function.name)
+                && matches!(function.inline_type, InlineType::Inline | InlineType::InlineAlways)
+        })
+        .filter(|function| {
+            let calls = call_counts.get(&function.id.0).copied().unwrap_or(0);
+            calls <= 1 || expression_size(&function.body) <= SMALL_BODY_NODES
+        })
+        .map(|function| function.id.0)
+        .collect()
+}
+
+fn expression_size(expr: &Expression) -> usize {
+    let mut count = 0;
+    visit_expr(expr, &mut |_| {
+        count += 1;
+        true
+    });
+    count
+}
+
+/// Post-order over the direct-call graph, so each function appears after all
+/// functions it calls. Robust to cycles (which only unconstrained code could
+/// create).
+fn post_order(program: &Program) -> Vec<usize> {
+    let count = program.functions.len();
+    let mut callees: Vec<Vec<usize>> = vec![Vec::new(); count];
+    for (index, function) in program.functions.iter().enumerate() {
+        visit_expr(&function.body, &mut |expr| {
+            if let Expression::Call(call) = expr
+                && let Expression::Ident(Ident { definition: Definition::Function(callee), .. }) =
+                    call.func.as_ref()
+                && (callee.0 as usize) < count
+            {
+                callees[index].push(callee.0 as usize);
+            }
+            true
+        });
+    }
+
+    let mut order = Vec::with_capacity(count);
+    let mut state = vec![0u8; count]; // 0 = unvisited, 1 = in progress, 2 = done
+    for root in 0..count {
