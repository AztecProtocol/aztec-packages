+
+/// Begin recording the source-level names of data types converted during
+/// monomorphization. Retrieve the results with [take_recorded_type_names].
+pub fn start_recording_type_names() {
+    RECORDED_TYPE_NAMES.with(|cell| *cell.borrow_mut() = Some(RecordedTypeNames::default()));
+}
+
+/// Stop recording and return everything recorded since
+/// [start_recording_type_names]. Returns an empty record if recording was
+/// never started.
+pub fn take_recorded_type_names() -> RecordedTypeNames {
+    RECORDED_TYPE_NAMES.with(|cell| cell.borrow_mut().take()).unwrap_or_default()
+}
+
+fn is_recording_type_names() -> bool {
+    RECORDED_TYPE_NAMES.with(|cell| cell.borrow().is_some())
+}
+
+fn record_type_name(name: String, typ: &ast::Type) {
+    // Only tuples are worth naming: structs and enums always convert to
+    // tuples, and naming primitive or array aliases would make a reverse
+    // lookup rename every occurrence of that primitive type.
+    if !matches!(typ, ast::Type::Tuple(_)) {
+        return;
+    }
+    RECORDED_TYPE_NAMES.with(|cell| {
