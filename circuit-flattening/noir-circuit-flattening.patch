+#[test]
+fn inliner_inlines_single_call_chain() {
+    let src = r#"
+    fn main(x: Field) -> pub Field {
+        outer(x)
+    }
+    fn outer(a: Field) -> Field {
+        inner(a + 1)
+    }
+    fn inner(b: Field) -> Field {
+        b * 2
+    }
+    "#;
+    insta::assert_snapshot!(get_inlined(src), @r"
+    fn main$f0(x$l0: Field) -> pub Field {
+        {
+            // >>> inlined call: outer;
+            let a$l6 = x$l0;
+            {
