+/// Monomorphize, inline with [crate::monomorphization::inliner], and print.
+fn get_inlined(src: &str) -> String {
+    let mut program = get_monomorphized(src).unwrap();
+    crate::monomorphization::inliner::inline_program(&mut program, &Default::default());
+    program.to_string()
+}
