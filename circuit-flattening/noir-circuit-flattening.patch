+/// Source-level type names recorded while monomorphizing, so that printers can
+/// show original struct/enum/alias names instead of structural tuples.
+#[derive(Debug, Default, Clone)]
+pub struct RecordedTypeNames {
+    /// Display name of every struct, enum, and alias type converted by
+    /// `convert_type`, mapped to the structural type it converted to.
+    pub type_aliases: BTreeMap<String, ast::Type>,
+    /// For each monomorphized function (keyed by `ast::FuncId.0`): the HIR
+    /// display names of its expanded parameter types and of its return type.
+    pub fn_signatures: BTreeMap<u32, (Vec<String>, String)>,
+}
+
+thread_local! {
+    /// `Some` while recording is active; see [start_recording_type_names].
+    static RECORDED_TYPE_NAMES: std::cell::RefCell<Option<RecordedTypeNames>> =
+        const { std::cell::RefCell::new(None) };
+    /// Scratch buffer: HIR type names of the parameters expanded so far for
+    /// the function currently being monomorphized.
+    static PARAM_TYPE_NAMES: std::cell::RefCell<Vec<String>> =
+        const { std::cell::RefCell::new(Vec::new()) };
