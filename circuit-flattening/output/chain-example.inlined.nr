    assert((out == {
        // >>> inlined call: expose_to_public;
        let self = prev;
        {
            {
                // >>> inlined call: innermost;
                let __arg_0 = self;
                let self = __arg_0;
                {
                    self.inner.inner
                }
            }
        }
    }), "incorrect output note_hashes")
