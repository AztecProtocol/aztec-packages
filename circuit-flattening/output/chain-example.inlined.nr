fn serialize(self: NullifierLeafPreimage) -> [Field; 3] {
    let mut writer = {
        // >>> inlined call: new;
        {
            {
                let data = [0; 3];
                let offset = 0;
                (data, offset)
            }
        }
    };
    stream_serialize(self, (&mut writer));
    {
