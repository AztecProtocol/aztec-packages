    propagate_nullifier_read_requests(self, private_call.public_inputs);
    scope_and_propagate_key_validation_requests(self, private_call.public_inputs);
    scope_and_propagate_note_hashes(self, private_call.public_inputs);
    scope_and_propagate_nullifiers(self, private_call.public_inputs);
    scope_and_propagate_l2_to_l1_messages(self, private_call.public_inputs);
    scope_and_propagate_logs(self, private_call.public_inputs);
    propagate_private_call_requests(self, private_call.public_inputs);
    propagate_public_call_requests(self, private_call.public_inputs);
    propagate_public_teardown_call_request(self, private_call.public_inputs);
