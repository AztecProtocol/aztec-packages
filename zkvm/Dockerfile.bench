# Multi-stage build for containerized benchmarking.
# Usage: docker build -t zkvm-bench -f Dockerfile.bench .
#        docker run --cpus=2 --memory=4g zkvm-bench --workload all

FROM rust:1.82-slim AS builder
WORKDIR /app
COPY . .
RUN cargo build --release -p zkvm-benchmarks

FROM debian:bookworm-slim
COPY --from=builder /app/target/release/zkvm-bench /usr/local/bin/
ENTRYPOINT ["zkvm-bench"]
