#!/usr/bin/env bash
# SCHEDULE: 60  (run every 60 minutes)
#
# Cron jobs run on a schedule via the cron poller.
# They can also be invoked manually: ./cron/example "optional extra prompt"

read -r -d '' TEMPLATE <<'EOF' || true
You are running as a scheduled task. Check the health of the system and report
any issues you find. This is an automated check — be concise.
EOF
source "$(dirname "$0")/../run.sh" "$@"
