+/**
+ * aztec-wsdb's own options, which Init carries: where its stores live, their LMDB map sizes and its thread count.
+ */
+export function encodeAztecWsdbOptions(
+  dataDir: string,
+  wsTreeMapSizes: WorldStateTreeMapSizes,
+  threads: number,
+): Uint8Array {
+  const mapSizes = Object.entries(getWsdbOptions(dataDir, wsTreeMapSizes).mapSizes)
+    .filter(([, sizeKb]) => sizeKb !== undefined)
+    .map(([treeId, sizeKb]) => ({ treeId: Number(treeId), sizeKb }));
+  return new Uint8Array(new Packr({ useRecords: false }).pack({ dataDir, threads, mapSizes }));
 }
 
