@@ -983,7 +983,7 @@ export class SequencerPublisher {
     header: CheckpointHeader,
     simulationOverridesPlan?: SimulationOverridesPlan,
   ): Promise<void> {
-    const flags = { ignoreDA: true, ignoreSignatures: true };
+    const flags = { ignoreDA: true };
 
