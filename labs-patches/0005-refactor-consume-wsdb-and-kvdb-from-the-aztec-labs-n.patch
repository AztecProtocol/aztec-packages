From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Charlie <karl.lye@gmail.com>
Date: Sat, 26 Sep 2026 18:20:02 +0000
Subject: [PATCH] refactor: consume wsdb and kvdb from the @aztec-labs npm
 scope

The native packages are moving to the labs org, so their npm packages are published under
@aztec-labs from the first version there (7.0.0-nightly.20260926.b) onwards.

diff --git a/docs/examples/bootstrap.sh b/docs/examples/bootstrap.sh
index 6bac416bcc5c45d2e0d31105fc8830f14c9ebe40..7a2b0c4df07401196825f8a6d1a94b0ecb3dbca5 100755
--- a/docs/examples/bootstrap.sh
+++ b/docs/examples/bootstrap.sh
@@ -198,7 +198,7 @@ function validate-webapp-tutorial {
       }
 
       // yarn-project pins the packages built outside it (e.g. @aztec-foundation/bb.js,
-      // @aztec-foundation/ipc-runtime, @aztec-foundation/wsdb, @aztec-foundation/noir-*) to published npm versions via
+      // @aztec-foundation/ipc-runtime, @aztec-labs/wsdb, @aztec-foundation/noir-*) to published npm versions via
       // its root resolutions. Workspace manifests declare those with placeholder
       // versions that only the resolutions rewrite, so mirror the pins here: consume
       // them from npm at the pinned version, never link them. Path-based entries
diff --git a/labs-aztec-toolchain/pins.mjs b/labs-aztec-toolchain/pins.mjs
