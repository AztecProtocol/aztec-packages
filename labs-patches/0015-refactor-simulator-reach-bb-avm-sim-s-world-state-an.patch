   }
 
@@ -295,9 +295,6 @@ export class AvmSimulatorPool implements AvmSimulator {
         return await this.spawnProcess({
           binaryPath: this.options.avmBinaryPath,
           wsdbIpcPath: this.options.wsdbIpcPath,
-          get cdbIpcPath() {
-            return cdbServer.ipcPath;
-          },
           cdb: request => cdbServer.handle(request),
           logger: this.options.logger,
         });
@@ -322,10 +319,11 @@ class AvmSimulatorProcess implements AvmProcessHandle {
     if (options.wsdbIpcPath === undefined) {
       throw new Error("A bb-avm-sim process needs the WSDB server's IPC path (wsdbIpcPath)");
     }
-    const service = await AvmService.spawn({
+    const service = await AvmService.process({
       binaryPath: options.binaryPath,
       logger: options.logger,
-      extraArgs: ['--wsdb', options.wsdbIpcPath, '--cdb', options.cdbIpcPath],
+      // The process reaches the WSDB server at its own socket, and the CDB through a socket this process serves.
+      hostCall: { wsdb: options.wsdbIpcPath, cdb: options.cdb },
       // Each simulation is self-contained (state comes from the WSDB/CDB servers, routed by fork id),
       // so a fresh process can safely serve the next call after a death.
       respawn: true,
