+++ b/yarn-project/stdlib/src/contract/derivation/bb_parity.test.ts
@@ -0,0 +1,44 @@
+import { BarretenbergSync } from '@aztec-foundation/bb.js';
+
+import { Fr } from '@aztec-labs/foundation/curves/bn254';
+import { readFileSync } from 'fs';
+
+import { FunctionSelector, loadContractArtifact } from '../../abi/index.js';
+import type { NoirCompiledContract } from '../../noir/index.js';
+import { getPathToFixture } from '../../tests/fixtures.js';
+import { getContractClassFromArtifact } from './contract_class.js';
+
+// Barretenberg's AztecContractClass derives a contract class from the artifact nargo writes. This TS derivation must
+// agree with it, so a TS consumer can derive classes without barretenberg and get the class ids the rest of the stack
+// computes.
+describe('contract class derivation matches barretenberg', () => {
+  beforeAll(async () => {
+    await BarretenbergSync.initSingleton();
+  });
+
+  it.each(['Benchmarking.test.json', 'Test.test.json', 'Token.test.json'])('%s', async fixture => {
+    const raw = readFileSync(getPathToFixture(fixture));
+    const fromBb = BarretenbergSync.getSingleton().aztecContractClass({ artifact: raw });
+    const fromTs = await getContractClassFromArtifact(
+      loadContractArtifact(JSON.parse(raw.toString()) as NoirCompiledContract),
+    );
+
+    const toFr = (bytes: Uint8Array) => Fr.fromBuffer(Buffer.from(bytes));
+    expect({
+      id: fromTs.id,
+      artifactHash: fromTs.artifactHash,
+      privateFunctionsRoot: fromTs.privateFunctionsRoot,
+      publicBytecodeCommitment: fromTs.publicBytecodeCommitment,
+      privateFunctions: fromTs.privateFunctions,
+    }).toEqual({
+      id: toFr(fromBb.id),
+      artifactHash: toFr(fromBb.artifactHash),
+      privateFunctionsRoot: toFr(fromBb.privateFunctionsRoot),
+      publicBytecodeCommitment: toFr(fromBb.publicBytecodeCommitment),
+      privateFunctions: fromBb.privateFunctions.map(fn => ({
+        selector: FunctionSelector.fromField(new Fr(fn.selector)),
+        vkHash: toFr(fn.vkHash),
+      })),
+    });
+  });
+});
