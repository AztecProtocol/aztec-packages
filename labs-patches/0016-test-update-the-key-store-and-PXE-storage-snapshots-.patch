From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Santiago Palladino <santiago@aztec-labs.com>
Date: Wed, 7 Oct 2026 20:03:42 -0300
Subject: [PATCH] test: update the key-store and PXE storage snapshots for v3
 addresses

The key-store test and the PXE storage compatibility test derive their account
addresses from fixed keys, and those addresses move with the v3 separator. The
stored layout is unchanged: every differing entry is an address used as a key
or value, so this is regenerated data, not a schema change, and needs no
PXE_DATA_SCHEMA_VERSION bump.

diff --git a/yarn-project/key-store/src/key_store.test.ts b/yarn-project/key-store/src/key_store.test.ts
index b9fe13292f44722aeb46f22285582c09ca542005..09a7bfdd1d78f133e2b01426960f1a4ff05a1018 100644
--- a/yarn-project/key-store/src/key_store.test.ts
+++ b/yarn-project/key-store/src/key_store.test.ts
@@ -32,7 +32,7 @@ describe('KeyStore', () => {
 
     const { address: accountAddress } = await keyStore.addAccount(keys, partialAddress);
     expect(accountAddress.toString()).toMatchInlineSnapshot(
-      `"0x0a3120bded2afb430e67e4bdb5326a673fbfd95642b6ea7f80d0cc958aac3940"`,
+      `"0x085dc21710e008944b4a98b19f0cd637b1c6896453a500e0c9110f9ab376a7b3"`,
     );
 
     const { pkMHash: returnedNpkMHash } = await keyStore.getKeyValidationRequest(
@@ -73,7 +73,7 @@ describe('KeyStore', () => {
     // Returned accounts are as expected
     const accounts = await keyStore.getAccounts();
     expect(accounts.toString()).toMatchInlineSnapshot(
-      `"0x0a3120bded2afb430e67e4bdb5326a673fbfd95642b6ea7f80d0cc958aac3940"`,
+      `"0x085dc21710e008944b4a98b19f0cd637b1c6896453a500e0c9110f9ab376a7b3"`,
     );
 
     // Manages to find master nullifier hiding key for the pk_m hash
diff --git a/yarn-project/pxe/src/storage/backwards_compatibility_tests/__snapshots__/AddressStore.json b/yarn-project/pxe/src/storage/backwards_compatibility_tests/__snapshots__/AddressStore.json
