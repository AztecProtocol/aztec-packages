+/// <reference lib="webworker" />
+import type {
+  FilesClose,
+  FilesCloseResponse,
+  FilesExists,
+  FilesExistsResponse,
+  FilesOpen,
+  FilesOpenResponse,
+  FilesRead,
+  FilesReadResponse,
+  FilesRemove,
+  FilesRemoveResponse,
+  FilesSize,
