   | 'WS_DATA_DIRECTORY'
   | 'WS_NUM_HISTORIC_CHECKPOINTS'
   | 'WS_NUM_HISTORIC_BLOCKS'
diff --git a/yarn-project/scripts/run_test.sh b/yarn-project/scripts/run_test.sh
index 994c37ae328e21088166e243267e82e0a9dbdd4a..202106f85e07ca26776301197e21724841231aab 100755
--- a/yarn-project/scripts/run_test.sh
+++ b/yarn-project/scripts/run_test.sh
@@ -16,5 +16,7 @@ export TOKIO_WORKER_THREADS=1
 export UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-8}
 export HARDWARE_CONCURRENCY=${CPUS:-16}
 export LOG_LEVEL=${LOG_LEVEL:-info}
+# Receipt waits on the test anvil: see defaultViemPollingIntervalMs in ethereum/src/client.ts.
+export L1_VIEM_POLLING_INTERVAL_MS=${L1_VIEM_POLLING_INTERVAL_MS:-100}
 exec node --no-warnings --experimental-vm-modules --loader @swc-node/register \
   ../node_modules/.bin/jest --runInBand $test "$@"
