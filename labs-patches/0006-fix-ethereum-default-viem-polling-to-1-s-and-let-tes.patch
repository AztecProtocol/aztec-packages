From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AztecBot <tech@aztec-labs.com>
Date: Wed, 7 Oct 2026 19:18:08 +0000
Subject: [PATCH] fix(ethereum): default viem polling to 1 s and let test
 runners shorten it

Clients built by createExtendedL1Client and getPublicClient without an
explicit interval used viem's 4 s default. waitForTransactionReceipt
checks once immediately and then once per interval, and anvil 1.8
returns a transaction's hash before mining it, so on a local chain every
receipt wait paid the full 4 s. The default is now the 1 s the node's own
clients already use, and L1_VIEM_POLLING_INTERVAL_MS overrides it; the
jest runners and the e2e compose file set 100 ms.

diff --git a/yarn-project/end-to-end/scripts/docker-compose.yml b/yarn-project/end-to-end/scripts/docker-compose.yml
index 609ee04f61a7e9fa7ca9d2f129e69883d586a9d3..a0d221ca42442a009ef858b4d0c0bfd3676fb753 100644
--- a/yarn-project/end-to-end/scripts/docker-compose.yml
+++ b/yarn-project/end-to-end/scripts/docker-compose.yml
@@ -57,6 +57,7 @@ services:
       FORCE_COLOR: ${FORCE_COLOR:-1}
       AZTEC_NODE_URL: http://local-network:8080
       ANVIL_HARDFORK: ${ANVIL_HARDFORK:-}
+      L1_VIEM_POLLING_INTERVAL_MS: 100
       # Allow git usage despite different ownership. Relevant for script tests.
       GIT_CONFIG_GLOBAL: /root/aztec-node/build-images/src/home/.gitconfig
       # For debugging scripts that were passed as TEST.
diff --git a/yarn-project/end-to-end/scripts/test_simple.sh b/yarn-project/end-to-end/scripts/test_simple.sh
index 4d878e805922fe8ded01f3947a5c5bb3168333dc..2028c496d49dff1c295b598755ccf8bda7b99029 100755
--- a/yarn-project/end-to-end/scripts/test_simple.sh
+++ b/yarn-project/end-to-end/scripts/test_simple.sh
@@ -18,6 +18,8 @@ export HARDWARE_CONCURRENCY=${CPUS:-16}
 export RAYON_NUM_THREADS=1
 export TOKIO_WORKER_THREADS=1
 export LOG_LEVEL=${LOG_LEVEL:-verbose}
+# Receipt waits on the test anvil: see defaultViemPollingIntervalMs in ethereum/src/client.ts.
+export L1_VIEM_POLLING_INTERVAL_MS=${L1_VIEM_POLLING_INTERVAL_MS:-100}
 export NODE_NO_WARNINGS=1
 export FORCE_COLOR=1
 
diff --git a/yarn-project/ethereum/src/client.test.ts b/yarn-project/ethereum/src/client.test.ts
index 2beb26e182a1c855797f6dacf6f5504c2b8c6d45..0e3a1ae23874cd0469e72ef3c8f2d7a1cd0a3a36 100644
--- a/yarn-project/ethereum/src/client.test.ts
+++ b/yarn-project/ethereum/src/client.test.ts
@@ -13,6 +13,20 @@ import {
 } from './client.js';
 
 describe('createExtendedL1Client polling', () => {
+  const originalPollingInterval = process.env.L1_VIEM_POLLING_INTERVAL_MS;
+
+  beforeEach(() => {
+    delete process.env.L1_VIEM_POLLING_INTERVAL_MS;
+  });
+
+  afterEach(() => {
+    if (originalPollingInterval === undefined) {
+      delete process.env.L1_VIEM_POLLING_INTERVAL_MS;
+    } else {
+      process.env.L1_VIEM_POLLING_INTERVAL_MS = originalPollingInterval;
+    }
+  });
+
   const privateKey = `0x${'01'.repeat(32)}`;
   const rpcUrls = ['http://127.0.0.1:8545'];
 
@@ -25,8 +39,14 @@ describe('createExtendedL1Client polling', () => {
     expect(createExtendedL1Client(rpcUrls, privateKey, foundry, 0).pollingInterval).toBe(0);
   });
 
-  it('preserves the public-chain default', () => {
-    expect(createExtendedL1Client(rpcUrls, privateKey, sepolia).pollingInterval).toBe(4000);
+  it('uses the configured polling interval on public chains', () => {
+    process.env.L1_VIEM_POLLING_INTERVAL_MS = '250';
+    expect(createExtendedL1Client(rpcUrls, privateKey, sepolia).pollingInterval).toBe(250);
+    expect(createExtendedL1Client(rpcUrls, privateKey, sepolia, 0).pollingInterval).toBe(0);
+  });
+
+  it('defaults to one-second polling on public chains', () => {
+    expect(createExtendedL1Client(rpcUrls, privateKey, sepolia).pollingInterval).toBe(1000);
   });
 });
 
diff --git a/yarn-project/ethereum/src/client.ts b/yarn-project/ethereum/src/client.ts
index 5eab2a41e243f025db3cc997d9605eccd7430568..801c250a28dceeb6c0ac8bd05b20f5ed8700b9ba 100644
--- a/yarn-project/ethereum/src/client.ts
+++ b/yarn-project/ethereum/src/client.ts
@@ -35,6 +35,19 @@ type Config = {
 
 export type { Config as EthereumClientConfig };
 
+const DEFAULT_VIEM_POLLING_INTERVAL_MS = 1_000;
+
+/**
+ * Polling interval for viem clients created without an explicit one. `waitForTransactionReceipt` checks for the
+ * receipt once immediately and then once per interval, and anvil 1.8 returns a transaction's hash before it has
+ * mined it, so on a local chain every receipt wait costs one interval; `L1_VIEM_POLLING_INTERVAL_MS` lets test
+ * runners shorten it.
+ */
+export function defaultViemPollingIntervalMs(): number {
+  const fromEnv = Number(process.env.L1_VIEM_POLLING_INTERVAL_MS);
+  return Number.isFinite(fromEnv) && fromEnv > 0 ? fromEnv : DEFAULT_VIEM_POLLING_INTERVAL_MS;
+}
+
 /** Error exposed by L1 RPC transports without including provider URLs in its message. */
 export class L1RpcError extends Error {
   constructor(message: string, options?: ErrorOptions) {
@@ -108,7 +121,7 @@ export function getPublicClient(config: Config): ViemPublicClient {
   return createPublicClient({
     chain: chain.chainInfo,
     transport: makeL1HttpTransport(config.l1RpcUrls, { timeout: config.l1HttpTimeoutMS }),
-    pollingInterval: config.viemPollingIntervalMS,
+    pollingInterval: config.viemPollingIntervalMS ?? defaultViemPollingIntervalMs(),
   });
 }
 
@@ -161,7 +174,7 @@ export function createExtendedL1Client(
     account: hdAccount,
     chain,
     transport: makeL1HttpTransport(rpcUrls, { timeout: opts?.httpTimeoutMS }),
-    pollingInterval: pollingIntervalMS ?? (isAnvilTestChain(chain.id) ? 100 : undefined),
+    pollingInterval: pollingIntervalMS ?? (isAnvilTestChain(chain.id) ? 100 : defaultViemPollingIntervalMs()),
   }).extend(publicActions);
 
   return extendedClient;
diff --git a/yarn-project/foundation/src/config/env_var.ts b/yarn-project/foundation/src/config/env_var.ts
index 20aa6cd36165ed5f9a59d60195a867bcca283133..25113f311f98279efabc970333bed80f220dc5c3 100644
--- a/yarn-project/foundation/src/config/env_var.ts
