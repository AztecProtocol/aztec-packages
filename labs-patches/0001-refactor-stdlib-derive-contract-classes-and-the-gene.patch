-/**
- * Returns the artifact hash of a given compiled contract artifact.
- *
- * ```
- * private_functions_artifact_leaves = artifact.private_functions.map fn =>
- *   sha256(fn.selector, fn.metadata_hash, sha256(fn.bytecode))
