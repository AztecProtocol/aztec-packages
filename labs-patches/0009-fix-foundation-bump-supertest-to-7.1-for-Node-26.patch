--- a/yarn-project/foundation/package.json
+++ b/yarn-project/foundation/package.json
@@ -199,7 +199,7 @@
     "globals": "^16.1.0",
     "jest": "^30.0.0",
     "prettier": "^3.5.3",
-    "supertest": "^6.3.3",
+    "supertest": "^7.1.0",
     "ts-node": "^10.9.1",
     "typescript": "^5.3.3",
     "typescript-eslint": "^8.32.1",
