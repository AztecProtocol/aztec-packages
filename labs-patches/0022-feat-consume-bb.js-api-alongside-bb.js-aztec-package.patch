From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Charlie <5764343+charlielye@users.noreply.github.com>
Date: Fri, 25 Sep 2026 12:29:55 +0000
Subject: [PATCH] feat: consume bb.js-api alongside bb.js (aztec-packages
 #25433)

bb.js now depends on @aztec-foundation/bb.js-api as workspace:^, which only
resolves inside the barretenberg/ts workspace, and bb.js-api carries four
per-arch optional dependencies that are not published. use-local has to portal
all five or `yarn install` fails with "Workspace not found", so pin them the way
bb-avm-sim's family is already pinned.
---
 labs-aztec-toolchain/pins.mjs | 9 +++++++++
 yarn-project/package.json     | 5 +++++
 2 files changed, 14 insertions(+)

diff --git a/labs-aztec-toolchain/pins.mjs b/labs-aztec-toolchain/pins.mjs
index e510068f..6820997b 100755
--- a/labs-aztec-toolchain/pins.mjs
+++ b/labs-aztec-toolchain/pins.mjs
@@ -63,6 +63,15 @@ const LOCAL_PACKAGES = {
   "@aztec-foundation/bb-avm-sim-linux-x64":
     "portal:barretenberg/ts/bb-avm-sim/packages/bb-avm-sim-linux-x64",
   "@aztec-foundation/bb.js": "portal:barretenberg/ts/bb.js",
+  "@aztec-foundation/bb.js-api": "portal:barretenberg/ts/bb.js-api",
+  "@aztec-foundation/bb.js-api-darwin-arm64":
+    "portal:barretenberg/ts/bb.js-api/packages/bb.js-api-darwin-arm64",
+  "@aztec-foundation/bb.js-api-darwin-x64":
+    "portal:barretenberg/ts/bb.js-api/packages/bb.js-api-darwin-x64",
+  "@aztec-foundation/bb.js-api-linux-arm64":
+    "portal:barretenberg/ts/bb.js-api/packages/bb.js-api-linux-arm64",
+  "@aztec-foundation/bb.js-api-linux-x64":
+    "portal:barretenberg/ts/bb.js-api/packages/bb.js-api-linux-x64",
   "@aztec-foundation/cdb": "portal:barretenberg/ts/cdb",
   "@aztec-foundation/constants-codegen": "portal:protocol/constants-codegen",
   "@aztec-foundation/ipc-runtime": "portal:ipc-runtime/ts",
diff --git a/yarn-project/package.json b/yarn-project/package.json
index 48db8124..ee783a94 100644
--- a/yarn-project/package.json
+++ b/yarn-project/package.json
@@ -90,6 +90,11 @@
     "@aztec-foundation/bb-avm-sim-linux-arm64": "6.0.0-rc.7",
     "@aztec-foundation/bb-avm-sim-linux-x64": "6.0.0-rc.7",
     "@aztec-foundation/bb.js": "6.0.0-rc.7",
+    "@aztec-foundation/bb.js-api": "6.0.0-rc.7",
+    "@aztec-foundation/bb.js-api-darwin-arm64": "6.0.0-rc.7",
+    "@aztec-foundation/bb.js-api-darwin-x64": "6.0.0-rc.7",
+    "@aztec-foundation/bb.js-api-linux-arm64": "6.0.0-rc.7",
+    "@aztec-foundation/bb.js-api-linux-x64": "6.0.0-rc.7",
     "@aztec-foundation/cdb": "6.0.0-rc.7",
     "@aztec-foundation/constants-codegen": "6.0.0-rc.7",
     "@aztec-foundation/ipc-runtime": "6.0.0-rc.7",
-- 
