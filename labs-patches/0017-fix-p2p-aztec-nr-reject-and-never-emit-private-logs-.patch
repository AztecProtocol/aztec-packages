diff --git a/yarn-project/stdlib/src/logs/private_log.ts b/yarn-project/stdlib/src/logs/private_log.ts
index cf5a8fc4e7628f0cd5fc81f90eff38f387d264b6..7ccc0639caaa7574fd5f844b87897f7d00669d14 100644
--- a/yarn-project/stdlib/src/logs/private_log.ts
+++ b/yarn-project/stdlib/src/logs/private_log.ts
@@ -63,6 +63,18 @@ export class PrivateLog {
     return this.emittedLength === 0;
   }
 
+  /**
+   * Whether `emittedLength` is within bounds and every field beyond it is zero. The protocol circuits require this of
+   * every private log: the tx hash commits to all `PRIVATE_LOG_SIZE_IN_FIELDS` fields while only the first
+   * `emittedLength` are published, so a log with non-zero padding has a tx hash that cannot be recomputed from
+   * published data.
+   */
+  hasZeroPadding() {
+    return (
+      this.emittedLength <= PRIVATE_LOG_SIZE_IN_FIELDS && this.fields.slice(this.emittedLength).every(f => f.isZero())
+    );
+  }
+
   static empty() {
     return new PrivateLog(makeTuple(PRIVATE_LOG_SIZE_IN_FIELDS, Fr.zero), 0);
   }
