new file mode 100644
index 0000000000000000000000000000000000000000..941c8babbb3b76120a5890f86674a0297cdd3e2f
--- /dev/null
+++ b/yarn-project/foundation/src/crypto/poseidon/encoding.ts
@@ -0,0 +1,28 @@
+import { Buffer } from 'buffer';
+
+import { Fr } from '../../curves/bn254/field.js';
+
+/** Bytes as the fields Noir hashes them as: 31-byte chunks, each read little-endian. */
+export function bytesToPoseidonFields(input: Buffer): Fr[] {
+  const fields: Fr[] = [];
+  for (let i = 0; i < input.length; i += 31) {
+    const fieldBytes = Buffer.alloc(32, 0);
+    input.slice(i, i + 31).copy(fieldBytes);
+    fieldBytes.reverse();
+    fields.push(Fr.fromBuffer(fieldBytes));
+  }
+  return fields;
+}
+
+/** bb's Poseidon2AbsorbChain command: the state, and the inputs as one flat buffer of 32 bytes per field. */
+export function absorbChainCommand(state: Fr[], inputs: Fr[]) {
+  const flat = Buffer.allocUnsafe(inputs.length * 32);
+  for (let i = 0; i < inputs.length; i++) {
+    flat.set(inputs[i].toBuffer(), i * 32);
+  }
+  return { state: state.map(s => s.toBuffer()), inputs: flat };
+}
+
+export function fieldsFromBuffers(buffers: Uint8Array[]): Fr[] {
+  return buffers.map(b => Fr.fromBuffer(Buffer.from(b)));
+}
