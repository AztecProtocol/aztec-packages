+describe('setPoseidonSynchronous', () => {
+  const fields = [new Fr(1n), new Fr(2n), new Fr(3n)];
+  const state = [new Fr(0n), new Fr(1n), new Fr(2n), new Fr(3n)];
+  const bytes = Buffer.from('a few bytes to hash, longer than one 31-byte chunk');
+
+  async function hashes() {
+    return {
+      hash: await poseidon2HashFields(fields),
+      separated: await poseidon2HashWithSeparator(fields, 7),
+      permutation: await poseidon2PermutationFields(state),
+      absorbed: await poseidon2AbsorbChain(state, fields),
+      bytes: await poseidon2HashBytes(bytes),
+    };
+  }
+
+  afterEach(() => setPoseidonSynchronous(false));
+
+  it('hashes the same on the synchronous and the asynchronous singletons', async () => {
+    setPoseidonSynchronous(false);
+    const asynchronous = await hashes();
+    setPoseidonSynchronous(true);
+    await expect(hashes()).resolves.toEqual(asynchronous);
+  });
+});
