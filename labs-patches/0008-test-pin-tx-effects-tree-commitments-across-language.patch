+    Array.from({ length: MAX_PRIVATE_LOGS_PER_TX }, (_, i) =>
+      PrivateLog.fromBlobFields(PRIVATE_LOG_SIZE_IN_FIELDS, Array(PRIVATE_LOG_SIZE_IN_FIELDS).fill(new Fr(i + 501))),
