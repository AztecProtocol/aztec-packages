From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AztecBot <tech@aztec-labs.com>
Date: Wed, 7 Oct 2026 21:48:35 +0000
Subject: [PATCH] chore: re-pin the standard contracts for the v3 address
 separator

HandshakeRegistry reaches get_public_keys, which asserts
account == AztecAddress::compute(public_keys, partial_address), so the address
domain separator is compiled into its bytecode. The pinned build therefore has
to be refreshed with the separator: left alone it derives V2 addresses inside a
V3 tree and rejects every account.

Re-pinning recompiles all four standard contracts against the current aztec-nr,
which also changes AuthRegistry's and MultiCallEntrypoint's bytecode and moves
their artifact hashes, class ids and canonical addresses. PublicChecks' bytecode
is unchanged, so its address moves through the separator alone. The pinned
artifacts do not compile in the STANDARD_*_ADDRESS stamps, so regenerating the
address tables leaves the pinned build as it is.

diff --git a/noir-projects/aztec-nr/aztec/src/standard_addresses.nr b/noir-projects/aztec-nr/aztec/src/standard_addresses.nr
index 9e6628e3b2874670259a162728b1a5243ed41f9c..b3f41dd2e7150c476db51ad3a2a0c35d9801c8c7 100644
--- a/noir-projects/aztec-nr/aztec/src/standard_addresses.nr
+++ b/noir-projects/aztec-nr/aztec/src/standard_addresses.nr
@@ -2,11 +2,11 @@
 use protocol_types::{address::AztecAddress, traits::FromField};
 
 pub global STANDARD_AUTH_REGISTRY_ADDRESS: AztecAddress = AztecAddress::from_field(
-    0x0be10329556fe4509df7237c5bca1d697bf9967bd2470e91f9eacd87eaae1b14,
+    0x2ba8714679fbee823f108f366f878ce3249861637de705b0ac7cfbd0f81b3a9c,
 );
 
 pub global STANDARD_MULTI_CALL_ENTRYPOINT_ADDRESS: AztecAddress = AztecAddress::from_field(
-    0x20371f16e7e6e10ecf4a7163845f6c47c883c77bb50e4d963da273e37d2b8723,
+    0x265552a432ba2f9420ce5283bec14d7385e7a4accaff6c82648efe312d42fcc2,
 );
 
 pub global STANDARD_PUBLIC_CHECKS_ADDRESS: AztecAddress = AztecAddress::from_field(
@@ -14,5 +14,5 @@ pub global STANDARD_PUBLIC_CHECKS_ADDRESS: AztecAddress = AztecAddress::from_fie
 );
 
 pub global STANDARD_HANDSHAKE_REGISTRY_ADDRESS: AztecAddress = AztecAddress::from_field(
-    0x29de142cc0919dc45cb6fc7a992e740a0eb1972f68f53f91c933e30f3d3feb27,
+    0x198aa5f21f7a13761f4729c544fb6edcae73a484d57b248b6390eb0dc5c06040,
 );
