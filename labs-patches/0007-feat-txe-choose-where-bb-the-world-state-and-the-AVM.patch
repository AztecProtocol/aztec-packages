+++ b/yarn-project/txe/src/backends.ts
@@ -0,0 +1,45 @@
+import { BackendType, Barretenberg, BarretenbergSync } from '@aztec-foundation/bb.js';
+
+/**
+ * Where the TXE runs its native services: bb (hashing and the other crypto), the world state and the AVM. One choice
+ * for all of them, made when the TXE starts.
+ * - `wasm`: their wasm modules, in-process.
+ * - `process`: spawned processes. Synchronous calls go over shared memory and asynchronous ones over a unix socket.
+ * - `napi`: their shared libraries, in-process.
+ */
+export type TXEBackends = 'wasm' | 'process' | 'napi';
+
+export const TXE_BACKENDS: readonly TXEBackends[] = ['wasm', 'process', 'napi'];
+
+export function parseTXEBackends(value: string): TXEBackends {
+  if (!(TXE_BACKENDS as readonly string[]).includes(value)) {
+    throw new Error(`Unknown TXE backends '${value}' (expected ${TXE_BACKENDS.join(', ')})`);
+  }
+  return value as TXEBackends;
+}
+
+/**
+ * Seeds this thread's bb.js singletons with `backends`, before any crypto call: `initSingleton` binds a singleton to
+ * whichever backend is asked for first, so this pre-empts the implicit one in foundation's crypto. Each thread (the
+ * main thread and every worker) has singletons of its own. The TXE only hashes, so the SRS is never loaded and bb
+ * runs single-threaded.
+ */
+export function initBarretenbergSingletons(backends: TXEBackends): Promise<unknown> {
+  switch (backends) {
+    case 'wasm':
+      return Promise.all([
+        Barretenberg.initSingleton({ backend: BackendType.Wasm, skipSrsInit: true, threads: 1 }),
+        BarretenbergSync.initSingleton({ backend: BackendType.Wasm }),
+      ]);
+    case 'process':
+      return Promise.all([
+        Barretenberg.initSingleton({ backend: BackendType.NativeUnixSocket, threads: 1 }),
+        BarretenbergSync.initSingleton({ backend: BackendType.NativeSharedMemory, threads: 1 }),
+      ]);
+    case 'napi':
+      return Promise.all([
+        Barretenberg.initSingleton({ backend: BackendType.Napi, skipSrsInit: true }),
+        BarretenbergSync.initSingleton({ backend: BackendType.Napi }),
+      ]);
+  }
+}
