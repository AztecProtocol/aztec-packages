+    }
+
+    #[test]
+    unconstrained fn private_revertible_note_after_public_note_hashes() {
+        // A private revertible note hash at index 1 in the private kernel's output, inserted at index 4 in the tx's
+        // note hashes after public non-revertible ones.
+        assert_discovers_note_in_section(2 * MAX_NOTE_HASHES_PER_TX + 1, 4);
+    }
+
+    #[test]
+    unconstrained fn public_revertible_note() {
+        // Emitted in app logic or teardown at index 5 in the tx's note hashes.
