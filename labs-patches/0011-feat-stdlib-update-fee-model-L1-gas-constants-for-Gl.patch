From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Santiago Palladino <santiago@aztec-labs.com>
Date: Tue, 6 Oct 2026 19:01:13 -0300
Subject: [PATCH] feat(stdlib): update fee model L1 gas constants for
 Glamsterdam

`L1_GAS_PER_CHECKPOINT_PROPOSED` and `L1_GAS_PER_EPOCH_VERIFIED` are the
TypeScript port of the constants in `FeeLib.sol`, used to predict the minimum
fee per mana a few slots ahead. Follow the L1 change that replaces the
benchmark-derived placeholders with values measured on Sepolia after
Glamsterdam: 500k -> 520k and 4M -> 2.5M. A stale port would predict fees that
no longer match what the rollup charges.

diff --git a/yarn-project/end-to-end/src/single-node/fees/fees_test.ts b/yarn-project/end-to-end/src/single-node/fees/fees_test.ts
index 0392920433bb3ef8db468ee94b6a6466a4389ed3..721cf3bdf718d9ae4e4a11ea135144c633cafd22 100644
--- a/yarn-project/end-to-end/src/single-node/fees/fees_test.ts
+++ b/yarn-project/end-to-end/src/single-node/fees/fees_test.ts
@@ -350,7 +350,7 @@ export class FeesTest extends SingleNodeTestContext {
 
       // @todo @lherskind As we deal with #13601
       // Right now the value is from `FeeLib.sol`
-      const L1_GAS_PER_EPOCH_VERIFIED = 4000000n;
+      const L1_GAS_PER_EPOCH_VERIFIED = 2500000n;
 
       // We round up
       const mulDiv = (a: bigint, b: bigint, c: bigint) => (a * b) / c + ((a * b) % c > 0n ? 1n : 0n);
diff --git a/yarn-project/stdlib/src/gas/README.md b/yarn-project/stdlib/src/gas/README.md
index 283e45e2a4628b43393ba477ec0f781fdf8a62ec..d5d3d2c088fc52fb9b054810d51a60c94527cec1 100644
--- a/yarn-project/stdlib/src/gas/README.md
+++ b/yarn-project/stdlib/src/gas/README.md
@@ -208,8 +208,8 @@ itself, before actual teardown consumption is known.
 
 | Constant                        | Value          |
 | ------------------------------- | -------------- |
-| `L1_GAS_PER_CHECKPOINT_PROPOSED` | 500,000       |
-| `L1_GAS_PER_EPOCH_VERIFIED`     | 4,000,000      |
+| `L1_GAS_PER_CHECKPOINT_PROPOSED` | 520,000       |
+| `L1_GAS_PER_EPOCH_VERIFIED`     | 2,500,000      |
 | `BLOBS_PER_CHECKPOINT` (FeeLib) | 3              |
 | `BLOB_GAS_PER_BLOB`             | 2^17           |
 | `MINIMUM_CONGESTION_MULTIPLIER` | 1e9            |
diff --git a/yarn-project/stdlib/src/gas/fee_math.ts b/yarn-project/stdlib/src/gas/fee_math.ts
index 16ae8d035b13202e4965d433dccb18536b13cc18..55840995725bfe9dfd817885334330d50cba3824 100644
--- a/yarn-project/stdlib/src/gas/fee_math.ts
+++ b/yarn-project/stdlib/src/gas/fee_math.ts
@@ -5,8 +5,8 @@
 
 // Constants matching FeeLib.sol
 export const MINIMUM_CONGESTION_MULTIPLIER = 1_000_000_000n;
-export const L1_GAS_PER_CHECKPOINT_PROPOSED = 500_000n;
-export const L1_GAS_PER_EPOCH_VERIFIED = 4_000_000n;
+export const L1_GAS_PER_CHECKPOINT_PROPOSED = 520_000n;
+export const L1_GAS_PER_EPOCH_VERIFIED = 2_500_000n;
 export const BLOBS_PER_CHECKPOINT = 3n;
 export const BLOB_GAS_PER_BLOB = 2n ** 17n;
 export const MAGIC_CONGESTION_VALUE_MULTIPLIER = 854_700_854n;
