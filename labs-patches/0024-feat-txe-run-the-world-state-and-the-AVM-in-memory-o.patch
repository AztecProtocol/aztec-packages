+/**
+ * The genesis `getWsdbExtraArgs` puts on aztec-wsdb's command line, as the InitGenesis command: how a wsdb service that
+ * is not spawned from a command line, such as wsdb-ref, is given it.
+ */
+export function getWsdbGenesis(genesis: GenesisData): Parameters<WsdbApi['initGenesis']>[0] {
+  const options = getWsdbOptions('', {
+    archiveTreeMapSizeKb: 0,
+    nullifierTreeMapSizeKb: 0,
+    noteHashTreeMapSizeKb: 0,
+    messageTreeMapSizeKb: 0,
+    publicDataTreeMapSizeKb: 0,
+  });
+  const entries = (map: Record<number, number>) => Object.entries(map).map(([treeId, n]) => [Number(treeId), n]);
+  return {
+    treeHeights: entries(options.treeHeights).map(([treeId, height]) => ({ treeId, height })),
+    treePrefill: entries(options.treePrefill).map(([treeId, size]) => ({ treeId, size })),
+    prefilledPublicData: genesis.prefilledPublicData.map(data => ({
+      slot: new Uint8Array(data.slot.toBuffer()),
+      value: new Uint8Array(data.value.toBuffer()),
+    })),
+    prefilledNullifiers: genesis.prefilledNullifiers.map(nullifier => new Uint8Array(nullifier.toBuffer())),
+    genesisTimestamp: Number(genesis.genesisTimestamp),
+    initialHeaderGeneratorPoint: options.initialHeaderGeneratorPoint,
+  };
+}
