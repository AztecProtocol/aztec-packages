@@ -32,6 +36,33 @@ unconstrained fn read_uninitialized_utility_returns_default() {
     });
 }
 
+#[test]
+unconstrained fn read_uninitialized_option_public_returns_none() {
+    let env = TestEnvironment::new();
+
+    env.public_context(|context| {
+        let state_var = option_in_public(context);
+        assert_eq(state_var.read(), Option::none());
+    });
+}
+
+#[test]
+unconstrained fn write_read_option_public_other_tx() {
+    let env = TestEnvironment::new();
+
+    let value = Option::some(5);
+
+    env.public_context(|context| {
+        let state_var = option_in_public(context);
+        state_var.write(value);
+    });
+
+    env.public_context(|context| {
+        let state_var = option_in_public(context);
+        assert_eq(state_var.read(), value);
+    });
+}
+
