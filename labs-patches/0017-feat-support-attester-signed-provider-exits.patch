diff --git a/yarn-project/ethereum/src/provider_exit_artifacts.test.ts b/yarn-project/ethereum/src/provider_exit_artifacts.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..58022cca58f9f7ba8ab7fa005cdba99ec16fc536
