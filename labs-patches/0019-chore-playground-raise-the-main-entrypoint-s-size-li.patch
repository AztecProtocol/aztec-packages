diff --git a/playground/vite.config.ts b/playground/vite.config.ts
index 20b3c668bbce3cda59e83df9c2acd24785b1eb36..d9eef98e4a62098eec17098eaf01c7911a6c9f07 100644
--- a/playground/vite.config.ts
