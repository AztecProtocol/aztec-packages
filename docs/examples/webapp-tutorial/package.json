{
  "name": "webapp-tutorial-pod-racing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf ../../target src/artifacts/*.json src/artifacts/*.ts dist",
    "compile": "cd ../.. && ${AZTEC:-aztec} compile --package pod_racing_contract --force && mkdir -p examples/webapp-tutorial/src/artifacts && cp target/pod_racing_contract-PodRacing.json examples/webapp-tutorial/src/artifacts",
    "codegen": "cd ../.. && ${AZTEC:-aztec} codegen ./target -o ./target && cp target/*.ts examples/webapp-tutorial/src/artifacts",
    "prep": "yarn compile && yarn codegen",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run tests/unit/",
    "test:e2e": "vitest run tests/e2e/ --test-timeout=120000",
    "build:test-extension": "node esbuild.extension.mjs",
    "build:wallet-extension": "vite build --config vite.extension.config.ts && node esbuild.extension.mjs",
    "interact": "npx tsx scripts/deploy-and-interact.ts",
    "test": "yarn test:unit && yarn build:test-extension && yarn test:e2e"
  },
  "dependencies": {
    "@aztec/accounts": "#include_aztec_version",
    "@aztec/aztec.js": "#include_aztec_version",
    "@aztec/constants": "#include_aztec_version",
    "@aztec/entrypoints": "#include_aztec_version",
    "@aztec/foundation": "#include_aztec_version",
    "@aztec/kv-store": "#include_aztec_version",
    "@aztec/noir-contracts.js": "#include_aztec_version",
    "@aztec/protocol-contracts": "#include_aztec_version",
    "@aztec/pxe": "#include_aztec_version",
    "@aztec/standard-contracts": "#include_aztec_version",
    "@aztec/stdlib": "#include_aztec_version",
    "@aztec/wallet-sdk": "#include_aztec_version",
    "@aztec/wallets": "#include_aztec_version",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "puppeteer": "^24.40.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^2.0.0"
  }
}
