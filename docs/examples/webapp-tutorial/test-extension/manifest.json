{
  "manifest_version": 3,
  "name": "Aztec Test Wallet",
  "version": "1.0.0",
  "description": "Test wallet extension for E2E testing of the webapp tutorial",
  "permissions": [],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content-script.js"],
      "run_at": "document_start"
    }
  ]
}
