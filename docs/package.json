{
  "name": "aztec-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "yarn clean && yarn preprocess && yarn spellcheck && yarn preprocess:move && yarn validate:redirects && yarn validate:api-ref-links && yarn docusaurus build && node scripts/append_api_docs_to_llms.js && node scripts/inject_md_directive.js && node scripts/inject_llms_directive.js",
    "validate:redirects": "./scripts/validate_redirect_targets.sh",
    "validate:api-ref-links": "./scripts/validate_api_ref_links.sh",
    "check:orphaned-urls": "./scripts/check_orphaned_urls.sh",
    "clean": "./scripts/clean.sh",
    "dev:netlify": "yarn netlify dev",
    "generate:aztec-nr-api": "./scripts/aztec_nr_docs_generation/generate_aztec_nr_docs.sh",
    "generate:typescript-api": "./scripts/typescript_api_generation/generate_ts_api_docs.sh",
    "generate:node-api-reference": "./scripts/node_api_reference_generation/generate_node_api_reference.sh",
    "generate:operator-cli-reference": "./scripts/cli_reference_generation/generate_operator_cli_ref.sh",
    "preprocess": "yarn node -r dotenv/config ./src/preprocess/index.js",
    "preprocess:move": "sh scripts/move_processed.sh",
    "serve": "yarn docusaurus serve",
    "spellcheck": "yarn cspell",
    "spellcheck:appendwords": "yarn cspell --words-only --unique | sort --ignore-case >> docs-words.txt",
    "start": "yarn clean && yarn preprocess && yarn generate:aztec-nr-api && yarn docusaurus start --host ${HOST:-localhost}",
    "test": "node --test src/preprocess/__tests__/*.test.js",
    "test:preprocess": "node --test src/preprocess/__tests__/*.test.js"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/plugin-content-docs": "3.10.1",
    "@docusaurus/plugin-ideal-image": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "@getbrevo/brevo": "^3.0.1",
    "@rspack/core": "^1.0.0",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "clsx": "^2.1.1",
    "docusaurus-theme-search-typesense": "0.25.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "6.0.3",
    "react-player": "^2.16.1",
    "rehype-katex": "7",
    "remark-gfm": "^1.0.0",
    "remark-math": "6"
  },
  "devDependencies": {
    "@aztec/l1-artifacts": "6.0.0-nightly.20260812",
    "@docusaurus/tsconfig": "3.10.1",
    "@tsconfig/docusaurus": "^1.0.7",
    "cspell": "^8.19.4",
    "dotenv": "^16.6.1",
    "netlify-cli": "^24.3.0"
  },
  "cspell": {
    "import": [
      "../cspell.json"
    ],
    "dictionaryDefinitions": [
      {
        "name": "docs-words",
        "path": "./docs-words.txt",
        "addWords": true
      }
    ],
    "dictionaries": [
      "docs-words"
    ],
    "files": [
      "./docs/**/{*.md,*.md?}",
      "./docs-developers/**/{*.md,*.md?}",
      "./docs-operate/**/{*.md,*.md?}",
      "./docs-participate/**/{*.md,*.md?}",
      "./developer_versioned_docs/**/{*.md,*.md?}",
      "./network_versioned_docs/**/{*.md,*.md?}",
      "./internal_notes/**/{*.md,*.md?}",
      "./src/components/Snippets/*.js",
      "./processed-docs/**/{*.md,*.md?}"
    ],
    "ignorePaths": [
      "node_modules",
      "processed-docs-cache",
      "/docs-words.txt"
    ]
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "tar-fs": "^3.1.1",
    "ws@npm:8.13.0": "npm:8.17.1",
    "path-to-regexp@npm:^1.7.0": "npm:1.9.0",
    "h3": "^1.15.5",
    "node-forge": "^1.3.2",
    "serve-handler": "^6.1.7",
    "serialize-javascript": "^7.0.3",
    "axios": "^1.13.5",
    "fastify": "5.8.2"
  },
  "packageManager": "yarn@4.13.0"
}
