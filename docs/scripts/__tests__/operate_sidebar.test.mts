import assert from "node:assert/strict";
import fs from "node:fs";
import { createRequire } from "node:module";
import path from "node:path";
import { test } from "node:test";
import line from "../../src/preprocess/line.js";

const docsDir = path.resolve(import.meta.dirname, "../..");
const require = createRequire(import.meta.url);

// Doc ids of pages in no sidebar on purpose. Every URL here is in snapshots/published-urls.txt, so
// removing a page needs a redirect first.
const UNLISTED: Record<string, string> = {
  "operators/prerequisites": "each role's first setup page covers it now; a netlify.toml redirect and an operator page point here",
  "operators/setup/become_a_staking_provider": "setup page from before the guided setups; a netlify.toml redirect and provider pages point here",
  "operators/setup/blob_storage": "setup page from before the guided setups; operators/concepts/l1-rpc links it",
  "operators/setup/blob_upload": "setup page from before the guided setups",
  "operators/setup/registering_sequencer": "setup page from before the guided setups",
  "operators/setup/running_a_node": "setup page from before the guided setups; netlify.toml redirects and two pages point here",
  "operators/setup/running_a_prover": "setup page from before the guided setups; a netlify.toml redirect points here",
  "operators/setup/sequencer_management": "setup page from before the guided setups; the guided setups and token pages link it",
  "reference/changelog/v4": "duplicate of operators/reference/changelog/v4, kept for its published URL",
};

// The id Docusaurus gives a docs file: its directory and its front-matter `id`, else its file name
// without a number prefix. A `slug` or `draft` does not change it.
function docId(rel: string, text: string): string {
  const front = /^---\n([\s\S]*?)\n---(\n|$)/.exec(text)?.[1] ?? "";
  const id = /^id:[ \t]*(.*?)[ \t]*(?:[ \t]#.*)?$/m.exec(front)?.[1].replace(/^(["'])(.*)\1$/, "$2");
  const name = path.posix.basename(rel).replace(/\.mdx?$/, "").replace(/^\d+[-_.]/, "");
  const dir = path.posix.dirname(rel);
  return `${dir === "." ? "" : `${dir}/`}${id || name}`;
}

/** Every doc id a sidebars file lists: string items, doc and ref items, and category links. */
function sidebarIds(file: string): Set<string> {
  const ids = new Set<string>();
  const walk = (item: unknown): void => {
    if (Array.isArray(item)) return item.forEach(walk);
    if (typeof item === "string") return void ids.add(item);
    const it = item as { type?: string; id?: string; dirName?: string; link?: { type?: string; id?: string }; items?: unknown };
    if (it.type === "autogenerated") throw new Error(`${file}: autogenerated items are not supported here; list the docs`);
    if ((it.type === "doc" || it.type === "ref") && it.id) ids.add(it.id);
    if (it.link?.type === "doc" && it.link.id) ids.add(it.link.id);
    if (it.items) walk(it.items);
  };
  Object.values(require(file)).forEach(walk);
  return ids;
}

test("every operate page is in its sidebar or listed in UNLISTED with a reason", () => {
  const roots = [docsDir, ...line.lineNames(path.dirname(docsDir)).map((l) => path.join(docsDir, "lines", l))];
  const unlistedSomewhere = new Set<string>();
  for (const root of roots) {
    const listed = sidebarIds(path.join(root, "sidebars-operate.js"));
    const pagesDir = path.join(root, "docs-operate");
    const pages = fs
      .readdirSync(pagesDir, { recursive: true, encoding: "utf8" })
      .map((rel) => rel.split(path.sep).join("/"))
      .filter((rel) => /\.mdx?$/.test(rel) && !path.posix.basename(rel).startsWith("_"));
    assert.ok(pages.length > 0, `no pages under ${pagesDir}`);
    const orphans = pages.map((rel) => docId(rel, fs.readFileSync(path.join(pagesDir, rel), "utf8"))).filter((id) => !listed.has(id));
    orphans.forEach((id) => unlistedSomewhere.add(id));
    assert.deepEqual(
      orphans.filter((id) => !(id in UNLISTED)).sort(),
      [],
      `${path.relative(docsDir, root) || "main"}: add each page to sidebars-operate.js, or to UNLISTED with the reason it stays out`,
    );
  }
  assert.deepEqual(
    Object.keys(UNLISTED).filter((id) => !unlistedSomewhere.has(id)),
    [],
    "these UNLISTED pages are in a sidebar now, or gone: remove them from UNLISTED",
  );
});
