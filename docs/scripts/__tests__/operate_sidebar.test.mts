import assert from "node:assert/strict";
import fs from "node:fs";
import { createRequire } from "node:module";
import os from "node:os";
import path from "node:path";
import { test } from "node:test";
import line from "../../src/preprocess/line.js";

const docsDir = path.resolve(import.meta.dirname, "../..");
const require = createRequire(import.meta.url);

// Doc ids of pages in no sidebar on purpose. Every URL here is in snapshots/published-urls.txt, so
// removing a page needs a redirect first.
const UNLISTED: Record<string, string> = {};
const unlisted = (id: string) => Object.hasOwn(UNLISTED, id);

// The id Docusaurus gives a docs file: its directory and its front-matter `id`, else its file name; a
// `slug` or `draft` does not change it. Number prefixes are refused, not parsed: no operate page has one,
// and Docusaurus strips them by rules (dates and versions excepted) this test does not repeat.
function docId(rel: string, text: string): string {
  if (rel.split("/").some((part) => /^\d+\s*[-_.]/.test(part))) throw new Error(`${rel}: number-prefixed names are not supported here`);
  const front = /^---\r?\n([\s\S]*?)\r?\n---(\r?\n|$)/.exec(text)?.[1] ?? "";
  const m = /^id:[ \t]*(?:"([^"]*)"|'([^']*)'|([^\s"'#][^\r\n]*?))(?:[ \t]+#.*)?[ \t]*\r?$/m.exec(front);
  const dir = path.posix.dirname(rel);
  return `${dir === "." ? "" : `${dir}/`}${m?.[1] ?? m?.[2] ?? m?.[3] ?? path.posix.basename(rel).replace(/\.mdx?$/, "")}`;
}

/** Every doc id a sidebars file lists: string items, doc and ref items, category links, shorthand categories. */
function sidebarIds(file: string): Set<string> {
  const ids = new Set<string>();
  // biome-ignore lint/complexity/noExcessiveCognitiveComplexity: baselined 2026-11-12: predates the complexity budget
  const walk = (item: unknown): void => {
    if (Array.isArray(item)) return void item.forEach(walk);
    if (typeof item === "string") return void ids.add(item);
    const it = item as { type?: string; id?: string; link?: { type?: string; id?: string }; items?: unknown };
    if (!it.type) return void Object.values(it).forEach(walk);
    if (it.type === "autogenerated") throw new Error(`${file}: autogenerated items are not supported here; list the docs`);
    if ((it.type === "doc" || it.type === "ref") && it.id) ids.add(it.id);
    if (it.link?.type === "doc" && it.link.id) ids.add(it.link.id);
    if (it.items) walk(it.items);
  };
  Object.values(require(file)).forEach(walk);
  return ids;
}

/** Doc ids under `root`/docs-operate that `root`/sidebars-operate.js does not list; `_` paths are partials. */
function orphans(root: string): string[] {
  const listed = sidebarIds(path.join(root, "sidebars-operate.js"));
  const pagesDir = path.join(root, "docs-operate");
  const pages = fs
    .readdirSync(pagesDir, { recursive: true, encoding: "utf8" })
    .map((rel) => rel.split(path.sep).join("/"))
    .filter((rel) => /\.mdx?$/.test(rel) && !rel.split("/").some((part) => part.startsWith("_")));
  assert.ok(pages.length > 0, `no pages under ${pagesDir}`);
  return pages.map((rel) => docId(rel, fs.readFileSync(path.join(pagesDir, rel), "utf8"))).filter((id) => !listed.has(id));
}

test("every operate page is in its sidebar or listed in UNLISTED with a reason", () => {
  const roots = [docsDir, ...line.lineNames(path.dirname(docsDir)).map((l) => path.join(docsDir, "lines", l))];
  const unlistedSomewhere = new Set<string>();
  for (const root of roots) {
    const found = orphans(root);
    for (const id of found) unlistedSomewhere.add(id);
    assert.deepEqual(
      found.filter((id) => !unlisted(id)).sort(),
      [],
      `${path.relative(docsDir, root) || "main"}: add each page to sidebars-operate.js, or to UNLISTED with the reason it stays out`,
    );
  }
  assert.deepEqual(
    Object.keys(UNLISTED).filter((id) => !unlistedSomewhere.has(id)),
    [],
    "these UNLISTED pages are in a sidebar now, or gone: remove them from UNLISTED",
  );
});

test("ids, sidebars and partials follow Docusaurus for shapes the operate tree does not use yet", () => {
  assert.equal(docId("a/page.md", "---\r\nid: renamed\r\n---\r\n"), "a/renamed");
  assert.equal(docId("a/page.md", '---\nid: "renamed #1" # note\n---\n'), "a/renamed #1");
  assert.equal(docId("page.mdx", "---\nslug: /elsewhere\n---\n"), "page");
  assert.throws(() => docId("01-guide/page.md", ""), /number-prefixed/);
  assert.equal(unlisted("constructor"), false);
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "operate-sidebar-"));
  try {
    for (const rel of ["a/b.md", "c/index.md", "c/d.md", "_partials/p.md", "a/_p.mdx", "constructor.md"]) {
      fs.mkdirSync(path.dirname(path.join(root, "docs-operate", rel)), { recursive: true });
      fs.writeFileSync(path.join(root, "docs-operate", rel), "");
    }
    const category = '{ type: "category", label: "C", link: { type: "doc", id: "c/index" }, items: [{ type: "doc", id: "c/d" }] }';
    fs.writeFileSync(path.join(root, "sidebars-operate.js"), `module.exports = { s: [{ Section: ["a/b", ${category}] }] };`);
    assert.deepEqual(orphans(root), ["constructor"]);
    fs.writeFileSync(path.join(root, "auto.js"), 'module.exports = { s: [{ Section: [{ type: "autogenerated", dirName: "." }] }] };');
    assert.throws(() => sidebarIds(path.join(root, "auto.js")), /autogenerated/);
  } finally {
    fs.rmSync(root, { recursive: true, force: true });
  }
});
