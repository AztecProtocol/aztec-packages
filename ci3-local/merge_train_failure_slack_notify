#!/usr/bin/env bash
set -eu

# Parse arguments
MODE=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --dequeued)
      MODE="dequeued"
      shift
      ;;
    --merged)
      MODE="merged"
      shift
      ;;
    *)
      ci_log_id=$1
      shift
      ;;
  esac
done

commit_title=$(git log -1 --pretty=format:'%s')
commit_author=$(git log -1 --pretty=format:'%an')

if [[ "$REF_NAME" == "merge-train/avm" ]]; then
  channel="#team-bonobos"
elif [[ "$REF_NAME" == "merge-train/barretenberg" ]]; then
  channel="#honk-team"
elif [[ "$REF_NAME" == "merge-train/ci" ]]; then
  channel="#help-ci"
elif [[ "$REF_NAME" == "merge-train/docs" ]]; then
  channel="#dev-rels"
elif [[ "$REF_NAME" == "merge-train/fairies" ]]; then
  channel="#team-fairies"
elif [[ "$REF_NAME" == "merge-train/fairies-v5" ]]; then
  channel="#team-fairies"
elif [[ "$REF_NAME" == "merge-train/spartan" ]]; then
  channel="#team-alpha-ci"
elif [[ "$REF_NAME" == "merge-train/spartan-v5" ]]; then
  channel="#team-alpha-ci"
else
  exit 0
fi

TOPDIR=$(git rev-parse --show-toplevel)

set -x

if [[ "$MODE" == "dequeued" ]]; then
  "$TOPDIR/ci3/slack_notify" \
    "$(printf 'PR was removed from the %s merge queue: <%s|View PR>\n%s by %s (🤖)' "$REF_NAME" "$PR_URL" "$commit_title" "$commit_author")" \
    "$channel"

elif [[ "$MODE" == "merged" ]]; then
  merged_target="${TARGET_BRANCH:-$REF_NAME}"
  "$TOPDIR/ci3/slack_notify" "PR merged into $merged_target: <$PR_URL|$commit_title> by $commit_author" "$channel"

else
  "$TOPDIR/ci3/slack_notify" \
    "$(printf 'There was a failure in %s: http://ci.aztec-labs.com/%s\n%s by %s (🤖)' "$REF_NAME" "$ci_log_id" "$commit_title" "$commit_author")" \
    "$channel"
fi
