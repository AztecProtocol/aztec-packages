#!/usr/bin/env bash
# Authenticate against our internal GCP Artifact Registry, used by PRIVATE_RELEASE builds.
#
# Activates the CI service account (GCP_PRIVATE_NPM_DEPLOY_KEY -> GOOGLE_APPLICATION_CREDENTIALS, the same key
# .github/ci3.sh stores) so callers can mint access tokens for the AR npm repo. When
# INTERNAL_DOCKER_REGISTRY is set (e.g. us-west1-docker.pkg.dev/<project>/<repo>), also registers
# docker's gcloud credential helper for that registry host.
NO_CD=1 source $(git rev-parse --show-toplevel)/ci3/source

# Ensure a service-account key is on disk, mirroring .github/ci3.sh's setup_environment.
if [ -z "${GOOGLE_APPLICATION_CREDENTIALS:-}" ] || [ ! -f "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]; then
  : "${GCP_PRIVATE_NPM_DEPLOY_KEY:?GCP_PRIVATE_NPM_DEPLOY_KEY or GOOGLE_APPLICATION_CREDENTIALS required for a private release}"
  export GOOGLE_APPLICATION_CREDENTIALS=$(mktemp)
  (umask 077; printf '%s' "$GCP_PRIVATE_NPM_DEPLOY_KEY" > "$GOOGLE_APPLICATION_CREDENTIALS")
fi

set +x  # Never echo the access token.
gcloud auth activate-service-account --key-file="$GOOGLE_APPLICATION_CREDENTIALS" >/dev/null
# Best-effort: the push target already encodes the project in the registry paths, and the CI SA
# may lack resourcemanager.projects.get, so don't let a failed/​warned project-set abort the login.
[ -n "${GCP_PROJECT_ID:-}" ] && gcloud config set project "$GCP_PROJECT_ID" >/dev/null 2>&1 || true

# docker: register the gcloud credential helper for the registry host (e.g. us-west1-docker.pkg.dev).
if [ -n "${INTERNAL_DOCKER_REGISTRY:-}" ]; then
  registry_host=${INTERNAL_DOCKER_REGISTRY%%/*}
  gcloud auth configure-docker "$registry_host" --quiet >/dev/null
fi
