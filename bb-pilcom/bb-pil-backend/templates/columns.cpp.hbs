#include "barretenberg/vm2/generated/columns.hpp"

#include <string>
#include <vector>

#include "barretenberg/common/std_string.hpp"

namespace bb::{{snakeCase name}} {

// Column names are used for
// (1) The debugger.
// (2) Tracegen stats.
// (3) The manifest through the transcript (only for debugging).
// We don't want to leak column names for release builds.
#ifdef AVM_INCLUDE_COLUMN_INFORMATION

// Two layers are needed to properly expand the macro. Don't ask why.
#define VARARGS_TO_STRING(...) #__VA_ARGS__
#define UNPACK_TO_STRING(...) VARARGS_TO_STRING(__VA_ARGS__)

const std::vector<std::string>& COLUMN_NAMES = []() {
    static auto vec = detail::split_and_trim(UNPACK_TO_STRING({{shoutySnakeCase name}}_ALL_ENTITIES), ',');
    return vec;
}();
#else
const std::vector<std::string>& COLUMN_NAMES = []() {
    // Generate a dummy vector of column names.
    static std::vector<std::string> vec;
    for (size_t i = 0; i < NUM_ALL_ENTITIES; i++) {
        vec.push_back("column_" + std::to_string(i));
    }
    return vec;
}();
#endif

} // namespace bb::{{snakeCase name}}
