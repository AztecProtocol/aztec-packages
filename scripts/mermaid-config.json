    "useMaxWidth": true
  },
  "er": {
    "diagramPadding": 20,
    "layoutDirection": "TB",
    "minEntityWidth": 100,
    "minEntityHeight": 75,
    "entityPadding": 15,
    "useMaxWidth": true
  },
  "state": {
    "diagramPadding": 8,
    "labelHeight": 16,
    "noteMargin": 10,
    "nodeSpacing": 30,
    "rankSpacing": 30,
    "useMaxWidth": true
