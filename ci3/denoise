#!/usr/bin/env bash
NO_CD=1 source ${root:-$(git rev-parse --show-toplevel)}/ci3/source

# Ensure a command is passed
if [ "$#" != 1 ]; then
  echo "Usage: $0 <command>"
  exit 1
fi

cmd=$1

if [[ "${DENOISE:-0}" -eq 0 ]] || [[ "${BUILD_SYSTEM_DEBUG:-0}" -eq 1 ]]; then
  set -e
  exec bash -c "$cmd"
  exit 0
fi

function cleanup {
  set +e
  if [ -n "${publish_pid:-}" ]; then
    kill $publish_pid &>/dev/null
    wait $publish_pid
    publish_pid=
  fi
  if [ -n "${job_pid:-}" ]; then
    kill $job_pid &>/dev/null
    wait $job_pid
    job_pid=
  fi
  if [ -n "${tail_pid:-}" ]; then
    kill $tail_pid &>/dev/null
    wait $tail_pid
    tail_pid=
  fi
  if [ -n "${dots_pid:-}" ]; then
    kill $dots_pid &>/dev/null
    wait $dots_pid
    dots_pid=
  fi
}
trap cleanup SIGINT SIGTERM
# Remove file on exit, so we can publish even after SIGINT or SIGTERM.
trap 'cleanup; rm -f $outfile $outfile.done $dots_fifo' EXIT

dots_per_line=${DENOISE_WIDTH:-64}
dot_count=0
status="in-progress"
time="in-progress"

# We don't want to lose color just because we're wrapping.
export FORCE_COLOR=${FORCE_COLOR:-1}

# If stdout is connected to a terminal, print singular dots for each line.
[ -t 1 ] && realtime=1 || realtime=0

key=$(uuid)
url=$(ci3_client url $key)
# DENOISE_TMPDIR gives a run a private output directory, so tests can scope their
# leaked-process checks to their own denoise instead of every one on the machine.
outfile=${DENOISE_TMPDIR:-/tmp}/$key
touch $outfile

function format_log_output {
  if [ -n "${PARENT_LOG_ID:-}" ]; then
    echo -e "Parent Log: $(ci_term_link $PARENT_LOG_ID)"
  fi
  echo "Command: ${DENOISE_DISPLAY_NAME:-$cmd}"
  echo "Working Dir: ${PWD:-}"
  echo "Date: $(date)"
  echo "Status: $status"
  echo "Took: ${time}"
  echo
  cat $outfile
}

function publish_log {
  [ -z "$CI3_SERVER" ] && return
  format_log_output | ci3_client log_put $key
}

function publish_log_final {
  [ -z "$CI3_SERVER" ] && return
  format_log_output | ci3_client log_put $key $ci3_log_expire final
}

function live_publish_log {
  while [ ! -f $outfile.done ]; do
    if [ $(( $(date +%s) - $(stat -c %Y "$outfile") )) -le 5 ]; then
      publish_log
    fi
    sleep 5
  done
}

if [ -n "$CI3_SERVER" ]; then
  live_publish_log &
  publish_pid=$!
  log_info="(${yellow}${url}${reset})"
fi

# Dot logging via named pipe so we can track both PIDs.
set +e
display_cmd="${DENOISE_DISPLAY_NAME:-$cmd}"
echo -e "Executing: $display_cmd ${log_info:-}"
echo -n "   0 "
dots_fifo=$(mktemp -u)
mkfifo "$dots_fifo"

tail --sleep-interval=0.2 -n +1 -f "$outfile" > "$dots_fifo" &
tail_pid=$!

while IFS= read -r line; do
    dot_count=$((dot_count+1))
    [ $realtime -eq 1 ] && printf "."
    if [[ "$dots_per_line" -gt 0 && $((dot_count % dots_per_line)) -eq 0 ]]; then
      [ $realtime -eq 0 ] && printf '%.s.' $(seq 1 "$dots_per_line")
      printf "\n%4s " "$dot_count"
    fi
done < "$dots_fifo" &
dots_pid=$!

# Execute the command in background.
PARENT_LOG_ID=$key bash -c "set -euo pipefail; $cmd" 2>&1 | redact > $outfile &
job_pid=$!

# Wait for the job to finish and get its exit status.
wait $job_pid
status=$?

time="${SECONDS}s"
# Let the live publisher finish its last write before the final one, so nothing overwrites it.
touch $outfile.done
[ -n "${publish_pid:-}" ] && wait $publish_pid || true
publish_log_final

# Kill tail (source), EOF propagates through fifo, dots loop drains and exits.
kill $tail_pid &>/dev/null
wait $tail_pid 2>/dev/null
tail_pid=
wait $dots_pid 2>/dev/null
dots_pid=

# Handle non-zero exit status
if [ "$status" -ne 0 ]; then
  # Print "interrupted" on SIGINT or SIGTERM.
  if [ "$status" -eq 143 ] || [ "$status" -eq 130 ]; then
    echo -e ". ${yellow}interrupted${reset} ($time)"
  else
    # With no log server there is no log URL to point the reader at, so the output has to go
    # inline or the failure is invisible.
    if [ -t 1 ] || [ "${DUMP_FAIL:-0}" -eq 1 ] || [ -z "$CI3_SERVER" ]; then
      echo -e "\nCommand exited with status $status. Dumping output:"
      cat $outfile
    fi
    echo -e ". ${red}failed${reset} ($time) ${log_info:-}"
    if [ "${CI:-0}" == "1" ]; then
      post_github_status failure "${display_cmd:0:240}" "$url" "failed ($time)" 2>/dev/null || true
    fi
  fi
else
  # With no log server there is no log to link to, so a CI orchestrator (e.g. the GitHub runner
  # driving bootstrap_ec2) would lose the output entirely, including the build's CI Log link.
  if [ -z "$CI3_SERVER" ] && [ "${CI:-0}" == "1" ]; then
    echo -e "\nOutput (no log store available):"
    cat $outfile
  fi
  echo -e ". ${green}done${reset} ($time)"
fi

exit $status
