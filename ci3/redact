#!/bin/bash
# Redacts sensitive environment variables from stdin.
# Matches env vars containing: KEY, TOKEN, PASSWORD, SECRET, MNEMONIC
# Replaces their values with *** in the output stream.
set -euo pipefail

# Build patterns as newline-separated string (no temp file)
patterns=""

for var in $(compgen -e); do
  if [[ "$var" =~ (KEY|TOKEN|PASSWORD|SECRET|MNEMONIC) ]]; then
    val="${!var}"
    # Skip empty values
    [[ -z "$val" ]] && continue
    # For multiline values, add each line as a separate pattern
    while IFS= read -r line; do
      [[ -n "$line" ]] && patterns+="$line"$'\n'
    done <<< "$val"
  fi
done

# If no patterns, just pass through
if [[ -z "$patterns" ]]; then
  cat
  exit 0
fi

# Use awk for efficient multipattern replacement with literal string matching
awk -v patterns="$patterns" '
BEGIN {
  n = split(patterns, arr, "\n")
  # Remove empty entries from split
  j = 0
  for (i = 1; i <= n; i++) {
    if (arr[i] != "") {
      parr[j++] = arr[i]
    }
  }
  n = j
}
{
  for (i = 0; i < n; i++) {
    p = parr[i]
    plen = length(p)
    # Use literal string replacement via index() to avoid regex issues
    while ((pos = index($0, p)) > 0) {
      $0 = substr($0, 1, pos-1) "***" substr($0, pos+plen)
    }
  }
  print
}
'
