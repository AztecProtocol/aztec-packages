#!/usr/bin/env bash
# Re-authenticate the 'origin' remote to act as the given token (defaults to $GITHUB_TOKEN).
#
# actions/checkout with persist-credentials: true stores the workflow's default github.token as a
# git http.extraheader. That header is an explicit Authorization and takes precedence over any token
# in the remote URL, so pushes go out as github-actions[bot] (contents: read only) and 403. The exact
# config key has varied across checkout versions (the v6 repin broke the previously-hardcoded
# `git config --unset-all http.https://github.com/.extraheader`), so we strip every persisted
# extraheader by pattern, then authenticate via a tokenized remote URL.
#
# Usage: git_auth_origin <owner/repo> [token]
set -euo pipefail

repo="${1:?usage: git_auth_origin <owner/repo> [token]}"
token="${2:-${GITHUB_TOKEN:?GITHUB_TOKEN is required}}"

for key in $(git config --name-only --get-regexp '^http\..*\.extraheader$' 2>/dev/null || true); do
  git config --unset-all "$key" || true
done
git remote set-url origin "https://x-access-token:${token}@github.com/${repo}.git"
