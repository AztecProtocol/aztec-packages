#!/usr/bin/env bash
# TEMPORARY DIAGNOSTIC VERSION — find what overrides the tokenized remote URL on the runner.
# Usage: git_auth_origin <owner/repo> [token]
set -euo pipefail

repo="${1:?usage: git_auth_origin <owner/repo> [token]}"
token="${2:-${GITHUB_TOKEN:?GITHUB_TOKEN is required}}"

for key in $(git config --name-only --get-regexp '^http\..*\.extraheader$' 2>/dev/null || true); do
  git config --unset-all "$key" || true
done
git remote set-url origin "https://x-access-token:${token}@github.com/${repo}.git"

echo "DIAG: credential.* config:"; git config --get-regexp '^credential\.' 2>/dev/null || echo "  (none)"
echo "DIAG: url.* config:"; git config --get-regexp '^url\.' 2>/dev/null || echo "  (none)"
echo "DIAG: remaining http.* keys:"; git config --name-only --get-regexp '^http\.' 2>/dev/null || echo "  (none)"
echo "DIAG: origin url: $(git remote get-url origin | sed -E 's#://[^@]*@#://***@#')"
echo "DIAG: git version: $(git --version)"
echo "DIAG: gh auth git credential helper present? $(git config --get-regexp 'credential.*helper' 2>/dev/null || echo no)"
