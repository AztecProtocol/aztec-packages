#!/usr/bin/env python3
"""Reference implementations of ci3/CI3_SERVER_API.md. Python 3 standard library only.

  ci3_server start  [--backend file|compat] [--port P] [--dir D] [compat flags]
                    start detached unless one already answers on the port; prints its URL
  ci3_server run    same flags, in the foreground
  ci3_server stop   [--port P] [--dir D]
  ci3_server status [--port P]

Backends:

  file    Everything is a file under --dir (default /tmp/ci3):
            logs/<id>  kv/<key>  lists/<name>  runs/<section>/<id>.json  events/<channel>.jsonl  artifacts/<name>
          A write with ?ttl= gets a `<path>.expires` sidecar holding the expiry epoch; expired entries
          read as absent and are swept periodically. This is what a local run uses.

  compat  Transitional: forwards to the stores the pre-API ci3 wrote to directly, with the key shapes
          the labs dashboard reads, so CI keeps its logs and test cache until that dashboard serves the
          API itself. Logs, kv, lists, runs and events go to redis (--redis HOST:PORT); final logs are
          also copied to S3 (--s3-logs), artifacts go to S3 (--s3-cache) and are read back through the
          bucket's public HTTP endpoint (--public-cache-url). S3 is driven through the `aws` CLI
          (--aws) with whatever credentials it finds (the instance profile in CI).

Set CI3_SERVER_TOKEN to require `Authorization: Bearer` on writes (reads stay anonymous), which is what
makes exposing a server through a tunnel safe.
"""
import argparse
import gzip
import http.client
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, unquote, urlsplit

DEFAULT_PORT = 4275
DEFAULT_DIR = "/tmp/ci3"
SEGMENT = re.compile(r"^[A-Za-z0-9._:+@=,-]+$")
LIST_DEFAULT_MAX = 1000
RUNS_MAX = 1000
DEFAULT_LOG_TTL = 60 * 60 * 24 * 14
SWEEP_INTERVAL = 600
CHUNK = 1 << 20
STORES = ("logs", "kv", "lists", "runs", "events", "artifacts")


class BadKey(ValueError):
    pass


class IncompleteBody(Exception):
    """The client sent fewer bytes than its Content-Length announced (it went away mid-upload)."""


class Redirect(Exception):
    def __init__(self, location):
        self.location = location


def check_key(key):
    """Keys are '/'-separated paths of safe segments. The reference servers' own file suffixes are
    reserved so a sidecar can never be addressed."""
    parts = key.split("/")
    if any(p in ("", ".", "..") or not SEGMENT.match(p) for p in parts):
        raise BadKey(key)
    if parts[-1].endswith((".expires", ".json", ".jsonl")) or parts[-1].startswith(".tmp-"):
        raise BadKey(key)
    return parts


class FileBackend:
    """Files with optional expiry sidecars. Writes are atomic (temp file + rename) because a live log
    is re-PUT every few seconds while a browser reads it. The lock serialises the sidecar and data
    updates against expiry checks, so a refresh of an expired entry is never mistaken for expired."""

    def __init__(self, root):
        self.root = os.path.abspath(root)
        self.lock = threading.RLock()
        for store in STORES:
            os.makedirs(os.path.join(self.root, store), exist_ok=True)

    def describe(self):
        return "backend: file\nstorage: %s" % self.root

    def path(self, store, key):
        return os.path.join(self.root, store, *check_key(key))

    def expired(self, path):
        try:
            with open(path + ".expires") as f:
                return float(f.read()) < time.time()
        except (FileNotFoundError, ValueError):
            return False

    def exists(self, path):
        with self.lock:
            if not os.path.isfile(path):
                return False
            if self.expired(path):
                self.remove(path)
                return False
            return True

    def remove(self, path):
        for p in (path, path + ".expires"):
            try:
                os.remove(p)
            except FileNotFoundError:
                pass

    def write(self, path, data, ttl=None):
        """data: bytes, or a file-like object streamed in chunks."""
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
        try:
            with os.fdopen(fd, "wb") as f:
                if isinstance(data, bytes):
                    f.write(data)
                else:
                    shutil.copyfileobj(data, f, CHUNK)
            with self.lock:
                if ttl is None:
                    self.remove(path + ".expires")
                else:
                    with open(path + ".expires", "w") as f:
                        f.write(str(int(time.time() + ttl)))
                os.replace(tmp, path)
        except BaseException:
            self.remove(tmp)
            raise

    def read(self, path):
        if not self.exists(path):
            return None
        with open(path, "rb") as f:
            return f.read()

    def sweep(self):
        for dirpath, _, files in os.walk(self.root):
            for name in files:
                if name.endswith(".expires"):
                    self.exists(os.path.join(dirpath, name[: -len(".expires")]))

    def log_put(self, key, data, ttl, final):
        self.write(self.path("logs", key), data, ttl)

    def log_get(self, key):
        return self.read(self.path("logs", key))

    def log_list(self, prefix):
        d = self.path("logs", prefix)
        if not os.path.isdir(d):
            return []
        return sorted(n for n in os.listdir(d)
                      if not n.endswith(".expires") and not n.startswith(".tmp-") and self.exists(os.path.join(d, n)))

    def kv_put(self, key, data, ttl):
        self.write(self.path("kv", key), data, ttl)

    def kv_get(self, key):
        return self.read(self.path("kv", key))

    def list_push(self, name, line, maximum, ttl):
        path = self.path("lists", name)
        with self.lock:
            lines = [line] + (self.read(path) or b"").decode(errors="replace").splitlines()
            self.write(path, "".join(l + "\n" for l in lines[:maximum]).encode(), ttl)

    def list_get(self, name):
        return self.read(self.path("lists", name))

    def run_put(self, section, run_id, body, ttl):
        self.write(self.path("runs", section + "/" + run_id) + ".json", body, ttl)

    def run_get(self, section, run_id):
        return self.read(self.path("runs", section + "/" + run_id) + ".json")

    def runs_list(self, section):
        d = self.path("runs", section)
        if not os.path.isdir(d):
            return []
        names = sorted((n for n in os.listdir(d) if n.endswith(".json")), reverse=True)
        return [json.loads(data) for n in names[:RUNS_MAX] for data in [self.read(os.path.join(d, n))] if data]

    def event(self, channel, body):
        path = self.path("events", channel) + ".jsonl"
        with self.lock:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "a") as f:
                f.write(body + "\n")

    def artifact_put(self, name, stream, ttl):
        self.write(self.path("artifacts", name), stream, ttl)

    def artifact_exists(self, name):
        return self.exists(self.path("artifacts", name))

    def artifact_open(self, name):
        """(size, file object) or None. Opened under the lock and sized from the open descriptor, so a
        concurrent replacement cannot pair one version's size with another's bytes."""
        path = self.path("artifacts", name)
        with self.lock:
            if not self.exists(path):
                return None
            f = open(path, "rb")
        return os.fstat(f.fileno()).st_size, f


class Redis:
    """Just enough of the RESP protocol for the commands the compat backend uses. One connection per
    call, so no locking. Values are bytes."""

    def __init__(self, host, port, timeout=30):
        self.host, self.port, self.timeout = host, port, timeout

    def __call__(self, *args):
        with socket.create_connection((self.host, self.port), timeout=self.timeout) as s:
            args = [a if isinstance(a, bytes) else str(a).encode() for a in args]
            s.sendall(b"*%d\r\n" % len(args) + b"".join(b"$%d\r\n%s\r\n" % (len(a), a) for a in args))
            return self.read_reply(s.makefile("rb"))

    def read_reply(self, f):
        line = f.readline()
        if not line:
            raise ConnectionError("redis closed the connection")
        kind, rest = line[:1], line[1:-2]
        if kind == b"+":
            return rest
        if kind == b":":
            return int(rest)
        if kind == b"-":
            raise RuntimeError("redis: " + rest.decode(errors="replace"))
        if kind == b"$":
            n = int(rest)
            if n < 0:
                return None
            data = f.read(n)
            if len(data) != n or f.read(2) != b"\r\n":
                raise ConnectionError("redis: truncated bulk reply")
            return data
        if kind == b"*":
            n = int(rest)
            return None if n < 0 else [self.read_reply(f) for _ in range(n)]
        raise RuntimeError("redis: unexpected reply %r" % line)


def s3_split(location):
    bucket, _, prefix = location[len("s3://"):].partition("/")
    return bucket, prefix.strip("/")


class CompatBackend:
    def __init__(self, args):
        if not args.redis:
            raise SystemExit("the compat backend needs --redis HOST:PORT")
        host, _, port = args.redis.rpartition(":")
        self.redis = Redis(host or args.redis, int(port or 6379))
        self.s3_logs, self.s3_cache, self.aws = args.s3_logs, args.s3_cache, args.aws
        bucket, prefix = s3_split(self.s3_cache)
        self.public_cache_url = (args.public_cache_url or "http://%s.s3.amazonaws.com/%s" % (bucket, prefix)).rstrip("/")
        # Redis is best effort, as it was for the pre-API ci3: artifacts and final logs still reach S3
        # when it is down, and the redis-only operations fail per request (502, a miss to the clients).
        try:
            Redis(self.redis.host, self.redis.port, timeout=3)("PING")
            self.redis_state = "ok at start"
        except OSError as e:
            self.redis_state = "unreachable at start"
            sys.stderr.write("ci3_server: redis %s:%d unreachable (%s)\n" % (self.redis.host, self.redis.port, e))

    def describe(self):
        return "backend: compat\nredis: %s:%d (%s)\nlogs: %s\ncache: %s" % (
            self.redis.host, self.redis.port, self.redis_state, self.s3_logs, self.s3_cache)

    def sweep(self):
        pass

    def s3_uri(self, location, key):
        bucket, prefix = s3_split(location)
        return "s3://%s/%s" % (bucket, "/".join(p for p in (prefix, key) if p))

    def s3_put(self, location, key, data):
        """data: bytes, or a local file path."""
        src, stdin = ("-", data) if isinstance(data, bytes) else (data, None)
        subprocess.run([self.aws, "s3", "cp", src, self.s3_uri(location, key)], input=stdin, check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)

    def s3_get(self, location, key):
        r = subprocess.run([self.aws, "s3", "cp", self.s3_uri(location, key), "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        return r.stdout if r.returncode == 0 else None

    @staticmethod
    def log_object(key):
        """The shapes the pre-API ci3 wrote: a flat id at <first 4 chars>/<id>.log.gz, a path such as
        bench/bb-breakdown/<key> at <path>.log.gz (where the dashboard's breakdown views read)."""
        return key + ".log.gz" if "/" in key else "%s/%s.log.gz" % (key[:4], key)

    def log_put(self, key, data, ttl, final):
        check_key(key)
        packed = gzip.compress(data)
        try:
            self.redis("SETEX", key, ttl or DEFAULT_LOG_TTL, packed)
            redis_error = None
        except (OSError, RuntimeError) as e:
            redis_error = e
        if final:
            # Synchronous: the top-level run log is written as the instance's last act.
            self.s3_put(self.s3_logs, self.log_object(key), packed)
        if redis_error:
            raise redis_error

    def log_get(self, key):
        check_key(key)
        try:
            data = self.redis("GET", key)
        except OSError:
            data = None
        if data is None:
            data = self.s3_get(self.s3_logs, self.log_object(key))
        return gzip.decompress(data) if data and data[:2] == b"\x1f\x8b" else data

    def log_list(self, prefix):
        check_key(prefix)
        r = subprocess.run([self.aws, "s3", "ls", self.s3_uri(self.s3_logs, prefix) + "/"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        names = [line.split()[-1] for line in r.stdout.decode(errors="replace").splitlines() if line.split()]
        return sorted(n[: -len(".log.gz")] for n in names if n.endswith(".log.gz"))

    def kv_put(self, key, data, ttl):
        check_key(key)
        self.redis("SETEX", key, ttl, data) if ttl else self.redis("SET", key, data)

    def kv_get(self, key):
        check_key(key)
        return self.redis("GET", key)

    def list_push(self, name, line, maximum, ttl):
        check_key(name)
        self.redis("LPUSH", name, line)
        self.redis("LTRIM", name, 0, maximum - 1)

    def list_get(self, name):
        check_key(name)
        lines = self.redis("LRANGE", name, 0, -1)
        return b"".join(l + b"\n" for l in lines) if lines else None

    def runs_key(self, section):
        check_key(section)
        return "ci-run-" + section

    def run_put(self, section, run_id, body, ttl):
        key = self.runs_key(section)
        for old in self.redis("ZRANGEBYSCORE", key, run_id, run_id) or []:
            self.redis("ZREM", key, old)
        self.redis("ZADD", key, run_id, body)
        self.redis("ZREMRANGEBYRANK", key, 0, -(RUNS_MAX + 1))

    def run_get(self, section, run_id):
        found = self.redis("ZRANGEBYSCORE", self.runs_key(section), run_id, run_id)
        return found[0] if found else None

    def runs_list(self, section):
        return [json.loads(raw) for raw in self.redis("ZREVRANGE", self.runs_key(section), 0, RUNS_MAX - 1) or []]

    def event(self, channel, body):
        check_key(channel)
        self.redis("PUBLISH", channel, body)

    def artifact_put(self, name, stream, ttl):
        check_key(name)
        fd, tmp = tempfile.mkstemp(prefix="ci3-artifact-")
        try:
            with os.fdopen(fd, "wb") as f:
                shutil.copyfileobj(stream, f, CHUNK)
            self.s3_put(self.s3_cache, name, tmp)
        finally:
            os.remove(tmp)

    def public_url(self, name):
        check_key(name)
        return "%s/%s" % (self.public_cache_url, name)

    def artifact_exists(self, name):
        try:
            with urllib.request.urlopen(urllib.request.Request(self.public_url(name), method="HEAD"), timeout=30):
                return True
        except urllib.error.URLError:
            return False

    def artifact_open(self, name):
        raise Redirect(self.public_url(name))


class Body:
    """A request body of known length, read lazily so an artifact streams to disk. `complete` says
    whether the client sent everything it announced."""

    def __init__(self, rfile, length):
        self.rfile, self.remaining = rfile, length

    def read(self, n=-1):
        if self.remaining <= 0:
            return b""
        data = self.rfile.read(self.remaining if n < 0 else min(n, self.remaining))
        self.remaining -= len(data)
        return data

    @property
    def complete(self):
        return self.remaining == 0


class Handler(BaseHTTPRequestHandler):
    server_version = "ci3-server/1"
    protocol_version = "HTTP/1.1"
    timeout = 300  # a stalled client cannot hold a thread forever

    def log_message(self, fmt, *args):
        if self.server.verbose:
            sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    def reply(self, code, body=b"", ctype="text/plain; charset=utf-8", headers=()):
        body = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def body(self):
        if self.headers.get("Transfer-Encoding"):
            raise LengthRequired()
        return Body(self.rfile, int(self.headers.get("Content-Length") or 0))

    def body_bytes(self):
        body = self.body()
        data = body.read()
        if not body.complete:
            raise IncompleteBody()
        return gzip.decompress(data) if self.headers.get("Content-Encoding", "").lower() == "gzip" else data

    def ttl(self):
        v = self.query.get("ttl", [""])[0]
        return int(v) if v else None

    def handle_request(self, fn):
        url = urlsplit(self.path)
        self.query = parse_qs(url.query)
        parts = [unquote(p) for p in url.path.strip("/").split("/") if p]
        try:
            fn(parts, parts[0] if parts else "", "/".join(parts[1:]))
        except BadKey:
            self.reply(400, "bad path\n")
        except LengthRequired:
            self.close_connection = True
            self.reply(411, "Content-Length required\n")
        except IncompleteBody:
            self.close_connection = True
            self.reply(400, "incomplete body\n")
        except Redirect as r:
            self.reply(302, headers=[("Location", r.location)])
        except Exception as e:  # a backend failure must not take the server down
            sys.stderr.write("ci3_server: %s %s failed: %r\n" % (self.command, self.path, e))
            self.reply(502, "backend error: %r\n" % (e,))

    def do_GET(self):
        self.handle_request(self.get)

    do_HEAD = do_GET

    def do_PUT(self):
        self.handle_request(self.put)

    def do_POST(self):
        self.handle_request(self.post)

    def get(self, parts, head, rest):
        b = self.server.backend
        if not parts:
            return self.reply(200, "ci3-server\n%s\n" % b.describe())
        if head == "health":
            return self.reply(200, "ci3-server", headers=[("X-CI3-Server", self.server.identity)])
        if head == "logs" and rest:
            if self.path.split("?")[0].endswith("/"):
                return self.reply(200, "".join(n + "\n" for n in b.log_list(rest)))
            return self.text(b.log_get(rest), "Log not found: %s\n" % rest)
        if head == "kv" and rest:
            return self.text(b.kv_get(rest), "")
        if head in ("lists", "list") and rest:
            return self.text(b.list_get(rest), "")
        if head == "runs" and rest:
            # A section may itself contain '/'; a run id is always a decimal timestamp.
            if len(parts) >= 3 and parts[-1].isdigit():
                data = b.run_get("/".join(parts[1:-1]), parts[-1])
                return self.reply(200, data, "application/json") if data else self.reply(404, "{}", "application/json")
            return self.reply(200, json.dumps(b.runs_list(rest)), "application/json")
        if head == "artifacts" and rest:
            if self.command == "HEAD":
                return self.reply(200 if b.artifact_exists(rest) else 404)
            opened = b.artifact_open(rest)
            if not opened:
                return self.reply(404)
            size, f = opened
            with f:
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Content-Length", str(size))
                self.end_headers()
                shutil.copyfileobj(f, self.wfile, CHUNK)
            return
        if head in STORES:
            return self.reply(404)
        # Browse URL: /<log id>, with an optional .txt suffix for compatibility with older links.
        key = "/".join(parts)
        key = key[:-4] if key.endswith(".txt") else key
        return self.text(b.log_get(key), "Log not found: %s\n" % key)

    def text(self, data, missing):
        return self.reply(200, data) if data is not None else self.reply(404, missing)

    def authorized(self):
        token = self.server.token
        if token and self.headers.get("Authorization") != "Bearer " + token:
            # The body is not read: an anonymous client must not make the server buffer it.
            self.close_connection = True
            self.reply(401, "missing or invalid bearer token\n")
            return False
        return True

    def put(self, parts, head, rest):
        b = self.server.backend
        if not self.authorized():
            return
        if head == "logs" and rest:
            b.log_put(rest, self.body_bytes(), self.ttl(), self.query.get("final", ["0"])[0] == "1")
            return self.reply(204)
        if head == "kv" and rest:
            b.kv_put(rest, self.body_bytes(), self.ttl())
            return self.reply(204)
        if head == "runs" and len(parts) >= 3:
            body = self.body_bytes()
            json.loads(body)
            b.run_put("/".join(parts[1:-1]), parts[-1], body, self.ttl())
            return self.reply(204)
        if head == "artifacts" and rest:
            body = self.body()
            b.artifact_put(rest, body, self.ttl())
            if not body.complete:
                raise IncompleteBody()
            return self.reply(201)
        return self.reply(405)

    def post(self, parts, head, rest):
        b = self.server.backend
        if not self.authorized():
            return
        if head == "kv" and rest == "mget":
            keys = self.body_bytes().decode().split("\n")
            keys = keys[:-1] if keys and keys[-1] == "" else keys
            values = []
            for k in keys:
                try:
                    values.append(b.kv_get(k) or b"")
                except BadKey:
                    values.append(b"")
            return self.reply(200, "".join(v.decode(errors="replace").rstrip("\n") + "\n" for v in values))
        if head == "lists" and rest:
            line = self.body_bytes().decode(errors="replace").rstrip("\n")
            b.list_push(rest, line, int(self.query.get("max", [LIST_DEFAULT_MAX])[0]), self.ttl())
            return self.reply(204)
        if head == "events" and rest:
            b.event(rest, self.body_bytes().decode(errors="replace").strip())
            return self.reply(204)
        return self.reply(405)


class LengthRequired(Exception):
    pass


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 256  # hundreds of parallel test processes publish at once in CI

    def __init__(self, addr, backend, identity, verbose):
        super().__init__(addr, Handler)
        self.backend, self.identity, self.verbose = backend, identity, verbose
        self.token = os.environ.get("CI3_SERVER_TOKEN", "")


def identity_of(args):
    """What two starters must agree on to share a server. The token's value is checked with a write
    probe, never exposed."""
    auth = "token" if os.environ.get("CI3_SERVER_TOKEN") else "none"
    return "backend=%s dir=%s redis=%s auth=%s" % (args.backend, os.path.abspath(args.dir), args.redis, auth)


def health(port):
    """The identity of the ci3 server on the port, or None."""
    try:
        conn = http.client.HTTPConnection("127.0.0.1", port, timeout=2)
        conn.request("GET", "/health")
        resp = conn.getresponse()
        return resp.getheader("X-CI3-Server", "") if resp.status == 200 and resp.read() == b"ci3-server" else None
    except OSError:
        return None


def token_accepted(port, token):
    """A write probe with a 1 second ttl: nothing is stored."""
    try:
        conn = http.client.HTTPConnection("127.0.0.1", port, timeout=5)
        conn.request("PUT", "/kv/ci3-server-probe?ttl=1", body=b"1", headers={"Authorization": "Bearer " + token})
        return conn.getresponse().status < 300
    except OSError:
        return False


def reusable(args, identity):
    if identity != identity_of(args):
        sys.stderr.write("port %d has a ci3 server with a different configuration (%s), wanted (%s); stop it first\n"
                         % (args.port, identity, identity_of(args)))
        return False
    token = os.environ.get("CI3_SERVER_TOKEN", "")
    if token and not token_accepted(args.port, token):
        sys.stderr.write("port %d has a ci3 server that rejects this CI3_SERVER_TOKEN; stop it first\n" % args.port)
        return False
    return True


def cmd_run(args):
    backend = CompatBackend(args) if args.backend == "compat" else FileBackend(args.dir)
    server = Server((args.host, args.port), backend, identity_of(args), args.verbose)
    # Written by the process that holds the port, so `stop` never targets a starter that lost the race.
    os.makedirs(args.dir, exist_ok=True)
    with open(os.path.join(args.dir, "server.pid"), "w") as f:
        f.write(str(os.getpid()))

    def sweeper():
        while True:
            time.sleep(SWEEP_INTERVAL)
            backend.sweep()

    threading.Thread(target=sweeper, daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    sys.stderr.write("ci3_server listening on http://%s:%d\n%s\n" % (args.host, args.port, backend.describe()))
    server.serve_forever()


def cmd_start(args):
    url = "http://localhost:%d" % args.port

    def answer_if_up():
        identity = health(args.port)
        if identity is None:
            return None
        if not reusable(args, identity):
            return 1
        print(url)
        return 0

    result = answer_if_up()
    if result is not None:
        return result
    # Parallel bootstraps sourcing ci3/source all start the server at once; only one binds. The
    # others see the port taken (or their own child exit) while the winner is still coming up, so
    # keep asking for a while before calling the port foreign or the start failed.
    if port_taken(args.port):
        for _ in range(30):
            time.sleep(0.1)
            result = answer_if_up()
            if result is not None:
                return result
        sys.stderr.write("port %d is taken by something that is not a ci3 server\n" % args.port)
        return 1
    os.makedirs(args.dir, exist_ok=True)
    logfile = os.path.join(args.dir, "server.log")
    cmd = [sys.executable, os.path.abspath(__file__), "run"] + run_flags(args)
    with open(logfile, "ab") as log:
        child = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    deadline, exited_at = time.time() + 10, None
    while time.time() < deadline:
        result = answer_if_up()
        if result is not None:
            return result
        if child.poll() is not None:
            exited_at = exited_at or time.time()
            if time.time() - exited_at > 3:
                break
        time.sleep(0.1)
    sys.stderr.write("ci3_server (%s backend) failed to start; see %s\n" % (args.backend, logfile))
    return 1


def run_flags(args):
    flags = ["--backend", args.backend, "--host", args.host, "--port", str(args.port), "--dir", args.dir,
             "--s3-logs", args.s3_logs, "--s3-cache", args.s3_cache, "--aws", args.aws]
    for name in ("redis", "public_cache_url"):
        if getattr(args, name):
            flags += ["--" + name.replace("_", "-"), getattr(args, name)]
    return flags + (["--verbose"] if args.verbose else [])


def port_taken(port):
    with socket.socket() as s:
        s.settimeout(0.5)
        return s.connect_ex(("127.0.0.1", port)) == 0


def cmd_stop(args):
    pidfile = os.path.join(args.dir, "server.pid")
    try:
        with open(pidfile) as f:
            pid = int(f.read())
        os.kill(pid, signal.SIGTERM)
        os.remove(pidfile)
        print("stopped ci3_server (pid %d)" % pid)
    except (FileNotFoundError, ValueError, ProcessLookupError):
        print("no ci3_server running from %s" % args.dir)


def cmd_status(args):
    if health(args.port) is None:
        print("no ci3_server on port %d" % args.port)
        return 1
    conn = http.client.HTTPConnection("127.0.0.1", args.port, timeout=2)
    conn.request("GET", "/")
    print("ci3_server up at http://localhost:%d\n%s" % (args.port, conn.getresponse().read().decode().strip()))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    for name, fn in (("run", cmd_run), ("start", cmd_start), ("stop", cmd_stop), ("status", cmd_status)):
        p = sub.add_parser(name)
        p.add_argument("--backend", choices=("file", "compat"), default="file")
        p.add_argument("--host", default="127.0.0.1")
        p.add_argument("--port", type=int, default=DEFAULT_PORT)
        p.add_argument("--dir", default=DEFAULT_DIR, help="file backend storage; also where server.pid and server.log live")
        p.add_argument("--verbose", action="store_true")
        p.add_argument("--redis", default="", help="compat: HOST[:PORT] of the redis to forward to")
        p.add_argument("--s3-logs", default="s3://aztec-ci-artifacts/logs", help="compat: where final logs are copied")
        p.add_argument("--s3-cache", default="s3://aztec-ci-artifacts/build-cache", help="compat: where artifacts are uploaded")
        p.add_argument("--public-cache-url", default="", help="compat: public HTTP endpoint of --s3-cache (default: the bucket's)")
        p.add_argument("--aws", default="aws", help="compat: the aws CLI to drive S3 with")
        p.set_defaults(fn=fn)
    args = parser.parse_args()
    sys.exit(args.fn(args) or 0)


if __name__ == "__main__":
    main()
