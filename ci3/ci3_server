#!/usr/bin/env python3
"""Reference implementations of ci3/CI3_SERVER_API.md. Python 3 standard library only.

  ci3_server run    [--backend file|compat] [--host H] [--port P] [--dir D]   serve in the foreground
  ci3_server start  [same options]     start detached unless one already answers on P; prints its URL
  ci3_server stop   [--port P] [--dir D]
  ci3_server status [--port P] [--dir D]

Backends:

  file    Everything is a file under --dir (default $CI3_LOCAL_DIR or /tmp/ci3):
            logs/<id>  kv/<key>  lists/<name>  runs/<section>/<id>.json  events/<channel>.jsonl  artifacts/<name>
          An entry written with ?ttl= gets a `<path>.expires` sidecar holding the expiry epoch; expired
          entries read as absent and are swept periodically. This is what a local run uses.

  compat  Transitional: forwards to the stores the pre-API ci3 wrote to directly, with the exact key
          shapes the labs dashboard reads, so CI keeps its logs and test cache until that dashboard
          implements the API itself. Logs, kv, lists, runs and events go to redis (CI3_COMPAT_REDIS_HOST,
          port CI3_COMPAT_REDIS_PORT); final logs are also copied to S3 (CI3_COMPAT_S3_LOGS, as
          <first 4 chars of id>/<id>.log.gz, or <path>.log.gz for ids that are paths, the shapes
          the pre-API ci3 wrote); artifacts go to S3 (CI3_COMPAT_S3_CACHE) and are
          read back through the bucket's public HTTP endpoint. S3 is driven through the `aws` CLI with
          whatever credentials it finds (the instance profile in CI).

Set CI3_SERVER_TOKEN to require `Authorization: Bearer` on writes (reads stay anonymous), which is what
makes exposing a server through a tunnel safe.
"""
import argparse
import gzip
import http.client
import io
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, unquote, urlsplit

DEFAULT_PORT = 4275
DEFAULT_DIR = os.environ.get("CI3_LOCAL_DIR", "/tmp/ci3")
SEGMENT = re.compile(r"^[A-Za-z0-9._:+@=,-]+$")
LIST_DEFAULT_MAX = 1000
RUNS_MAX = 1000
DEFAULT_LOG_TTL = 60 * 60 * 24 * 14
SWEEP_INTERVAL = 600
CHUNK = 1 << 20
MAX_CHUNKED_BODY = 1 << 30
SOCKET_TIMEOUT = 300
STORES = ("logs", "kv", "lists", "runs", "events", "artifacts")


class BadKey(ValueError):
    pass


def check_key(key):
    """Keys are '/'-separated paths of safe segments; the reference servers' own file suffixes are
    reserved so sidecars can never be addressed."""
    parts = key.split("/")
    if not parts or any(p in ("", ".", "..") or not SEGMENT.match(p) for p in parts):
        raise BadKey(key)
    if parts[-1].endswith((".expires", ".json", ".jsonl")) or parts[-1].startswith(".tmp-"):
        raise BadKey(key)
    return parts


class IncompleteBody(Exception):
    """The client sent fewer bytes than its Content-Length announced (it went away mid-upload)."""


class Redirect(Exception):
    """An artifact operation answered by pointing the client elsewhere."""

    def __init__(self, code, location):
        self.code, self.location = code, location


# file backend


class FileBackend:
    """Files with optional expiry sidecars. Writes are atomic (temp file + rename) because a live log
    is re-PUT every few seconds while the browser reads it. The lock serialises the sidecar and data
    updates against expiry checks, so a refresh of an expired entry is never mistaken for expired."""

    def __init__(self, root):
        self.root = os.path.abspath(root)
        self.lock = threading.RLock()
        for s in STORES:
            os.makedirs(os.path.join(self.root, s), exist_ok=True)

    def describe(self):
        return "backend: file\nstorage: %s" % self.root

    def path(self, store, key):
        return os.path.join(self.root, store, *check_key(key))

    def _expired(self, path):
        try:
            with open(path + ".expires") as f:
                return float(f.read().strip()) < time.time()
        except (FileNotFoundError, ValueError):
            return False

    def exists(self, path):
        with self.lock:
            if not os.path.isfile(path):
                return False
            if self._expired(path):
                self.remove(path)
                return False
            return True

    def remove(self, path):
        for p in (path, path + ".expires"):
            try:
                os.remove(p)
            except FileNotFoundError:
                pass

    def write(self, path, data, ttl=None):
        """data: bytes, or a file-like object streamed in chunks. Nothing is published unless the
        whole body arrived."""
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
        try:
            with os.fdopen(fd, "wb") as f:
                if isinstance(data, (bytes, bytearray)):
                    f.write(data)
                else:
                    shutil.copyfileobj(data, f, CHUNK)
                    if getattr(data, "remaining", 0) > 0:
                        raise IncompleteBody()
            with self.lock:
                if ttl is not None:
                    with open(path + ".expires", "w") as f:
                        f.write(str(int(time.time() + ttl)))
                else:
                    try:
                        os.remove(path + ".expires")
                    except FileNotFoundError:
                        pass
                os.replace(tmp, path)
        except BaseException:
            try:
                os.remove(tmp)
            except FileNotFoundError:
                pass
            raise

    def read(self, path):
        if not self.exists(path):
            return None
        with open(path, "rb") as f:
            return f.read()

    def sweep(self):
        for dirpath, _, files in os.walk(self.root):
            for name in files:
                if name.endswith(".expires"):
                    self.exists(os.path.join(dirpath, name[: -len(".expires")]))

    # --- API ---

    def log_put(self, key, data, ttl, final):
        self.write(self.path("logs", key), data, ttl)

    def log_get(self, key):
        return self.read(self.path("logs", key))

    def log_list(self, prefix):
        d = self.path("logs", prefix)
        if not os.path.isdir(d):
            return []
        return sorted(n for n in os.listdir(d)
                      if not n.endswith(".expires") and not n.startswith(".tmp-") and self.exists(os.path.join(d, n)))

    def kv_put(self, key, data, ttl):
        self.write(self.path("kv", key), data, ttl)

    def kv_get(self, key):
        return self.read(self.path("kv", key))

    def kv_mget(self, keys):
        out = []
        for k in keys:
            try:
                v = self.kv_get(k)
            except BadKey:
                v = None
            out.append(v)
        return out

    def list_push(self, name, line, maximum, ttl):
        path = self.path("lists", name)
        with self.lock:
            existing = (self.read(path) or b"").decode(errors="replace").splitlines()
            lines = [line] + existing
            self.write(path, ("".join(l + "\n" for l in lines[:maximum])).encode(), ttl)

    def list_get(self, name):
        return self.read(self.path("lists", name))

    def run_put(self, section, run_id, body, ttl):
        self.write(self.path("runs", section + "/" + run_id) + ".json", body, ttl)

    def run_get(self, section, run_id):
        return self.read(self.path("runs", section + "/" + run_id) + ".json")

    def runs_list(self, section):
        section_dir = self.path("runs", section)
        runs = []
        if os.path.isdir(section_dir):
            names = sorted((n for n in os.listdir(section_dir) if n.endswith(".json")), reverse=True)
            for n in names[:RUNS_MAX]:
                data = self.read(os.path.join(section_dir, n))
                if data:
                    try:
                        runs.append(json.loads(data))
                    except ValueError:
                        pass
        return runs

    def event(self, channel, body):
        path = self.path("events", channel) + ".jsonl"
        with self.lock:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "a") as f:
                f.write(body + "\n")

    def artifact_put(self, name, stream, ttl):
        self.write(self.path("artifacts", name), stream, ttl)

    def artifact_exists(self, name):
        return self.exists(self.path("artifacts", name))

    def artifact_open(self, name):
        """(size, file object) or None. Opened under the lock and sized from the open descriptor, so a
        concurrent replacement cannot pair one version's size with another's bytes."""
        path = self.path("artifacts", name)
        with self.lock:
            if not self.exists(path):
                return None
            try:
                f = open(path, "rb")
            except FileNotFoundError:
                return None
        return os.fstat(f.fileno()).st_size, f


# compat backend: redis + S3, the stores the old ci3 wrote to directly


class Redis:
    """Just enough of the RESP protocol for the commands below; one connection per call, so no
    locking. Values are bytes."""

    def __init__(self, host, port, timeout=30):
        self.host, self.port, self.timeout = host, port, timeout

    def __call__(self, *args):
        with socket.create_connection((self.host, self.port), timeout=self.timeout) as s:
            parts = [b"*%d\r\n" % len(args)]
            for a in args:
                if isinstance(a, str):
                    a = a.encode()
                elif isinstance(a, int):
                    a = str(a).encode()
                parts.append(b"$%d\r\n%s\r\n" % (len(a), a))
            s.sendall(b"".join(parts))
            return self._read(s.makefile("rb"))

    def _read(self, f):
        line = f.readline()
        if not line:
            raise ConnectionError("redis closed the connection")
        kind, rest = line[:1], line[1:-2]
        if kind == b"+":
            return rest
        if kind == b"-":
            raise RuntimeError("redis: " + rest.decode(errors="replace"))
        if kind == b":":
            return int(rest)
        if kind == b"$":
            n = int(rest)
            if n < 0:
                return None
            data = f.read(n)
            if len(data) != n or f.read(2) != b"\r\n":
                raise ConnectionError("redis: truncated bulk reply")
            return data
        if kind == b"*":
            n = int(rest)
            return None if n < 0 else [self._read(f) for _ in range(n)]
        raise RuntimeError("redis: unexpected reply %r" % line)


def s3_split(location):
    no_scheme = location[len("s3://") :] if location.startswith("s3://") else location
    bucket, _, prefix = no_scheme.partition("/")
    return bucket, prefix.strip("/")


def gunzip_if_needed(data):
    if data is not None and data[:2] == b"\x1f\x8b":
        return gzip.decompress(data)
    return data


class CompatBackend:
    def __init__(self):
        env = os.environ.get
        self.redis = Redis(env("CI3_COMPAT_REDIS_HOST", "localhost"), int(env("CI3_COMPAT_REDIS_PORT", "6379")))
        self.s3_logs = env("CI3_COMPAT_S3_LOGS", "s3://aztec-ci-artifacts/logs")
        self.s3_cache = env("CI3_COMPAT_S3_CACHE", "s3://aztec-ci-artifacts/build-cache")
        self.aws = env("CI3_COMPAT_AWS", "aws")
        cache_bucket, cache_prefix = s3_split(self.s3_cache)
        self.public_cache_url = env(
            "CI3_COMPAT_PUBLIC_CACHE_URL", "http://%s.s3.amazonaws.com/%s" % (cache_bucket, cache_prefix)
        ).rstrip("/")
        # Redis is best effort, as it was for the pre-API ci3: artifacts and final logs still reach S3
        # when it is down, and the redis-only operations fail per request (502, which the clients
        # treat as a miss).
        try:
            Redis(self.redis.host, self.redis.port, timeout=3)("PING")
            self.redis_ok = True
        except OSError as e:
            self.redis_ok = False
            sys.stderr.write("ci3_server: redis %s:%d unreachable (%s); logs, test cache, lists, runs and events will fail\n"
                             % (self.redis.host, self.redis.port, e))

    def describe(self):
        return "backend: compat\nredis: %s:%d (%s)\nlogs: %s\ncache: %s" % (
            self.redis.host, self.redis.port, "ok at start" if self.redis_ok else "unreachable at start", self.s3_logs, self.s3_cache)

    def sweep(self):
        pass

    # --- S3 through the aws CLI ---

    def _s3_uri(self, location, key):
        bucket, prefix = s3_split(location)
        return "s3://%s/%s" % (bucket, "/".join(p for p in (prefix, key) if p))

    def _s3_put(self, location, key, data):
        """data: bytes or a file path."""
        uri = self._s3_uri(location, key)
        if isinstance(data, (bytes, bytearray)):
            subprocess.run([self.aws, "s3", "cp", "-", uri], input=data, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        else:
            subprocess.run([self.aws, "s3", "cp", data, uri], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)

    def _s3_get(self, location, key):
        r = subprocess.run([self.aws, "s3", "cp", self._s3_uri(location, key), "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        return r.stdout if r.returncode == 0 else None

    @staticmethod
    def _log_object(key):
        # The shapes the pre-API ci3 wrote: a flat id lands at <first 4 chars>/<id>.log.gz
        # (cache_persistent), a path such as bench/bb-breakdown/<key> at <path>.log.gz
        # (cache_s3_transfer_to), which is where the dashboard's breakdown views read.
        if "/" in key:
            return key + ".log.gz"
        return "%s/%s.log.gz" % (key[:4], key)

    # --- API ---

    def log_put(self, key, data, ttl, final):
        check_key(key)
        packed = gzip.compress(data)
        redis_error = None
        try:
            self.redis("SETEX", key, ttl or DEFAULT_LOG_TTL, packed)
        except (OSError, RuntimeError) as e:
            redis_error = e
        if final:
            # Synchronous: the top-level run log is written as the instance's last act and a
            # background upload would die with it. Done even when redis failed.
            self._s3_put(self.s3_logs, self._log_object(key), packed)
        if redis_error is not None:
            raise redis_error

    def log_get(self, key):
        check_key(key)
        try:
            data = self.redis("GET", key)
        except OSError:
            data = None
        if data is None:
            data = self._s3_get(self.s3_logs, self._log_object(key))
        return gunzip_if_needed(data)

    def log_list(self, prefix):
        check_key(prefix)
        r = subprocess.run([self.aws, "s3", "ls", self._s3_uri(self.s3_logs, prefix) + "/"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        names = []
        for line in r.stdout.decode(errors="replace").splitlines():
            name = line.split()[-1] if line.split() else ""
            if name.endswith(".log.gz"):
                names.append(name[: -len(".log.gz")])
        return sorted(names)

    def kv_put(self, key, data, ttl):
        check_key(key)
        if ttl:
            self.redis("SETEX", key, ttl, data)
        else:
            self.redis("SET", key, data)

    def kv_get(self, key):
        check_key(key)
        return self.redis("GET", key)

    def kv_mget(self, keys):
        good = []
        for k in keys:
            try:
                check_key(k)
                good.append(k)
            except BadKey:
                good.append(None)
        wanted = [k for k in good if k is not None]
        values = iter(self.redis("MGET", *wanted) if wanted else [])
        return [next(values) if k is not None else None for k in good]

    def list_push(self, name, line, maximum, ttl):
        check_key(name)
        self.redis("LPUSH", name, line)
        self.redis("LTRIM", name, 0, maximum - 1)

    def list_get(self, name):
        check_key(name)
        lines = self.redis("LRANGE", name, 0, -1)
        if not lines:
            return None
        return b"".join(l + b"\n" for l in lines)

    def _runs_key(self, section):
        check_key(section)
        return "ci-run-" + section

    def run_put(self, section, run_id, body, ttl):
        key = self._runs_key(section)
        for old in self.redis("ZRANGEBYSCORE", key, run_id, run_id) or []:
            self.redis("ZREM", key, old)
        self.redis("ZADD", key, run_id, body)
        self.redis("ZREMRANGEBYRANK", key, 0, -(RUNS_MAX + 1))

    def run_get(self, section, run_id):
        found = self.redis("ZRANGEBYSCORE", self._runs_key(section), run_id, run_id)
        return found[0] if found else None

    def runs_list(self, section):
        runs = []
        for raw in self.redis("ZREVRANGE", self._runs_key(section), 0, RUNS_MAX - 1) or []:
            try:
                runs.append(json.loads(raw))
            except ValueError:
                pass
        return runs

    def event(self, channel, body):
        check_key(channel)
        self.redis("PUBLISH", channel, body)

    def artifact_put(self, name, stream, ttl):
        check_key(name)
        fd, tmp = tempfile.mkstemp(prefix="ci3-artifact-")
        try:
            with os.fdopen(fd, "wb") as f:
                shutil.copyfileobj(stream, f, CHUNK)
            if getattr(stream, "remaining", 0) > 0:
                raise IncompleteBody()
            self._s3_put(self.s3_cache, name, tmp)
        finally:
            os.remove(tmp)

    def _public_url(self, name):
        check_key(name)
        return "%s/%s" % (self.public_cache_url, name)

    def artifact_exists(self, name):
        req = urllib.request.Request(self._public_url(name), method="HEAD")
        try:
            with urllib.request.urlopen(req, timeout=30):
                return True
        except urllib.error.URLError:
            return False

    def artifact_open(self, name):
        raise Redirect(302, self._public_url(name))


# HTTP


class Handler(BaseHTTPRequestHandler):
    server_version = "ci3-server/1"
    protocol_version = "HTTP/1.1"
    timeout = SOCKET_TIMEOUT  # a stalled client cannot hold a thread forever

    def log_message(self, fmt, *args):
        if self.server.verbose:
            sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    def reply(self, code, body=b"", ctype="text/plain; charset=utf-8", headers=()):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def body_stream(self):
        """The request body as a file object: Content-Length bodies are read lazily, chunked ones
        (curl -T -) are decoded fully first."""
        if self.headers.get("Transfer-Encoding", "").lower() == "chunked":
            out = io.BytesIO()
            total = 0
            while True:
                line = self.rfile.readline()
                if not line:
                    raise IncompleteBody()
                size = int(line.strip().split(b";")[0] or b"0", 16)
                if size == 0:
                    while self.rfile.readline().strip():
                        pass
                    break
                total += size
                if total > MAX_CHUNKED_BODY:
                    raise IncompleteBody()
                chunk = self.rfile.read(size)
                if len(chunk) != size or self.rfile.readline() not in (b"\r\n", b"\n"):
                    raise IncompleteBody()
                out.write(chunk)
            out.seek(0)
            return out
        length = int(self.headers.get("Content-Length") or 0)
        return _Limited(self.rfile, length)

    def body_bytes_from(self, stream):
        data = stream.read()
        if getattr(stream, "remaining", 0) > 0:
            raise IncompleteBody()
        return data

    def body_bytes(self):
        data = self.body_bytes_from(self.body_stream())
        if self.headers.get("Content-Encoding", "").lower() == "gzip":
            data = gzip.decompress(data)
        return data

    def authorized(self):
        token = self.server.token
        return not token or self.headers.get("Authorization", "") == "Bearer " + token

    def ttl(self):
        v = self.query.get("ttl", [None])[0]
        return int(v) if v else None

    def route(self):
        url = urlsplit(self.path)
        self.query = parse_qs(url.query)
        parts = [unquote(p) for p in url.path.strip("/").split("/") if p]
        head = parts[0] if parts else ""
        return parts, head, "/".join(parts[1:])

    def dispatch(self, fn):
        try:
            return fn()
        except BadKey:
            return self.reply(400, "bad path\n")
        except IncompleteBody:
            self.close_connection = True
            return self.reply(400, "incomplete body\n")
        except Redirect as r:
            return self.reply(r.code, "", headers=[("Location", r.location)])
        except Exception as e:  # a backend failure must not take the server down
            sys.stderr.write("ci3_server: %s %s failed: %r\n" % (self.command, self.path, e))
            return self.reply(502, "backend error: %r\n" % (e,))

    def text_or_404(self, data, missing):
        if data is None:
            return self.reply(404, missing)
        return self.reply(200, data)

    # --- reads ---

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        self.dispatch(self._get)

    def _get(self):
        b = self.server.backend
        parts, head, rest = self.route()
        if not parts:
            return self.reply(200, "ci3-server\n%s\n" % b.describe())
        if head == "health":
            return self.reply(200, "ci3-server", headers=[("X-CI3-Server", self.server.identity)])
        if head == "logs" and rest:
            if self.path.split("?")[0].endswith("/"):
                return self.reply(200, "".join(n + "\n" for n in b.log_list(rest)))
            return self.text_or_404(b.log_get(rest), "Log not found: %s\n" % rest)
        if head == "kv" and rest:
            return self.text_or_404(b.kv_get(rest), "")
        if head in ("lists", "list") and rest:
            return self.text_or_404(b.list_get(rest), "")
        if head == "runs" and rest:
            # A section may itself contain '/'; a run id is always a decimal timestamp, so a path
            # ending in one is tried as a run before being treated as a section.
            if len(parts) >= 3 and parts[-1].isdigit():
                data = b.run_get("/".join(parts[1:-1]), parts[-1])
                if data is not None:
                    return self.reply(200, data, "application/json")
                return self.reply(404, "{}", "application/json")
            return self.reply(200, json.dumps(b.runs_list(rest)), "application/json")
        if head == "artifacts" and rest:
            if self.command == "HEAD":
                return self.reply(200 if b.artifact_exists(rest) else 404, "")
            opened = b.artifact_open(rest)
            if opened is None:
                return self.reply(404, "")
            size, f = opened
            with f:
                self.send_response(200)
                self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Content-Length", str(size))
                self.end_headers()
                shutil.copyfileobj(f, self.wfile, CHUNK)
            return
        if head in STORES:
            return self.reply(404, "")
        # Browse URL: /<log id>, with an optional .txt suffix for compatibility with older links.
        key = "/".join(parts)
        if key.endswith(".txt"):
            key = key[:-4]
        return self.text_or_404(b.log_get(key), "Log not found: %s\n" % key)

    # --- writes ---

    def do_PUT(self):
        self.dispatch(self._put)

    def unauthorized(self):
        # The body is not read: an anonymous client must not be able to make the server buffer it.
        self.close_connection = True
        return self.reply(401, "missing or invalid bearer token\n")

    def _put(self):
        b = self.server.backend
        parts, head, rest = self.route()
        if not self.authorized():
            return self.unauthorized()
        if head == "logs" and rest:
            b.log_put(rest, self.body_bytes(), self.ttl(), self.query.get("final", ["0"])[0] == "1")
            return self.reply(204)
        if head == "kv" and rest:
            b.kv_put(rest, self.body_bytes(), self.ttl())
            return self.reply(204)
        if head == "runs" and len(parts) >= 3:
            body = self.body_bytes()
            try:
                json.loads(body)
            except ValueError:
                return self.reply(400, "runs take a JSON object\n")
            b.run_put("/".join(parts[1:-1]), parts[-1], body, self.ttl())
            return self.reply(204)
        if head == "artifacts" and rest:
            stream = self.body_stream()
            if self.headers.get("Content-Encoding", "").lower() == "gzip":
                stream = io.BytesIO(gzip.decompress(self.body_bytes_from(stream)))
            b.artifact_put(rest, stream, self.ttl())
            return self.reply(201)
        self.body_stream().read()
        return self.reply(405, "")

    def do_POST(self):
        self.dispatch(self._post)

    def _post(self):
        b = self.server.backend
        parts, head, rest = self.route()
        if not self.authorized():
            return self.unauthorized()
        if head == "kv" and rest == "mget":
            keys = self.body_bytes().decode().split("\n")
            if keys and keys[-1] == "":
                keys.pop()
            values = b.kv_mget(keys)
            return self.reply(200, "".join((v or b"").decode(errors="replace").rstrip("\n") + "\n" for v in values))
        if head == "lists" and rest:
            line = self.body_bytes().decode(errors="replace").rstrip("\n")
            maximum = int(self.query.get("max", [LIST_DEFAULT_MAX])[0])
            b.list_push(rest, line, maximum, self.ttl())
            return self.reply(204)
        if head == "events" and rest:
            b.event(rest, self.body_bytes().decode(errors="replace").strip())
            return self.reply(204)
        self.body_stream().read()
        return self.reply(405, "")


class _Limited(io.RawIOBase):
    def __init__(self, raw, length):
        self.raw, self.remaining = raw, length

    def readable(self):
        return True

    def read(self, n=-1):
        if self.remaining <= 0:
            return b""
        if n < 0 or n > self.remaining:
            n = self.remaining
        data = self.raw.read(n)
        self.remaining -= len(data)
        return data

    def readinto(self, b):
        data = self.read(len(b))
        b[: len(data)] = data
        return len(data)


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    # Hundreds of parallel test processes publish at once in CI; the default backlog of 5 would
    # drop connections.
    request_queue_size = 256

    def __init__(self, addr, backend, token, verbose, identity):
        super().__init__(addr, Handler)
        self.backend, self.token, self.verbose, self.identity = backend, token, verbose, identity


def identity_of(args):
    """What two starters must agree on to share a server: backend, storage directory, and whether
    writes take a token (the token's value is checked with a write probe, never exposed)."""
    token = os.environ.get("CI3_SERVER_TOKEN", "")
    return "backend=%s dir=%s auth=%s" % (args.backend, os.path.abspath(args.dir), "token" if token else "none")


# process management


def health(port, host="127.0.0.1"):
    """The server's identity line, or None when nothing answers as a ci3 server."""
    try:
        conn = http.client.HTTPConnection(host, port, timeout=2)
        conn.request("GET", "/health")
        resp = conn.getresponse()
        if resp.status == 200 and resp.read() == b"ci3-server":
            return resp.getheader("X-CI3-Server", "")
        return None
    except OSError:
        return None


def token_accepted(port, token, host="127.0.0.1"):
    """A write probe: the running server takes our token. Nothing is stored (a 1 second ttl)."""
    try:
        conn = http.client.HTTPConnection(host, port, timeout=5)
        conn.request("PUT", "/kv/ci3-server-probe?ttl=1", body=b"1", headers={"Authorization": "Bearer " + token})
        return conn.getresponse().status < 300
    except OSError:
        return False


def reusable(args, identity):
    """Whether the server already on the port is the one this start asks for."""
    if identity != identity_of(args):
        sys.stderr.write("port %d has a ci3 server with a different configuration (%s), wanted (%s); stop it first\n"
                         % (args.port, identity, identity_of(args)))
        return False
    token = os.environ.get("CI3_SERVER_TOKEN", "")
    if token and not token_accepted(args.port, token):
        sys.stderr.write("port %d has a ci3 server that rejects this CI3_SERVER_TOKEN; stop it first\n" % args.port)
        return False
    return True


def port_open(port, host="127.0.0.1"):
    with socket.socket() as s:
        s.settimeout(0.5)
        return s.connect_ex((host, port)) == 0


def make_backend(args):
    if args.backend == "compat":
        return CompatBackend()
    return FileBackend(args.dir)


def cmd_run(args):
    backend = make_backend(args)
    server = Server((args.host, args.port), backend, os.environ.get("CI3_SERVER_TOKEN", ""), args.verbose, identity_of(args))
    # Written by the process that actually holds the port, so `stop` never targets a starter that
    # lost the race to bind.
    os.makedirs(args.dir, exist_ok=True)
    with open(os.path.join(args.dir, "server.pid"), "w") as f:
        f.write(str(os.getpid()))

    def sweeper():
        while True:
            time.sleep(SWEEP_INTERVAL)
            try:
                backend.sweep()
            except OSError:
                pass

    threading.Thread(target=sweeper, daemon=True).start()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    sys.stderr.write("ci3_server listening on http://%s:%d (%s)\n" % (args.host, args.port, backend.describe()))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def cmd_start(args):
    url = "http://localhost:%d" % args.port
    identity = health(args.port)
    if identity is not None:
        if not reusable(args, identity):
            return 1
        print(url)
        return 0
    if port_open(args.port):
        # Something listens but did not answer as a ci3 server: most likely another starter's
        # server still binding. Give it a moment before calling the port foreign.
        for _ in range(30):
            time.sleep(0.1)
            identity = health(args.port)
            if identity is not None:
                if not reusable(args, identity):
                    return 1
                print(url)
                return 0
        sys.stderr.write("port %d is taken by something that is not a ci3 server\n" % args.port)
        return 1
    os.makedirs(args.dir, exist_ok=True)
    logfile = os.path.join(args.dir, "server.log")
    log = open(logfile, "ab")
    cmd = [sys.executable, os.path.abspath(__file__), "run", "--backend", args.backend, "--host", args.host,
           "--port", str(args.port), "--dir", args.dir]
    if args.verbose:
        cmd.append("--verbose")
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True, close_fds=True)
    # Concurrent callers (parallel bootstraps sourcing ci3/source at once) race to start the
    # server. The losers fail to bind and exit while the winner is still coming up, so a child
    # exit is not a failure until the port has stayed silent for a while.
    deadline = time.time() + 10
    exited_at = None
    while time.time() < deadline:
        identity = health(args.port)
        if identity is not None:
            if not reusable(args, identity):
                return 1
            print(url)
            return 0
        if proc.poll() is not None:
            exited_at = exited_at or time.time()
            if time.time() - exited_at > 3:
                break
        time.sleep(0.1)
    sys.stderr.write("ci3_server (%s backend) failed to start; see %s\n" % (args.backend, logfile))
    return 1


def cmd_stop(args):
    pidfile = os.path.join(args.dir, "server.pid")
    try:
        with open(pidfile) as f:
            pid = int(f.read().strip())
        os.kill(pid, signal.SIGTERM)
        os.remove(pidfile)
        print("stopped ci3_server (pid %d)" % pid)
    except (FileNotFoundError, ValueError, ProcessLookupError):
        print("no ci3_server running from %s" % args.dir)
    return 0


def cmd_status(args):
    if health(args.port) is not None:
        conn = http.client.HTTPConnection("127.0.0.1", args.port, timeout=2)
        conn.request("GET", "/")
        print("ci3_server up at http://localhost:%d\n%s" % (args.port, conn.getresponse().read().decode().strip()))
        return 0
    print("no ci3_server on port %d" % args.port)
    return 1


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="cmd", required=True)
    for name, fn in (("run", cmd_run), ("start", cmd_start), ("stop", cmd_stop), ("status", cmd_status)):
        p = sub.add_parser(name)
        p.add_argument("--backend", choices=("file", "compat"), default=os.environ.get("CI3_SERVER_BACKEND", "file"))
        p.add_argument("--host", default="127.0.0.1")
        p.add_argument("--port", type=int, default=int(os.environ.get("CI3_LOCAL_PORT", DEFAULT_PORT)))
        p.add_argument("--dir", default=DEFAULT_DIR)
        p.add_argument("--verbose", action="store_true")
        p.set_defaults(fn=fn)
    args = parser.parse_args()
    sys.exit(args.fn(args) or 0)


if __name__ == "__main__":
    main()
