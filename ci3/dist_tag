#!/usr/bin/env bash
# Returns the release channel name from a semver tag (e.g. "nightly" from "5.0.0-nightly.20260415").
# Used for S3 aliases (aztec-up, playground), git branch pushes (l1-contracts), and docker tags.
# NOT used for npm dist-tags — deploy_npm computes those independently.
source $(git rev-parse --show-toplevel)/ci3/source
version=$REF_NAME
if [ -n "${DIST_TAG:-}" ]; then
  echo "$DIST_TAG"
  return
fi
if ! semver check $version; then
  echo_stderr "$version is not a valid semver."
  exit 1
fi
dist=$(semver prerelease $version | sed 's/\..*//')
if [ -n "$dist" ]; then
  echo $dist
else
  echo latest
fi
