#!/usr/bin/env bash
# Exit 0 if build-cache artifact <name> is on the server, 1 otherwise (or no server).
# Usage: ci3_client_artifact_exists <name>
NO_CD=1 source ${ci3:-$(git rev-parse --show-toplevel)/ci3}/source_ci3_client
set -uo pipefail
name=${1:?usage: ci3_client_artifact_exists <name>}
[ -n "$CI3_SERVER" ] || exit 1
ci3_curl --max-time 30 -L -I -o /dev/null "$CI3_SERVER/artifacts/$name"
