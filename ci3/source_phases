# Sourced by source_bootstrap. Provides CI phase timing instrumentation.
# Provides ci_phase for wrapping build/test commands with timing published
# to Redis channel ci:phase:complete as JSON, stored in the ci_phases table.
# Cache download/upload timing is intentionally not tracked — only build time matters.

function _publish_phase {
  local phase=$1 duration_secs=$2 exit_code=$3
  [ "${CI_REDIS_AVAILABLE:-0}" -eq 1 ] || return 0
  # Skip sub-0.1s phases (no real work done — fully cached or negligible)
  awk "BEGIN{exit !($duration_secs < 0.1)}" && return 0
  local commit_hash=${COMMIT_HASH:-$(git rev-parse HEAD 2>/dev/null || true)}
  redis_publish ci:phase:complete "$(jq -c -n \
    --arg phase "$phase" \
    --argjson duration "$duration_secs" \
    --argjson exit_code "$exit_code" \
    --arg run_id "${RUN_ID:-}" \
    --arg job_id "${JOB_ID:-}" \
    --arg dashboard "${CI_DASHBOARD:-}" \
    --arg ref_name "${REF_NAME:-}" \
    --arg commit_hash "$commit_hash" \
    '{phase:$phase, duration_secs:$duration, exit_code:$exit_code,
      run_id:$run_id, job_id:$job_id, dashboard:$dashboard,
      ref_name:$ref_name, commit_hash:$commit_hash}')" &>/dev/null &
}

# High-resolution elapsed seconds since $1 (captured via $EPOCHREALTIME).
# Uses awk instead of bc — bc is not installed on CI runners.
function _elapsed {
  awk "BEGIN{printf \"%.3f\", $EPOCHREALTIME - $1}"
}

# General phase wrapper.
# Usage: ci_phase <name> <command...>
# Example: ci_phase "barretenberg" ./barretenberg/cpp/bootstrap.sh
function ci_phase {
  local phase_name=$1; shift
  local _t=$EPOCHREALTIME
  "$@"
  local code=$?
  _publish_phase "$phase_name" "$(_elapsed $_t)" "$code"
  return $code
}

export -f _publish_phase _elapsed ci_phase
