#!/usr/bin/env bash
# End the current benchmark and write results.
# This is a standalone script that can be called without sourcing source_benchmark.
# Usage: end_bench
#
# Reads __BENCH_NAME and __BENCH_START_TIME from the environment.
# Writes benchmark JSON to bench-out/<bench_name>.bench.json
set -eu

if [[ -z "${__BENCH_NAME:-}" || -z "${__BENCH_START_TIME:-}" ]]; then
  exit 0
fi

end_time=$(date +%s)
duration=$((end_time - __BENCH_START_TIME))
bench_name="$__BENCH_NAME"

# Create bench-out directory if needed
mkdir -p bench-out

# Sanitize bench name for filename (replace / with _)
filename=$(echo "$bench_name" | tr '/' '_')

# Write benchmark JSON
cat > "bench-out/${filename}.bench.json" << EOF
[{"name": "ci/${bench_name}", "value": ${duration}, "unit": "seconds"}]
EOF
