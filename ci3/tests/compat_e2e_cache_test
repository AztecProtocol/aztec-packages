#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
source "$root/ci3/source_stdlib"

function fail {
  echo "FAILED: $1" >&2
  exit 1
}

release_compat_e2e=$(sed -n '/^function release_compat_e2e /,/^}/p' "$root/bootstrap.sh")
grep -q 'export USE_TEST_CACHE=1' <<< "$release_compat_e2e" || fail "compat e2e cache reads are disabled"

source_commit=$(git rev-parse HEAD)
function first_compat_command {
  AZTEC_CACHE_COMMIT=$source_commit "$root/yarn-project/end-to-end/bootstrap.sh" compat_test_cmds "$1" | sed -n '1p'
}

command_5_0_1_a=$(first_compat_command 5.0.1)
command_5_0_1_b=$(first_compat_command 5.0.1)
command_5_1_0=$(first_compat_command 5.1.0)

[[ "$command_5_0_1_a" != disabled-cache:* ]] || fail "committed build inputs disabled caching"
[[ "$command_5_0_1_a" == *"CONTRACT_ARTIFACTS_VERSION=5.0.1"* ]] || fail "artifact version is missing from command"
[[ "$command_5_0_1_a" == "$command_5_0_1_b" ]] || fail "identical inputs generated different commands"

key_5_0_1_a=$(hash_str_orig "$command_5_0_1_a")
key_5_0_1_b=$(hash_str_orig "$command_5_0_1_b")
key_5_1_0=$(hash_str_orig "$command_5_1_0")

[[ "$key_5_0_1_a" == "$key_5_0_1_b" ]] || fail "identical commands generated different cache keys"
[[ "$key_5_0_1_a" != "$key_5_1_0" ]] || fail "artifact version did not invalidate cache key"

build_hash=${command_5_0_1_a%%:*}
changed_build_command="ffffffffffffffff${command_5_0_1_a#$build_hash}"
changed_build_key=$(hash_str_orig "$changed_build_command")
[[ "$key_5_0_1_a" != "$changed_build_key" ]] || fail "build hash did not invalidate cache key"

echo "Compat e2e cache tests passed."
