#!/usr/bin/env bash
# Exercises the ci3_client commands against the file-backed reference server (ci3_server) on a
# private port and directory, and the ci3 scripts that build on them (cache_log, the test cache
# filter, the build cache). Nothing here touches the default local server or /tmp/ci3.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
# The ci3 scripts under test resolve their includes from $root and their branch from $REF_NAME, as
# every real caller has both exported; some steps below run them from a scratch directory.
export root="$ROOT"
export ci3="$ROOT/ci3"
export REF_NAME=${REF_NAME:-$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)}
export PATH="$ci3:$PATH"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'
TESTS_PASSED=0
TESTS_FAILED=0
pass() { echo "${GREEN}✓${NC} $1"; ((TESTS_PASSED++)) || true; }
fail() { echo "${RED}✗${NC} $1: $2"; ((TESTS_FAILED++)) || true; }
check() { # <name> <expected> <actual>
  if [ "$2" == "$3" ]; then pass "$1"; else fail "$1" "expected [$2] got [$3]"; fi
}

echo "=== ci3 client/server test suite ==="

work=$(mktemp -d)
port=$((20000 + RANDOM % 20000))
cleanup() {
  "$ci3/ci3_server" stop --port $port --dir "$work/store" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

# The test's environment must not inherit the build's production endpoint or credentials.
unset CI3_SERVER CI3_PUBLIC_URL PARENT_LOG_ID CI3_PASSWORD CI3_CACHE_PUBLIC
export CI=0
server_args=(--port "$port" --dir "$work/store" --public-cache-url http://127.0.0.1:1)
url=$("$ci3/ci3_server" start "${server_args[@]}")
export CI3_SERVER=$url
check "configured server exported" "$url" "$CI3_SERVER"
check "url points at the server" "$url/abc" "$(ci3_client url abc)"
check "CI3_PUBLIC_URL is the link base" "https://me.example/abc" "$(CI3_PUBLIC_URL=https://me.example ci3_client url abc)"

# --- logs ---
echo "--- logs ---"
printf 'line one\nline two\n' | ci3_client log_put log1
check "log roundtrip" "$(printf 'line one\nline two')" "$(ci3_client log_get log1)"
check "browse url serves the log" "$(printf 'line one\nline two')" "$(curl -s "$url/log1")"
check ".txt suffix still serves the log" "line one" "$(curl -s "$url/log1.txt" | head -1)"
printf 'replaced\n' | ci3_client log_put log1
check "log put replaces" "replaced" "$(ci3_client log_get log1)"
printf 'in progress\n' | ci3_client log_put_partial live1
check "partial log is readable" "in progress" "$(ci3_client log_get live1)"
printf 'complete\n' | ci3_client log_put live1
check "final log replaces its partial snapshot" "complete" "$(ci3_client log_get live1)"
printf 'nested\n' | ci3_client log_put group/123/abc
check "log ids may be paths" "nested" "$(ci3_client log_get group/123/abc)"
printf 'flow\n' | ci3_client log_put bench/bb-breakdown/native-ecdsar1+transfer_0_recursions+sponsored_fpc-abc
check "benchmark flow names with + are valid ids" "flow" "$(ci3_client log_get bench/bb-breakdown/native-ecdsar1+transfer_0_recursions+sponsored_fpc-abc)"
printf 'two\n' | ci3_client log_put group/123/def
check "log list under a prefix" "$(printf 'abc\ndef')" "$(ci3_client log_list group/123)"
check "log list of an unknown prefix is empty" "" "$(ci3_client log_list group/nope)"
head -c 300000 /dev/urandom | base64 >"$work/big"
ci3_client log_put big <"$work/big"
if cmp -s "$work/big" <(ci3_client log_get big); then pass "large log survives gzip transport"; else fail "large log survives gzip transport" "content differs"; fi
if ci3_client log_get nope 2>/dev/null; then fail "missing log exits 1" "exit 0"; else pass "missing log exits 1"; fi
printf 'short lived\n' | ci3_client log_put ttl1 1
sleep 2
if ci3_client log_get ttl1 2>/dev/null; then fail "log ttl expires" "still readable"; else pass "log ttl expires"; fi

# --- kv ---
echo "--- kv ---"
ci3_client kv_set k1 v1
ci3_client kv_set k2 v2
check "kv get" "v1" "$(ci3_client kv_get k1)"
check "kv miss is an empty line" "" "$(ci3_client kv_get nope)"
mapfile -t got < <(ci3_client kv_get k1 nope k2)
check "kv mget count" 3 "${#got[@]}"
check "kv mget values in order" "v1||v2" "${got[0]}|${got[1]}|${got[2]}"
ci3_client kv_set hb 1 1
sleep 2
check "kv ttl expires" "" "$(ci3_client kv_get hb)"

# --- lists ---
echo "--- lists ---"
ci3_client list_push hist one 2
ci3_client list_push hist two 2
ci3_client list_push hist three 2
check "list newest first, bounded" "$(printf 'three\ntwo')" "$(ci3_client list_get hist)"
ci3_client list_push history_abc_merge-train/avm "with slash"
check "list names may be paths" "with slash" "$(ci3_client list_get history_abc_merge-train/avm)"
check "list browse url" "with slash" "$(curl -s "$url/list/history_abc_merge-train/avm")"
if ci3_client list_get nolist 2>/dev/null; then fail "missing list exits 1" "exit 0"; else pass "missing list exits 1"; fi

# --- runs ---
echo "--- runs ---"
echo '{"status":"RUNNING","name":"x","msg":"test","author":"test","timestamp":1700000000000123}' | ci3_client run_put prs 1700000000000123
echo '{"status":"RUNNING","name":"y","msg":"test","author":"test","timestamp":1700000000000456}' | ci3_client run_put prs 1700000000000456
check "run get" x "$(ci3_client run_get prs 1700000000000123 | jq -r .name)"
check "runs listed newest first" "y,x" "$(curl -s "$url/runs/prs" | jq -r 'map(.name) | join(",")')"
echo '{"status":"RUNNING","name":"x","msg":"test","author":"test","timestamp":1700000000000789}' | ci3_client run_put merge-train/avm 1700000000000789
check "run section may contain a slash" RUNNING "$(ci3_client run_get merge-train/avm 1700000000000789 | jq -r .status)"
check "runs list for a slashed section" 1 "$(curl -s "$url/runs/merge-train/avm" | jq length)"
if ci3_client run_get prs 1 2>/dev/null; then fail "missing run exits 1" "exit 0"; else pass "missing run exits 1"; fi
check "unknown section lists empty" "[]" "$(curl -s "$url/runs/nothing")"

# --- artifacts ---
echo "--- artifacts ---"
head -c 200000 /dev/urandom >"$work/blob"
ci3_client artifact_put foo-abc.tar.gz "$work/blob"
if ci3_client artifact_exists foo-abc.tar.gz; then pass "artifact exists after put"; else fail "artifact exists after put" "exit 1"; fi
if cmp -s "$work/blob" <(ci3_client artifact_get foo-abc.tar.gz); then pass "artifact roundtrip"; else fail "artifact roundtrip" "content differs"; fi
if ci3_client artifact_exists nope.tar.gz; then fail "missing artifact exists exits 1" "exit 0"; else pass "missing artifact exists exits 1"; fi
if ci3_client artifact_get nope.tar.gz >/dev/null 2>&1; then fail "missing artifact get exits 1" "exit 0"; else pass "missing artifact get exits 1"; fi
# A client that dies mid-upload announces more bytes than it sends; nothing may be published.
port_only=${url##*:}
{ printf 'PUT /artifacts/truncated.tar.gz HTTP/1.1\r\nHost: x\r\nContent-Length: 100000\r\n\r\n'; head -c 1000 /dev/urandom; } | timeout 5 bash -c "cat >/dev/tcp/127.0.0.1/$port_only" 2>/dev/null || true
sleep 0.5
if ci3_client artifact_exists truncated.tar.gz; then fail "truncated upload is not published" "artifact exists"; else pass "truncated upload is not published"; fi
check "artifact ttl recorded" 1 "$( [ -f "$work/store/objects/artifacts/_foo-abc.tar.gz/data.expires" ] && echo 1 || echo 0)"
# Bodies must announce their length: a chunked upload (curl -T -) is refused outright.
check "chunked upload is refused" 411 "$(printf 'x' | curl -s -o /dev/null -w '%{http_code}' -H 'Transfer-Encoding: chunked' -T - "$url/logs/chunked")"

# --- auth ---
echo "--- bad paths and reuse ---"
check "bad path rejected" 400 "$(curl -s -o /dev/null -w '%{http_code}' -X PUT --data-binary x "$url/logs/%2E%2E/etc")"
check "server sidecars are not addressable" 404 "$(curl -s -o /dev/null -w '%{http_code}' "$url/logs/log1.expires")"
check "run files are not addressable as logs" 404 "$(curl -s -o /dev/null -w '%{http_code}' "$url/logs/x.json")"
if "$ci3/ci3_server" start "${server_args[@]}" --dir "$work/other-store" >/dev/null 2>&1; then fail "start with a different storage dir refuses to reuse the server" "reused"; else pass "start with a different storage dir refuses to reuse the server"; fi
if "$ci3/ci3_server" start "${server_args[@]}" --public-cache-url http://127.0.0.1:2 >/dev/null 2>&1; then fail "start with a different public cache refuses to reuse the server" "reused"; else pass "start with a different public cache refuses to reuse the server"; fi
if CI3_CACHE_PUBLIC=1 "$ci3/ci3_server" start "${server_args[@]}" >/dev/null 2>&1; then fail "start with a different cache mode refuses to reuse the server" "reused"; else pass "start with a different cache mode refuses to reuse the server"; fi
check "start with the same configuration reuses the server" "$url" "$("$ci3/ci3_server" start "${server_args[@]}" 2>/dev/null)"

# --- no server: every client is a harmless no-op ---
echo "--- no server ---"
check "log_put drains stdin and exits 0" 0 "$( { printf 'x\n' | CI3_SERVER= ci3_client log_put z; echo $?; } )"
check "log_put_partial drains stdin and exits 0" 0 "$( { printf 'x\n' | CI3_SERVER= ci3_client log_put_partial z; echo $?; } )"
mapfile -t got < <(CI3_SERVER= ci3_client kv_get a b)
check "kv_get answers one empty line per key" "2||" "${#got[@]}|${got[0]}|${got[1]}"
check "kv_set exits 0" 0 "$( { CI3_SERVER= ci3_client kv_set a b; echo $?; } )"
if CI3_SERVER= ci3_client artifact_exists foo-abc.tar.gz; then fail "artifact_exists exits 1" "exit 0"; else pass "artifact_exists exits 1"; fi
if CI3_SERVER=http://127.0.0.1:1 ci3_client check >/dev/null 2>&1; then
  fail "an unreachable explicit server fails preflight" "exit 0"
else
  pass "an unreachable explicit server fails preflight"
fi

# --- the ci3 scripts built on the clients ---
echo "--- cache_log ---"
out=$(printf 'hello from cache_log\n' | DUP=1 cache_log "Test" cachelog1 2>/dev/null)
check "cache_log DUP=1 passes output through" "hello from cache_log" "$out"
stored=$(ci3_client log_get cachelog1)
if [[ "$stored" == *"Parent Log:"* && "$stored" == *"hello from cache_log"* && "$stored" == *"Took: "*s* ]]; then
  pass "cache_log stores a finalized log"
else
  fail "cache_log stores a finalized log" "$stored"
fi

echo "--- test cache ---"
source "$ci3/source_stdlib"
cached="deadbeef00000000 echo cached-test"
fresh="deadbeef00000000 echo fresh-test"
ci3_client kv_set "$(hash_str_orig "$cached")" cachelog1
kept=$(printf '%s\n%s\n' "$cached" "$fresh" | USE_TEST_CACHE=1 filter_cached_test_cmd 2>/dev/null)
check "filter_cached_test_cmd drops the cached command" "$fresh" "$kept"
kept=$(printf '%s\n%s\n' "$cached" "$fresh" | USE_TEST_CACHE=0 filter_cached_test_cmd 2>/dev/null)
check "filter_cached_test_cmd is a passthrough without the test cache" "$(printf '%s\n%s' "$cached" "$fresh")" "$kept"

echo "--- test execution and run metadata ---"
export CI=0 PASS_LOG=1 USE_TEST_CACHE=1 REF_NAME=ci3-client-test TARGET_BRANCH=next
export COMMIT_HASH=abc COMMIT_AUTHOR=test COMMIT_MSG=test RUN_ID=1 JOB_ID=x-full CI_DASHBOARD=prs AWS_TOKEN=none
export LIVE_LOGGING=0 SLACK_NOTIFY_FLAKE=0
unset GITHUB_TOKEN GH_TOKEN GITHUB_REPOSITORY
first=$(run_test_cmd 'deadbeef00000001 echo through-api' 2>&1 | tail -1 | sed 's/\x1b\[[0-9;]*m//g')
check "run_test_cmd passes" PASSED "${first%% *}"
ci3_client kv_set "$(hash_str_orig 'deadbeef00000001 echo through-api')" cachelog1
second=$(run_test_cmd 'deadbeef00000001 echo through-api' 2>&1 | tail -1 | sed 's/\x1b\[[0-9;]*m//g')
check "a cached test is skipped" SKIPPED "${second%% *}"
TRACK_TEST_HISTORY=1 run_test_cmd 'deadbeef00000002 echo history' >/dev/null 2>&1
history=$(ci3_client list_get "history_$(hash_str_orig 'echo history')_next")
if [[ "$history" == *PASSED* && "$history" == *'echo history'* ]]; then
  pass "test history records the result under the target branch"
else
  fail "test history records the result under the target branch" "$history"
fi
CI_LOG_ID=1700000000000999 run_test_cmd 'deadbeef00000003 echo {\"span\":1} >> $TEST_TIMING_FILE' >/dev/null 2>&1
timings=$(ci3_client log_list test-timings/1700000000000999)
check "one timing file is listed for the run" 1 "$(echo "$timings" | wc -l | tr -d ' ')"
check "the timing data can be read through the API" '{"span":1}' "$(ci3_client log_get "test-timings/1700000000000999/$timings")"
"$ROOT/ci.sh" test-timings 1700000000000999 "$work/timings" >/dev/null
check "test-timings downloads the timing data" '{"span":1}' "$(cat "$work/timings/$timings.jsonl")"
if CI3_SERVER=http://127.0.0.1:1 "$ROOT/ci.sh" test-timings 1700000000000999 "$work/failed-timings" >"$work/timings.out" 2>"$work/timings.err"; then
  fail "test-timings propagates listing failures" "reported success with an unreachable server"
else
  pass "test-timings propagates listing failures"
fi
log_ci_run 1700000000000999 >/dev/null 2>&1
check "run starts with a heartbeat" 'RUNNING 1' "$(ci3_client run_get prs 1700000000000999 | jq -r .status) $(ci3_client kv_get hb-1700000000000999)"
log_ci_run 1700000000000999 PASSED >/dev/null 2>&1
check "run completion preserves its metadata" 'PASSED x-full prs' "$(ci3_client run_get prs 1700000000000999 | jq -r '[.status, .job_id, .dashboard] | join(" ")')"

echo "--- build cache ---"
mkdir -p "$work/src" "$work/dst"
echo "artifact content" >"$work/src/file.txt"
(cd "$work" && cache_upload "ci3-client-test-$$.tar.gz" src/file.txt 2>"$work/upload.err")
if grep -q "Cache upload of ci3-client-test-$$.tar.gz complete" "$work/upload.err"; then pass "cache_upload stores on the server"; else fail "cache_upload stores on the server" "$(cat "$work/upload.err")"; fi
if cache_exists "ci3-client-test-$$.tar.gz"; then pass "cache_exists finds it"; else fail "cache_exists finds it" "exit 1"; fi
cache_download "ci3-client-test-$$.tar.gz" "$work/dst" 2>"$work/download.err"
check "cache_download extracts it" "artifact content" "$(cat "$work/dst/src/file.txt")"
if grep -q "Cache download and extraction of ci3-client-test-$$.tar.gz complete" "$work/download.err"; then pass "cache_download reports completion"; else fail "cache_download reports completion" "$(cat "$work/download.err")"; fi
(cd "$work" && cache_upload "ci3-client-test-$$.tar.gz" src/file.txt 2>"$work/upload2.err")
if grep -q "already exists" "$work/upload2.err"; then pass "cache_upload skips an existing artifact"; else fail "cache_upload skips an existing artifact" "$(cat "$work/upload2.err")"; fi
if NO_CACHE=1 cache_download "ci3-client-test-$$.tar.gz" "$work/dst" 2>/dev/null; then fail "NO_CACHE=1 skips download" "exit 0"; else pass "NO_CACHE=1 skips download"; fi

echo
if [[ $TESTS_FAILED -eq 0 ]]; then
  echo "${GREEN}All $TESTS_PASSED tests passed.${NC}"
  exit 0
else
  echo "${RED}$TESTS_FAILED of $((TESTS_PASSED + TESTS_FAILED)) tests failed.${NC}"
  exit 1
fi
