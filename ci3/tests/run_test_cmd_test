#!/usr/bin/env bash
# Test that run_test_cmd's result cache is bypassed for 'disabled-cache' commands.
#
# run_test_cmd has a per-command result cache: it computes key=hash_str_orig "$cmd"
# and, when USE_TEST_CACHE=1 and redis holds a stored pass for that key, prints
# SKIPPED and exits 0 without ever running the underlying command. Commands marked
# 'disabled-cache' must NEVER be served a cached result (mirrors filter_cached_test_cmd),
# so the cache read is guarded with [[ "$cmd" != *disabled-cache* ]].
#
# This exercises the real run_test_cmd script end-to-end against a real redis:
#   1. A normal cached command -> SKIPPED, underlying command does NOT run.
#   2. The same command with a 'disabled-cache' prefix -> the command DOES run
#      (cache bypassed), even though a matching pass is stored in redis.
#
# We stand up an isolated redis docker container on a dedicated host port and put a
# thin 'redis-cli' shim on PATH that targets it. This keeps the real run_test_cmd ->
# source_redis -> redis_cli -> redis-cli code path intact while isolating the test
# from the shared CI redis (which port 6379 forwards to), so we never read or write
# production cache keys.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CI3_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

TESTS_PASSED=0
TESTS_FAILED=0

pass() { echo "${GREEN}✓${NC} $1"; ((TESTS_PASSED++)) || true; }
fail() { echo "${RED}✗${NC} $1${2:+: $2}"; ((TESTS_FAILED++)) || true; }

WORK_DIR=$(mktemp -d /tmp/run_test_cmd_test.XXXXXX)
REDIS_NAME="ci3-run-test-cmd-redis-$$"
REDIS_PORT=16379

cleanup() {
  docker rm -f "$REDIS_NAME" &>/dev/null || true
  rm -rf "$WORK_DIR"
}
trap cleanup EXIT

# --- Stand up an isolated real redis -----------------------------------------

# Find a free host port for our private redis (avoid 6379 which forwards to prod).
while nc -z localhost "$REDIS_PORT" &>/dev/null; do
  REDIS_PORT=$((REDIS_PORT + 1))
done

docker rm -f "$REDIS_NAME" &>/dev/null || true
if ! docker run --rm -d --name "$REDIS_NAME" -p "$REDIS_PORT:6379" \
    redis:latest redis-server --save "" --appendonly no &>/dev/null; then
  echo "Could not start redis docker container; skipping (docker required)." >&2
  exit 0
fi

# Wait for redis to accept connections.
for _ in $(seq 1 30); do
  redis-cli -p "$REDIS_PORT" ping &>/dev/null && break
  sleep 0.2
done
if ! redis-cli -p "$REDIS_PORT" ping &>/dev/null; then
  echo "Redis did not become ready; skipping." >&2
  exit 0
fi
echo "Using real redis (docker '$REDIS_NAME') on host port $REDIS_PORT."

# Thin redis-cli shim that forwards to the real redis-cli but pins it to our private
# instance. run_test_cmd's redis_cli runs 'redis-cli --raw -h $CI_REDIS "$@"' (port
# 6379 hardcoded), so we inject -p here to redirect it to our isolated container.
REAL_REDIS_CLI="$(command -v redis-cli)"
mkdir -p "$WORK_DIR/bin"
cat > "$WORK_DIR/bin/redis-cli" <<EOF
#!/usr/bin/env bash
exec "$REAL_REDIS_CLI" -p $REDIS_PORT "\$@"
EOF
chmod +x "$WORK_DIR/bin/redis-cli"

# --- Build the environment run_test_cmd expects ------------------------------

# Run run_test_cmd with the cache enabled and our isolated redis wired in.
# CI_REDIS_AVAILABLE=1 forces the redis path; CI=0 keeps us out of CI-only branches;
# pre-setting DASHBOARD_URL stops source_redis from trying to start its own services.
run_with_cache() {
  local cmd=$1
  PATH="$WORK_DIR/bin:$PATH" \
  CI=0 \
  USE_TEST_CACHE=1 \
  CI_REDIS=localhost \
  CI_REDIS_AVAILABLE=1 \
  DASHBOARD_URL="http://localhost:0" \
  ISOLATE=0 \
  TIMEOUT=60s \
    "$CI3_DIR/run_test_cmd" "$cmd"
}

# Compute the cache key exactly as run_test_cmd does (hash_str_orig of the full cmd).
hash_key() {
  echo "$1" | git hash-object --stdin | cut -c1-16 | tr -d '\n'
}

# --- Case 1: normal cached command is SKIPPED, never executed ----------------

SENTINEL1="$WORK_DIR/sentinel_normal"
NORMAL_CMD="testhash bash -c 'touch $SENTINEL1'"
NORMAL_KEY=$(hash_key "$NORMAL_CMD")

# Seed a stored "pass" (the value is the log key; any non-empty value triggers skip).
redis-cli -p "$REDIS_PORT" SET "$NORMAL_KEY" "stored-log-key" &>/dev/null
rm -f "$SENTINEL1"

out=$(run_with_cache "$NORMAL_CMD" 2>&1) || true
if echo "$out" | grep -q "SKIPPED"; then
  pass "normal cached command prints SKIPPED"
else
  fail "normal cached command did not print SKIPPED" "$out"
fi
if [ ! -e "$SENTINEL1" ]; then
  pass "normal cached command did NOT execute (cache hit served)"
else
  fail "normal cached command WAS executed despite cache hit"
fi

# --- Case 2: disabled-cache command bypasses cache and runs ------------------

SENTINEL2="$WORK_DIR/sentinel_disabled"
DISABLED_CMD="disabled-cache bash -c 'touch $SENTINEL2'"
DISABLED_KEY=$(hash_key "$DISABLED_CMD")

# Seed a stored "pass" for this exact command too, so the ONLY thing preventing a
# skip is the disabled-cache guard.
redis-cli -p "$REDIS_PORT" SET "$DISABLED_KEY" "stored-log-key" &>/dev/null
rm -f "$SENTINEL2"

out=$(run_with_cache "$DISABLED_CMD" 2>&1) || true
if echo "$out" | grep -q "SKIPPED"; then
  fail "disabled-cache command was wrongly SKIPPED (cache not bypassed)" "$out"
else
  pass "disabled-cache command was not SKIPPED"
fi
if [ -e "$SENTINEL2" ]; then
  pass "disabled-cache command actually executed (cache bypassed)"
else
  fail "disabled-cache command did NOT execute" "$out"
fi

# --- Results -----------------------------------------------------------------

echo
echo "Passed: $TESTS_PASSED"
echo "Failed: $TESTS_FAILED"
[ "$TESTS_FAILED" -eq 0 ]
