#!/usr/bin/env bash
# Tests for the retry script, specifically:
# - default mode retries any non-zero exit until success or attempts are exhausted
# - "-p <regex>" mode only retries failures whose output matches the regex, and fails fast otherwise
# - RETRY_DISABLED runs the command once
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
RETRY="$ROOT/ci3/retry"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

TESTS_PASSED=0
TESTS_FAILED=0
pass() { echo "${GREEN}✓${NC} $1"; ((TESTS_PASSED++)) || true; }
fail() { echo "${RED}✗${NC} $1: $2"; ((TESTS_FAILED++)) || true; }

echo "=== Retry Test Suite ==="

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# Writes a stub at $tmp/stub that fails (printing $2 to stderr) until it has been called $1 times,
# recording the number of invocations in $tmp/count.
mkstub() {
  rm -f "$tmp/count"
  cat > "$tmp/stub" <<EOF
#!/usr/bin/env bash
c=\$(cat "$tmp/count" 2>/dev/null || echo 0); c=\$((c + 1)); echo \$c > "$tmp/count"
if [ \$c -lt $1 ]; then echo "$2" >&2; exit 1; fi
echo "ok on attempt \$c"; exit 0
EOF
  chmod +x "$tmp/stub"
}
attempts() { cat "$tmp/count" 2>/dev/null || echo 0; }

export RETRY_SLEEP=0
net_flake="Could not resolve host|unable to access|Connection refused"

# --- Test 1: default mode retries a transient failure then succeeds ---
mkstub 3 "transient blip"
code=0; "$RETRY" "$tmp/stub" &>/dev/null || code=$?
if [ "$code" -eq 0 ] && [ "$(attempts)" -eq 3 ]; then
  pass "default mode retries then succeeds (3 attempts)"
else
  fail "default mode retries then succeeds" "code=$code attempts=$(attempts)"
fi

# --- Test 2: default mode gives up after 3 attempts ---
mkstub 99 "always fails"
code=0; "$RETRY" "$tmp/stub" &>/dev/null || code=$?
if [ "$code" -eq 1 ] && [ "$(attempts)" -eq 3 ]; then
  pass "default mode fails after 3 attempts"
else
  fail "default mode fails after 3 attempts" "code=$code attempts=$(attempts)"
fi

# --- Test 3: pattern mode retries a matching (network) failure then succeeds ---
mkstub 3 "fatal: unable to access: Could not resolve host: github.com"
code=0; "$RETRY" -p "$net_flake" "$tmp/stub" &>/dev/null || code=$?
if [ "$code" -eq 0 ] && [ "$(attempts)" -eq 3 ]; then
  pass "pattern mode retries matching failure then succeeds"
else
  fail "pattern mode retries matching failure then succeeds" "code=$code attempts=$(attempts)"
fi

# --- Test 4: pattern mode fails fast on a non-matching (genuine) error ---
mkstub 99 "error[E0412]: cannot find type Foo"
code=0; "$RETRY" -p "$net_flake" "$tmp/stub" &>/dev/null || code=$?
if [ "$code" -eq 1 ] && [ "$(attempts)" -eq 1 ]; then
  pass "pattern mode fails fast on non-matching error (1 attempt)"
else
  fail "pattern mode fails fast on non-matching error" "code=$code attempts=$(attempts)"
fi

# --- Test 5: pattern mode gives up after 3 attempts on a persistent matching failure ---
mkstub 99 "Connection refused"
code=0; "$RETRY" -p "$net_flake" "$tmp/stub" &>/dev/null || code=$?
if [ "$code" -eq 1 ] && [ "$(attempts)" -eq 3 ]; then
  pass "pattern mode fails after 3 attempts on persistent match"
else
  fail "pattern mode fails after 3 attempts on persistent match" "code=$code attempts=$(attempts)"
fi

# --- Test 6: RETRY_DISABLED runs the command exactly once ---
mkstub 99 "Could not resolve host"
code=0; RETRY_DISABLED=1 "$RETRY" -p "$net_flake" "$tmp/stub" &>/dev/null || code=$?
if [ "$code" -eq 1 ] && [ "$(attempts)" -eq 1 ]; then
  pass "RETRY_DISABLED runs once and ignores -p"
else
  fail "RETRY_DISABLED runs once and ignores -p" "code=$code attempts=$(attempts)"
fi

echo
if [[ $TESTS_FAILED -eq 0 ]]; then
  echo "${GREEN}All $TESTS_PASSED tests passed.${NC}"
  exit 0
else
  echo "${RED}$TESTS_FAILED of $((TESTS_PASSED + TESTS_FAILED)) tests failed.${NC}"
  exit 1
fi
