#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

TESTS_PASSED=0
TESTS_FAILED=0

pass() { echo "${GREEN}PASS${NC} $1"; ((TESTS_PASSED++)) || true; }
fail() {
  echo "${RED}FAIL${NC} $1: $2"
  ((TESTS_FAILED++)) || true
}

setup_repo() {
  local tmp
  tmp=$(mktemp -d)
  mkdir -p "$tmp/ci3"
  cp "$ROOT/ci3/merge_train_failure_slack_notify" "$tmp/ci3/"
  cat > "$tmp/ci3/slack_notify" <<'STUB'
#!/usr/bin/env bash
printf 'slack_notify\n%s\n%s\n' "$1" "$2" > "$TMPDIR/slack_notify.out"
STUB
  cat > "$tmp/ci3/slack_notify_with_claudebox_kickoff" <<'STUB'
#!/usr/bin/env bash
printf 'slack_notify_with_claudebox_kickoff\n%s\n%s\n%s\n' "$1" "$2" "$3" > "$TMPDIR/kickoff.out"
STUB
  chmod +x "$tmp/ci3/"*

  git -C "$tmp" init -q
  git -C "$tmp" config user.name "Test Author"
  git -C "$tmp" config user.email test@example.com
  git -C "$tmp" add ci3
  GIT_AUTHOR_NAME="Alice" GIT_AUTHOR_EMAIL=alice@example.com \
    GIT_COMMITTER_NAME="Alice" GIT_COMMITTER_EMAIL=alice@example.com \
    git -C "$tmp" commit -q -m "feat: example (#123)"
  printf '%s\n' "$tmp"
}

test_merged_notification_uses_target_branch() {
  local tmp output expected_text expected_channel
  tmp=$(setup_repo)
  (
    cd "$tmp"
    TMPDIR="$tmp" REF_NAME="merge-train/spartan-v5" TARGET_BRANCH="v5-next" \
      PR_URL="https://github.com/AztecProtocol/aztec-packages/pull/123" \
      ./ci3/merge_train_failure_slack_notify --merged
  )

  output=$(cat "$tmp/slack_notify.out")
  expected_text="PR merged into v5-next: <https://github.com/AztecProtocol/aztec-packages/pull/123|feat: example (#123)> by Alice"
  expected_channel="#team-alpha"
  if [[ "$output" == $'slack_notify\n'"$expected_text"$'\n'"$expected_channel" ]]; then
    pass "merged notification uses PR base branch"
  else
    fail "merged notification uses PR base branch" "got: $output"
  fi
  rm -rf "$tmp"
}

test_merged_notification_falls_back_to_ref_name() {
  local tmp output expected_text expected_channel
  tmp=$(setup_repo)
  (
    cd "$tmp"
    TMPDIR="$tmp" REF_NAME="merge-train/spartan" \
      PR_URL="https://github.com/AztecProtocol/aztec-packages/pull/456" \
      ./ci3/merge_train_failure_slack_notify --merged
  )

  output=$(cat "$tmp/slack_notify.out")
  expected_text="PR merged into merge-train/spartan: <https://github.com/AztecProtocol/aztec-packages/pull/456|feat: example (#123)> by Alice"
  expected_channel="#team-alpha"
  if [[ "$output" == $'slack_notify\n'"$expected_text"$'\n'"$expected_channel" ]]; then
    pass "merged notification falls back to ref name"
  else
    fail "merged notification falls back to ref name" "got: $output"
  fi
  rm -rf "$tmp"
}

test_dequeued_notification_still_names_merge_train() {
  local tmp output
  tmp=$(setup_repo)
  (
    cd "$tmp"
    TMPDIR="$tmp" REF_NAME="merge-train/spartan-v5" TARGET_BRANCH="v5-next" \
      PR_URL="https://github.com/AztecProtocol/aztec-packages/pull/789" \
      GITHUB_REPOSITORY="AztecProtocol/aztec-packages" \
      ./ci3/merge_train_failure_slack_notify --dequeued
  )

  output=$(cat "$tmp/kickoff.out")
  if grep -q "PR was removed from the merge-train/spartan-v5 merge queue" <<< "$output" &&
     grep -q "PR was dequeued from merge queue for merge-train/spartan-v5" <<< "$output"; then
    pass "dequeued notification still names merge train"
  else
    fail "dequeued notification still names merge train" "got: $output"
  fi
  rm -rf "$tmp"
}

echo "=== Merge Train Slack Notify Test Suite ==="
test_merged_notification_uses_target_branch
test_merged_notification_falls_back_to_ref_name
test_dequeued_notification_still_names_merge_train

echo
if [[ $TESTS_FAILED -eq 0 ]]; then
  echo "${GREEN}All $TESTS_PASSED tests passed.${NC}"
  exit 0
else
  echo "${RED}$TESTS_FAILED of $((TESTS_PASSED + TESTS_FAILED)) tests failed.${NC}"
  exit 1
fi
