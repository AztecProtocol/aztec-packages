#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

export CI=1
export CI_REDIS_AVAILABLE=0
export DASHBOARD_URL=http://ci.aztec-labs.com

source "$ROOT/ci3/source"

printf 'CI booting...\n' | redis_setexz test-redis-disabled 300

echo "redis_setexz drains stdin when redis is disabled"
