#!/usr/bin/env bash
# Exercises ci3_compat_server: the API served on top of redis and S3 with the key shapes the pre-API
# ci3 wrote. Redis is a throwaway docker container; S3 is a fake `aws` on PATH that copies to a
# directory, fronted by a static http server as the bucket's public endpoint. Skips when docker is
# unavailable.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
# The ci3 scripts under test resolve their includes from $root and their branch from $REF_NAME, as
# every real caller has both exported; some steps below run them from a scratch directory.
export root="$ROOT"
export ci3="$ROOT/ci3"
export REF_NAME=${REF_NAME:-$(git -C "$ROOT" rev-parse --abbrev-ref HEAD)}

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'
TESTS_PASSED=0
TESTS_FAILED=0
pass() { echo "${GREEN}✓${NC} $1"; ((TESTS_PASSED++)) || true; }
fail() { echo "${RED}✗${NC} $1: $2"; ((TESTS_FAILED++)) || true; }
check() { # <name> <expected> <actual>
  if [ "$2" == "$3" ]; then pass "$1"; else fail "$1" "expected [$2] got [$3]"; fi
}

echo "=== ci3 compat backend test suite ==="

if ! docker info &>/dev/null; then
  echo "docker unavailable, skipping."
  exit 0
fi

work=$(mktemp -d)
redis_port=$((20000 + RANDOM % 20000))
server_port=$((20000 + RANDOM % 20000))
public_port=$((20000 + RANDOM % 20000))
redis_name="ci3-compat-test-$$"
fake_s3="$work/s3"
mkdir -p "$fake_s3/aztec-ci-artifacts/build-cache" "$fake_s3/aztec-ci-artifacts/logs" "$work/bin"

cleanup() {
  "$ci3/ci3_compat_server" stop --port $server_port --dir "$work/store" >/dev/null 2>&1 || true
  [ -n "${public_pid:-}" ] && kill $public_pid 2>/dev/null || true
  docker rm -f "$redis_name" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

# A fake aws CLI: `aws s3 cp <src> <dst>` between local paths, '-' and s3:// URIs under $fake_s3.
cat >"$work/bin/aws" <<EOF
#!/usr/bin/env bash
set -euo pipefail
resolve() { case "\$1" in s3://*) echo "$fake_s3/\${1#s3://}";; *) echo "\$1";; esac; }
if [ "\$1 \$2" == "s3 ls" ]; then
  d=\$(resolve "\$3"); [ -d "\$d" ] || exit 1
  for f in "\$d"/*; do [ -f "\$f" ] && printf '2026-01-01 00:00:00 %10d %s\\n' "\$(stat -c %s "\$f")" "\$(basename "\$f")"; done; exit 0
fi
[ "\$1 \$2" == "s3 cp" ] || { echo "fake aws: unsupported: \$*" >&2; exit 1; }
src=\$3; dst=\$4
src=\$(resolve "\$src"); dst=\$(resolve "\$dst")
if [ "\$src" == "-" ]; then mkdir -p "\$(dirname "\$dst")"; cat >"\$dst"
elif [ "\$dst" == "-" ]; then cat "\$src"
else mkdir -p "\$(dirname "\$dst")"; cp "\$src" "\$dst"; fi
EOF
chmod +x "$work/bin/aws"
export PATH="$work/bin:$ci3:$PATH"

echo "starting redis..."
if ! docker run -d --rm --name "$redis_name" -p 127.0.0.1:$redis_port:6379 redis:7-alpine >/dev/null 2>"$work/docker.err"; then
  echo "could not start redis ($(cat "$work/docker.err" | tail -1)), skipping."
  exit 0
fi
for _ in $(seq 1 50); do docker exec "$redis_name" redis-cli ping 2>/dev/null | grep -q PONG && break; sleep 0.2; done
redis() { docker exec "$redis_name" redis-cli --raw "$@"; }

# The bucket's public endpoint.
(cd "$fake_s3/aztec-ci-artifacts/build-cache" && exec python3 -m http.server $public_port --bind 127.0.0.1 >/dev/null 2>&1) &
public_pid=$!

# As on the build instance: an aztec-mode config naming the compat server (here with the test's redis
# and fake bucket endpoint), links to the dashboard; the clients know nothing about compat.
unset CI3_SERVER CI3_PUBLIC_URL PARENT_LOG_ID
url=$("$ci3/ci3_compat_server" start --port $server_port --dir "$work/store" --redis 127.0.0.1:$redis_port --public-cache-url http://127.0.0.1:$public_port)
export CI=1 CI3_CONFIG=$work/config.json
printf '{"mode": "aztec", "server": "%s", "public_url": "http://dashboard.example", "password": "secret"}\n' "$url" >"$CI3_CONFIG"
source "$ci3/source_ci3_client"
check "compat server probed" "http://localhost:$server_port" "$CI3_SERVER"
check "links point at the dashboard" "http://dashboard.example/abc" "$(ci3_client url abc)"

echo "--- logs ---"
printf 'live\n' | ci3_client log_put log1 100
check "live log lands in redis, gzipped" "1f8b" "$(redis GET log1 | head -c 2 | xxd -p)"
check "live log is not copied to S3" "" "$(ls "$fake_s3/aztec-ci-artifacts/logs" 2>/dev/null)"
check "live log reads back" "live" "$(ci3_client log_get log1)"
printf 'done\n' | ci3_client log_put log1 100 final
check "final log copied to S3 as <4>/<id>.log.gz" "done" "$(gunzip -c "$fake_s3/aztec-ci-artifacts/logs/log1/log1.log.gz")"
check "redis ttl applied" 1 "$( [ "$(redis TTL log1)" -le 100 ] && [ "$(redis TTL log1)" -gt 0 ] && echo 1 || echo 0)"
redis DEL log1 >/dev/null
check "log falls back to S3 when gone from redis" "done" "$(ci3_client log_get log1)"
if ci3_client log_get nope 2>/dev/null; then fail "missing log exits 1" "exit 0"; else pass "missing log exits 1"; fi
printf 'x\n' | ci3_client log_put 1700000000000123 100 final
check "run log object name" "1700/1700000000000123.log.gz" "$(cd "$fake_s3/aztec-ci-artifacts/logs" && ls 1700/*)"
printf '{"bench":1}\n' | ci3_client log_put bench/bb-breakdown/native-flow-abc "" final
check "path ids keep their S3 path (dashboard breakdown views)" '{"bench":1}' "$(gunzip -c "$fake_s3/aztec-ci-artifacts/logs/bench/bb-breakdown/native-flow-abc.log.gz")"
printf '{"t":1}\n' | ci3_client log_put test-timings/1700000000000123/aaaa "" final
printf '{"t":2}\n' | ci3_client log_put test-timings/1700000000000123/bbbb "" final
check "timing files listed from the bucket" "$(printf 'aaaa\nbbbb')" "$(ci3_client log_list test-timings/1700000000000123)"
check "timing file read back" '{"t":2}' "$(ci3_client log_get test-timings/1700000000000123/bbbb)"

echo "--- kv ---"
ci3_client kv_set testhash logid1 604800
check "kv is a plain redis string" "logid1" "$(redis GET testhash)"
check "kv ttl applied" 1 "$( [ "$(redis TTL testhash)" -gt 0 ] && echo 1 || echo 0)"
ci3_client kv_set forever 1
check "kv without ttl persists" -1 "$(redis TTL forever)"
check "kv get" "logid1" "$(ci3_client kv_get testhash)"
mapfile -t got < <(ci3_client kv_get testhash nope forever)
check "kv mget" "logid1||1" "${got[0]}|${got[1]}|${got[2]}"
ci3_client kv_set hb-1 1 1
sleep 2
check "kv expires" "" "$(ci3_client kv_get hb-1)"

echo "--- lists ---"
ci3_client list_push history_x_next one 2
ci3_client list_push history_x_next two 2
ci3_client list_push history_x_next three 2
check "list is a redis list, newest first, trimmed" "$(printf 'three\ntwo')" "$(redis LRANGE history_x_next 0 -1)"
check "list get" "$(printf 'three\ntwo')" "$(ci3_client list_get history_x_next)"
if ci3_client list_get nolist 2>/dev/null; then fail "missing list exits 1" "exit 0"; else pass "missing list exits 1"; fi

echo "--- runs ---"
echo '{"status":"RUNNING","name":"a"}' | ci3_client run_put prs 1700000000000111
echo '{"status":"RUNNING","name":"b"}' | ci3_client run_put prs 1700000000000222
check "runs are the ci-run-<section> sorted set" 2 "$(redis ZCARD ci-run-prs)"
echo '{"status":"PASSED","name":"a"}' | ci3_client run_put prs 1700000000000111
check "run update replaces the member" 2 "$(redis ZCARD ci-run-prs)"
check "run get" '{"status":"PASSED","name":"a"}' "$(ci3_client run_get prs 1700000000000111)"
check "runs listed newest first" "b,a" "$(curl -s "$CI3_SERVER/runs/prs" | jq -r 'map(.name) | join(",")')"
echo '{"status":"RUNNING"}' | ci3_client run_put merge-train/avm 1700000000000333
check "slashed section key" 1 "$(redis ZCARD ci-run-merge-train/avm)"
if ci3_client run_get prs 1 2>/dev/null; then fail "missing run exits 1" "exit 0"; else pass "missing run exits 1"; fi

echo "--- events ---"
check "event is published" 204 "$(printf '{"a":1}' | curl -s -o /dev/null -w '%{http_code}' --data-binary @- "$CI3_SERVER/events/ci:test:started")"

echo "--- artifacts ---"
head -c 100000 /dev/urandom >"$work/blob"
ci3_client artifact_put foo-abc.tar.gz "$work/blob"
if cmp -s "$work/blob" "$fake_s3/aztec-ci-artifacts/build-cache/foo-abc.tar.gz"; then pass "artifact put lands in the bucket"; else fail "artifact put lands in the bucket" "missing or differs"; fi
if ci3_client artifact_exists foo-abc.tar.gz; then pass "artifact exists via the public endpoint"; else fail "artifact exists via the public endpoint" "exit 1"; fi
if ci3_client artifact_exists nope.tar.gz; then fail "missing artifact exists exits 1" "exit 0"; else pass "missing artifact exists exits 1"; fi
check "artifact get redirects to the public endpoint" "302" "$(curl -s -o /dev/null -w '%{http_code}' "$CI3_SERVER/artifacts/foo-abc.tar.gz")"
if cmp -s "$work/blob" <(ci3_client artifact_get foo-abc.tar.gz); then pass "artifact get follows the redirect"; else fail "artifact get follows the redirect" "content differs"; fi

echo "--- build cache through the compat server ---"
mkdir -p "$work/src" "$work/dst"
echo "artifact content" >"$work/src/file.txt"
(cd "$work" && cache_upload "compat-test-$$.tar.gz" src/file.txt 2>"$work/upload.err")
if [ -f "$fake_s3/aztec-ci-artifacts/build-cache/compat-test-$$.tar.gz" ]; then pass "cache_upload lands in the bucket"; else fail "cache_upload lands in the bucket" "$(cat "$work/upload.err")"; fi
cache_download "compat-test-$$.tar.gz" "$work/dst" 2>"$work/download.err"
check "cache_download extracts it" "artifact content" "$(cat "$work/dst/src/file.txt")"

echo "--- unreachable redis ---"
# Redis is best effort: the server comes up, redis-backed operations fail per request, S3 still works.
url2=$("$ci3/ci3_compat_server" start --redis 127.0.0.1:1 --port $((server_port + 1)) --dir "$work/store2" 2>/dev/null)
check "compat server starts without redis" "http://localhost:$((server_port + 1))" "$url2"
check "redis-backed write fails per request" 502 "$(curl -s -o /dev/null -w '%{http_code}' -X PUT --data-binary v "$url2/kv/k")"
check "final log still reaches S3 without redis" 502 "$(printf 'x' | curl -s -o /dev/null -w '%{http_code}' -X PUT --data-binary @- "$url2/logs/noredis?final=1")"
check "final log object written" "x" "$(gunzip -c "$fake_s3/aztec-ci-artifacts/logs/nore/noredis.log.gz")"
CI3_SERVER=$url2 ci3_client artifact_put via-no-redis.tar.gz "$work/blob"
if cmp -s "$work/blob" "$fake_s3/aztec-ci-artifacts/build-cache/via-no-redis.tar.gz"; then pass "artifact upload works without redis"; else fail "artifact upload works without redis" "missing"; fi
"$ci3/ci3_compat_server" stop --port $((server_port + 1)) --dir "$work/store2" >/dev/null 2>&1 || true

echo
if [[ $TESTS_FAILED -eq 0 ]]; then
  echo "${GREEN}All $TESTS_PASSED tests passed.${NC}"
  exit 0
else
  echo "${RED}$TESTS_FAILED of $((TESTS_PASSED + TESTS_FAILED)) tests failed.${NC}"
  exit 1
fi
