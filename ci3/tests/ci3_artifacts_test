#!/usr/bin/env python3
"""Exercise artifact routing through a file server and a private public-cache fixture."""
import functools
import gzip
import http.client
import io
import json
import os
from pathlib import Path
import runpy
import subprocess
import tarfile
import tempfile
import threading
import unittest
from compression import zstd
from http.server import BaseHTTPRequestHandler, SimpleHTTPRequestHandler, ThreadingHTTPServer


CI3 = Path(__file__).resolve().parents[1]
SERVER = runpy.run_path(str(CI3 / "ci3_server"))


class PublicCache(SimpleHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def send_head(self):
        self.server.authorization = self.headers.get("Authorization")
        if hasattr(self.server, "before_download"):
            self.server.before_download()
        if hasattr(self.server, "response_body"):
            self.send_response(200)
            if self.server.response_length is not None:
                self.send_header("Content-Length", str(self.server.response_length))
            self.end_headers()
            return io.BytesIO(self.server.response_body)
        return super().send_head()


class UploadRedirect(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def do_PUT(self):
        if self.server.status is not None:
            self.send_response(self.server.status)
            self.send_header("Location", self.server.target + self.path)
            self.send_header("Content-Length", "0")
            self.send_header("Connection", "close")
            self.end_headers()
            self.wfile.flush()
        self.close_connection = True


class ArtifactTest(unittest.TestCase):
    def setUp(self):
        work = tempfile.TemporaryDirectory()
        self.addCleanup(work.cleanup)
        self.directory = Path(work.name)
        self.public = self.directory / "public"
        self.public.mkdir()
        self.upstream = ThreadingHTTPServer(
            ("127.0.0.1", 0), functools.partial(PublicCache, directory=str(self.public)))
        self.start_server(self.upstream)
        self.upstream_url = "http://127.0.0.1:%d" % self.upstream.server_port
        self.backend = SERVER["FileBackend"](str(self.directory / "store"))
        self.server = SERVER["Server"](("127.0.0.1", 0), self.backend, "test", False)
        self.server.public_cache_url = self.upstream_url
        self.start_server(self.server)
        self.env = {k: v for k, v in os.environ.items() if not k.startswith("CI3_")}
        self.env.update(CI="0", CI3_SERVER="http://127.0.0.1:%d" % self.server.server_port,
                        root=str(CI3.parent), REF_NAME="ci3-artifacts-test",
                        NO_CACHE="0", NO_CACHE_UPLOAD="0", CACHE_FORCE_UPLOAD="")
        (self.directory / "file.txt").write_text("public artifact\n")
        self.name = "nested/build+abc.tar.gz"
        (self.public / "nested").mkdir()
        with tarfile.open(self.public / self.name, "w:gz") as archive:
            archive.add(self.directory / "file.txt", arcname="file.txt")
        self.archive = (self.public / self.name).read_bytes()

    def start_server(self, server):
        threading.Thread(target=server.serve_forever, daemon=True).start()
        self.addCleanup(server.server_close)
        self.addCleanup(server.shutdown)

    def command(self, script, *args, **env):
        return subprocess.run([str(CI3 / script), *map(str, args)], env=dict(self.env, **env),
                              cwd=self.directory, capture_output=True, timeout=10)

    def request(self, method, path):
        conn = http.client.HTTPConnection("127.0.0.1", self.server.server_port, timeout=5)
        self.addCleanup(conn.close)
        conn.request(method, path)
        resp = conn.getresponse()
        return resp.status, resp.getheader("Location"), resp.read()

    def test_local_artifact_takes_precedence(self):
        self.backend.artifact_put(self.name, b"local bytes", None)
        self.assertEqual(self.request("GET", "/artifacts/" + self.name), (200, None, b"local bytes"))
        self.assertEqual(self.request("HEAD", "/artifacts/" + self.name), (200, None, b""))

    def test_local_misses_redirect_get_and_head(self):
        for method in ("GET", "HEAD"):
            with self.subTest(method=method):
                self.assertEqual(self.request(method, "/artifacts/" + self.name),
                                 (302, self.upstream_url + "/" + self.name, b""))

    def test_opt_in_public_cache_retains_downloads(self):
        self.server.cache_public = True
        result = self.command("ci3_client", "artifact_get", self.name, CI3_PASSWORD="server-only")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, self.archive)
        stored = Path(self.backend.path("artifacts", self.name))
        self.assertTrue(stored.is_file())
        self.assertEqual(stored.read_bytes(), self.archive)
        self.assertTrue(Path(str(stored) + ".expires").is_file())
        self.assertIsNone(self.upstream.authorization)
        (self.public / self.name).unlink()
        result = self.command("ci3_client", "artifact_get", self.name)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, self.archive)

    def test_public_cache_does_not_download_for_head(self):
        self.server.cache_public = True
        self.assertEqual(self.request("HEAD", "/artifacts/" + self.name),
                         (302, self.upstream_url + "/" + self.name, b""))
        self.assertFalse(self.backend.artifact_exists(self.name))

    def test_public_cache_keeps_a_concurrent_local_upload(self):
        self.server.cache_public = True
        self.upstream.before_download = lambda: self.backend.artifact_put(self.name, b"local upload", None)
        result = self.command("ci3_client", "artifact_get", self.name)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, b"local upload")

    def test_public_cache_rejects_a_truncated_download(self):
        self.server.cache_public = True
        self.upstream.response_body = self.archive
        self.upstream.response_length = len(self.archive) + 100
        status, _, _ = self.request("GET", "/artifacts/" + self.name)
        self.assertEqual(status, 502)
        self.assertFalse(self.backend.artifact_exists(self.name))
        self.assertEqual(list((self.directory / "store/objects/artifacts").rglob(".tmp-*")), [])

    def test_public_cache_accepts_an_unknown_response_length(self):
        self.server.cache_public = True
        self.upstream.response_body = self.archive
        self.upstream.response_length = None
        result = self.command("ci3_client", "artifact_get", self.name)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, self.archive)
        self.assertTrue(self.backend.artifact_exists(self.name))

    def test_cache_mode_environment_reaches_the_detached_server(self):
        self.server.shutdown()
        self.server.server_close()
        args = ("--port", self.server.server_port, "--dir", self.directory / "store",
                "--public-cache-url", self.upstream_url)
        self.addCleanup(lambda: self.command("ci3_server", "stop", *args))
        started = self.command("ci3_server", "start", *args, CI3_CACHE_PUBLIC="1")
        self.assertEqual(started.returncode, 0, started.stderr)
        result = self.command("ci3_client", "artifact_get", self.name)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, self.archive)
        self.assertTrue(self.backend.artifact_exists(self.name))

    def test_client_follows_redirects_without_forwarding_password(self):
        for command in ("artifact_get", "artifact_exists"):
            with self.subTest(command=command):
                result = self.command("ci3_client", command, self.name, CI3_PASSWORD="server-only")
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, self.archive if command == "artifact_get" else b"")
                self.assertIsNone(self.upstream.authorization)

    def test_missing_public_artifact_is_a_miss(self):
        for mode in (False, True):
            self.server.cache_public = mode
            for command in ("artifact_get", "artifact_exists"):
                with self.subTest(mode=mode, command=command):
                    result = self.command("ci3_client", command, "missing.tar.gz")
                    self.assertEqual(result.returncode, 1, result.stderr)
                    self.assertEqual(result.stdout, b"")
                    self.assertFalse(self.backend.artifact_exists("missing.tar.gz"))

    def test_invalid_names_are_not_redirected(self):
        for name in ("%2e%2e/secret", "foo%0d%0aLocation:evil"):
            for method in ("GET", "HEAD"):
                with self.subTest(name=name, method=method):
                    status, location, _ = self.request(method, "/artifacts/" + name)
                    self.assertEqual(status, 400)
                    self.assertIsNone(location)

    def test_expired_local_artifact_falls_back_to_public(self):
        self.backend.artifact_put(self.name, b"expired bytes", -1)
        result = self.command("ci3_client", "artifact_get", self.name)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, self.archive)

    def test_upload_stays_on_the_local_server(self):
        result = self.command("ci3_client", "artifact_put", self.name, self.directory / "file.txt")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual((Path(self.backend.path("artifacts", self.name))).read_bytes(), b"public artifact\n")
        self.assertEqual((self.public / self.name).read_bytes(), self.archive)

    def test_large_upload_follows_an_early_redirect(self):
        redirect = ThreadingHTTPServer(("127.0.0.1", 0), UploadRedirect)
        redirect.target = self.env["CI3_SERVER"]
        self.start_server(redirect)
        blob = self.directory / "large-upload"
        data = bytes(range(256)) * (128 * 1024)
        blob.write_bytes(data)
        for status in (307, 308, 403, None):
            with self.subTest(status=status):
                redirect.status = status
                name = "redirect-%s.tar.gz" % status
                result = self.command("ci3_client", "artifact_put", name, blob,
                                      CI3_SERVER="http://127.0.0.1:%d" % redirect.server_port)
                stored = Path(self.backend.path("artifacts", name))
                if status in (307, 308):
                    self.assertEqual(result.returncode, 0, result.stderr)
                    self.assertEqual(stored.read_bytes(), data)
                else:
                    self.assertEqual(result.returncode, 2, result.stderr)
                    self.assertFalse(stored.exists())

    def test_cache_helpers_use_the_artifact_api(self):
        result = self.command("cache_exists", self.name)
        self.assertEqual(result.returncode, 0, result.stderr)
        result = self.command("cache_ls", self.name)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, b"file.txt\n")
        result = self.command("ci3_client", "artifact_download", self.name, self.directory / "out")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, b"")
        self.assertEqual((self.directory / "out/file.txt").read_text(), "public artifact\n")

    def test_upload_skips_a_public_hit_and_can_be_forced(self):
        result = self.command("ci3_client", "artifact_upload", self.name, "file.txt")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertFalse(self.backend.artifact_exists(self.name))
        result = self.command("ci3_client", "artifact_upload", self.name, "file.txt", CACHE_FORCE_UPLOAD="1")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertTrue(self.backend.artifact_exists(self.name))
        self.assertEqual((self.public / self.name).read_bytes(), self.archive)

    def test_cache_helpers_roundtrip_through_local_storage(self):
        for extension in ("tar.gz", "tar.zst"):
            with self.subTest(extension=extension):
                name = "local/roundtrip." + extension
                (self.directory / "file.txt").write_text("locally built artifact\n")
                result = self.command("ci3_client", "artifact_upload", name, "file.txt")
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertTrue(self.backend.artifact_exists(name))
                (self.directory / "file.txt").unlink()
                result = self.command("ci3_client", "artifact_download", name, self.directory / extension)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, b"")
                self.assertEqual((self.directory / extension / "file.txt").read_text(), "locally built artifact\n")

    def test_disabled_uploads_skip_packaging(self):
        for name, env in (("disabled-cache.tar.gz", {}),
                          ("disabled-upload.tar.gz", {"NO_CACHE_UPLOAD": "1"}),
                          ("no-server.tar.gz", {"CI3_SERVER": ""})):
            with self.subTest(name=name):
                result = self.command("ci3_client", "artifact_upload", name, "nonexistent-file", **env)
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertFalse(self.backend.artifact_exists(name))

    def test_cache_upload_reports_transfer_failure(self):
        result = self.command("ci3_client", "artifact_upload", "failure.tar.gz", "file.txt", CI3_SERVER="http://127.0.0.1:1")
        self.assertNotEqual(result.returncode, 0, result.stderr)
        self.assertIn(b"ci3_client artifact_upload:", result.stderr)

    def test_upload_works_when_the_public_cache_is_unreachable(self):
        self.server.public_cache_url = "http://127.0.0.1:1"
        result = self.command("ci3_client", "artifact_upload", "offline.tar.gz", "file.txt")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertTrue(self.backend.artifact_exists("offline.tar.gz"))

    def test_archives_preserve_directories_links_and_executable_permissions(self):
        source = self.directory / "build output"
        source.mkdir()
        (source / "empty").mkdir()
        binary = source / "program"
        binary.write_bytes(b"executable bytes\n")
        binary.chmod(0o755)
        (source / "link").symlink_to("program")
        (source / "toolchain").symlink_to("/opt/toolchain")
        os.link(binary, source / "hardlink")
        for extension in ("tar.gz", "zst"):
            with self.subTest(extension=extension):
                name = "structure." + extension
                result = self.command("ci3_client", "artifact_upload", name, "build output", "file.txt")
                self.assertEqual(result.returncode, 0, result.stderr)
                self.assertEqual(result.stdout, b"")
                destination = self.directory / ("extracted-" + extension)
                result = self.command("ci3_client", "artifact_download", name, destination)
                self.assertEqual(result.returncode, 0, result.stderr)
                restored = destination / "build output"
                self.assertTrue((restored / "empty").is_dir())
                self.assertEqual((restored / "program").read_bytes(), binary.read_bytes())
                self.assertEqual((restored / "program").stat().st_mode & 0o777, 0o755)
                self.assertEqual(os.readlink(restored / "link"), "program")
                self.assertEqual(os.readlink(restored / "toolchain"), "/opt/toolchain")
                self.assertTrue(os.path.samefile(restored / "program", restored / "hardlink"))
                self.assertTrue((destination / "file.txt").is_file())

    def test_disabled_downloads_do_not_extract(self):
        for name, env in (("disabled-cache.tar.gz", {}), (self.name, {"NO_CACHE": "1"}),
                          (self.name, {"CI3_SERVER": ""})):
            with self.subTest(name=name, env=env):
                destination = self.directory / "disabled-destination"
                result = self.command("ci3_client", "artifact_download", name, destination, **env)
                self.assertEqual(result.returncode, 1, result.stderr)
                self.assertFalse(destination.exists())

    def test_corrupt_or_truncated_downloads_fail(self):
        self.upstream.response_body = self.archive
        self.upstream.response_length = len(self.archive) + 100
        result = self.command("ci3_client", "artifact_download", self.name, self.directory / "truncated")
        self.assertEqual(result.returncode, 2, result.stderr)
        archives = (("truncated.tar.gz", self.archive[:-4]),
                    ("corrupt.tar.gz", b"\x1f\x8b\x08\x00" + b"\x00" * 6 + b"\x07" * 30),
                    ("truncated.zst", zstd.compress(gzip.decompress(self.archive))[:-4]))
        for name, data in archives:
            with self.subTest(name=name):
                self.upstream.response_body = data
                self.upstream.response_length = len(data)
                result = self.command("ci3_client", "artifact_download", name, self.directory / "corrupt")
                self.assertEqual(result.returncode, 2, result.stderr)

    def test_missing_upload_input_does_not_publish_an_archive(self):
        result = self.command("ci3_client", "artifact_upload", "missing-input.tar.gz", "file.txt", "absent")
        self.assertEqual(result.returncode, 2, result.stderr)
        self.assertFalse(self.backend.artifact_exists("missing-input.tar.gz"))

    def test_cache_filter_runs_tests_when_the_server_is_unreachable(self):
        commands = b"hash-one echo first\nhash-two echo second\n"
        env = dict(self.env, USE_TEST_CACHE="1", CI3_SERVER="http://127.0.0.1:1")
        result = subprocess.run([str(CI3 / "filter_cached_test_cmd")], input=commands, env=env,
                                capture_output=True, timeout=10)
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(result.stdout, commands)

    def test_benchmark_comparison_reads_the_selected_server(self):
        repository = self.directory / "repository"
        repository.mkdir()
        subprocess.run(["git", "init", "-q", str(repository)], check=True)
        subprocess.run(["git", "-C", str(repository), "-c", "user.name=Test", "-c", "user.email=test@example.com",
                        "commit", "--allow-empty", "-qm", "test"], check=True)
        tree = subprocess.check_output(["git", "-C", str(repository), "rev-parse", "HEAD^{tree}"]).decode().strip()
        (repository / "ci3").symlink_to(CI3)
        data = b'[{"name":"local benchmark","unit":"ms","value":12}]'
        with io.BytesIO() as archive:
            with tarfile.open(fileobj=archive, mode="w:gz") as tar:
                info = tarfile.TarInfo("bench-out/bench.json")
                info.size = len(data)
                tar.addfile(info, io.BytesIO(data))
            self.backend.artifact_put("bench-" + tree + ".tar.gz", archive.getvalue(), None)
        result = subprocess.run([str(CI3 / "bench_compare"), "HEAD", "--baseline", "HEAD"], cwd=repository,
                                env=self.env, capture_output=True, timeout=10)
        self.assertEqual(result.returncode, 0, result.stderr)
        comparison = json.loads(result.stdout)
        self.assertEqual(comparison["benches"][0]["name"], "local benchmark")
        self.assertEqual(comparison["benches"][0]["pct"], 0)


if __name__ == "__main__":
    unittest.main()
