#!/usr/bin/env bash
# Captures stdin as a log.
# If a ci3 server is available, store the input as a log there.
# If DUP=1 then we duplicate input also to stdout.
NO_CD=1 source $(git rev-parse --show-toplevel)/ci3/source
source "$ci3/source_log"

name=$1

key=${2:-$(uuid)}
dup=${DUP:-0}
outfile=/tmp/$key
touch $outfile
trap 'stop_log_publisher; rm -f "$outfile"' EXIT
if [ -n "${PARENT_LOG_ID:-}" ]; then
  echo -e "Parent Log: $(ci_term_link $PARENT_LOG_ID)" >>$outfile
else
  echo -e "Parent Log: none" >>$outfile
fi
echo -e "Started: $(date)" >>$outfile
echo -e "Completed: in-progress" >>$outfile
echo -e "Took: in-progress\n" >>$outfile

function finalize_log {
  # Use sed to update the header.
  sed -i "3c Completed: $(date)" "$outfile"
  sed -i "4c Took: ${SECONDS}s" "$outfile"
}

if [ -n "${CI3_SERVER:-}" ]; then
  log_str="$name log id: ${yellow}$(ci3_client url $key)${reset}"
  echo_stderr -e "$log_str"
  # Background monitors outlive the build; after printing their link, close its output pipes.
  if [ "$dup" -ne 1 ]; then
    exec >/dev/null 2>/dev/null
  fi
  start_log_publisher "$key" "$outfile"
  if [ "$dup" -eq 1 ]; then
    redact | tee -a $outfile
    # Print a second line if the log is long enough.
    # This is to avoid having to scroll up to see the log id.
    if [ "$(cat $outfile | wc -l)" -ge 16 ]; then
      echo_stderr -e "$log_str"
    fi
  else
    redact | cat >>$outfile
  fi
  stop_log_publisher
  finalize_log
  if ! publish_log_final "$key" "$outfile"; then
    [ "$dup" -eq 1 ] || cat "$outfile" >&2
    exit 1
  fi
else
  if [ "$dup" -eq 1 ]; then
    redact | cat
  else
    cat >/dev/null
  fi
fi
