#!/usr/bin/env bash
NO_CD=1 source $(git rev-parse --show-toplevel)/ci3/source

function process_batch {
  set -euo pipefail

  # Read all lines from stdin into an array.
  mapfile -t lines

  # Build array of hashes to query for.
  local hashes=()
  for line in "${lines[@]}"; do
    hashes+=($(hash_str_orig "$line"))
  done

  # Batch resolve against the test cache: one line per hash, empty when the test has not passed.
  readarray -t results < <(ci3_client kv_get "${hashes[@]}")
  if [ "${#results[@]}" -ne "${#lines[@]}" ]; then
    # Anything but one answer per test means the lookup failed: run everything.
    printf '%s\n' "${lines[@]}"
    return
  fi

  # Output the lines whose hashes have no passing run recorded.
  for i in "${!results[@]}"; do
    if [ -z "${results[$i]}" ] || [[ "${lines[$i]}" == *disabled-cache* ]]; then
      echo "${lines[$i]}"
    else
      echo -e "${blue}SKIPPED${reset} ($(ci_term_link ${results[$i]})): ${lines[$i]}" >&3
    fi
  done
}
export -f process_batch

if [ "${USE_TEST_CACHE:-0}" -eq 1 ] && [ -n "${CI3_SERVER:-}" ]; then
  exec 3> >(cache_log "Skipped tests")
  # Process stdin in batches of 50.
  parallel --pipe -N50 --keep-order process_batch
  exec 3>&-
  wait
else
  # Noop.
  cat
fi
