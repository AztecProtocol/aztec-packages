# Resolve the environment and verify the server once per process tree (see CI3_SERVER_API.md).
# A failed check must propagate to the caller; eval alone would hide its exit status.
export ci3=${ci3:-$(git rev-parse --show-toplevel)/ci3}
ci3_client_env=$("$ci3/ci3_client" env) || return 1
eval "$ci3_client_env"
unset ci3_client_env
