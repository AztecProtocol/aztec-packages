# Connects ci3 to its log / test-cache / artifact server (see CI3_SERVER_API.md). Discovery lives in
# ci3_client (`ci3_client env`); this shim only puts its result into the shell: CI3_SERVER (the server
# every ci3_client <command> command talks to, or empty), CI3_PUBLIC_URL (the base of printed links),
# USE_TEST_CACHE=0 when there is no server, and the retention / public-cache / transitional constants
# the bash callers read. Sourced by ci3/source; self-contained on purpose.
export ci3=${ci3:-$(git rev-parse --show-toplevel)/ci3}
eval "$("$ci3/ci3_client" env)"
