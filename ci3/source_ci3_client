# Connects ci3 to its log / test-cache / artifact server (see CI3_SERVER_API.md).
# Nothing in ci3 talks to a server except through the ci3_client_* scripts, which source this.
#
# Configuration (the only variables a caller sets):
#   CI3_SERVER_URL         the server to use. A URL, or `compat`: start the transitional compat
#                          server here, forwarding to the production redis/S3 the pre-API ci3 wrote
#                          to directly (what CI does until the labs dashboard serves the API).
#                          Unset: a local run (CI=0) starts the file-backed server on localhost;
#                          a CI run has no server and proceeds without logs or a test cache, as the
#                          GitHub runner does (its links still point at the dashboard).
#   CI3_SERVER_TOKEN       bearer token for writes.
#   CI3_PUBLIC_URL         base of the links we print (default: the server, or the dashboard for
#                          compat and for CI with no server). Set it to share a tunnelled server.
#   CI3_SERVER_START_ARGS  extra flags for a server started on demand (e.g. --port, --dir).
#
# CI3_SERVER is the outcome, exported once per process tree: the base URL of the server every
# client talks to, or empty when there is none. Setting it (even empty) skips discovery.
#
# Self-contained on purpose: the client scripts source only this file, so it must not depend on
# the rest of ci3/source having been loaded.

export ci3=${ci3:-$(git rev-parse --show-toplevel)/ci3}

# Transitional constants, until the labs dashboard serves the API: the redis the compat server
# forwards to and the dashboard that renders it. One place, so removing them is one edit.
ci3_compat_redis=ci-redis-tiered.lzka0i.ng.0001.use2.cache.amazonaws.com:6379
ci3_dashboard_url=http://ci.aztec-labs.com

if [ -z "${CI3_SERVER+set}" ]; then
  export CI3_SERVER=""
  case "${CI3_SERVER_URL:-}" in
    compat)
      if url=$("$ci3/ci3_server" start --backend compat --redis "$ci3_compat_redis" ${CI3_SERVER_START_ARGS:-}); then
        export CI3_SERVER=$url
        export CI3_PUBLIC_URL=${CI3_PUBLIC_URL:-$ci3_dashboard_url}
      else
        echo -e "\033[38;2;250;217;121mCould not start the compat ci3 server. Logs and test cache disabled.\033[0m" >&2
      fi
      ;;
    "")
      if [ "${CI:-0}" -eq 0 ]; then
        if url=$("$ci3/ci3_server" start ${CI3_SERVER_START_ARGS:-}); then
          export CI3_SERVER=$url
        else
          echo -e "\033[38;2;250;217;121mCould not start the local ci3 server (needs python3). Logs and test cache disabled.\033[0m" >&2
        fi
      fi
      ;;
    *)
      url=${CI3_SERVER_URL%/}
      if [ "$(curl -s --max-time 5 "$url/health" 2>/dev/null)" == "ci3-server" ]; then
        export CI3_SERVER=$url
      else
        echo -e "\033[38;2;250;217;121mCannot reach ci3 server at $url. Logs and test cache disabled.\033[0m" >&2
      fi
      ;;
  esac
  unset url
fi

# Links: the server, or the dashboard when the logs end up there (compat, or CI with no server).
if [ -z "${CI3_PUBLIC_URL:-}" ]; then
  if [ -z "$CI3_SERVER" ] && [ "${CI:-0}" -eq 1 ]; then
    export CI3_PUBLIC_URL=$ci3_dashboard_url
  else
    export CI3_PUBLIC_URL=$CI3_SERVER
  fi
fi
CI3_PUBLIC_URL=${CI3_PUBLIC_URL%/}

# No server, no test cache.
if [ -z "$CI3_SERVER" ]; then
  export USE_TEST_CACHE=0
fi

# Retention asked of the server: logs 2 weeks in CI and 2 days locally, build-cache artifacts a
# week (a local run stores every build it makes; without this /tmp/ci3 would only ever grow).
if [ "${CI:-0}" -eq 1 ]; then
  ci3_log_expire=$((60 * 60 * 24 * 14))
else
  ci3_log_expire=$((60 * 60 * 24 * 2))
fi
ci3_artifact_expire=$((60 * 60 * 24 * 7))

# The public, read-only build cache (S3 over plain HTTP) that artifact reads fall back to on a miss:
# the bucket endpoint from inside AWS, the CDN in front of it otherwise. ci3 never writes to it.
if [ "${CI:-0}" -eq 1 ]; then
  ci3_public_cache_url=http://aztec-ci-artifacts.s3.amazonaws.com/build-cache
else
  ci3_public_cache_url=https://build-cache.aztec-labs.com
fi

# curl against the server with the bearer token. Silent: callers decide what a failure means.
function ci3_curl {
  curl -s -f ${CI3_SERVER_TOKEN:+-H "Authorization: Bearer $CI3_SERVER_TOKEN"} "$@"
}
export -f ci3_curl
