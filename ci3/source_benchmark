# CI benchmark instrumentation functions.
# Source this file to get benchmark timing utilities for bootstrap scripts.
#
# Benchmarks are only recorded when CI_FULL=1.
#
# This file shadows cache_download, cache_upload, and echo_header to automatically
# track build timings:
#   - cache_download: On cache miss, starts a benchmark timer
#   - cache_upload: Ends any in-progress benchmark timer
#   - echo_header: Ends previous benchmark, starts new one based on header text
#
# Exit traps are automatically initialized to record the final benchmark on
# successful script exit.
#
# Benchmarks are written to bench-out/<name>.bench.json in the format:
#   [{"name": "ci/<name>", "value": <seconds>, "unit": "seconds"}]

# Track current benchmark state
export __BENCH_NAME="${__BENCH_NAME:-}"
export __BENCH_START_TIME="${__BENCH_START_TIME:-}"
# Track if we've set up the exit trap
export __BENCH_TRAP_SET="${__BENCH_TRAP_SET:-}"

# Start timing a benchmark.
# Args: <bench_name> - Name for the benchmark (will be prefixed with "ci/")
# Only starts if CI_FULL=1.
function start_bench {
  if [[ "${CI_FULL:-0}" != "1" ]]; then
    return 0
  fi
  local bench_name="$1"
  export __BENCH_NAME="$bench_name"
  export __BENCH_START_TIME=$(date +%s)
}

# End the current benchmark and write results to bench-out/.
# No-op if no benchmark is in progress.
function end_bench {
  if [[ -z "$__BENCH_NAME" || -z "$__BENCH_START_TIME" ]]; then
    return 0
  fi

  local end_time=$(date +%s)
  local duration=$((end_time - __BENCH_START_TIME))
  local bench_name="$__BENCH_NAME"

  # Clear state before writing
  export __BENCH_NAME=""
  export __BENCH_START_TIME=""

  # Create bench-out directory if needed
  mkdir -p bench-out

  # Sanitize bench name for filename (replace / with _)
  local filename=$(echo "$bench_name" | tr '/' '_')

  # Write benchmark JSON
  cat > "bench-out/${filename}.bench.json" << EOF
[{"name": "ci/${bench_name}", "value": ${duration}, "unit": "seconds"}]
EOF
}

# Wrapper for cache_download that starts a benchmark on cache miss.
# Derives bench name from artifact name (removes hash suffix and extension).
function cache_download {
  local artifact="$1"
  local out_dir="${2:-.}"

  if command cache_download "$artifact" "$out_dir"; then
    return 0
  else
    # Cache miss - start benchmark
    # Derive bench name: remove hash and extension, e.g. "barretenberg-clang20-abc123.zst" -> "barretenberg-clang20"
    local bench_name=$(echo "$artifact" | sed -E 's/-[a-f0-9]{16}\.(tar\.gz|zst)$//' | sed 's/\.tar\.gz$//' | sed 's/\.zst$//')
    start_bench "$bench_name"
    return 1
  fi
}

# Wrapper for cache_upload that ends any in-progress benchmark.
function cache_upload {
  command cache_upload "$@"
  end_bench
}

# Wrapper for echo_header that manages benchmarks.
# Ends any in-progress benchmark and starts a new one based on the header text.
function echo_header {
  # End any in-progress benchmark first
  end_bench

  # Print the header (call the actual script)
  command echo_header "$@"

  # Start new benchmark: derive name from header (lowercase, spaces to underscores)
  local bench_name=$(echo "$*" | tr '[:upper:]' '[:lower:]' | tr ' ' '_')
  start_bench "$bench_name"
}

# Set up an exit trap to end any in-progress benchmark on script exit.
# Only ends benchmarks on normal exit (exit code 0).
function init_bench_traps {
  if [[ -n "$__BENCH_TRAP_SET" ]]; then
    return 0
  fi
  export __BENCH_TRAP_SET=1
  trap '__bench_exit_handler' EXIT
}

# Internal exit handler for benchmark traps
function __bench_exit_handler {
  local exit_code=$?
  if [[ $exit_code -eq 0 ]]; then
    end_bench
  fi
}

export -f start_bench end_bench cache_download cache_upload echo_header init_bench_traps __bench_exit_handler

# Automatically initialize bench traps when sourced
init_bench_traps
