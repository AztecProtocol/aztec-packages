#!/usr/bin/env bash
# Tars the given paths and stores the result as build-cache artifact <name> on the ci3 server
# (see CI3_SERVER_API.md). In a local run that is the file-backed ci3_server, so a rebuild after
# switching branches back is a local cache hit.
# DO NOT output to stdout. This script is used in contexts where stdout is processed.
NO_CD=1 source ${root:-$(git rev-parse --show-toplevel)}/ci3/source

if [ "$#" -lt 2 ]; then
  echo_stderr "Usage: $0 <my-artifact.tar.gz> <binary_paths_to_tar_gz_and_upload...>"
  exit 1
fi

if [[ "$1" == *"disabled-cache"* ]]; then
  echo_stderr "Skipping upload of $1 due to uncommitted changes/files."
  exit 0
fi

# Name, intended to have .tar.gz ending
name="$1"
# Now $@ = our binary path args
shift 1

if [[ "${NO_CACHE_UPLOAD:-0}" -eq 1 ]]; then
  echo_stderr "Skipping upload because NO_CACHE_UPLOAD=1."
  exit 0
fi

if [ -z "$CI3_SERVER" ] && [ -z "${CACHE_LOCAL_DIR:-}" ]; then
  echo_stderr "Skipping upload of $name, no ci3 server available."
  exit 0
fi

if [ -n "$CI3_SERVER" ] && [ -z "${S3_FORCE_UPLOAD:-}" ] && ci3_client artifact_exists "$name"; then
  echo_stderr "Skipping upload, already exists: $name"
  exit 0
fi

out_tar=$(mktemp)
trap 'rm -f $out_tar' EXIT

if [[ "$name" == *.zst ]]; then
  tar --use-compress-program="zstd -T0" -cf $out_tar "$@"
else
  tar -czf $out_tar "$@"
fi

# Save to local cache if enabled.
if [[ -n "${CACHE_LOCAL_DIR:-}" ]]; then
  if mkdir -p "$CACHE_LOCAL_DIR" 2>/dev/null; then
    cp "$out_tar" "$CACHE_LOCAL_DIR/$name"
    echo_stderr "Saved $name to local cache."
  else
    echo_stderr "Warning: Cannot create local cache dir $CACHE_LOCAL_DIR, skipping local cache."
  fi
fi

if [ -z "$CI3_SERVER" ]; then
  echo_stderr "Skipping upload of $name, no ci3 server available."
elif ci3_client artifact_put "$name" "$out_tar"; then
  echo_stderr "Cache upload of $name complete in ${SECONDS}s."
else
  echo_stderr "Cache upload of $name failed."
fi
