#!/bin/bash
# Regression test: rk.py proxy must pass through compressed content without
# double-compression.  The bug was: Flask-Compress on ci-metrics compressed
# the response, requests auto-decompressed it (stripping Content-Encoding),
# then Flask-Compress on rk.py re-compressed with deflate — producing garbled
# binary output in the browser.
#
# The fix: use resp.raw.stream() to pass through raw (still-compressed) bytes
# and keep the Content-Encoding header, so Flask-Compress on rk.py skips.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

VENV="${TMPDIR:-/tmp}/ci-metrics-test-venv"
if ! "${VENV}/bin/python" -c "import flask, flask_compress, requests" 2>/dev/null; then
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q flask flask-compress requests
fi

"$VENV/bin/python" "$SCRIPT_DIR/test_proxy.py"
