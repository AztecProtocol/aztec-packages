#!/bin/bash
# Validate dashboard HTML view structure:
# - ci-insights.html: 3 tabs (overview, test-details, attribution), no cost chart
# - cost-overview.html: 2 tabs (overview, resource-details), no attribution
# - test-timings.html: redirect to ci-insights
# - Nav consistency across all pages
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VIEWS="$SCRIPT_DIR/../views"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

PASSED=0
FAILED=0

pass() { echo "${GREEN}✓${NC} $1"; ((PASSED++)) || true; }
fail() {
  echo "${RED}✗${NC} $1"
  if [ -n "${2:-}" ]; then echo "  $2"; fi
  ((FAILED++)) || true
}

# T <name> <file> <grep-pattern> — assert pattern IS found
T() {
  local name=$1 file=$2 pattern=$3
  if grep -qE "$pattern" "$file" 2>/dev/null; then
    pass "$name"
  else
    fail "$name" "pattern not found: $pattern"
  fi
}

# N <name> <file> <grep-pattern> — assert pattern is NOT found
N() {
  local name=$1 file=$2 pattern=$3
  if grep -qE "$pattern" "$file" 2>/dev/null; then
    fail "$name" "pattern unexpectedly found: $pattern"
  else
    pass "$name"
  fi
}

echo "=== CI Insights View ==="
ci="$VIEWS/ci-insights.html"
T "has overview tab"       "$ci" 'data-tab="overview"'
T "has test-details tab"   "$ci" 'data-tab="test-details"'
T "has attribution tab"    "$ci" 'data-tab="attribution"'
T "has tab-overview div"   "$ci" 'id="tab-overview"'
T "has tab-test-details"   "$ci" 'id="tab-test-details"'
T "has tab-attribution"    "$ci" 'id="tab-attribution"'
N "no cost chart canvas"   "$ci" 'id="costChart"'
N "no cost-per-merge KPI"  "$ci" 'kv-cpm|ks-cpm'
T "has merge queue chart"  "$ci" 'mergeQueueChart|merge-queue'
T "has flakes table"       "$ci" 'flakes'
T "nav: cost overview"     "$ci" 'cost-overview'
T "nav: namespace billing" "$ci" 'namespace-billing'
N "nav: no test-timings"   "$ci" 'href=.*test-timings'

echo
echo "=== Cost Overview View ==="
co="$VIEWS/cost-overview.html"
T "has overview tab"       "$co" 'data-tab="overview"'
T "has resource-details"   "$co" 'data-tab="details"'
N "no attribution tab"     "$co" 'data-tab="attribution"'
N "no attribution div"     "$co" 'id="tab-attribution"'
T "nav: ci insights"       "$co" 'ci-insights'
T "nav: namespace billing" "$co" 'namespace-billing'
N "nav: no test-timings"   "$co" 'href=.*test-timings'

echo
echo "=== Test Timings View (redirect) ==="
tt="$VIEWS/test-timings.html"
T "redirects to ci-insights" "$tt" "location.href.*=.*ci-insights"
T "includes tab=test-details" "$tt" "tab=test-details"

echo
echo "=== Summary ==="
if [[ $FAILED -eq 0 ]]; then
  echo "${GREEN}All $PASSED view tests passed.${NC}"
  exit 0
else
  echo "${RED}$FAILED view tests failed.${NC}"
  exit 1
fi
