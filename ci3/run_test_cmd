#!/usr/bin/env bash
# Called by 'parallelize' to execute a given test cmd.
# This is a thin wrapper around exec_test that handles CI integration:
# - Cache checking
# - Flake detection and owner notification
NO_CD=1 source $(git rev-parse --show-toplevel)/ci3/source
source "$ci3/source_log"

# We must enable job control to ensure our test runs in it's own process group.
# Otherwise, when parallel sends a TERM to the group, it will also kill any child process of the test.
# This can cause issues with proper cleanup (e.g. killing docker client processes as they run).
set -m

cmd=$1
[ -z "$cmd" ] && exit 0

is_merge_queue=0
[[ "$REF_NAME" =~ ^gh-readonly-queue/ ]] && is_merge_queue=1

# If enabled, update the test log every 5s.
live_logging=0
# If enabled, save logs for passed tests.
pass_log=0
# Allow a flaking tests to pass rather than fail.
allow_flakes=0
# If enabled, track test result in history tracker.
track_test_history=0
# If enabled, track failed test results to fail tracker.
track_test_fail=0
# If enabled, notify slack on flakes.
slack_notify_flake=0

if [ "$CI" -eq 1 ]; then
  # CI overrides.
  if [ -n "${CI3_SERVER:-}" ]; then
    live_logging=1
  fi
  pass_log=1
  allow_flakes=1
  track_test_fail=1

  # Track the test in the history tracker if this is in merge queue, targeting a version branch, or
  # targeting a merge-train.
  if [[ "$is_merge_queue" -eq 1 || ("${TARGET_BRANCH:-}" =~ ^v[0-9]) || ("${TARGET_BRANCH:-}" == merge-train/*) ]]; then
    track_test_history=1
  fi

  # Notify on flakes if in merge queue, backport-to-v2-staging, or a spartan merge-train.
  # The spartan trains run their full test suite on pull_request (via ci-full-no-test-cache),
  # not just merge_group, so without these cases the spartan PR's flakes are never reported.
  [[ "$is_merge_queue" -eq 1 \
      || "$REF_NAME" == "backport-to-v2-staging" \
      || "$REF_NAME" == "merge-train/spartan" \
      || "$REF_NAME" == "merge-train/spartan-v5" ]] && slack_notify_flake=1
fi

# Env overrides.
live_logging=${LIVE_LOGGING:-$live_logging}
pass_log=${PASS_LOG:-$pass_log}
allow_flakes=${ALLOW_FLAKES:-$allow_flakes}
track_test_history=${TRACK_TEST_HISTORY:-$track_test_history}
track_test_fail=${TRACK_TEST_FAIL:-$track_test_fail}
slack_notify_flake=${SLACK_NOTIFY_FLAKE:-$slack_notify_flake}

# The "key" is used for test caching (should re-run or not). It includes all test framework arguments.
key=$(hash_str_orig "$cmd")

# Extract the test command (without hash prefix) for display and tracking.
export test_cmd="${cmd#* }"

# The "test hash" does not include framework arguments, only the test command itself.
# It is used for tracking test history.
test_hash=$(hash_str_orig "$test_cmd")

# We can skip the test if it's already been successfully run.
# We actually pre-filter tests in CI runs so this is rarely hit.
# Commands marked 'disabled-cache' must never be served a cached result (mirrors filter_cached_test_cmd).
if [ "${USE_TEST_CACHE:-0}" -eq 1 ] && [[ "$cmd" != *disabled-cache* ]]; then
  log_key=$(ci3_client kv_get "$key") || log_key=
  if [ -n "$log_key" ]; then
    log_info=" ($(ci_term_link $log_key))"
    echo -e "${blue}SKIPPED${reset}${log_info:-}: $cmd"
    exit 0
  fi
fi

# Exit handler to cleanup.
function cleanup {
  stop_log_publisher
  if [ -f ${tmp_file:-} ]; then
    rm -f $tmp_file
  fi
}
trap cleanup EXIT

# Signal handler to forward SIGTERM/SIGINT to test process group.
# We use set -m so exec_test runs in its own process group (leader PID = test_pid).
# We must kill the process GROUP (-$pid) not just exec_test, otherwise children
# like docker_isolate are orphaned and Docker containers keep running.
function sig_handler {
  [ -n "${test_pid:-}" ] && kill -TERM -$test_pid &>/dev/null
  exit
}
trap sig_handler SIGTERM SIGINT

# Finalize the current attempt before its file is reused for a retry.
function rotate_log {
  publish_log_final "$log_key" "$tmp_file" "$@" || { cat "$tmp_file"; log_info=; }
  log_key=$(uuid)
  log_info=" ($(ci_term_link $log_key))"
  > "$tmp_file"
  start_live_log
}

function start_live_log {
  log_running_message="${blue}RUNNING${reset}${log_info:-}: $test_cmd"
  if [ "$live_logging" -eq 1 ]; then
    start_log_publisher "$log_key" "$tmp_file" 30
  fi
}

# Create a new log key and ci link.
log_key=$(uuid)
log_info=" ($(ci_term_link $log_key))"
grind_link=$(term_link "$(ci3_client url "grind?cmd=$(urlencode "$cmd")")" "grind")
fail_links="($grind_link)"

# Create a temporary file for the test log.
tmp_file=/tmp/$key
touch $tmp_file

# Start live log publishing if enabled.
start_live_log

function run_test {
  # Reset timer and run the test in background (for prompt signal handling) using exec_test.
  SECONDS=0
  set +e
  # This attempt's log id names the test's timing file (test-timings/<CI_LOG_ID>/<LOG_ID>). Tracks
  # rotate_log on retries.
  LOG_ID=$log_key $ci3/exec_test "$cmd" >> "$tmp_file" 2>&1 &
  test_pid=$!
  wait $test_pid
  code=$?

  # If the test received a SIGTERM or SIGINT, we don't want to track or print anything, just exit.
  if [ "$code" -eq 143 ] || [ "$code" -eq 130 ]; then
    exit $code
  fi
}

function finalize_test {
  stop_log_publisher
  if [ -z "${CI3_SERVER:-}" ]; then
    log_info=
    [ "$code" -eq 0 ] || cat "$tmp_file"
    return
  fi
  if [ "$code" -eq 0 ] && [ "$pass_log" -eq 0 ]; then
    log_info=
    return
  fi
  local ttl=()
  # Keep failures for twelve weeks, long enough to investigate recurring flakes.
  [ "$code" -eq 0 ] || ttl=($((60 * 60 * 24 * 7 * 12)))
  if publish_log_final "$log_key" "$tmp_file" "${ttl[@]}"; then
    if [ "$code" -eq 0 ] && [ "$CI" -eq 1 ]; then
      ci3_client kv_set "$key" "$log_key" 604800 || true
    fi
  else
    log_info=
    cat "$tmp_file"
  fi
}

function track_test {
  local list_key=$1
  local line=$(pr_link "$2")
  local max_lines=${3:-1000}

  ci3_client list_push $list_key "$(date "+%m-%d %H:%M:%S"): $(echo -e "$line")" $max_lines || true
}

function track_test_history {
  track_test "history_${test_hash}${TARGET_BRANCH:+_$TARGET_BRANCH}" "$1" ${2:-}
}

function track_test_failed {
  track_test "failed_tests${CI_DASHBOARD:+_$CI_DASHBOARD}" "$1" 10000
}

# Show PASSED and early out on success.
function pass {
  finalize_test

  local line="${green}PASSED${reset}${log_info:-}: $test_cmd (${SECONDS}s)"
  echo -e "$line"

  if [ "$track_test_history" -eq 1 ]; then
    local track_line="${green}PASSED${reset}${log_info:-} ${fail_links}: $test_cmd (${SECONDS}s) (${purple}$COMMIT_AUTHOR${reset}: $COMMIT_MSG)"
    track_test_history "$track_line"
  fi

  exit 0
}

# Show FAILED and exit with error code.
function fail {
  finalize_test

  local line="${red}FAILED${reset}${log_info:-}: $test_cmd (${SECONDS}s) (code: $code)"
  echo -e "$line"

  if [ "${DUMP_FAIL:-0}" -eq 1 ]; then
    cat $tmp_file
    echo -e "$line"
  fi

  local track_line="${red}FAILED${reset}${log_info:-} ${fail_links}: $test_cmd (${SECONDS}s) (code: $code) (${purple}$COMMIT_AUTHOR${reset}: $COMMIT_MSG)"
  [ "$track_test_history" -eq 1 ] && track_test_history "$track_line"
  [ "$track_test_fail" -eq 1 ] && track_test_failed "$track_line"
  post_github_status failure "ci/$test_cmd" "$(ci3_client url "$log_key")" "$test_cmd" || true

  exit $code
}

# Resolve the slack channel used for flake notifications, based on the PR head
# branch. Defaults to empty (slack_notify falls back to #aztec3-ci). Cached in
# /tmp so parallel test runs don't repeatedly hit the gh API.
function flake_slack_channel {
  local cache=/tmp/.flake_slack_channel
  if [ -f "$cache" ]; then
    cat "$cache"
    return
  fi
  local head_branch="${PR_HEAD_REF:-$REF_NAME}"
  if [[ "$head_branch" =~ ^gh-readonly-queue/.+/pr-([0-9]+)- ]] \
      && [ -n "${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
    head_branch=$(GH_TOKEN="$GITHUB_TOKEN" gh pr view "${BASH_REMATCH[1]}" \
      --repo AztecProtocol/aztec-packages --json headRefName -q '.headRefName' 2>/dev/null || true)
  fi
  local channel=""
  case "$head_branch" in
    merge-train/spartan | merge-train/spartan-v5) channel="#team-alpha-ci" ;;
  esac
  echo "$channel" > "$cache"
  echo "$channel"
}

# Show FLAKED and send slack message to test owner(s). Exit with success.
function flake {
  local group_suffix=""
  if [ -n "${flake_group_id:-}" ]; then
    group_suffix=" group:$flake_group_id"
  fi
  local line="${purple}FLAKED${reset}${log_info:-}: $test_cmd (${SECONDS}s) (code: $code)${group_suffix}"
  echo -e "$line"

  local track_line="${purple}FLAKED${reset}${log_info:-} ${fail_links}: $test_cmd (${SECONDS}s) (code: $code)${group_suffix} (${purple}$COMMIT_AUTHOR${reset}: $COMMIT_MSG)"
  [ "$track_test_history" -eq 1 ] && track_test_history "$track_line"
  [ "$track_test_fail" -eq 1 ] && track_test_failed "$track_line"
  # Save flake to buffer file (for PR comment generation)
  if [ -n "${FLAKES_FILE:-}" ]; then
    echo "$line" >> "$FLAKES_FILE"
  fi

  if [ "$slack_notify_flake" -eq 1 ]; then
    # Send slack message to owners.
    local slack_uids=""
    for uid in $owners; do
      slack_uids+="<@$uid> "
    done
    slack_notify "${slack_uids% }: Test flaked on *${TARGET_BRANCH:-$REF_NAME}*: \`$test_cmd\` $(ci3_client url $log_key)" "$(flake_slack_channel)"
  fi

  exit 0
}

run_test

# Test passed.
[ $code -eq 0 ] && pass

# If flakes are not allowed, fail the test.
[ "$allow_flakes" -eq 0 ] && fail

# Get matching test entries
test_entries=$(get_test_entry "$test_cmd" "$tmp_file")

# Extract owners from entries
owners=$(echo "$test_entries" | jq -r '.owners[]' | sort -u)

# Extract flake_group_id from first matching entry
flake_group_id=$(echo "$test_entries" | jq -r '.flake_group_id // empty' | head -1)

# If there's no owner for a failed test, we consider it a hard fail.
# Otherwise we perform a single retry.
if [ -z "$owners" ]; then
  fail
else
  failure_log_key=$log_key
  failure_log_info=$log_info
  rotate_log $((60 * 60 * 24 * 7 * 12))

  echo -e "${yellow}RETRYING${reset}${log_info}: $test_cmd"

  run_test

  if [ $code -eq 0 ]; then
    # Publish the retry's log, then point back at the failure for flake reporting.
    if [ -n "${CI3_SERVER:-}" ]; then
      publish_log_final "$log_key" "$tmp_file" || cat "$tmp_file"
    fi
    log_key=$failure_log_key
    log_info=$failure_log_info
    flake
  fi

  # Otherwise we failed twice in a row, so hard fail.
  fail
fi
