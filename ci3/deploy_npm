#!/usr/bin/env bash
NO_CD=1 source $(git rev-parse --show-toplevel)/ci3/source

version=$1

dry_run=${DRY_RUN:-0}

# Only two npm dist-tags are used: 'latest' for stable releases and 'prerelease' for everything else.
# Pre-release versions (nightlies, RCs, etc.) are installed by exact version, not by dist-tag.
prerelease=$(semver prerelease $version)
if [ -n "$prerelease" ]; then
  npm_tag="prerelease"
else
  npm_tag="latest"
fi

# Point .npmrc config to one that relies on 'NPM_TOKEN' in the environment.
export NPM_CONFIG_GLOBALCONFIG="$root/ci3/npm/.npmrc"

package_name=$(jq -r '.name' package.json)
echo_header "publishing $package_name"

published_version=$(npm show . version --tag $npm_tag 2>/dev/null | grep -vE '^@' || true)

# Check if there is already a published package equal to given version, assume this is a re-run of a deploy.
if [ "$version" == "$published_version" ]; then
  echo "Tagged $npm_tag version $version is equal to published $npm_tag version $published_version."
  echo "Skipping publish."
  exit 0
fi

# Create temp directory for publishing
tmpdir=$(mktemp -d)
function cleanup {
  rm -rf "$tmpdir"
}
trap cleanup SIGINT SIGTERM EXIT

# Use npm pack instead of yarn pack. yarn pack fails on portal: dependencies (e.g. bb.js)
# because its beforeWorkspacePacking hook can't resolve workspace:^ for portal links.
# npm pack just packs the files without trying to resolve workspace refs.
npm pack --pack-destination "$tmpdir" --quiet

# Extract and prepare
cd "$tmpdir"
tar -xzf *.tgz
cd package

# Replace workspace:^ with concrete versions.
release_prep_package_json $version

# Final gate before an immutable publish: any contract artifacts being shipped must carry the real
# release version in aztec_version, not the build-time "dev" placeholder. v4.3.0 reached npm with
# aztec_version="dev" because REF_NAME was unset when the build stamped it; refuse to publish such a
# mismatch rather than ship it. Packages without contract artifacts have no artifacts/ dir and are skipped.
if [ -d artifacts ]; then
  for f in artifacts/*.json; do
    [ -e "$f" ] || continue
    stamped=$(jq -r 'if has("aztec_version") then .aztec_version else empty end' "$f")
    if [ -n "$stamped" ] && [ "$stamped" != "$version" ]; then
      echo_stderr "ERROR: $package_name: $(basename "$f") has aztec_version='$stamped', expected '$version'. Refusing to publish."
      exit 1
    fi
  done
fi

# Publish from temp dir
if [ "$dry_run" -eq 1 ]; then
  denoise "npm publish --ignore-scripts --dry-run --tag $npm_tag --access public"
else
  # Check if version exists.
  if npm view "$package_name@$version" version >/dev/null 2>&1; then
    # Tag the existing version.
    npm dist-tag add $package_name@$version $npm_tag
  else
    # Publish new version.
    denoise "npm publish --ignore-scripts --tag $npm_tag --access public"
  fi
fi
