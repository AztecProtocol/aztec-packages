#!/usr/bin/env bash
NO_CD=1 source $(git rev-parse --show-toplevel)/ci3/source

version=$1

dry_run=${DRY_RUN:-0}

# Only two npm dist-tags are used: 'latest' for stable releases and 'prerelease' for everything else.
# Pre-release versions (nightlies, RCs, etc.) are installed by exact version, not by dist-tag.
prerelease=$(semver prerelease $version)
if [ -n "$prerelease" ]; then
  npm_tag="prerelease"
else
  npm_tag="latest"
fi

# Point .npmrc config to one that relies on 'NPM_TOKEN' in the environment. A private release
# (INTERNAL_NPM_REGISTRY set) has already exported NPM_CONFIG_GLOBALCONFIG — an .npmrc that scopes
# @aztec/@noir-lang to our internal GCP Artifact Registry npm repo (see bootstrap.sh::private_release)
# — so we leave it in place; a normal release uses the npmjs config.
if [ -z "${INTERNAL_NPM_REGISTRY:-}" ]; then
  export NPM_CONFIG_GLOBALCONFIG="$root/ci3/npm/.npmrc"
fi

package_name=$(jq -r '.name' package.json)

# Pack mode: with NPM_PACK_DIR set the release build only produces the publishable tarball (same
# version stamping and workspace rewriting as a publish) and drops it into that directory. The public
# release job then publishes the collected tarballs from a GitHub runner with npm trusted publishing
# (ci3/publish_npm_release), so the build machine never holds npm credentials.
pack_dir=${NPM_PACK_DIR:-}
if [ -n "$pack_dir" ]; then
  echo_header "packing $package_name"
  published_version=""
else
  echo_header "publishing $package_name"
  published_version=$(npm show . version --tag $npm_tag 2>/dev/null | grep -vE '^@' || true)
fi

# Check if there is already a published package equal to given version, assume this is a re-run of a deploy.
if [ "$version" == "$published_version" ]; then
  echo "Tagged $npm_tag version $version is equal to published $npm_tag version $published_version."
  echo "Skipping publish."
  exit 0
fi

# Where this package lives in the tree, for the repository field release_prep_package_json stamps.
export NPM_PACKAGE_DIR
NPM_PACKAGE_DIR=$(python3 -c 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$PWD" "$root" 2>/dev/null || true)

# Create temp directory for publishing
tmpdir=$(mktemp -d)
function cleanup {
  rm -rf "$tmpdir"
}
trap cleanup SIGINT SIGTERM EXIT

# Use npm pack instead of yarn pack. yarn pack fails on portal: dependencies (e.g. bb.js)
# because its beforeWorkspacePacking hook can't resolve workspace:^ for portal links.
# npm pack just packs the files without trying to resolve workspace refs.
npm pack --pack-destination "$tmpdir" --quiet

# Extract and prepare
cd "$tmpdir"
tar -xzf *.tgz
cd package

# Replace workspace:^ with concrete versions.
release_prep_package_json $version

if [ -n "$pack_dir" ]; then
  mkdir -p "$pack_dir"
  # The pack above already ran the package's prepack scripts inside its workspace; this extracted
  # copy has no workspace, so they must not run again (same reason publish uses --ignore-scripts).
  npm pack --ignore-scripts --pack-destination "$pack_dir" --quiet
  exit 0
fi

# Publish from temp dir
if [ "$dry_run" -eq 1 ]; then
  denoise "npm publish --ignore-scripts --dry-run --tag $npm_tag --access public"
else
  # Check if version exists.
  if npm view "$package_name@$version" version >/dev/null 2>&1; then
    # Tag the existing version.
    npm dist-tag add $package_name@$version $npm_tag
  else
    # Publish new version.
    denoise "npm publish --ignore-scripts --tag $npm_tag --access public"
  fi
fi
