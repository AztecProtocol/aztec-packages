// Implementation based on https://eprint.iacr.org/2023/323.pdf
// The optimised approach based on quad gates explained here: barretenberg/stdlib/hash/poseidon2/QUAD_THEOREM.md
include "poseidon2_params.pil";

// WARNING: Any change in this file must be reflected in
//          optimized/relations/poseidon2_perm_impl.hpp because this is the only pil file
//          which does not generate hpp/cpp files when we run `bb_pil`. We manually optimized
//          the generated code to speed-up build time.

/**
 * This trace performs the poseidon2 permutation.
 * This subtrace does not support any errors.
 * Every permutation is computed on a single row.
 *
 * Layout
 *  - Initial external linear layer (M_E applied to a_*) commits T_*_{4..7}.
 *  - 4 starting full rounds, each committing the 4 external-matrix outputs.
 *  - 56 partial rounds encoded as a K_BRIDGE=56 closed-form chain. Only state[0]
 *    is committed at every partial round (56 cols, B_4_0..B_59_0). The three
 *    linear lanes evolve as virtual polynomials X_n, Y_n, Z_n .
 *    A single 3-column bridge at the final partial round commits B_59_{1,2,3}
 *    so the subsequent full rounds can consume them as the standard 4-lane state. Partial-round
 *    commits: 56 + 3 = 59.
 *  - 4 ending full rounds, each committing the 4 external-matrix outputs.
 *  - Final state is matched against the claimed output (b_*).
 *
 * Usage:
 *  sel_should_exec {
 *       input[0], input[1], input[2], input[3],
 *       output[0], output[1], output[2], output[3]
 *   } in
 *   poseidon2_perm.sel {
 *       poseidon2_perm.a_0, poseidon2_perm.a_1, poseidon2_perm.a_2, poseidon2_perm.a_3,
 *       poseidon2_perm.b_0, poseidon2_perm.b_1, poseidon2_perm.b_2, poseidon2_perm.b_3
 *   };
 */
namespace poseidon2_perm;

    // Selector for poseidon2 operation
    pol commit sel;
    // Selector is boolean
    sel * (1 - sel) = 0;
    #[skippable_if]
    sel = 0;

    // The input values are represented by a_0, a_1, a_2, a_3
    pol commit a_0;
    pol commit a_1;
    pol commit a_2;
    pol commit a_3;

    // Output values represented by b_0, b_1, b_2, b_3
    pol commit b_0;
    pol commit b_1;
    pol commit b_2;
    pol commit b_3;

    // Intermediate helper values denoted by T_{id} - based on Appendix B of https://eprint.iacr.org/2023/323.pdf;
    // T_0 = a_0 + a_1;
    // T_1 = a_2 + a_3;
    // T_2 = 2 * a_1 + T_0;
    // T_3 = 2 * a_3 + T_0;
    // T_4 = 4 * T_1 + T_3;
    // T_5 = 4 * T_0 + T_2;
    // T_6 = T_3 + T_5;
    // T_7 = T_2 + T_4;

    // We additionally include the round identifier in the naming
    // <STEP>_<ROUND>_<INPUT>
    // e.g. ARK_0_2 -> Add Round Constant, round 0, input 2

    // FIRST EXTERNAL MATRIX LAYER
    pol commit EXT_LAYER_4;
    pol commit EXT_LAYER_5;
    pol commit EXT_LAYER_6;
    pol commit EXT_LAYER_7;
    pol EXT_LAYER_0 = a_0 + a_1;
    pol EXT_LAYER_1 = a_2 + a_3;
    pol EXT_LAYER_2 = 2 * a_1 + EXT_LAYER_1;
    pol EXT_LAYER_3 = 2 * a_3 + EXT_LAYER_0;
    sel * (EXT_LAYER_4 - (4 * EXT_LAYER_1 + EXT_LAYER_3)) = 0;
    sel * (EXT_LAYER_5 - (4 * EXT_LAYER_0 + EXT_LAYER_2)) = 0;
    sel * (EXT_LAYER_6 - (EXT_LAYER_3 + EXT_LAYER_5)) = 0;
    sel * (EXT_LAYER_7 - (EXT_LAYER_2 + EXT_LAYER_4)) = 0;

    /////////////////////////////////////////////////////
    // START FULL ROUNDS (4 ROUNDS)
    /////////////////////////////////////////////////////
    // Round 1 (Full Round)
    // ARK (Add Round Constant)
    pol ARK_0_0 = EXT_LAYER_6 + poseidon2_params.C_0_0;
    pol ARK_0_1 = EXT_LAYER_5 + poseidon2_params.C_0_1;
    pol ARK_0_2 = EXT_LAYER_7 + poseidon2_params.C_0_2;
    pol ARK_0_3 = EXT_LAYER_4 + poseidon2_params.C_0_3;

    // S-BOX (In full round all inputs are exponentiated)
    pol A_0_0 = ARK_0_0 * ARK_0_0 * ARK_0_0 * ARK_0_0 * ARK_0_0;
    pol A_0_1 = ARK_0_1 * ARK_0_1 * ARK_0_1 * ARK_0_1 * ARK_0_1;
    pol A_0_2 = ARK_0_2 * ARK_0_2 * ARK_0_2 * ARK_0_2 * ARK_0_2;
    pol A_0_3 = ARK_0_3 * ARK_0_3 * ARK_0_3 * ARK_0_3 * ARK_0_3;

    // MATRIX (Full round uses the external matrix)
    pol commit T_0_4;
    pol commit T_0_5;
    pol commit T_0_6;
    pol commit T_0_7;

    pol T_0_0 = A_0_0 + A_0_1;
    pol T_0_1 = A_0_2 + A_0_3;
    pol T_0_2 = 2 * A_0_1 + T_0_1;
    pol T_0_3 = 2 * A_0_3 + T_0_0;
    sel * (T_0_4 - (4 * T_0_1 + T_0_3)) = 0;
    sel * (T_0_5 - (4 * T_0_0 + T_0_2)) = 0;
    sel * (T_0_6 - (T_0_3 + T_0_5)) = 0;
    sel * (T_0_7 - (T_0_2 + T_0_4)) = 0;

    // Round 2 (Full Round)
    // ARK (Add Round Constant)
    pol ARK_1_0 = T_0_6 + poseidon2_params.C_1_0;
    pol ARK_1_1 = T_0_5 + poseidon2_params.C_1_1;
    pol ARK_1_2 = T_0_7 + poseidon2_params.C_1_2;
    pol ARK_1_3 = T_0_4 + poseidon2_params.C_1_3;

    // S-BOX (In full round all inputs are exponentiated)
    pol A_1_0 = ARK_1_0 * ARK_1_0 * ARK_1_0 * ARK_1_0 * ARK_1_0;
    pol A_1_1 = ARK_1_1 * ARK_1_1 * ARK_1_1 * ARK_1_1 * ARK_1_1;
    pol A_1_2 = ARK_1_2 * ARK_1_2 * ARK_1_2 * ARK_1_2 * ARK_1_2;
    pol A_1_3 = ARK_1_3 * ARK_1_3 * ARK_1_3 * ARK_1_3 * ARK_1_3;

    // MATRIX (Full round uses the external matrix)
    pol commit T_1_4;
    pol commit T_1_5;
    pol commit T_1_6;
    pol commit T_1_7;

    pol T_1_0 = A_1_0 + A_1_1;
    pol T_1_1 = A_1_2 + A_1_3;
    pol T_1_2 = 2 * A_1_1 + T_1_1;
    pol T_1_3 = 2 * A_1_3 + T_1_0;
    sel * (T_1_4 - (4 * T_1_1 + T_1_3)) = 0;
    sel * (T_1_5 - (4 * T_1_0 + T_1_2)) = 0;
    sel * (T_1_6 - (T_1_3 + T_1_5)) = 0;
    sel * (T_1_7 - (T_1_2 + T_1_4)) = 0;

    // Round 3 (Full Round)
    // ARK (Add Round Constant)
    pol ARK_2_0 = T_1_6 + poseidon2_params.C_2_0;
    pol ARK_2_1 = T_1_5 + poseidon2_params.C_2_1;
    pol ARK_2_2 = T_1_7 + poseidon2_params.C_2_2;
    pol ARK_2_3 = T_1_4 + poseidon2_params.C_2_3;

    // S-BOX (In full round all inputs are exponentiated)
    pol A_2_0 = ARK_2_0 * ARK_2_0 * ARK_2_0 * ARK_2_0 * ARK_2_0;
    pol A_2_1 = ARK_2_1 * ARK_2_1 * ARK_2_1 * ARK_2_1 * ARK_2_1;
    pol A_2_2 = ARK_2_2 * ARK_2_2 * ARK_2_2 * ARK_2_2 * ARK_2_2;
    pol A_2_3 = ARK_2_3 * ARK_2_3 * ARK_2_3 * ARK_2_3 * ARK_2_3;

    // MATRIX (Full round uses the external matrix)
    pol commit T_2_4;
    pol commit T_2_5;
    pol commit T_2_6;
    pol commit T_2_7;

    pol T_2_0 = A_2_0 + A_2_1;
    pol T_2_1 = A_2_2 + A_2_3;
    pol T_2_2 = 2 * A_2_1 + T_2_1;
    pol T_2_3 = 2 * A_2_3 + T_2_0;
    sel * (T_2_4 - (4 * T_2_1 + T_2_3)) = 0;
    sel * (T_2_5 - (4 * T_2_0 + T_2_2)) = 0;
    sel * (T_2_6 - (T_2_3 + T_2_5)) = 0;
    sel * (T_2_7 - (T_2_2 + T_2_4)) = 0;

    // Round 4 (Full Round)
    // ARK (Add Round Constant)
    pol ARK_3_0 = T_2_6 + poseidon2_params.C_3_0;
    pol ARK_3_1 = T_2_5 + poseidon2_params.C_3_1;
    pol ARK_3_2 = T_2_7 + poseidon2_params.C_3_2;
    pol ARK_3_3 = T_2_4 + poseidon2_params.C_3_3;

    // S-BOX (In full round all inputs are exponentiated)
    pol A_3_0 = ARK_3_0 * ARK_3_0 * ARK_3_0 * ARK_3_0 * ARK_3_0;
    pol A_3_1 = ARK_3_1 * ARK_3_1 * ARK_3_1 * ARK_3_1 * ARK_3_1;
    pol A_3_2 = ARK_3_2 * ARK_3_2 * ARK_3_2 * ARK_3_2 * ARK_3_2;
    pol A_3_3 = ARK_3_3 * ARK_3_3 * ARK_3_3 * ARK_3_3 * ARK_3_3;

    // MATRIX (Full round uses the external matrix)
    pol commit T_3_4;
    pol commit T_3_5;
    pol commit T_3_6;
    pol commit T_3_7;

    pol T_3_0 = A_3_0 + A_3_1;
    pol T_3_1 = A_3_2 + A_3_3;
    pol T_3_2 = 2 * A_3_1 + T_3_1;
    pol T_3_3 = 2 * A_3_3 + T_3_0;
    sel * (T_3_4 - (4 * T_3_1 + T_3_3)) = 0;
    sel * (T_3_5 - (4 * T_3_0 + T_3_2)) = 0;
    sel * (T_3_6 - (T_3_3 + T_3_5)) = 0;
    sel * (T_3_7 - (T_3_2 + T_3_4)) = 0;

    /////////////////////////////////////////////////////
    // PARTIAL ROUNDS (56 ROUNDS)
    // Given the sponge state [W, X, Y, Z], the poseidon2 permutation partial round consists of the following steps
    // using pil-style notation
    // 1) Adding Round Constant (ARK) applied to all "lanes" (i.e. the state values)
    //    -> state[i]' = state[i] + round_constant_i, for a given round
    // 2) S-BOX applied to just the W-state
    //    -> W' = W^5
    // 3) Apply Internal MDS Matrix
    //    -> MDS Matrix defined as: Diag(MU_0,MU_1,MU_2,MU_3)
    //    -> STATE_SUM = (W + C_W)^5 + (X + C_X) + (Y + C_Y) + (Z + C_Z)
    //    -> W' = MU_0 * W^5 + STATE_SUM
    //    -> X' = MU_1 * X + STATE_SUM
    //    -> Y' = MU_2 * Y + STATE_SUM
    //    -> Z' = MU_3 * Z + STATE_SUM
    //
    // It can be observed here that for partial rounds only W (state[0]) undergoes a non-linear transformation 
    // This means that we can choose to NOT commit to states X, Y, Z without increasing the degree.
    // We now introduce the semantics of how we will combine all 56 partial rounds for states X, Y, and Z without committing to them.
    // Define alpha = (W + C_W)^5 and let s_i for i = 1, 2, or 3 represent X, Y, or Z resp.
    // - ARK: s_i = s_i + C_i where C_i is a constant
    // - S_BOX: s_i = s_i, unchanged
    // - MDS: s_i = MU_i * s_i + STATE_SUM
    // Expanding all the values for a state X yields:
    // - X' = MU_1 * (X + C_X) + (X + C_X) + (Y + C_Y) + (Z + C_Z) + alpha
    // We can group the (X + C_X):
    // - X' = (MU_1 + 1) * (X + C_X) + (Y + C_Y) + (Z + C_Z) + alpha
    // Rename (MU_1 + 1) to be M3_11 and distribute over X and C_X:
    // - X' = M3_11 * X + M3_11 * C_X + (Y + C_Y) + (Z + C_Z) + alpha
    // Now split the variables between the witness and constant values:
    // - X' = M3_11 *  X  +   Y +   Z + alpha
    //      + M3_11 * C_X + C_Y + C_Z
    // In this file we can represent X' by the following relations:
    // pol R_X_LOCAL = M3_11 * C_X + C_Y + C_Z
    // pol X'        = M3_11 * X   + Y   + Z + alpha + R_X_LOCAL
    // Now PRACTICALLY, C_X, C_Y and C_Z are zero for partial rounds so we simplify the relation by never defining R_X_LOCAL
    //
    // We can apply the same expansion to state W, noting two differences:
    // - S_BOX is non-trivial: W = (W + C_W)^5 = alpha
    // - the MDS coefficient acts on alpha, not on (W + C_W)
    // Expanding all the values for state W yields:
    // - W' = MU_0 * alpha + alpha + (X + C_X) + (Y + C_Y) + (Z + C_Z)
    // We can group the alpha terms
    // - W' = (MU_0 + 1) * alpha + (X + C_X) + (Y + C_Y) + (Z + C_Z)
    // Unlike X, Y, Z, we commit to state W'. Again C_X, C_Y and C_Z are zero so the relation simplifies to 
    // - W' = (MU_0 + 1) * alpha + X + Y + Z
    //
    // The following recurrence is repeated for all 56 rounds, at the final 56th round we commit them so
    // that they can be used in the subsequent full round
    /////////////////////////////////////////////////////

    // ─── Entry to the partial-round chain ─────────────────────────────────
    // The starting full rounds emit their MDS output with a permuted lane order:
    //   lane 0 ← T_3_6, lane 1 ← T_3_5, lane 2 ← T_3_7, lane 3 ← T_3_4.
    // Re-alias to the uniform B_n_<lane> naming so partial rounds compose cleanly.
    pol B_3_0 = T_3_6;
    pol X_0 = T_3_5;
    pol Y_0 = T_3_7;
    pol Z_0 = T_3_4;

    // Round 5 (Partial Round)
    pol commit B_4_0;
    pol ARK_4_0 = B_3_0 + poseidon2_params.C_4_0;
    pol ALPHA_1 = ARK_4_0 * ARK_4_0 * ARK_4_0 * ARK_4_0 * ARK_4_0;

    pol X_1 = poseidon2_params.M3_11 * X_0 + Y_0 + Z_0 + ALPHA_1;
    pol Y_1 = X_0 + poseidon2_params.M3_22 * Y_0 + Z_0 + ALPHA_1;
    pol Z_1 = X_0 + Y_0 + poseidon2_params.M3_33 * Z_0 + ALPHA_1;

    sel * (B_4_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_1
                  + (X_0 + Y_0 + Z_0))) = 0;

    // Round 6 (Partial Round)
    pol commit B_5_0;
    pol ARK_5_0 = B_4_0 + poseidon2_params.C_5_0;
    pol ALPHA_2 = ARK_5_0 * ARK_5_0 * ARK_5_0 * ARK_5_0 * ARK_5_0;

    pol X_2 = poseidon2_params.M3_11 * X_1 + Y_1 + Z_1 + ALPHA_2;
    pol Y_2 = X_1 + poseidon2_params.M3_22 * Y_1 + Z_1 + ALPHA_2;
    pol Z_2 = X_1 + Y_1 + poseidon2_params.M3_33 * Z_1 + ALPHA_2;

    sel * (B_5_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_2
                  + (X_1 + Y_1 + Z_1))) = 0;

    // Round 7 (Partial Round)
    pol commit B_6_0;
    pol ARK_6_0 = B_5_0 + poseidon2_params.C_6_0;
    pol ALPHA_3 = ARK_6_0 * ARK_6_0 * ARK_6_0 * ARK_6_0 * ARK_6_0;

    pol X_3 = poseidon2_params.M3_11 * X_2 + Y_2 + Z_2 + ALPHA_3;
    pol Y_3 = X_2 + poseidon2_params.M3_22 * Y_2 + Z_2 + ALPHA_3;
    pol Z_3 = X_2 + Y_2 + poseidon2_params.M3_33 * Z_2 + ALPHA_3;

    sel * (B_6_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_3
                  + (X_2 + Y_2 + Z_2))) = 0;

    // Round 8 (Partial Round)
    pol commit B_7_0;
    pol ARK_7_0 = B_6_0 + poseidon2_params.C_7_0;
    pol ALPHA_4 = ARK_7_0 * ARK_7_0 * ARK_7_0 * ARK_7_0 * ARK_7_0;

    pol X_4 = poseidon2_params.M3_11 * X_3 + Y_3 + Z_3 + ALPHA_4;
    pol Y_4 = X_3 + poseidon2_params.M3_22 * Y_3 + Z_3 + ALPHA_4;
    pol Z_4 = X_3 + Y_3 + poseidon2_params.M3_33 * Z_3 + ALPHA_4;

    sel * (B_7_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_4
                  + (X_3 + Y_3 + Z_3))) = 0;

    // Round 9 (Partial Round)
    pol commit B_8_0;
    pol ARK_8_0 = B_7_0 + poseidon2_params.C_8_0;
    pol ALPHA_5 = ARK_8_0 * ARK_8_0 * ARK_8_0 * ARK_8_0 * ARK_8_0;

    pol X_5 = poseidon2_params.M3_11 * X_4 + Y_4 + Z_4 + ALPHA_5;
    pol Y_5 = X_4 + poseidon2_params.M3_22 * Y_4 + Z_4 + ALPHA_5;
    pol Z_5 = X_4 + Y_4 + poseidon2_params.M3_33 * Z_4 + ALPHA_5;

    sel * (B_8_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_5
                  + (X_4 + Y_4 + Z_4))) = 0;

    // Round 10 (Partial Round)
    pol commit B_9_0;
    pol ARK_9_0 = B_8_0 + poseidon2_params.C_9_0;
    pol ALPHA_6 = ARK_9_0 * ARK_9_0 * ARK_9_0 * ARK_9_0 * ARK_9_0;

    pol X_6 = poseidon2_params.M3_11 * X_5 + Y_5 + Z_5 + ALPHA_6;
    pol Y_6 = X_5 + poseidon2_params.M3_22 * Y_5 + Z_5 + ALPHA_6;
    pol Z_6 = X_5 + Y_5 + poseidon2_params.M3_33 * Z_5 + ALPHA_6;

    sel * (B_9_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_6
                  + (X_5 + Y_5 + Z_5))) = 0;

    // Round 11 (Partial Round)
    pol commit B_10_0;
    pol ARK_10_0 = B_9_0 + poseidon2_params.C_10_0;
    pol ALPHA_7 = ARK_10_0 * ARK_10_0 * ARK_10_0 * ARK_10_0 * ARK_10_0;

    pol X_7 = poseidon2_params.M3_11 * X_6 + Y_6 + Z_6 + ALPHA_7;
    pol Y_7 = X_6 + poseidon2_params.M3_22 * Y_6 + Z_6 + ALPHA_7;
    pol Z_7 = X_6 + Y_6 + poseidon2_params.M3_33 * Z_6 + ALPHA_7;

    sel * (B_10_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_7
                  + (X_6 + Y_6 + Z_6))) = 0;

    // Round 12 (Partial Round)
    pol commit B_11_0;
    pol ARK_11_0 = B_10_0 + poseidon2_params.C_11_0;
    pol ALPHA_8 = ARK_11_0 * ARK_11_0 * ARK_11_0 * ARK_11_0 * ARK_11_0;

    pol X_8 = poseidon2_params.M3_11 * X_7 + Y_7 + Z_7 + ALPHA_8;
    pol Y_8 = X_7 + poseidon2_params.M3_22 * Y_7 + Z_7 + ALPHA_8;
    pol Z_8 = X_7 + Y_7 + poseidon2_params.M3_33 * Z_7 + ALPHA_8;

    sel * (B_11_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_8
                  + (X_7 + Y_7 + Z_7))) = 0;

    // Round 13 (Partial Round)
    pol commit B_12_0;
    pol ARK_12_0 = B_11_0 + poseidon2_params.C_12_0;
    pol ALPHA_9 = ARK_12_0 * ARK_12_0 * ARK_12_0 * ARK_12_0 * ARK_12_0;

    pol X_9 = poseidon2_params.M3_11 * X_8 + Y_8 + Z_8 + ALPHA_9;
    pol Y_9 = X_8 + poseidon2_params.M3_22 * Y_8 + Z_8 + ALPHA_9;
    pol Z_9 = X_8 + Y_8 + poseidon2_params.M3_33 * Z_8 + ALPHA_9;

    sel * (B_12_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_9
                  + (X_8 + Y_8 + Z_8))) = 0;

    // Round 14 (Partial Round)
    pol commit B_13_0;
    pol ARK_13_0 = B_12_0 + poseidon2_params.C_13_0;
    pol ALPHA_10 = ARK_13_0 * ARK_13_0 * ARK_13_0 * ARK_13_0 * ARK_13_0;

    pol X_10 = poseidon2_params.M3_11 * X_9 + Y_9 + Z_9 + ALPHA_10;
    pol Y_10 = X_9 + poseidon2_params.M3_22 * Y_9 + Z_9 + ALPHA_10;
    pol Z_10 = X_9 + Y_9 + poseidon2_params.M3_33 * Z_9 + ALPHA_10;

    sel * (B_13_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_10
                  + (X_9 + Y_9 + Z_9))) = 0;

    // Round 15 (Partial Round)
    pol commit B_14_0;
    pol ARK_14_0 = B_13_0 + poseidon2_params.C_14_0;
    pol ALPHA_11 = ARK_14_0 * ARK_14_0 * ARK_14_0 * ARK_14_0 * ARK_14_0;

    pol X_11 = poseidon2_params.M3_11 * X_10 + Y_10 + Z_10 + ALPHA_11;
    pol Y_11 = X_10 + poseidon2_params.M3_22 * Y_10 + Z_10 + ALPHA_11;
    pol Z_11 = X_10 + Y_10 + poseidon2_params.M3_33 * Z_10 + ALPHA_11;

    sel * (B_14_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_11
                  + (X_10 + Y_10 + Z_10))) = 0;

    // Round 16 (Partial Round)
    pol commit B_15_0;
    pol ARK_15_0 = B_14_0 + poseidon2_params.C_15_0;
    pol ALPHA_12 = ARK_15_0 * ARK_15_0 * ARK_15_0 * ARK_15_0 * ARK_15_0;

    pol X_12 = poseidon2_params.M3_11 * X_11 + Y_11 + Z_11 + ALPHA_12;
    pol Y_12 = X_11 + poseidon2_params.M3_22 * Y_11 + Z_11 + ALPHA_12;
    pol Z_12 = X_11 + Y_11 + poseidon2_params.M3_33 * Z_11 + ALPHA_12;

    sel * (B_15_0 - ((poseidon2_params.MU_0 + 1) * ALPHA_12
                  + (X_11 + Y_11 + Z_11))) = 0;

