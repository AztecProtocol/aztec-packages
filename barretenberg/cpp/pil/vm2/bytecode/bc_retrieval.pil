include "contract_instance_retrieval.pil";
include "class_id_derivation.pil";

include "../constants_gen.pil";
include "../precomputed.pil";
include "../trees/retrieved_bytecodes_tree_check.pil";

/**
 * This subtrace constrains everything related to "retrieving" a bytecode given an address. In practice this means we:
 *  - Silo the address:
 *      - siloed_nullifier = H(DOM_SEP__SILOED_NULLIFIER, deployer_protocol_contract_address, address)
 *      - Enforced by lookup into contract_instance_retrieval.pil (#[CONTRACT_INSTANCE_RETRIEVAL]), which looks up nullifier_check.pil (#[DEPLOYMENT_NULLIFIER_READ]).
 *  - Check if the nullifier exists.
 *      - Enforced in above lookup (contract_instance_retrieval.pil (#[CONTRACT_INSTANCE_RETRIEVAL]) -> nullifier_check.pil (#[DEPLOYMENT_NULLIFIER_READ])).
 *  - Derive the address.
 *      - Enforced in above lookup (contract_instance_retrieval.pil (#[CONTRACT_INSTANCE_RETRIEVAL]) -> address_derivation.pil (#[ADDRESS_DERIVATION])).
 *      - Note: for this trace, we only 'care' about the contract instance member current_class_id (not salt, deployer_addr, init_hash), which is validated in
 *        #[CLASS_ID_DERIVATION]. It is sufficient that after validating nullifier membership, #[CONTRACT_INSTANCE_RETRIEVAL] -> #[ADDRESS_DERIVATION] will enforce
 *        that the correct instance members are used. If a prover tries to use the wrong instance members, address derivation will have unsatisfiable constraints.
 *  - Check updatability.
 *      - Enforced in above lookup (contract_instance_retrieval.pil (#[CONTRACT_INSTANCE_RETRIEVAL]) -> update_check.pil (#[UPDATE_CHECK])).
 *  - Derive the class id.
 *      - class_id = H(DOM_SEP__CONTRACT_CLASS_ID, artifact_hash, private_functions_root, bytecode_id (= public_bytecode_commitment))
 *      - Enforced by lookup into class_id_derivation.pil (#[CLASS_ID_DERIVATION]).
 *
 * The general idea is that, for each context, execution.pil refers to this trace to retrieve a bytecode for that context's address. As long as the bytecode exists
 * it proceeds to instruction fetching. This trace is responsible for proving success or failure of retrieval, whereas bytecode values themselves are accessed
 * in instr_fetching.pil (via bc_decomposition.pil).
 * Note: we don't need to silo and check the class id because the deployer contract guarantees that if a contract instance exists, the class has been registered.
 *
 * PRECONDITIONS: All tree state in this trace (transient bytecode, nullifier, and public state) matches that of the tx tree state at the start of the relevant call.
 * This is not enforced here; we rely on the execution trace to enforce that this circuit is looked up at the start of each context with the tx state (#[BYTECODE_RETRIEVAL_RESULT]).
 *
 * USAGE: Note for all lookups below: the correctness of bytecode_id (= public bytecode commitment) is not constrained in this trace, rather in
 * bc_hashing via a multipermutation with bc_decomposition.
 *
 * To enforce bytecode retrieval success (error == 0) or failure (error == 1):
 *     sel {
 *            id, address, error
 *     } in bc_retrieval.sel {
 *            bc_retrieval.bytecode_id, bc_retrieval.address, bc_retrieval.error
 *     };
 *
 * To enforce this against the current tree states (adapted from #[BYTECODE_RETRIEVAL_RESULT]):
 *     sel {
 *            id, address, error,
 *            nullifier_tree_root, public_data_tree_root,
 *            prev_retrieved_bytecodes_tree_root, prev_retrieved_bytecodes_tree_size,
 *            retrieved_bytecodes_tree_root, retrieved_bytecodes_tree_size
 *     } in bc_retrieval.sel {
 *            bc_retrieval.bytecode_id, bc_retrieval.address, bc_retrieval.error,
 *            bc_retrieval.nullifier_tree_root, bc_retrieval.public_data_tree_root,
 *            bc_retrieval.prev_retrieved_bytecodes_tree_root, bc_retrieval.prev_retrieved_bytecodes_tree_size,
 *            bc_retrieval.next_retrieved_bytecodes_tree_root, bc_retrieval.next_retrieved_bytecodes_tree_size
 *     };
 *
 * ERROR HANDLING:
 * Two errors need to be handled as part of this trace:
 * (1) !instance_exists: The contract at the given address is not deployed (instance_not_found_error in cpp),
 * (2) TOO_MANY_BYTECODES: We have reached the limit of the number of bytecodes to retrieve for this tx (limit_error in cpp). (TODO(MW) rename to one or other)
 *
 * In either case, this trace sets error == 1 and skips both class id derivation and insertion into the retrieved bytecodes tree. It additionally enforces that:
 *  - artifact_hash == 0
 *  - private_functions_root == 0
 *  - bytecode_id == 0
 *  - next_retrieved_bytecodes_tree_root == prev_retrieved_bytecodes_tree_root
 *  - next_retrieved_bytecodes_tree_size == prev_retrieved_bytecodes_tree_size
 * In other words, if an error occurs, we ensure contract class members and the bytecode id are all empty, and we do not progress the state
 * of the bytecode tree.
 * In case (1), where the instance does not exist, we also enforce that the class id is empty.
 *
 * TRACE SHAPE: This subtrace retrieves one bytecode instance per row, anchored by the bytecode_id column.
 *
 * INTERACTIONS:                                                  --> precomputed.pil
 *  execution.pil --> instr_fetching.pil --> bc_decomposition.pil <-> bc_hashing.pil
 *                --> bc_retrieval.pil --> contract_instance_retrieval.pil --> nullifier_check.pil
 *                                                                         --> address_derivation.pil
 *                                                                         --> update_check.pil
 *                                     --> retrieved_bytecodes_tree_check.pil
 *                                     --> class_id_derivation.pil
 * This trace is looked up by:
 * - execution.pil: To unconditionally retrieve the bytecode at execution.contract_address represented by execution.bytecode_id (#[BYTECODE_RETRIEVAL_RESULT]).
 *                  This lookup occurs at the first row of each context. It enforces that the tree states in context.pil match those here, and that any errors
 *                  are propagated to execution.sel_bytecode_retrieval_failure.
 *
 * This trace looks up:
 * - contract_instance_retrieval.pil: To constrain the existence or non-existence of the contract against the address and class id columns of this trace
 *                                    (#[CONTRACT_INSTANCE_RETRIEVAL]). Additionally links the state tree roots. This lookup is crucial since we defer the
 *                                    nullifier, address, and update checks to the contract instance retrieval trace.
 * - retrieved_bytecodes_tree_check.pil: If an instance exists, to constrain whether it is a new class id not yet accessed by this tx (#[IS_NEW_CLASS_CHECK]).
 *                                       If there is no error, to insert the class id into the retrieved bytecodes tree (#[RETRIEVED_BYTECODES_INSERTION]).
 *                                       These cases must form separate lookups to ensure we do not add to the tree when we have hit the bytecode limit.
 * - class_id_derivation.pil: If there is no error, to constrain correctness of the class id against the contract class member columns (artifact hash,
 *                            private functions root, and bytecode id) of this trace (#[CLASS_ID_DERIVATION]).
 *
*/

namespace bc_retrieval;

///////////////////////////////
// Set Up Columns
///////////////////////////////

pol commit sel; // @boolean
sel * (1 - sel) = 0;
// No relations will be checked if this identity is satisfied.
#[skippable_if]
sel = 0;

// If sel = 0, and it's not the first row, then all following rows should have sel = 0.
#[TRACE_CONTINUITY]
(1 - precomputed.first_row) * (1 - sel) * sel' = 0;

// This id is the bytecode commitment itself (bytecode_id == public_bytecode_commitment).
// Note: This is constrained in bc_hashing <-> bc_decomposition, where the latter is looked up via instr_fetching (#[BYTES_FROM_BC_DEC]).
pol commit bytecode_id;
// The contract address.
pol commit address;

// Contract instance members (See full contract instance struct at barretenberg/cpp/src/barretenberg/vm2/common/aztec_types.hpp).
pol commit current_class_id;

// Contract class members (See barretenberg/cpp/src/barretenberg/vm2/common/aztec_types.hpp).
pol commit artifact_hash;
pol commit private_functions_root;
// Note that bytecode_id is used as public_bytecode_commitment!

// Current states (Note: These should be looked up and constrained by the caller).
// Current state of the public data and nullifier trees.
pol commit public_data_tree_root;
pol commit nullifier_tree_root;
// Current state of the transient bytecodes tree.
pol commit prev_retrieved_bytecodes_tree_root;
pol commit prev_retrieved_bytecodes_tree_size;

// Next state of the transient bytecodes tree.
pol commit next_retrieved_bytecodes_tree_root;
pol commit next_retrieved_bytecodes_tree_size;

///////////////////////////////
// Contract Retrieval
///////////////////////////////

pol commit instance_exists; // @boolean (by lookup into contract_instance_retrieval)
// instance_exists is only on for active rows.
// TODO(MW): Added this to avoid switching on #[IS_NEW_CLASS_CHECK] for inactive rows but may not be required
#[SEL_ON_INSTANCE_EXISTS]
(1 - sel) * instance_exists = 0;

// This constrains the existence/non-existence of the contract. The contract_instance_retrieval circuit also
// constrains the required nullifier, address, and update checks (see above description for details).
#[CONTRACT_INSTANCE_RETRIEVAL]
sel {
    address,
    current_class_id,
    instance_exists,
    public_data_tree_root,
    nullifier_tree_root
} in contract_instance_retrieval.sel {
    contract_instance_retrieval.address,
    contract_instance_retrieval.current_class_id,
    contract_instance_retrieval.exists,
    contract_instance_retrieval.public_data_tree_root,
    contract_instance_retrieval.nullifier_tree_root
};

////////////////////////////////////////////////
// Error Handling
////////////////////////////////////////////////
//
// We have two errors to consider (see above ERROR HANDLING section in description for more details):
//  !instance_exists: Constrained above in #[CONTRACT_INSTANCE_RETRIEVAL], used below to toggle the error column
//                    and enforce that is_new_class is off and current_class_id is zero.
//  TOO_MANY_BYTECODES: Constrained below using prev_retrieved_bytecodes_tree_size, which itself is constrained in the execution trace
//                      (#[RETRIEVED_BYTECODES_TREE_SIZE_NOT_CHANGED] in execution.pil, #[RETRIEVED_BYTECODES_TREE_SIZE_CONTINUITY] in
//                      context.pil/tx_context.pil), and linked to this trace in #[BYTECODE_RETRIEVAL_RESULT]. It is used to toggle the
//                      error column.
// Switching on the error column forces the class members to be zero.

// Whether we have retrieved the bytecode for this class before (if not, is_new_class == 1 and we insert the bytecode into the tree).
pol commit is_new_class; // @boolean (by lookup into retrieved_bytecodes_tree_check when instance_exists == 1; constrained to be 0 when instance_exists == 0)

// Whether we have retrieved the maximum number of different bytecodes for this tx.
pol commit no_remaining_bytecodes; // @boolean
no_remaining_bytecodes * (1 - no_remaining_bytecodes) = 0;

// The tree size is 1 (AVM_RETRIEVED_BYTECODES_TREE_INITIAL_SIZE) + retrieved_bytecodes_count
pol REMAINING_BYTECODES = constants.MAX_PUBLIC_CALLS_TO_UNIQUE_CONTRACT_CLASS_IDS + constants.AVM_RETRIEVED_BYTECODES_TREE_INITIAL_SIZE - prev_retrieved_bytecodes_tree_size;
// no_remaining_bytecodes == 1 iff REMAINING_BYTECODES == 0
// We need the helper column for the inverse of REMAINING_BYTECODES: remaining_bytecodes_inv
pol commit remaining_bytecodes_inv; // @zero-check
#[NO_REMAINING_BYTECODES]
sel * (REMAINING_BYTECODES * (no_remaining_bytecodes * (1 - remaining_bytecodes_inv) + remaining_bytecodes_inv) - 1 + no_remaining_bytecodes) = 0;

// @boolean (by definition; no_remaining_bytecodes and is_new_class are constrained to be boolean)
pol TOO_MANY_BYTECODES = no_remaining_bytecodes * is_new_class;

// TODO(MW): Add INSTANCE_NOT_FOUND var (= 1 - instance_exists) for clarity/consistency with TOO_MANY_BYTECODES?

// We error if instance doesn't exist or if we have too many bytecodes.
pol commit error; // @boolean (by definition; sel, instance_exists, TOO_MANY_BYTECODES are all boolean)
#[ERROR_CHECK]
sel * (instance_exists * (1 - TOO_MANY_BYTECODES) - (1 - error)) = 0;

// Enforce is_new_class == 0 if the instance does not exist.
#[NEW_CLASS_IS_ZERO_IF_INSTANCE_DOES_NOT_EXIST]
sel * (1 - instance_exists) * is_new_class = 0;

// Enforce current_class_id == 0 if the instance does not exist.
#[CURRENT_CLASS_ID_IS_ZERO_IF_INSTANCE_DOES_NOT_EXIST]
sel * (1 - instance_exists) * current_class_id = 0;

// If class ID derivation is disabled (error), force other members to 0.
#[ARTIFACT_HASH_IS_ZERO_IF_ERROR]
error * (artifact_hash - 0) = 0;
#[PRIVATE_FUNCTION_ROOT_IS_ZERO_IF_ERROR]
error * (private_functions_root - 0) = 0;
#[BYTECODE_ID_IS_ZERO_IF_ERROR]
error * (bytecode_id - 0) = 0; // Off so we do not lookup into this trace against a valid id.

// On error, constrain next root and size to be the same as the previous ones.
#[RETRIEVED_BYTECODES_TREE_ROOT_NOT_CHANGED_IF_ERROR]
error * (next_retrieved_bytecodes_tree_root - prev_retrieved_bytecodes_tree_root) = 0;
#[RETRIEVED_BYTECODES_TREE_SIZE_NOT_CHANGED_IF_ERROR]
error * (next_retrieved_bytecodes_tree_size - prev_retrieved_bytecodes_tree_size) = 0;

pol commit should_retrieve; // @boolean (by definition; sel gating enforces zero on non-active rows)
should_retrieve = sel * (1 - error);

///////////////////////////////
// Class ID Derivation
///////////////////////////////

// This constrains the correctness of class id against the class members (see above description for details).
// Note: only need to derive the class id if the instance exists. TODO: Probably some latch is also needed.
// TODO(MW): I think the below is ok - class_id_derivation works over a single row with two lookups to poseidon
// anchored by the start and end rows with a matching result. We may need to add input_len to second lookup, but not relevant here.
#[CLASS_ID_DERIVATION]
should_retrieve {
  current_class_id,
  artifact_hash,
  private_functions_root,
  bytecode_id /*=public_bytecode_commitment*/
} in class_id_derivation.sel {
  class_id_derivation.class_id,
  class_id_derivation.artifact_hash,
  class_id_derivation.private_functions_root,
  class_id_derivation.public_bytecode_commitment
};

///////////////////////////////
// Bytecode Tree Read/Write
///////////////////////////////

// This constrains that is_new_class is on iff the bytecode does not exist in the tree.
#[IS_NEW_CLASS_CHECK]
instance_exists {
    current_class_id,
    is_new_class,
    prev_retrieved_bytecodes_tree_root
} in retrieved_bytecodes_tree_check.sel {
    retrieved_bytecodes_tree_check.class_id,
    retrieved_bytecodes_tree_check.leaf_not_exists,
    retrieved_bytecodes_tree_check.root
};

// This constrains that if we have retrieved bytecode for a new class, we update the tree correctly.
// Otherwise, it constrains we have /not/ updated the tree.
#[RETRIEVED_BYTECODES_INSERTION]
should_retrieve {
    current_class_id,
    should_retrieve, /*=1*/
    prev_retrieved_bytecodes_tree_root,
    prev_retrieved_bytecodes_tree_size,
    next_retrieved_bytecodes_tree_root,
    next_retrieved_bytecodes_tree_size
} in retrieved_bytecodes_tree_check.sel {
    retrieved_bytecodes_tree_check.class_id,
    retrieved_bytecodes_tree_check.write,
    retrieved_bytecodes_tree_check.root,
    retrieved_bytecodes_tree_check.tree_size_before_write,
    retrieved_bytecodes_tree_check.write_root,
    retrieved_bytecodes_tree_check.tree_size_after_write
};

