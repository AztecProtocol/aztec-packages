include "bc_decomposition.pil";

include "../constants_gen.pil";
include "../poseidon2_hash.pil";
include "../precomputed.pil";

/**
 * Bytecode hashing.
 *
 * Constrains that each bytecode's public bytecode commitment (bytecode_id) equals
 * the Poseidon2 hash of its packed field elements prepended with a domain-separated
 * length field. This is part of the infallible set of AVM operations: the prover must
 * produce a valid hash to satisfy the circuit.
 *
 * We fetch bytecode as packed field elements from bc_decomposition.pil.
 * A selector in bc_decomposition.pil is activated at pc == 0, 31, 62, ... for every
 * bytecode. In the bc_decomposition subtrace, we reconstruct the corresponding field
 * element. Finally, we copy through a multi-permutation based on the selector these
 * field elements to here (bc_hashing.pil) and then proceed to hashing.
 *
 * PRECONDITIONS:
 * - Bytecodes must be non-empty (empty bytecode would cause input_len - 2 to
 *   underflow in #[BYTECODE_LENGTH_FIELDS]).
 * - size_in_bytes < MAX_PACKED_PUBLIC_BYTECODE_SIZE_IN_FIELDS * 31 (enforced at the
 *   contract registration level, so the first-field computation does not overflow).
 *
 * TRACE SHAPE:
 * Variable-length: one row per Poseidon2 round, consuming 3 field inputs per row.
 * Each bytecode produces ceil((num_fields + 1) / 3) rows, where num_fields is the
 * number of 31-byte packed fields from bc_decomposition and +1 accounts for the
 * prepended domain separator | length field. Rows for a single bytecode are
 * contiguous, starting from row 2 (row 1 is a zero row for shifts). The first row
 * of each bytecode group has start = 1; the last has latch = 1.
 *
 * Example (p_f = packed_fields):
 *
 * bc_hash_0 = H([sep, 0x111, 0x222, 0x333, 0x444, 0x555, 0x666, 0x777])
 * bc_hash_1 = H([sep, 0xaaa, 0xbbb, 0xccc])
 *
 *   pc_index |  pc_index_1 |  pc_index_2 | bytecode_id |  p_f_0  |  p_f_1  |  p_f_2  |  output_hash  | latch | START | rounds_rem | padding |
 * -----------+-------------+-------------+-------------+---------+---------+---------+---------------+-------+-------+------------+---------+
 *     0      |      0      |      31     |      0      |   sep   |  0x111  |  0x222  |   bc_hash_0   |   0   |   1   |     3      |    0    |
 *     62     |      93     |      124    |      0      |  0x333  |  0x444  |  0x555  |   bc_hash_0   |   0   |   0   |     2      |    0    |
 *     155    |      186    |      217    |      0      |  0x666  |  0x777  |    0    |   bc_hash_0   |   1   |   0   |     1      |    1    |
 *     0      |      0      |      31     |      1      |   sep   |  0xaaa  |  0xbbb  |   bc_hash_1   |   0   |   1   |     2      |    0    |
 *     62     |      93     |      124    |      1      |  0xccc  |    0    |    0    |   bc_hash_1   |   1   |   0   |     1      |    2    |
 *
 * ERROR HANDLING:
 * This gadget does not have error conditions. Bytecode hashing is infallible — a hash
 * mismatch is an assertion failure in simulation and does not produce a trace row.
 *
 * INTERACTIONS:
 * - bc_decomposition.pil: #[BYTECODE_LENGTH_BYTES] (permutation) — fetches bytecode
 *   length from the decomposition start row.
 * - bc_decomposition.pil: #[GET_PACKED_FIELD_0/1/2] (multi-permutation) — fetches
 *   packed field elements at the corresponding pc indices.
 * - bc_decomposition.pil: #[CHECK_FINAL_BYTES_REMAINING] (lookup) — verifies the
 *   claimed final field is genuinely the last by checking remaining bytes < 31.
 * - poseidon2_hash.pil: #[POSEIDON2_HASH] (lookup) — delegates each round's inputs,
 *   length, round counter, and output to the Poseidon2 hash sub-trace.
 *
 * SECURITY NOTES:
 * Security assumptions depend on the Poseidon2 hash (intractable to find a meaningful
 * collision). The poseidon2_hash circuit propagates the final output_hash to each row
 * and constrains they are the same, chaining each round to the next.
 *
 * A prover can place the latch in any row and that value will test correctness of the
 * bytecode hash. We assume it is impossible, given inputs (i0, ..., iN), for the prover
 * to find a subsequence such that Hash(inputs) == Hash(subsequence).
 *
 * This trace relies on chaining and inc/decrementing of values per row, so the final
 * output_hash can only be considered correct once all values have been processed and
 * the final state checked. Lookups into this trace should always be gated by latch = 1.
 */
namespace bc_hashing;

    pol commit sel; // @boolean
    sel * (1 - sel) = 0;

    #[skippable_if]
    sel = 0;

    // ==== SELECTORS AND TRACE STRUCTURE ====

    // If the current row is not active, then there are no more active rows after that.
    // Note that sel cannot be activated in the first row as sel' is defined.
    // As a consequence, if a row is activated (sel == 1) somewhere in this sub-trace, then
    // the activated rows start from the second row and are contiguous.
    #[TRACE_CONTINUITY]
    (1 - precomputed.first_row) * (1 - sel) * sel' = 0;

    // Signifies the row that contains the final bytecode hash for this bytecode_id.
    // The prover can decide where to place this latch.
    pol commit latch; // @boolean
    latch * (1 - latch) = 0;

    // latch == 1 ==> sel == 1
    #[SEL_TOGGLED_AT_LATCH]
    latch * (1 - sel) = 0;

    // Given both latch and first_row are boolean and that latch cannot be activated at first row (sel would have
    // to be activated which is impossible on first row), LATCH_CONDITION is a boolean.
    pol LATCH_CONDITION = latch + precomputed.first_row;

    // The start of a new bytecode id and new set of hashing runs.
    pol commit start; // @boolean
    start * (1 - start) = 0;

    // Committed because it is used as a permutation selector in #[GET_PACKED_FIELD_0].
    pol commit sel_not_start; // @boolean (by definition)
    sel_not_start = sel * (1 - start);

    // If the current row is a latch or the first row, the next row should be a start (if it's active):
    #[START_AFTER_LATCH]
    sel' * (start' - LATCH_CONDITION) = 0;

    // ==== PC INDEX PROGRESSION ====

    pol commit pc_index, pc_index_1, pc_index_2;

    // The PC increments by 31*3=93 each row as long as:
    // a) the row is not latched, in which case the next pc is zero
    // b) we are not at start, in which case we only read 2 fields, and => only increment pc by 31*2=62
    #[PC_INCREMENTS]
    sel' * (pc_index' - ((1 - LATCH_CONDITION) * (62 + pc_index + sel_not_start * 31))) = 0;

    // At start, pc_index_1 == pc_index (same row; field 0 is the separator, field 1 is the first
    // bytecode field at pc == 0). Otherwise, pc_index_1 == pc_index + 31.
    #[PC_INCREMENTS_1]
    sel * (pc_index_1 - start * pc_index - sel_not_start * (pc_index + 31)) = 0;

    // pc_index_2 is always 31 bytes after pc_index_1.
    #[PC_INCREMENTS_2]
    sel * (pc_index_2 - (pc_index_1 + 31)) = 0;

    // ==== BYTECODE ID ====

    // bytecode_id is freely chosen by the prover at start rows. It is constrained to equal
    // output_hash on every active row (#[HASH_IS_ID]), which is in turn constrained by the
    // Poseidon2 lookup (#[POSEIDON2_HASH]). Between start and latch, the id is propagated unchanged:
    pol commit bytecode_id;
    #[ID_PROPAGATION]
    (1 - LATCH_CONDITION) * (bytecode_id' - bytecode_id) = 0;

    // ==== PACKED FIELDS AND FIRST FIELD ====

    // We need 3 packed fields to use as inputs for each Poseidon2 round.
    pol commit packed_fields_0, packed_fields_1, packed_fields_2;

    // Only constrained at start for the prepended field (free on other rows; constrained by lookups below):
    pol commit size_in_bytes;

    // Fetch the bytecode length in bytes from bc_decomposition at start.
    #[BYTECODE_LENGTH_BYTES]
    start { precomputed.zero, bytecode_id, size_in_bytes }
    is
    bc_decomposition.start { bc_decomposition.pc, bc_decomposition.id, bc_decomposition.bytes_remaining };

    // At the start of a new bytecode hash, the initial field has to be the size appended to the
    // separator, and we skip the lookup fetching a field from decomposition.
    // NOTE: size_in_bytes is constrained to be less than MAX_PACKED_PUBLIC_BYTECODE_SIZE_IN_FIELDS
    // (= 3000) * 31 at the contract registration level, so the below does not overflow.
    pol FIRST_FIELD = constants.DOM_SEP__PUBLIC_BYTECODE + size_in_bytes * 2**32;

    #[START_IS_FIRST_FIELD]
    start * (packed_fields_0 - FIRST_FIELD) = 0;

    // ==== PACKED FIELD LOOKUPS ====

    // Fetch packed field elements from bc_decomposition via multi-permutation.
    // Each round consumes 3 fields at pc_index, pc_index_1, pc_index_2. Field 0 is
    // skipped at start (where it is forced to the separator via #[START_IS_FIRST_FIELD]).
    // Fields 1 and 2 are skipped when they are padding (sel_not_padding_X = 0).
    #[GET_PACKED_FIELD_0]
    sel_not_start { pc_index, bytecode_id, packed_fields_0 }
    is
    bc_decomposition.sel_packed_read[0] { bc_decomposition.pc, bc_decomposition.id, bc_decomposition.packed_field };

    #[GET_PACKED_FIELD_1]
    sel_not_padding_1 { pc_index_1, bytecode_id, packed_fields_1 }
    is
    bc_decomposition.sel_packed_read[1] { bc_decomposition.pc, bc_decomposition.id, bc_decomposition.packed_field };

    #[GET_PACKED_FIELD_2]
    sel_not_padding_2 { pc_index_2, bytecode_id, packed_fields_2 }
    is
    bc_decomposition.sel_packed_read[2] { bc_decomposition.pc, bc_decomposition.id, bc_decomposition.packed_field };

    // ==== PADDING ====

    // We lookup the Poseidon2 inputs in chunks of 3 (to match the permutation width), so if the
    // total number of fields hashed is not a multiple of 3, we have some padding field values (= 0).
    // These would fail the lookups into bc_decomposition, so they are gated by sel_not_padding_X.
    // Note: packed_fields_0 must never be a padding value; padding can only occur at the last row
    // (i.e. latch = 1).

    // Committed because they are used as permutation selectors in #[GET_PACKED_FIELD_1/2].
    pol commit sel_not_padding_1; // @boolean
    pol commit sel_not_padding_2; // @boolean
    sel_not_padding_1 * (1 - sel_not_padding_1) = 0;
    sel_not_padding_2 * (1 - sel_not_padding_2) = 0;

    // Force sel_not_padding_X to 0 when sel is 0 (prevents ghost row injection attacks).
    #[SEL_NOT_PADDING_REQUIRES_SEL]
    (sel_not_padding_1 + sel_not_padding_2) * (1 - sel) = 0;
    // It follows that `sel * sel_not_padding_i == sel_not_padding_i` and
    // `sel * (1 - sel_not_padding_i) == sel - sel_not_padding_i`.

    // PADDING_1 == 1 <==> packed_fields[1] is a padding value ==> (see #[PADDING_CONSISTENCY]) PADDING_2 == 1
    pol PADDING_1 = sel - sel_not_padding_1;
    // PADDING_2 == 1 <==> packed_fields[2] is a padding value <==> we have any padded values
    pol PADDING_2 = sel - sel_not_padding_2;

    // If packed_fields[1] is a padding value, packed_fields[2] must also be a padding value:
    // PADDING_1 == 1 ==> PADDING_2 == 1
    #[PADDING_CONSISTENCY]
    PADDING_1 * sel_not_padding_2 = 0;

    // PADDING_2 == 1 ==> latch == 1
    #[PADDING_END]
    PADDING_2 * (1 - latch) = 0;

    // PADDING_1 == 1 ==> packed_fields_1 == 0
    #[PADDED_BY_ZERO_1]
    PADDING_1 * packed_fields_1 = 0;

    // PADDING_2 == 1 ==> packed_fields_2 == 0
    #[PADDED_BY_ZERO_2]
    PADDING_2 * packed_fields_2 = 0;

    // ==== FINAL FIELD VERIFICATION ====

    // Value of bc_decomposition.pc at the final field. Only meaningful at latch rows (can be 0 on
    // other rows). Committed because it is used in the #[CHECK_FINAL_BYTES_REMAINING] lookup.
    pol commit pc_at_final_field;

    // The decomp trace relies on decrementing counters. Instead of using range checks to show that
    // we are at the last field (<==> bc_decomposition.bytes_remaining is within expected), we check
    // that at the claimed final field (i.e. final occurrence of sel_packed = 1 in bc_decomp), we
    // have less than 31 bytes remaining.
    //
    // In decomp: sel_windows_gt_remaining = 1 if bytes_remaining < WINDOW_SIZE.
    // Currently, WINDOW_SIZE = 37 and we encode 31 bytes into each packed field => if
    // sel_windows_gt_remaining = 1 && bytes_pc_plus_31..bytes_pc_plus_36 are all zero,
    // then we have no further fields to hash.
    //
    // Example: bytecode of 80 bytes => hash 3 fields + 1 for sep => 2 rows, final row has padding
    // of 2:
    //   pc_index = 62, packed_fields_0 = final field, packed_fields_1 = padding = 0,
    //   packed_fields_2 = padding = 0
    // We want to show packed_fields_0 is the last field of the bytecode (=> our padding is correct).
    // In bc_decomposition at pc_index = 62:
    //   sel_packed = 1, packed_field = final field, bytes_remaining = 18
    // To avoid using gt/range check to show bytes_remaining < 32, we instead lookup that
    // sel_windows_gt_remaining = 1 (<==> bytes_remaining < 37) and bytes_pc_plus_31 through
    // bytes_pc_plus_36 are empty.
    //
    // NOTE: This relies on the hardcoded WINDOW_SIZE = 37 and WILL BREAK if this ever changes!
    // ASIDE NOTE: A simpler solution would be to lookup that at pc_index - 6 we have
    // sel_windows_gt_remaining = 1 in bc_decomposition, but this would underflow if we have a
    // bytecode of under 2 fields (pc_index = 0).
    #[CHECK_FINAL_BYTES_REMAINING]
    latch {
        pc_at_final_field,
        bytecode_id,
        sel /* =1 */,
        precomputed.zero /* =0 */,
        precomputed.zero /* =0 */,
        precomputed.zero /* =0 */,
        precomputed.zero /* =0 */,
        precomputed.zero /* =0 */,
        precomputed.zero /* =0 */
    } in bc_decomposition.sel_packed {
        bc_decomposition.pc,
        bc_decomposition.id,
        bc_decomposition.sel_windows_gt_remaining,
        bc_decomposition.bytes_pc_plus_31,
        bc_decomposition.bytes_pc_plus_32,
        bc_decomposition.bytes_pc_plus_33,
        bc_decomposition.bytes_pc_plus_34,
        bc_decomposition.bytes_pc_plus_35,
        bc_decomposition.bytes_pc_plus_36
    };

    // When PADDING_1 = 1 & PADDING_2 = 1: pc_at_final_field = pc_index       (final_bytes_remaining <= 31)
    // When PADDING_1 = 0 & PADDING_2 = 1: pc_at_final_field = pc_index_1     (31 < final_bytes_remaining <= 62)
    // When PADDING_1 = 0 & PADDING_2 = 0: pc_at_final_field = pc_index_2     (62 < bytes_remaining <= 93)
    // TODO: Technically when we have no padding (PADDING_2 = 0) we don't need to check the below
    // because the decomp lookups cover us. However, this does constrain that when latch == 1, we are
    // definitely at the last field of bc_decomp, I'm not sure whether this is required but kept in
    // just in case.
    #[PADDING_CORRECTNESS]
    pc_at_final_field - latch * (
        PADDING_1 * pc_index +            // two padding fields ==> pc_at_final_field = pc_index
        (PADDING_2 - PADDING_1) * pc_index_1 + // one padding field ==> pc_at_final_field = pc_index_1
        sel_not_padding_2 * pc_index_2    // no padding ==> pc_at_final_field = pc_index_2
    ) = 0;

    // ==== LENGTH AND ROUND COUNTING ====

    // The length of the hashed bytecode in fields, including the prepended field. We use it to look
    // up into poseidon2_hash to ensure that the hashed IV matches our bytecode length.
    // Note: We constrain `input_len` at the final row (latch) by linking it to pc_at_final_field,
    //       but correct usage of `poseidon2_hash` requires us to constrain it at the start row.
    //       Therefore, we will constrain propagation of `input_len` on all rows of the computation.
    pol commit input_len;

    // Minus one for the initial field not present in bc_decomposition, and one to include the final
    // field (pc_at_final_field marks the beginning of the last field).
    // Note: this doesn't underflow as we don't handle empty bytecode (see PRECONDITIONS).
    #[BYTECODE_LENGTH_FIELDS]
    latch * (31 * (input_len - 2) - pc_at_final_field) = 0;

    #[INPUT_LEN_PROPAGATION]
    (1 - LATCH_CONDITION) * (input_len' - input_len) = 0;

    // The number of rounds (rows) remaining to completely hash the bytecode.
    // Like input_len, its correctness is constrained at the final row (latch), where (due to
    // #[CHECK_FINAL_BYTES_REMAINING] and #[PADDING_CORRECTNESS]) we know we have reached the end of
    // bytecode processed by bc_decomposition and we must have decremented uniformly until this point.
    // We use it to ensure the ordering of Poseidon2 rounds is correct (i.e. a malicious prover
    // cannot swap the order of poseidon rounds).
    // (Note that we don't need to constrain this vs input_len because a. input_len is checked vs the
    // incrementing pc values at latch and b. the poseidon2_hash trace we lookup into links these
    // values anyway.)
    pol commit rounds_rem;

    // The rounds remaining decrement by 1 each row, and must equal 1 at the latch row.
    // The two branches are combined into one expression:
    //   When latch == 0 (and not first_row): rounds_rem' == rounds_rem - 1
    //   When latch == 1:                     rounds_rem == 1
    // Both are gated by sel to leave inactive rows unconstrained.
    #[ROUNDS_DECREMENT]
    sel * ((1 - LATCH_CONDITION) * (rounds_rem' - rounds_rem + 1) + latch * (rounds_rem - 1)) = 0;

    // ==== HASH OUTPUT ====

    pol commit output_hash;

    // Since we constrain the id the same for each row (#[ID_PROPAGATION]) and id == output_hash
    // below, there is no need for a separate HASH_PROPAGATION constraint.
    // Note that we must constrain the below at *each row* to ensure that poseidon rows from different
    // hashing traces (i.e. mismatched output_hash, matching tuple of inputs and length) are not
    // inserted maliciously:
    #[HASH_IS_ID]
    sel * (bytecode_id - output_hash) = 0;

    // Delegate the actual Poseidon2 computation to poseidon2_hash.pil. Each active row maps to one
    // permutation round, sending the 3 inputs, the total input length, the remaining round count,
    // and the expected output hash. This is what ultimately constrains that output_hash
    // (== bytecode_id) is the correct Poseidon2 hash of the packed fields.
    #[POSEIDON2_HASH]
    sel {
        start,
        latch,
        packed_fields_0,
        packed_fields_1,
        packed_fields_2,
        input_len,
        rounds_rem,
        output_hash
    } in poseidon2_hash.sel {
        poseidon2_hash.start,
        poseidon2_hash.end,
        poseidon2_hash.input_0,
        poseidon2_hash.input_1,
        poseidon2_hash.input_2,
        poseidon2_hash.input_len,
        poseidon2_hash.num_perm_rounds_rem,
        poseidon2_hash.output
    };

    // ==== PROOF SKETCH ====
    //
    // We want to show that the output_hash correctly enforces that it is the result of hashing
    // the bytes of a given bytecode identified by bytecode_id. Thanks to #[TRACE_CONTINUITY] and
    // #[SEL_TOGGLED_AT_LATCH], we have the guarantee that the rows above the final latch are
    // activated. If they are activated, then bytecode_id is maintained and pc_index decrements by
    // 31 * 3 = 93 when we move to the top. From #[START_AFTER_LATCH], we have the guarantee that
    // we cannot meet a row with latch == 1 before we meet start == 1 when we go up. This shows
    // that bytecode_id, pc_index, and incremental_hash evolution did not deviate from the happy path.
    //
    // When we reach a row with start == 1 (we know we must reach one thanks to #[START_AFTER_LATCH]
    // enforcing it on the second row), then #[START_IS_FIRST_FIELD] implies that pc_index and
    // packed_fields are correctly initialized. Note also that thanks to #[TRACE_CONTINUITY] and
    // #[GET_PACKED_FIELD_i] we retrieved packed_field_i at the right pc_index_i from the
    // bc_decomposition sub-trace.
    //
    // We remark that before reaching another latch, a prover might add additional rows without
    // latch on top of the start or even add a row with start == 1. This does not have any security
    // impact as what matters is the guarantee to have a correct initialization at start. What is
    // more, having a row without latch on top of the start would mean that a Poseidon2 pre-image
    // for a small integer (bytes_remaining) must have been found.
