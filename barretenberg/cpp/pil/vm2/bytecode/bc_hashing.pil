include "bc_decomposition.pil";

include "../constants_gen.pil";
include "../poseidon2_hash.pil";
include "../precomputed.pil";

/**
 * Bytecode hashing.
 *
 * Constrains that each bytecode's public bytecode commitment (bytecode_id) equals
 * the Poseidon2 hash of its packed field elements prepended with a domain-separated
 * length field. This is part of the infallible set of AVM operations: the prover must
 * produce a valid hash to satisfy the circuit.
 *
 * We fetch bytecode as packed field elements from bc_decomposition.pil.
 * A selector in bc_decomposition.pil is activated at pc == 0, 31, 62, ... for every
 * bytecode. When this selector is on, we reconstruct the corresponding field
 * element in the subtrace. Finally, we copy these field elements through a
 * multi-permutation based on the selector to here and then proceed to hashing.
 *
 * In this subtrace, each computation block (per bytecode) lays out the "packed fields"
 * obtained from bc_decomposition.pil over 3 columns: packed_fields_0, packed_fields_1, packed_fields_2.
 * On each row, we also constrain the associated pc indices (pc_index, pc_index_1, pc_index_2)
 * to be incremented by 31 in a rotation, starting with pc_index_1 because the
 * first field is the separator. Layout is:
 * ROW    pc_index, pc_index_1, pc_index_2
 *  1          0         0           31
 *  2         62        93          124
 *  3        155       186          217 ...
 *
 * Each computation block is constrained to have the same bytecode_id and therefore,
 * the multi-permutation enforces that the packed fields from one block in bc_decomposition.pil
 * are kept together in the same block in bc_hashing.pil. Strictly speaking we do not constrain
 * in bc_decomposition.pil nor in this trace that each block has a different bytecode_id but
 * if this happens we have the guarantee that the packed fields and `size_in_bytes` (part of
 * the initial field) are the same for all blocks with the same bytecode_id. This is guaranteed
 * by the collision resistance of Poseidon2.
 *
 * PRECONDITIONS:
 * - size_in_bytes < 2^232 (enforced at the contract registration level,
 *   that MAX_PACKED_PUBLIC_BYTECODE_SIZE_IN_FIELDS = 3000 anyway).
 *
 * TRACE SHAPE:
 * Variable-length: one row per Poseidon2 round, consuming 3 field inputs per row.
 * Each bytecode produces ceil((num_fields + 1) / 3) rows, where num_fields is the
 * number of 31-byte packed fields from bc_decomposition and +1 accounts for the
 * prepended domain separator | length field. Rows for a single bytecode are
 * contiguous, starting from the second row (the first row is a zero row for shifts).
 * The first row of each bytecode group has `start == 1`; the last has `end == 1`.
 *
 * Example (p_f = packed_fields):
 *
 * bc_hash_0 = H([sep, 0x111, 0x222, 0x333, 0x444, 0x555, 0x666, 0x777])
 * bc_hash_1 = H([sep, 0xaaa, 0xbbb, 0xccc])
 *
 *   pc_index |  pc_index_1 |  pc_index_2 | bytecode_id |  p_f_0  |  p_f_1  |  p_f_2  | end   | start | rounds_rem | padding | input_len |
 * -----------+-------------+-------------+-------------+---------+---------+---------+-------+-------+------------+---------+-----------+
 *     0      |      0      |      31     |  bc_hash_0  |   sep   |  0x111  |  0x222  |   0   |   1   |     3      |    1    |     8     |
 *     62     |      93     |      124    |  bc_hash_0  |  0x333  |  0x444  |  0x555  |   0   |   0   |     2      |    1    |    unc    |
 *     155    |      186    |      217    |  bc_hash_0  |  0x666  |  0x777  |    0    |   1   |   0   |     1      |    1    |    unc    |
 *     0      |      0      |      31     |  bc_hash_1  |   sep   |  0xaaa  |  0xbbb  |   0   |   1   |     2      |    2    |     4     |
 *     62     |      93     |      124    |  bc_hash_1  |  0xccc  |    0    |    0    |   1   |   0   |     1      |    2    |    unc    |
 *
 * ERROR HANDLING:
 * This gadget does not have error conditions. Bytecode hashing is infallible — a hash
 * mismatch is an assertion failure in simulation and does not produce a trace row.
 *
 * INTERACTIONS:
 * Downstream:
 * - bc_decomposition.pil: #[BYTECODE_LENGTH_BYTES] (permutation) — fetches bytecode
 *   length from the decomposition start row.
 * - bc_decomposition.pil: #[GET_PACKED_FIELD_0/1/2] (multi-permutation) — fetches
 *   packed field elements at the corresponding pc indices.
 * - poseidon2_hash.pil: #[POSEIDON2_HASH] (lookup) — delegates each round's inputs,
 *   length, round counter, and output to the Poseidon2 hash sub-trace.
 *
 * Upstream:
 * The only upstream trace interacting with bc_hashing.pil is bc_decomposition.pil through the permutations
 * mentioned above. At high level, the execution trace retrieves bytecode_id from bc_retrieval.pil and
 * then by proceeding to instruction fetching, triggers the following interaction path:
 * execution.pil --> instr_fetching.pil --> bc_decomposition.pil <-> bc_hashing.pil --> poseidon2_hash.pil
 *
 * SECURITY NOTES:
 * Security assumptions depend on the Poseidon2 hash (intractable to find a meaningful
 * collision) so that if the bytecode_id is correct, then the computation block (all rows
 * between start and end) contains the correct packed fields and size_in_bytes corresponding
 * to `bytecode_id`.
 *
 */
namespace bc_hashing;

    pol commit sel; // @boolean
    sel * (1 - sel) = 0;

    #[skippable_if]
    sel = 0;

    // ==== MULTI-ROW COMPUTATION SELECTORS ====
    // See recipe: https://github.com/AztecProtocol/aztec-packages/blob/next/barretenberg/cpp/pil/vm2/docs/recipes.md#contiguous-multi-rows-computation-trace

    pol commit start; // @boolean
    start * (1 - start) = 0;
    pol commit end; // @boolean
    end * (1 - end) = 0;

    pol LATCH_CONDITION = end + precomputed.first_row;

    // If start or end is active, sel must be active.
    #[SEL_ON_START_OR_END]
    (start + end) * (1 - sel) = 0;

    // sel is continuous within a computation block: it cannot change except at a latch.
    #[TRACE_CONTINUITY]
    (1 - LATCH_CONDITION) * (sel - sel') = 0;

    // A new computation block must start immediately after a latch.
    #[START_AFTER_LATCH]
    sel' * (start' - LATCH_CONDITION) = 0;

    // Committed because it is used as a permutation selector in #[GET_PACKED_FIELD_0].
    pol commit sel_not_start; // @boolean (by definition)
    sel_not_start = sel - start;
    // Note that from  #[SEL_ON_START_OR_END], we have `start * (1 - sel) == 0` which is
    // equivalent to `sel * start == start` and therefore
    // `sel_not_start == sel * (1 - start) == sel - start`

    // ==== PC INDEX PROGRESSION ====

    pol commit pc_index, pc_index_1, pc_index_2;

    // The PC increments by 31*3=93 each row as long as:
    // a) the row is not latched, in which case the next pc is zero
    // b) we are not at start, in which case we only read 2 fields, and => only increment pc by 31*2=62
    // See the layout depicted at the top of the file.

    // pc_index is zero at start, otherwise it 31 less than pc_index_1.
    #[PC_INCREMENTS]
    pc_index = sel_not_start * (pc_index_1 - 31);

    // pc_index_1 is always a multiple of 93, i.e., starts at zero and increments by 93 each row.
    #[PC_INCREMENTS_1]
    pc_index_1' = sel_not_start' * (pc_index_1 + 93);

    // pc_index_2 is always 31 bytes after pc_index_1.
    #[PC_INCREMENTS_2]
    sel * (pc_index_2 - (pc_index_1 + 31)) = 0;

    // ==== BYTECODE ID ====

    // bytecode_id is freely chosen by the prover at start rows. It is constrained to be the correct
    // Poseidon2 hash through the Poseidon2 lookup (#[POSEIDON2_HASH]).
    // Between start and end, the bytecode_id is propagated unchanged:
    pol commit bytecode_id;
    #[ID_PROPAGATION]
    (1 - LATCH_CONDITION) * (bytecode_id' - bytecode_id) = 0;

    // ==== PACKED FIELDS AND FIRST FIELD ====

    // We need 3 packed fields to use as inputs for each Poseidon2 round.
    pol commit packed_fields_0, packed_fields_1, packed_fields_2;

    // Only constrained at start for the prepended field (free on other rows; constrained by the permutations below):
    pol commit size_in_bytes;

    // Fetch the bytecode length in bytes from bc_decomposition at start.
    #[BYTECODE_LENGTH_BYTES]
    start { precomputed.zero, bytecode_id, size_in_bytes }
    is
    bc_decomposition.start { bc_decomposition.pc, bc_decomposition.id, bc_decomposition.bytes_remaining };

    // At the start of a new bytecode hash, the initial field has to be the size appended to the
    // separator, and we skip the lookup fetching a field from decomposition.
    // NOTE: size_in_bytes is constrained to be less than MAX_PACKED_PUBLIC_BYTECODE_SIZE_IN_FIELDS
    // (= 3000) * 31 at the contract registration level, so the below does not overflow.
    pol FIRST_FIELD = constants.DOM_SEP__PUBLIC_BYTECODE + size_in_bytes * 2**32;

    #[START_IS_FIRST_FIELD]
    start * (packed_fields_0 - FIRST_FIELD) = 0;

    // ==== PACKED FIELD MULTI-PERMUTATION ====

    // Fetch the packed field elements from bc_decomposition via multi-permutation.
    // Each round consumes 3 fields at pc_index, pc_index_1, pc_index_2. Field 0 is
    // skipped at start (where it is forced to be the separator via #[START_IS_FIRST_FIELD]).
    // Fields 1 and 2 are skipped when they are padding (sel_not_padding_X = 0).
    #[GET_PACKED_FIELD_0]
    sel_not_start { pc_index, bytecode_id, packed_fields_0 }
    is
    bc_decomposition.sel_packed_read[0] { bc_decomposition.pc, bc_decomposition.id, bc_decomposition.packed_field };

    #[GET_PACKED_FIELD_1]
    sel_not_padding_1 { pc_index_1, bytecode_id, packed_fields_1 }
    is
    bc_decomposition.sel_packed_read[1] { bc_decomposition.pc, bc_decomposition.id, bc_decomposition.packed_field };

    #[GET_PACKED_FIELD_2]
    sel_not_padding_2 { pc_index_2, bytecode_id, packed_fields_2 }
    is
    bc_decomposition.sel_packed_read[2] { bc_decomposition.pc, bc_decomposition.id, bc_decomposition.packed_field };

    // ==== PADDING ====

    // We lookup the Poseidon2 inputs in chunks of 3 (to match the permutation width), so if the
    // total number of fields hashed is not a multiple of 3, we have some padding field values (= 0).
    // These would fail the lookups into bc_decomposition, so they are gated by sel_not_padding_X.
    // Note: packed_fields_0 must never be a padding value; padding can only occur at the last row
    // (i.e. end = 1).

    // Committed because they are used as permutation selectors in #[GET_PACKED_FIELD_1/2].
    pol commit sel_not_padding_1; // @boolean
    pol commit sel_not_padding_2; // @boolean
    sel_not_padding_1 * (1 - sel_not_padding_1) = 0;
    sel_not_padding_2 * (1 - sel_not_padding_2) = 0;

    // Force sel_not_padding_X to 0 when sel is 0 (prevents ghost row injection attacks).
    #[SEL_NOT_PADDING_REQUIRES_SEL]
    (sel_not_padding_1 + sel_not_padding_2) * (1 - sel) = 0;
    // It follows that `sel * sel_not_padding_i == sel_not_padding_i` and
    // `sel * (1 - sel_not_padding_i) == sel - sel_not_padding_i`.

    // PADDING_1 == 1 <==> packed_fields[1] is a padding value ==> (see #[PADDING_CONSISTENCY]) PADDING_2 == 1
    pol PADDING_1 = sel - sel_not_padding_1;
    // PADDING_2 == 1 <==> packed_fields[2] is a padding value <==> we have any padded values
    pol PADDING_2 = sel - sel_not_padding_2;

    // If packed_fields[1] is a padding value, packed_fields[2] must also be a padding value:
    // PADDING_1 == 1 ==> PADDING_2 == 1
    #[PADDING_CONSISTENCY]
    PADDING_1 * sel_not_padding_2 = 0;

    // PADDING_2 == 1 ==> end == 1
    #[PADDING_END]
    PADDING_2 * (1 - end) = 0;

    // Note: #[PADDING_CONSISTENCY] and #[PADDING_END] are not strictly necessary because
    // they should inherit from the constraints on bc_decomposition.pc. However, these
    // 2 constraints are very cheap and allow the correct layout of the "pc_indices" to be
    // self-contained within this trace.

    // When we have a padding field, the corresponding packed field is not retrieved from the
    // multi-permutation. We therefore need to constrain a padding field to be zero to feed
    // poseidon2_hash.pil with the correct inputs because poseidon2_hash.pil does not constrain
    // that padded fields == 0. Otherwise, a malicious prover could compute a wrong bytecode_id.
    // PADDING_1 == 1 ==> packed_fields_1 == 0
    #[PADDED_BY_ZERO_1]
    PADDING_1 * packed_fields_1 = 0;

    // PADDING_2 == 1 ==> packed_fields_2 == 0
    #[PADDED_BY_ZERO_2]
    PADDING_2 * packed_fields_2 = 0;

    // We compute the number of padding fields and propagate it to the `start` row in order
    // to correctly constrain the `input_len` at the start row. (see #[BYTECODE_LENGTH_FIELDS] below).
    pol commit padding; // Takes a value in {0, 1, 2}.
    #[PADDING_COMPUTATION]
    end * (padding - PADDING_1 - PADDING_2) = 0;

    #[PADDING_PROPAGATION]
    (1 - LATCH_CONDITION) * (padding' - padding) = 0;

    // ==== LENGTH AND ROUND COUNTING ====

    // The number of rounds (rows) remaining to completely hash the bytecode.
    // This is required by poseidon2_hash.pil to ensure the ordering of Poseidon2 rounds is correct.
    // Note that #[BYTECODE_LENGTH_FIELDS] links `rounds_rem` to `input_len` at the start row.
    // Furthermore, the poseidon2_hash trace we lookup into links these values anyway.
    pol commit rounds_rem;

    // The length of the hashed bytecode in fields, including the prepended field. We use it to look
    // up into poseidon2_hash to ensure that the hashed IV matches our bytecode length.
    // Note: poseidon2_hash.pil usage requires us to pass `input_len` to the lookup at the start row.
    //       We constrain `input_len` at the start row by linking it to padding value and `rounds_rem`.
    pol commit input_len;

    // Alternatively, we could have constrained `input_len` based on `size_in_bytes` but this
    // would have required some more costly range checks.
    #[BYTECODE_LENGTH_FIELDS]
    start * (3 * rounds_rem - padding - input_len) = 0;

    // The rounds remaining decrement by 1 each row, and must equal 1 at the end row.
    // The two branches are combined into one expression:
    //   When end == 0 (and active row): rounds_rem == rounds_rem' + 1
    //   When end == 1:                  rounds_rem == 1
    // From #[SEL_ON_START_OR_END] we have `sel * end == end` and thus `sel * (1 - end) == sel - end`.
    #[ROUNDS_DECREMENT]
    rounds_rem = end + (sel - end) * (rounds_rem' + 1);

    // ==== HASH OUTPUT ====

    // Delegate the actual Poseidon2 computation to poseidon2_hash.pil. Each active row maps to one
    // permutation round, sending the 3 inputs, the total input length, the remaining round count,
    // and the expected output hash. This is what ultimately constrains that
    // bytecode_id is the correct Poseidon2 hash of the packed fields.
    #[POSEIDON2_HASH]
    sel {
        start,
        end,
        packed_fields_0,
        packed_fields_1,
        packed_fields_2,
        input_len,
        rounds_rem,
        bytecode_id
    } in poseidon2_hash.sel {
        poseidon2_hash.start,
        poseidon2_hash.end,
        poseidon2_hash.input_0,
        poseidon2_hash.input_1,
        poseidon2_hash.input_2,
        poseidon2_hash.input_len,
        poseidon2_hash.num_perm_rounds_rem,
        poseidon2_hash.output
    };
