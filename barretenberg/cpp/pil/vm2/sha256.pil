include "bitwise.pil";
include "precomputed.pil";
include "range_check.pil";
include "constants_gen.pil";
include "sha256_mem.pil";

/**
 * SHA-256 Compression Subtrace
 *
 * Virtual sub-trace to sha256_mem.pil
 *
 * This subtrace performs the Sha256 Compression function on a set of given inputs.
 * All input values are assumed to be range checked to 32-bits by the calling function
 * (i.e. inputs come from the sha256_mem.pil). Outputs values are guaranteed to be 32-bits
 * by this subtrace. To simulate modulo operations we use the convention lhs_a and rhs_a to
 * indicate the big-endian decomposition of a value `a`, there lhs_a is the MSB while
 * rhs_a is the LSB.
 *
 * TRACE SHAPE, ERROR HANDLING, ETC..:
 * See sha256_mem.pil header for detailed error handling, trace diagrams, and temporality groups.
 *
 * INTERACTIONS:
 * - As destination: execution.pil dispatches into this component via a permutation on `start`.
 *   See sha256_mem.pil header for the full USAGE block (tuple, selector, column roles).
 * - As source: this file looks up into:
 *   - range_check.sel_sha256: range checks for rotation limbs and modular addition limbs.
 *     Tuple: { value, rng_chk_bits }; range_check enforces `0 <= value < 2^rng_chk_bits`.
 *   - bitwise.sel_sha256: XOR and AND operations for compression computation.
 *     Tuple: { input_a, input_b, output_c, op_id, tag_a, tag_b }.
 *     Note: tag_a and tag_b are both passed u32_tag since inputs are known to share the same tag;
 *     duplicating the tag makes the source tuple match the (tag_a, tag_b) pair on the destination.
 *   - precomputed.sel_sha256_compression: round constant lookup by round index.
 *     Tuple: { round_index, constant }.
 *
 * NOTE_ON_ROTATIONS
 * Given a positive integer a < 32, we want to compute Y = X `rotr` a.
 * Decompose X = lhs * 2^a + rhs. The rotation result is Y = rhs * 2^(32-a) + lhs.
 * We algebraically eliminate lhs by substituting lhs = Y - rhs * 2^(32-a) into the
 * decomposition, yielding a single combined constraint:
 *   X = Y * 2^a - rhs * (2^32 - 1)
 * It suffices to range-check rhs < 2^a. Soundness follows from keccakf1600.pil (adapted
 * to the 32-bit case): for any rhs < 2^a and X in [0, 2^32), the combined equation has a
 * unique solution (see proof in keccakf1600.pil).
 */


namespace sha256;

    #[skippable_if]
    sel = 0; // from sha256_mem.pil

    pol SEL_NO_ERR = sel * (1 - err); // @boolean (by definition: product of booleans)

    // ========== INITIAL STATE & CONTROL FLOW =============

    // Initial state values loaded from state_offset;
    pol commit init_a;
    pol commit init_b;
    pol commit init_c;
    pol commit init_d;
    pol commit init_e;
    pol commit init_f;
    pol commit init_g;
    pol commit init_h;

    // Output state values to be written to memory, the need to be "limbed" since it's addition modulo 2^32
    // We could re-use the init columns but we need to reverse the round orders.
    // Only the output_X_rhs is written to memory.
    // NOTE: These columns are only constrained on the `last` row (round 64). On all other rows they are
    // unconstrained, which is safe because they are only read (via memory writes in sha256_mem) on `last` rows.
    pol commit output_a_lhs;
    pol commit output_a_rhs;
    pol commit output_b_lhs;
    pol commit output_b_rhs;
    pol commit output_c_lhs;
    pol commit output_c_rhs;
    pol commit output_d_lhs;
    pol commit output_d_rhs;
    pol commit output_e_lhs;
    pol commit output_e_rhs;
    pol commit output_f_lhs;
    pol commit output_f_rhs;
    pol commit output_g_lhs;
    pol commit output_g_rhs;
    pol commit output_h_lhs;
    pol commit output_h_rhs;

    // We perform a compression operation if we are not at a latched row, or there is not an err
    pol commit perform_round; // @boolean (by definition: product of booleans)
    perform_round = (1 - LATCH_CONDITION) * SEL_NO_ERR;
    pol commit last; // @boolean (by definition: product of booleans)
    last = (1 - err) * end;
    // Since `end == 1 ==> sel == 1`, we have `last == SEL_NO_ERR * end`.
    // However, `err == 1` does not imply `end == 1` and we cannot simplify to `last = end - err`.

    // These are needed while we can't use constant values in lookups.
    // For the XOR lookups
    pol commit xor_op_id;
    perform_round * (xor_op_id - constants.AVM_BITWISE_XOR_OP_ID) = 0;
    // For the AND lookups
    pol commit and_op_id;
    perform_round * (and_op_id - constants.AVM_BITWISE_AND_OP_ID) = 0;

    // Counter - tracks how many compression rounds remain.
    // - Initialization: on the start row it forces rounds_remaining = 64,
    // - On every perform_round row it decrements by 1 (rounds_remaining' = rounds_remaining - 1).
    pol NUM_ROUNDS = 64;
    pol commit rounds_remaining;
    #[ROUNDS_REM_INIT]
    start * (rounds_remaining - NUM_ROUNDS) = 0;
    #[ROUNDS_REM_DECREMENT]
    perform_round * (rounds_remaining - rounds_remaining' - 1) = 0;

    pol commit round_count;
    SEL_NO_ERR * (round_count - (NUM_ROUNDS - rounds_remaining)) = 0;
    // rounds_remaining_inv is the inverse of rounds_remaining, used in the zero-check below.
    // It is only constrained when SEL_NO_ERR = 1; on error/inactive rows it is free (safe since
    // it is not referenced outside the SEL_NO_ERR guard).
    pol commit rounds_remaining_inv;
    // end == 1 iff rounds_remaining == 0 (zero-check with error support).
    // See https://github.com/AztecProtocol/aztec-packages/blob/next/barretenberg/cpp/pil/vm2/docs/recipes.md#with-error-support.
    SEL_NO_ERR * (rounds_remaining * (end * (1 - rounds_remaining_inv) + rounds_remaining_inv) - 1 + end) = 0;

    pol commit rng_chk_32; // todo: while we no support for constants
    SEL_NO_ERR * (rng_chk_32 - 32) = 0;

    // Hash Values, at start must match the initial hash values
    pol commit a;
    start * (1 - err) * (a - init_a) = 0;
    pol commit b;
    start * (1 - err) * (b - init_b) = 0;
    pol commit c;
    start * (1 - err) * (c - init_c) = 0;
    pol commit d;
    start * (1 - err) * (d - init_d) = 0;
    pol commit e;
    start * (1 - err) * (e - init_e) = 0;
    pol commit f;
    start * (1 - err) * (f - init_f) = 0;
    pol commit g;
    start * (1 - err) * (g - init_g) = 0;
    pol commit h;
    start * (1 - err) * (h - init_h) = 0;

    // Propagate initial state values across all rounds.
    // Initial states must be propagated correctly because they are used in the `last` row
    // when adding to the compression output. `last` is mutually exclusive to `perform_round` but
    // these constraints don't need to use `last`  because on the 64th row of `perform_round` we
    // will constrain the next row (i.e. the `last` row) to be correct.
    #[PROPAGATE_INIT_A]
    perform_round * (init_a' - init_a) = 0;
    #[PROPAGATE_INIT_B]
    perform_round * (init_b' - init_b) = 0;
    #[PROPAGATE_INIT_C]
    perform_round * (init_c' - init_c) = 0;
    #[PROPAGATE_INIT_D]
    perform_round * (init_d' - init_d) = 0;
    #[PROPAGATE_INIT_E]
    perform_round * (init_e' - init_e) = 0;
    #[PROPAGATE_INIT_F]
    perform_round * (init_f' - init_f) = 0;
    #[PROPAGATE_INIT_G]
    perform_round * (init_g' - init_g) = 0;
    #[PROPAGATE_INIT_H]
    perform_round * (init_h' - init_h) = 0;

    // ========== COMPUTE W =============
    // w is only computed on the 16th round (as 0-15 are populated from the input)
    // s0 := (w[i-15] rightrotate 7) xor (w[i-15] rightrotate 18) xor (w[i-15] rightshift  3)
    // s1 := (w[i-2] rightrotate 17) xor (w[i-2] rightrotate 19) xor (w[i-2] rightshift 10)
    // w[i] := w[i-16] + s0 + w[i-7] + s1

    // Computing the w values for each round requires the 16th, 15th, 7th and 2nd previous w values (i - 16, i - 15, i - 7 and i - 2)
    // To store this in the vm, we track 16 columns that are added to by each row and we denote the following
    // helper_w0 = i - 16, helper_w1 = i - 15, helper_w9 = i - 7, helper_w14 = i - 2, helper_w15 = i - 1

    pol commit helper_w0, helper_w1, helper_w2, helper_w3;
    pol commit helper_w4, helper_w5, helper_w6, helper_w7;
    pol commit helper_w8, helper_w9, helper_w10, helper_w11;
    pol commit helper_w12, helper_w13, helper_w14, helper_w15;

    perform_round * (helper_w0' - helper_w1) = 0;
    perform_round * (helper_w1' - helper_w2) = 0;
    perform_round * (helper_w2' - helper_w3) = 0;
    perform_round * (helper_w3' - helper_w4) = 0;
    perform_round * (helper_w4' - helper_w5) = 0;
    perform_round * (helper_w5' - helper_w6) = 0;
    perform_round * (helper_w6' - helper_w7) = 0;
    perform_round * (helper_w7' - helper_w8) = 0;
    perform_round * (helper_w8' - helper_w9) = 0;
    perform_round * (helper_w9' - helper_w10) = 0;
    perform_round * (helper_w10' - helper_w11) = 0;
    perform_round * (helper_w11' - helper_w12) = 0;
    perform_round * (helper_w12' - helper_w13) = 0;
    perform_round * (helper_w13' - helper_w14) = 0;
    perform_round * (helper_w14' - helper_w15) = 0;
    // The last value is given the currently computed w value
    perform_round * (helper_w15' - w) = 0;

    // Message Schedule Array, in the first row
    pol commit w;
    // We compute w when we are no longer part of an input round (i.e. when we load input)
    // from memory. This selector is therefore off for the first 16 rounds.
    pol commit sel_compute_w; // @boolean (by definition: product of booleans)
    sel_compute_w = perform_round * (1 - sel_is_input_round);
    pol COMPUTED_W = helper_w0 + w_s_0 + helper_w9 + w_s_1;
    pol commit computed_w_lhs;
    pol commit computed_w_rhs;
    sel_compute_w * ((computed_w_lhs * 2**32 + computed_w_rhs) - COMPUTED_W) = 0;
    sel_compute_w * (w - computed_w_rhs) = 0;
    // Check Modulo Add Operation
    // COMPUTED_W is the sum of 4 terms < 2^32, so lhs < 4 (fits in 8 bits).
    #[RANGE_COMP_W_LHS]
    sel_compute_w { computed_w_lhs } in precomputed.sel_range_8 { precomputed.idx };
    #[RANGE_COMP_W_RHS]
    sel_compute_w { computed_w_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };

    // ========== Compute w_s0 ===================
    // w[i-15] `rotr` 7 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit w_15_rotr_7;
    pol commit rhs_w_7;
    sel_compute_w * (helper_w1 - w_15_rotr_7 * 2**7 + rhs_w_7 * (2**32 - 1)) = 0;
    ///// Check rhs_w_7 < 2**7 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_7; // todo: while no constants in lookup
    sel_compute_w * (rng_chk_7 - 7) = 0;
    #[RANGE_RHS_W_7]
    sel_compute_w { rhs_w_7, rng_chk_7 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_w_7

    // w[i-15] `rotr` 18 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit w_15_rotr_18;
    pol commit rhs_w_18;
    sel_compute_w * (helper_w1 - w_15_rotr_18 * 2**18 + rhs_w_18 * (2**32 - 1)) = 0;
    ///// Check rhs_w_18 < 2**18 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_18; // todo: while no constants in lookup
    sel_compute_w * (rng_chk_18 - 18) = 0;
    #[RANGE_RHS_W_18]
    sel_compute_w { rhs_w_18, rng_chk_18 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_w_18

    // w[i-15] `rightshift`  3
    // The shift result is lhs_w_3 (the high part of the decomposition). It is used directly
    // in the XOR lookup #[W_S_0_XOR_1], which also implicitly range-checks it to 32 bits.
    pol commit lhs_w_3;
    pol commit rhs_w_3;
    sel_compute_w * (helper_w1 - (lhs_w_3 * 2**3 + rhs_w_3)) = 0;
    ///// Check rhs_w_3 < 2**3 (we don't have to check lhs_w_3 < 2**32 since it's used in the lookup #[W_S_0_XOR_1])
    pol commit rng_chk_3; // todo: while no constants in lookup
    sel_compute_w * (rng_chk_3 - 3) = 0;
    #[RANGE_RHS_W_3]
    sel_compute_w { rhs_w_3, rng_chk_3 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_w_3

    // s0 := (w[i-15] `rotr` 7) `xor` (w[i-15] `rotr` 18) `xor` (w[i-15] `rightshift`  3)
    pol commit w_15_rotr_7_xor_w_15_rotr_18;
    #[W_S_0_XOR_0]
    sel_compute_w { w_15_rotr_7, w_15_rotr_18, w_15_rotr_7_xor_w_15_rotr_18, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    pol commit w_s_0;
    #[W_S_0_XOR_1]
    sel_compute_w { w_15_rotr_7_xor_w_15_rotr_18, lhs_w_3, w_s_0, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    // ========== Compute w_s1 ===================
    // w[i-2] `rotr` 17 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit w_2_rotr_17;
    pol commit rhs_w_17;
    sel_compute_w * (helper_w14 - w_2_rotr_17 * 2**17 + rhs_w_17 * (2**32 - 1)) = 0;
    ///// Check rhs_w_17 < 2**17 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_17; // todo: while no constants in lookup
    sel_compute_w * (rng_chk_17 - 17) = 0;
    #[RANGE_RHS_W_17]
    sel_compute_w { rhs_w_17, rng_chk_17 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_w_17

    // w[i-2] `rotr` 19 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit w_2_rotr_19;
    pol commit rhs_w_19;
    sel_compute_w * (helper_w14 - w_2_rotr_19 * 2**19 + rhs_w_19 * (2**32 - 1)) = 0;
    ///// Check rhs_w_19 < 2**19 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_19; // todo: while no constants in lookup
    sel_compute_w * (rng_chk_19 - 19) = 0;
    #[RANGE_RHS_W_19]
    sel_compute_w { rhs_w_19, rng_chk_19 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_w_19

    // w[i-2] `rightshift` 10
    // The shift result is lhs_w_10 (the high part of the decomposition). It is used directly
    // in the XOR lookup #[W_S_1_XOR_1], which also implicitly range-checks it to 32 bits.
    pol commit lhs_w_10;
    pol commit rhs_w_10;
    sel_compute_w * (helper_w14 - (lhs_w_10 * 2**10 + rhs_w_10)) = 0;
    ///// Check rhs_w_10 < 2**10 (we don't have to check lhs_w_10 < 2**32 since it's used in the lookup #[W_S_1_XOR_1])
    pol commit rng_chk_10; // todo: while no constants in lookup
    sel_compute_w * (rng_chk_10 - 10) = 0;
    #[RANGE_RHS_W_10]
    sel_compute_w { rhs_w_10, rng_chk_10 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_w_10

    // s1 := (w[i-2] `rotr` 17) `xor` (w[i-2] `rotr` 19) `xor` (w[i-2] `rightshift` 10)
    pol commit w_2_rotr_17_xor_w_2_rotr_19;
    #[W_S_1_XOR_0]
    sel_compute_w { w_2_rotr_17, w_2_rotr_19, w_2_rotr_17_xor_w_2_rotr_19, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    pol commit w_s_1;
    #[W_S_1_XOR_1]
    sel_compute_w { w_2_rotr_17_xor_w_2_rotr_19, lhs_w_10, w_s_1, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    // ========== START OF COMPRESSION BLOCK ==================

    // ====== Computing S1 ====================
    // e `rotr` 6 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit e_rotr_6;
    pol commit rhs_e_6;
    perform_round * (e - e_rotr_6 * 2**6 + rhs_e_6 * (2**32 - 1)) = 0;
    ///// Check rhs_e_6 < 2**6 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_6; // todo: while no constants in lookup
    perform_round * (rng_chk_6 - 6) = 0;
    #[RANGE_RHS_E_6]
    perform_round { rhs_e_6, rng_chk_6 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_e_6

    // e `rotr` 11 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit e_rotr_11;
    pol commit rhs_e_11;
    perform_round * (e - e_rotr_11 * 2**11 + rhs_e_11 * (2**32 - 1)) = 0;
    ///// Check rhs_e_11 < 2**11 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_11; // todo: while no constants in lookup
    perform_round * (rng_chk_11 - 11) = 0;
    #[RANGE_RHS_E_11]
    perform_round { rhs_e_11, rng_chk_11 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_e_11

    // e `rotr` 25 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit e_rotr_25;
    pol commit rhs_e_25;
    perform_round * (e - e_rotr_25 * 2**25 + rhs_e_25 * (2**32 - 1)) = 0;
    ///// Check rhs_e_25 < 2**25 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_25; // todo: while no constants in lookup
    perform_round * (rng_chk_25 - 25) = 0;
    #[RANGE_RHS_E_25]
    perform_round { rhs_e_25, rng_chk_25 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_e_25
    // pol S_1 = (E `rotr` 6) `xor` (E `rotr` 11) `xor` (E `rotr` 25);

    pol commit e_rotr_6_xor_e_rotr_11;
    #[S_1_XOR_0]
    perform_round { e_rotr_6, e_rotr_11, e_rotr_6_xor_e_rotr_11, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    pol commit s_1;
    #[S_1_XOR_1]
    perform_round { e_rotr_6_xor_e_rotr_11, e_rotr_25, s_1, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    // ==== COMPUTING CH ===========
    // pol CH = (E `and` F) `xor` ((`not` E) `and` G);
    pol commit e_and_f;

    #[CH_AND_0]
    perform_round { e, f, e_and_f, and_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    // Bitwise NOT of e: not_e = (2^32 - 1) - e, i.e. the ones' complement for 32-bit values.
    pol commit not_e;
    perform_round * (e + not_e - (2**32 - 1)) = 0;

    pol commit not_e_and_g;
    #[CH_AND_1]
    perform_round { not_e, g, not_e_and_g, and_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    pol commit ch;
    #[CH_XOR]
    perform_round { e_and_f, not_e_and_g, ch, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    // ===== COMPUTING TMP 1 ===========
    // Lookup round constants
    pol commit round_constant;
    #[ROUND_CONSTANT]
    perform_round { round_count, round_constant }
    in
    precomputed.sel_sha256_compression { precomputed.idx, precomputed.sha256_compression_round_constant };

    pol TMP_1 = h + s_1 + ch + round_constant + w;

    // ===== S0 ==================
    // pol S_0 = (A `rotr` 2) `xor` (A `rotr` 13) `xor` (A `rotr` 22);
    // a `rotr` 2 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit a_rotr_2;
    pol commit rhs_a_2;
    perform_round * (a - a_rotr_2 * 2**2 + rhs_a_2 * (2**32 - 1)) = 0;
    ///// Check rhs_a_2 < 2**2 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_2; // todo: while no constants in lookup
    perform_round * (rng_chk_2 - 2) = 0;
    #[RANGE_RHS_A_2]
    perform_round { rhs_a_2, rng_chk_2 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_a_2

    // a `rotr` 13 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit a_rotr_13;
    pol commit rhs_a_13;
    perform_round * (a - a_rotr_13 * 2**13 + rhs_a_13 * (2**32 - 1)) = 0;
    ///// Check rhs_a_13 < 2**13 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_13; // todo: while no constants in lookup
    perform_round * (rng_chk_13 - 13) = 0;
    #[RANGE_RHS_A_13]
    perform_round { rhs_a_13, rng_chk_13 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_a_13

    // a `rotr` 22 — combined constraint (see NOTE_ON_ROTATIONS)
    pol commit a_rotr_22;
    pol commit rhs_a_22;
    perform_round * (a - a_rotr_22 * 2**22 + rhs_a_22 * (2**32 - 1)) = 0;
    ///// Check rhs_a_22 < 2**22 (see NOTE_ON_ROTATIONS at the top of this file)
    pol commit rng_chk_22; // todo: while no constants in lookup
    perform_round * (rng_chk_22 - 22) = 0;
    #[RANGE_RHS_A_22]
    perform_round { rhs_a_22, rng_chk_22 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    ///// End Check rhs_a_22

    // (A_0 `rotr` 2) `xor` (A_0 `rotr` 13)
    pol commit a_rotr_2_xor_a_rotr_13;
    #[S_0_XOR_0]
    perform_round { a_rotr_2, a_rotr_13, a_rotr_2_xor_a_rotr_13, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    pol commit s_0;
    #[S_0_XOR_1]
    perform_round { a_rotr_2_xor_a_rotr_13, a_rotr_22, s_0, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    // ====== Computing Maj =========
    // pol MAJ = (A `and` B) `xor` (A `and` C) `xor` (B `and` C);
    pol commit a_and_b;
    #[MAJ_AND_0]
    perform_round { a, b, a_and_b, and_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    pol commit a_and_c;
    #[MAJ_AND_1]
    perform_round { a, c, a_and_c, and_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    pol commit b_and_c;
    #[MAJ_AND_2]
    perform_round { b, c, b_and_c, and_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    pol commit a_and_b_xor_a_and_c;
    #[MAJ_XOR_0]
    perform_round { a_and_b, a_and_c, a_and_b_xor_a_and_c, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    pol commit maj;
    #[MAJ_XOR_1]
    perform_round { a_and_b_xor_a_and_c, b_and_c, maj, xor_op_id, u32_tag, u32_tag }
    in
    bitwise.sel_sha256 { bitwise.ia, bitwise.ib, bitwise.ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };

    // ==== Compute TMP 2 ====
    pol NEXT_A = s_0 + maj + TMP_1;

    pol commit next_a_lhs;
    pol commit next_a_rhs;
    perform_round * ((next_a_lhs * 2**32 + next_a_rhs) - NEXT_A) = 0;
    // Check Modulo Add Operation
    // NEXT_A is the sum of 7 terms < 2^32, so lhs < 7 (fits in 8 bits).
    #[RANGE_COMP_NEXT_A_LHS]
    perform_round { next_a_lhs } in precomputed.sel_range_8 { precomputed.idx };
    #[RANGE_COMP_NEXT_A_RHS]
    perform_round { next_a_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };

    pol NEXT_E = d + TMP_1;

    pol commit next_e_lhs;
    pol commit next_e_rhs;
    perform_round * ((next_e_lhs * 2**32 + next_e_rhs) - NEXT_E) = 0;
    // Check Modulo Add Operation
    // NEXT_E is the sum of 6 terms < 2^32, so lhs < 6 (fits in 8 bits).
    #[RANGE_COMP_NEXT_E_LHS]
    perform_round { next_e_lhs } in precomputed.sel_range_8 { precomputed.idx };
    #[RANGE_COMP_NEXT_E_RHS]
    perform_round { next_e_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };

    // ========== STATE TRANSITION (SHA-256 round update) =============
    // After each round: a' = (s0 + maj + tmp1) mod 2^32, e' = (d + tmp1) mod 2^32,
    // and the remaining state values shift: b'=a, c'=b, d'=c, f'=e, g'=f, h'=g.
    perform_round * (a' - next_a_rhs) = 0;
    perform_round * (b' - a) = 0;
    perform_round * (c' - b) = 0;
    perform_round * (d' - c) = 0;
    perform_round * (e' - next_e_rhs) = 0;
    perform_round * (f' - e) = 0;
    perform_round * (g' - f) = 0;
    perform_round * (h' - g) = 0;

    // ========== OUTPUT COMPUTATION =============
    // Add the initial state to the final round state (modulo 2^32) to produce the compression output.
    // Each output is decomposed into lhs (overflow) and rhs (result mod 2^32). Only rhs is written to memory.
    pol OUT_A = a + init_a;
    last * (OUT_A - (output_a_lhs * 2**32 + output_a_rhs)) = 0;
    pol OUT_B = b + init_b;
    last * (OUT_B - (output_b_lhs * 2**32 + output_b_rhs)) = 0;
    pol OUT_C = c + init_c;
    last * (OUT_C - (output_c_lhs * 2**32 + output_c_rhs)) = 0;
    pol OUT_D = d + init_d;
    last * (OUT_D - (output_d_lhs * 2**32 + output_d_rhs)) = 0;
    pol OUT_E = e + init_e;
    last * (OUT_E - (output_e_lhs * 2**32 + output_e_rhs)) = 0;
    pol OUT_F = f + init_f;
    last * (OUT_F - (output_f_lhs * 2**32 + output_f_rhs)) = 0;
    pol OUT_G = g + init_g;
    last * (OUT_G - (output_g_lhs * 2**32 + output_g_rhs)) = 0;
    pol OUT_H = h + init_h;
    last * (OUT_H - (output_h_lhs * 2**32 + output_h_rhs)) = 0;

    // OUT_X = X + init_X where both operands are < 2^32, so the sum is < 2^33 and
    // output_X_lhs (the carry) is 0 or 1. No `last` guard needed: these columns are
    // unconstrained on non-last rows, so the prover can set them to 0.
    output_a_lhs * (output_a_lhs - 1) = 0;
    output_b_lhs * (output_b_lhs - 1) = 0;
    output_c_lhs * (output_c_lhs - 1) = 0;
    output_d_lhs * (output_d_lhs - 1) = 0;
    output_e_lhs * (output_e_lhs - 1) = 0;
    output_f_lhs * (output_f_lhs - 1) = 0;
    output_g_lhs * (output_g_lhs - 1) = 0;
    output_h_lhs * (output_h_lhs - 1) = 0;

    #[RANGE_COMP_A_RHS]
    last { output_a_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    #[RANGE_COMP_B_RHS]
    last { output_b_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    #[RANGE_COMP_C_RHS]
    last { output_c_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    #[RANGE_COMP_D_RHS]
    last { output_d_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    #[RANGE_COMP_E_RHS]
    last { output_e_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    #[RANGE_COMP_F_RHS]
    last { output_f_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    #[RANGE_COMP_G_RHS]
    last { output_g_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
    #[RANGE_COMP_H_RHS]
    last { output_h_rhs, rng_chk_32 }
    in
    range_check.sel_sha256 { range_check.value, range_check.rng_chk_bits };
