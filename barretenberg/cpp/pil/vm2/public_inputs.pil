/**
 * Public Inputs subtrace for the AVM.
 *
 * This subtrace contains the public inputs columns of which there are 4 of them.
 * The mapping from the AVM public inputs structure to these 4 columns is as follows:
 *
 * ====================================================================================================================
 * INPUTS
 * ====================================================================================================================
 * Rows    | Section                                       | Col 0                | Col 1                     | Col 2            | Col 3         | Referenced By
 * --------|-----------------------------------------------|----------------------|---------------------------|------------------|---------------|-----------------------------------------------------------
 * 0       | global_variables.chain_id                     | chain_id             | -                         | -                | -             | get_env_var #[READ_FROM_PUBLIC_INPUTS_COL0]
 * 1       | global_variables.version                      | version              | -                         | -                | -             | get_env_var #[READ_FROM_PUBLIC_INPUTS_COL0]
 * 2       | global_variables.block_number                 | block_number         | -                         | -                | -             | get_env_var #[READ_FROM_PUBLIC_INPUTS_COL0]
 * 3       | global_variables.slot_number                  | slot_number          | -                         | -                | -             | UNUSED in AVM but constrained by public base rollup (via BlockConstantData)
 * 4       | global_variables.timestamp                    | timestamp            | -                         | -                | -             | get_env_var #[READ_FROM_PUBLIC_INPUTS_COL0], update_check #[TIMESTAMP_FROM_PUBLIC_INPUTS]
 * 5       | global_variables.coinbase                     | coinbase             | -                         | -                | -             | UNUSED in AVM but constrained by public base rollup (via BlockConstantData)
 * 6       | global_variables.fee_recipient                | fee_recipient        | -                         | -                | -             | UNUSED in AVM but constrained by public base rollup (via BlockConstantData)
 * 7       | global_variables.gas_fees                     | fee_per_da_gas       | fee_per_l2_gas            | -                | -             | get_env_var #[READ_FROM_PUBLIC_INPUTS_COL0] (col0), #[READ_FROM_PUBLIC_INPUTS_COL1] (col1)
 * 8..18   | protocol_contracts                            | 11 serialized fields | -                         | -                | -             | contract_instance_retrieval #[READ_DERIVED_ADDRESS_FROM_PUBLIC_INPUTS]
 * 19      | start_tree_snapshots.l1_to_l2_message_tree    | root                 | next_available_leaf_index | -                | -             | tx_context #[PUBLIC_INPUTS_L1_L2_TREE]
 * 20      | start_tree_snapshots.note_hash_tree           | root                 | next_available_leaf_index | -                | -             | tx_context #[PUBLIC_INPUTS_NOTE_HASH_TREE]
 * 21      | start_tree_snapshots.nullifier_tree           | root                 | next_available_leaf_index | -                | -             | tx_context #[PUBLIC_INPUTS_NULLIFIER_TREE]
 * 22      | start_tree_snapshots.public_data_tree         | root                 | next_available_leaf_index | -                | -             | tx_context #[PUBLIC_INPUTS_PUBLIC_DATA_TREE]
 * 23      | start_gas_used                                | da_gas               | l2_gas                    | -                | -             | tx_context #[PUBLIC_INPUTS_GAS_USED]
 * 24      | gas_settings.gas_limits                       | da_gas               | l2_gas                    | -                | -             | tx_context #[PUBLIC_INPUTS_READ_GAS_LIMIT]
 * 25      | gas_settings.teardown_gas_limits              | da_gas               | l2_gas                    | -                | -             | tx_context #[PUBLIC_INPUTS_READ_GAS_LIMIT] (on teardown)
 * 26      | gas_settings.max_fees_per_gas                 | fee_per_da_gas       | fee_per_l2_gas            | -                | -             | UNUSED in AVM but constrained by public base rollup (effective_gas_fees check)
 * 27      | gas_settings.max_priority_fees_per_gas        | fee_per_da_gas       | fee_per_l2_gas            | -                | -             | UNUSED in AVM but constrained by public base rollup (effective_gas_fees check)
 * 28      | effective_gas_fees                            | fee_per_da_gas       | fee_per_l2_gas            | -                | -             | tx #[READ_EFFECTIVE_FEE_PUBLIC_INPUTS]
 * 29      | fee_payer                                     | fee_payer            | -                         | -                | -             | tx #[READ_FEE_PAYER_PUBLIC_INPUTS]
 * 30      | prover_id                                     | prover_id            | -                         | -                | -             | UNUSED in AVM but constrained by public base rollup (prover_id check)
 * 31      | public_call_request_array_lengths             | setup_calls          | -                         | -                | -             | tx #[READ_PHASE_LENGTH]
 * 32      |                                               | app_logic_calls      | -                         | -                | -             | tx #[READ_PHASE_LENGTH]
 * 33      |                                               | teardown_call        | -                         | -                | -             | tx #[READ_PHASE_LENGTH]
 * 34..65  | public_setup_call_requests[0..32]             | msg_sender           | contract_address          | is_static_call   | calldata_hash | tx #[READ_PUBLIC_CALL_REQUEST_PHASE]
 * 66..97  | public_app_logic_call_requests[0..32]         | msg_sender           | contract_address          | is_static_call   | calldata_hash | tx #[READ_PUBLIC_CALL_REQUEST_PHASE]
 * 98      | public_teardown_call_request                  | msg_sender           | contract_address          | is_static_call   | calldata_hash | tx #[READ_PUBLIC_CALL_REQUEST_PHASE]
 * 99      | prev_non_revertible_accum_data_array_lengths  | note_hashes          | -                         | -                | -             | tx #[READ_PHASE_LENGTH]
 * 100     |                                               | nullifiers           | -                         | -                | -             | tx #[READ_PHASE_LENGTH]
 * 101     |                                               | l2_to_l1_msgs        | -                         | -                | -             | tx #[READ_PHASE_LENGTH]
 * 102     | prev_revertible_accum_data_array_lengths      | note_hashes          | -                         | -                | -             | tx #[READ_PHASE_LENGTH]
 * 103     |                                               | nullifiers           | -                         | -                | -             | tx #[READ_PHASE_LENGTH]
 * 104     |                                               | l2_to_l1_msgs        | -                         | -                | -             | tx #[READ_PHASE_LENGTH]
 * 105..168| prev_non_revertible_accum_data.note_hashes    | note_hash[i]         | -                         | -                | -             | tx #[READ_TREE_INSERT_VALUE]
 * 169..232| prev_non_revertible_accum_data.nullifiers     | nullifier[i]         | -                         | -                | -             | tx #[READ_TREE_INSERT_VALUE] (idx 169 also for note_hash_tree_check #[READ_FIRST_NULLIFIER])
 * 233..240| prev_non_revertible_accum_data.l2_to_l1_msgs  | recipient            | content                   | contract_address | -             | tx #[READ_L2_L1_MSG]
 * 241..304| prev_revertible_accum_data.note_hashes        | note_hash[i]         | -                         | -                | -             | tx #[READ_TREE_INSERT_VALUE]
 * 305..368| prev_revertible_accum_data.nullifiers         | nullifier[i]         | -                         | -                | -             | tx #[READ_TREE_INSERT_VALUE]
 * 369..376| prev_revertible_accum_data.l2_to_l1_msgs      | recipient            | content                   | contract_address | -             | tx #[READ_L2_L1_MSG]
 *
 * ====================================================================================================================
 * OUTPUTS
 * ====================================================================================================================
 * Rows      | Section                                     | Col 0                | Col 1                     | Col 2            | Col 3         | Referenced By
 * ----------|---------------------------------------------|----------------------|---------------------------|------------------|---------------|-----------------------------------------------------------
 * 377       | end_tree_snapshots.l1_to_l2_message_tree    | root                 | next_available_leaf_index | -                | -             | tx_context #[PUBLIC_INPUTS_L1_L2_TREE] (cleanup)
 * 378       | end_tree_snapshots.note_hash_tree           | root                 | next_available_leaf_index | -                | -             | tx_context #[PUBLIC_INPUTS_NOTE_HASH_TREE] (cleanup)
 * 379       | end_tree_snapshots.nullifier_tree           | root                 | next_available_leaf_index | -                | -             | tx_context #[PUBLIC_INPUTS_NULLIFIER_TREE] (cleanup)
 * 380       | end_tree_snapshots.public_data_tree         | root                 | next_available_leaf_index | -                | -             | tx_context #[PUBLIC_INPUTS_PUBLIC_DATA_TREE] (cleanup)
 * 381       | end_gas_used                                | da_gas               | l2_gas                    | -                | -             | tx_context #[PUBLIC_INPUTS_GAS_USED] (cleanup)
 * 382       | accumulated_data_array_lengths              | note_hashes          | -                         | -                | -             | tx_context #[PUBLIC_INPUTS_WRITE_NOTE_HASH_COUNT]
 * 383       |                                             | nullifiers           | -                         | -                | -             | tx_context #[PUBLIC_INPUTS_WRITE_NULLIFIER_COUNT]
 * 384       |                                             | l2_to_l1_msgs        | -                         | -                | -             | tx_context #[PUBLIC_INPUTS_WRITE_L2_TO_L1_MESSAGE_COUNT]
 * 385       |                                             | public_data_writes   | -                         | -                | -             | public_data_check #[WRITE_WRITES_LENGTH_TO_PUBLIC_INPUTS]
 * 386..449  | accumulated_data.note_hashes[0..64]         | note_hash[i]         | -                         | -                | -             | note_hash_tree_check #[WRITE_NOTE_HASH_TO_PUBLIC_INPUTS]
 * 450..513  | accumulated_data.nullifiers[0..64]          | nullifier[i]         | -                         | -                | -             | nullifier_check #[WRITE_NULLIFIER_TO_PUBLIC_INPUTS]
 * 514..521  | accumulated_data.l2_to_l1_msgs[0..8]        | recipient            | content                   | contract_address | -             | tx #[WRITE_L2_L1_MSG], send_l2_to_l1_msg #[WRITE_L2_TO_L1_MSG]
 * 522..4618 | accumulated_data.public_logs                | length/payload       | -                         | -                | -             | emit_public_log #[WRITE_DATA_TO_PUBLIC_INPUTS], tx_context #[PUBLIC_INPUTS_WRITE_PUBLIC_LOG_COUNT] (row 522)
 * 4619..4682| accumulated_data.public_data_writes[0..64]  | leaf_slot            | value                     | -                | -             | public_data_check #[WRITE_PUBLIC_DATA_TO_PUBLIC_INPUTS]
 * 4683      | transaction_fee                             | transaction_fee      | -                         | -                | -             | tx #[WRITE_FEE_PUBLIC_INPUTS]
 * 4684      | reverted                                    | reverted (0/1)       | -                         | -                | -             | tx_context #[PUBLIC_INPUTS_READ_REVERTED]
 *
 */

/* NOTE ON NON-MALLEABILITY OF ACCUMULATED-DATA OUTPUT ARRAYS:
 * Accumulated-data output arrays are written by one-way lookups (#[WRITE_*_TO_PUBLIC_INPUTS]);
 * the AVM constrains only the active prefix [0, length), leaving [length, MAX) unconstrained.
 * This is safe because every rollup consumer is length-bounded — the out_hash (UnbalancedMerkleTree,
 * num_non_empty_leaves) and the DA blob (create_tx_blob_data) both ignore the tail, and trees use
 * the AVM end snapshots. validate_avm_accumulated_data_padding (public_tx_base_inputs_validator.nr)
 * additionally zero-pads the tail defensively (non-malleability safeguard).
 */

namespace public_inputs;

pol constant sel; // 1 for rows [0, AVM_PUBLIC_INPUTS_COLUMNS_MAX_LENGTH)

pol public cols[4];
