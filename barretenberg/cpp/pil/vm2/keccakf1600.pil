include "bitwise.pil";
include "constants_gen.pil";
include "range_check.pil";
include "precomputed.pil";
include "keccak_memory.pil";

/**
 * This gadget implements the keccakf1600 permutation. It is memory-aware and uses the keccak_memory
 * gadget to read the slice input and write the slice output from/into memory.
 * This gadget essentially gets as input as source address src_addr and destination address dst_addr.
 * Both addresses are resolved and represent the first memory offset of the slice.
 * The input/read memory slice and the output/write memory slice are of length 25 (like keccakf1600 state)
 * and expect to exclusively contain elements of type U64.
 * The core of this gadget consists in the keccakf1600 permutation which is implemented as a sequence
 * of 24 rounds and each round is computed over a single row. Other columns/logic consist in error handling,
 * and interactions with the keccak_memory gadget.
 *
 * The logical flow is as follows:
 * - The selector `start` triggers the gadget.
 * - The gadget checks that both slices are not out-of-bounds. Otherwise, it sets the error flag.
 * - If no error is detected, the gadget triggers the gadget keccak_memory to read the slice input.
 * - We get back from keccak_memory the permutation input values or a tag_error flag. If the latter,
 *   we set the error flag.
 * - If no error is detected, the gadget triggers the keccakf1600 permutation.
 * - The permutation output values are written to the slice output.
 *
 * The happy path (no error) will generate 24 rows in this trace and 50 in keccak_memory (2 full slices).
 * A slice out-of-bound error will generate 1 row in this trace and 0 in keccak_memory (slices inactive).
 * A tag_error flag will generate 1 row in this trace and a number of rows in keccak_memory
 * which corresponds to the relative slice offset with the first invalid tag (write slice is inactive).
 *
 * Usage (a permutation and not a lookup):
 * sel_keccakf1600 { clk, dst_addr, src_addr, space_id, error }
 * is
 * keccakf1600.start { keccakf1600.clk, keccakf1600.dst_addr, keccakf1600.src_addr, keccakf1600.space_id, keccakf1600.error };
 *
 * Inputs: clk, dst_addr, src_addr, space_id
 * Output: error
 *
 * - dst_addr and src_addr are the first memory offset of the pertaining slice.
 * - space_id serves to propagate the right memory space up to the memory trace.
 * - clk is required for the unicity in the permutation and to propagate to the memory trace
 *   to unambiguously order the memory operations.
 * - error is set to 1 if any error is detected.
 */
namespace keccakf1600;

// Reference document: https://keccak.team/files/Keccak-reference-3.0.pdf
// Overview: https://keccak.team/keccak_specs_summary.html
//
// A keccakf1600 permutation is the result of 24 (AVM_KECCAKF1600_NUM_ROUNDS) iterations
// of a round function.
// The round function is composed of 5 sub-functions: theta, rho, pi, chi, and iota.
// Main low-level operations are: XOR, AND, bit rotations
// All the sub-functions operate over a state of 25 64-bit values.
//
// Bitwise operations XOR, AND are invoked with lookups to bitwise.pil through 2 flavors:
// - Standard 64-bit operations (bitwise.sel_keccak)
// - SIMD-64 operations (bitwise.sel_simd_64) which packs 2 64-bit operations into a single row.
// We try to use as many SIMD-64 lookups as possible in order to minimize the number of lookups in
// this file. However, we do not push too the limit in order to keep the constraints readable.

//#################################################################################################
//                  High-Level Trace Structure Columns
//#################################################################################################
//   ctr   sel   start   end     state_in_00  state_in_01 ....
//    1     1      1      0
//    2     1      0      0         ROUND FUNCTION SPECIFICS
//    3     1      0      0
//    ...  ...    ...    ...               ...
//    24    1      0      1

// We use one row to compute a single round function.
// 24 rows correspond to one keccak permutation.
// Only on last row, we constrain the output columns.

// keccakf1600 selector
pol commit sel; // @boolean
sel * (1 - sel) = 0;

// No relations will be checked if this identity is satisfied.
#[skippable_if]
sel = 0;

// ==== MULTI-ROW COMPUTATION SELECTORS ====
// See recipe: https://github.com/AztecProtocol/aztec-packages/blob/next/barretenberg/cpp/pil/vm2/docs/recipes.md#contiguous-multi-rows-computation-trace

// First round of a keccak permutation. This is where the multi-rows computation starts and selector start
// is used by the caller to trigger the keccak permutation computation.
pol commit start; // @boolean
start * (1 - start) = 0;

// Selector for the last round of a keccak permutation
pol commit end; // @boolean
end * (1 - end) = 0;

pol LATCH_CONDITION = end + precomputed.first_row;

// If start or end is active, sel must be active.
#[SEL_ON_START_OR_END]
(start + end) * (1 - sel) = 0;

// sel is continuous within a computation block: it cannot change except at a latch.
#[TRACE_CONTINUITY]
(1 - LATCH_CONDITION) * (sel - sel') = 0;

// A new computation block must start immediately after a latch.
#[START_AFTER_LATCH]
sel' * (start' - LATCH_CONDITION) = 0;

// error is defined below after round function
pol commit sel_no_error; // @boolean (by definition)
#[SEL_NO_ERROR]
sel_no_error = sel * (1 - error);

// Round number which starts at 1 and ends at AVM_KECCAKF1600_NUM_ROUNDS (24).
pol commit round;

// We enforce the initial round to be set to 1.
start * (round - 1) = 0;

// We enforce that `end == 1` whenever `error == 1`.
// Note that error is constrained only on the start row.
#[END_ON_ERROR]
error * (end - 1) = 0;

#[KECCAK_ROUND_INCREMENT]
// Note: sel factor is required for an empty row to satisfy this relation
sel * (1 - LATCH_CONDITION) * (round' - round - 1) = 0;

// Lookup constant support: Can be removed when we support constants in lookups.
pol commit bitwise_xor_op_id;
sel * (bitwise_xor_op_id - constants.AVM_BITWISE_XOR_OP_ID) = 0;
pol commit bitwise_and_op_id;
sel * (bitwise_and_op_id - constants.AVM_BITWISE_AND_OP_ID) = 0;
pol commit tag_u64;
sel * (tag_u64 - constants.MEM_TAG_U64) = 0;

//#############################################################################
//                  Keccak Round Functions
//#############################################################################
// keccakf1600 permutation state corresponds to 25 64-bit words. They are indexed by two
// indices ranging over 0,1,2,3,4.
// Each state word evolves over the different transformations and a state word is prefixed by
// "state" and suffixed by the corresponding indices.

// State words before starting the round.
pol commit state_in_00, state_in_01, state_in_02, state_in_03, state_in_04,
           state_in_10, state_in_11, state_in_12, state_in_13, state_in_14,
           state_in_20, state_in_21, state_in_22, state_in_23, state_in_24,
           state_in_30, state_in_31, state_in_32, state_in_33, state_in_34,
           state_in_40, state_in_41, state_in_42, state_in_43, state_in_44;

// Theta function consists of three steps
// 1) For each index i in state_in_ij, we XOR the 5 values state_in_ij (denoted by A[i, j]) together.
//    - C[i] = A[i, 0] ^ A[i, 1] ^ A[i, 2] ^ A[i, 3] ^ A[i, 4]
// 2) Compute the xor of the adjacent column parities with a left rotation. Note the index is performed mod 5
//    - D[i] = C[i - 1] ^ rotl (C[i + 1], 1)
// 3) Compute the new output state.
//    - A[i, j] ^= D[i]
//
// Since we make use of the bitwise trace to compute these xors, we need to define intermediate values
// for each xor computation. We denote these intermediate values as theta_xor_row_i.
// Step 0: theta_xor_i1 = state_in_i0 ^ state_in_i1
// Step 1: theta_xor_i2 = theta_xor_i1 ^ state_in_i2
// Step 2: theta_xor_i3 = theta_xor_i2 ^ state_in_i3
// Step 3: theta_xor_row_i = theta_xor_i3 ^ state_in_i4

// Computations for the i indices (0,1), (2,3) are computed in SIMD-64 pairs, i.e.,
// for step j, we group:
// - theta_xor_0j and theta_xor_1j together.
// - theta_xor_2j and theta_xor_3j together.
//
// These pairs need to match the simulation gadget (keccakf1600.cpp).
// Computation for the index i = 4 is computed in a scalar manner.

//#############################################################################
//                  Theta XOR Computation Index 0
//#############################################################################

// state_in_00 ^ state_in_01 = theta_xor_01
pol commit theta_xor_01;
pol commit theta_xor_02;
pol commit theta_xor_03;
pol commit theta_xor_row_0;
pol commit theta_xor_11;
pol commit theta_xor_12;
pol commit theta_xor_13;
pol commit theta_xor_row_1;
pol commit theta_xor_21;
pol commit theta_xor_22;
pol commit theta_xor_23;
pol commit theta_xor_row_2;
pol commit theta_xor_31;
pol commit theta_xor_32;
pol commit theta_xor_33;
pol commit theta_xor_row_3;
pol commit theta_xor_41;
pol commit theta_xor_42;
pol commit theta_xor_43;
pol commit theta_xor_row_4;

// --- Step 0 ---
// state_in_i0 ^ state_in_i1 = theta_xor_i1

// i = 0,1
// [state_in_00, state_in_10] ^ [state_in_01, state_in_11] = [theta_xor_01, theta_xor_11]
#[THETA_XOR_SIMD_01]
sel_no_error { bitwise_xor_op_id, state_in_00, state_in_10, state_in_01, state_in_11, theta_xor_01, theta_xor_11 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

// i = 2,3
// [state_in_20, state_in_30] ^ [state_in_21, state_in_31] = [theta_xor_21, theta_xor_31]
#[THETA_XOR_SIMD_21]
sel_no_error { bitwise_xor_op_id, state_in_20, state_in_30, state_in_21, state_in_31, theta_xor_21, theta_xor_31 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

// i = 4
// state_in_40 ^ state_in_41 = theta_xor_41
#[THETA_XOR_41]
sel_no_error { bitwise_xor_op_id, state_in_40, state_in_41, theta_xor_41, tag_u64, tag_u64 } in
bitwise.sel_keccak { bitwise.op_id, bitwise.ia, bitwise.ib, bitwise.ic, bitwise.tag_a, bitwise.tag_b };

// --- Step 1 ---
// theta_xor_i1 ^ state_in_i2 = theta_xor_i2

// i = 0,1
// [theta_xor_01, theta_xor_11] ^ [state_in_02, state_in_12] = [theta_xor_02, theta_xor_12]
#[THETA_XOR_SIMD_02]
sel_no_error { bitwise_xor_op_id, theta_xor_01, theta_xor_11, state_in_02, state_in_12, theta_xor_02, theta_xor_12 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

// i = 2,3
// [theta_xor_21, theta_xor_31] ^ [state_in_22, state_in_32] = [theta_xor_22, theta_xor_32]
#[THETA_XOR_SIMD_22]
sel_no_error { bitwise_xor_op_id, theta_xor_21, theta_xor_31, state_in_22, state_in_32, theta_xor_22, theta_xor_32 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

// i = 4
// theta_xor_41 ^ state_in_42 = theta_xor_42
#[THETA_XOR_42]
sel_no_error { bitwise_xor_op_id, theta_xor_41, state_in_42, theta_xor_42, tag_u64, tag_u64 } in
bitwise.sel_keccak { bitwise.op_id, bitwise.ia, bitwise.ib, bitwise.ic, bitwise.tag_a, bitwise.tag_b };

// --- Step 2 ---
// theta_xor_i2 ^ state_in_i3 = theta_xor_i3

// i = 0,1
// [theta_xor_02, theta_xor_12] ^ [state_in_03, state_in_13] = [theta_xor_03, theta_xor_13]
#[THETA_XOR_SIMD_03]
sel_no_error { bitwise_xor_op_id, theta_xor_02, theta_xor_12, state_in_03, state_in_13, theta_xor_03, theta_xor_13 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

// i = 2,3
// [theta_xor_22, theta_xor_32] ^ [state_in_23, state_in_33] = [theta_xor_23, theta_xor_33]
#[THETA_XOR_SIMD_23]
sel_no_error { bitwise_xor_op_id, theta_xor_22, theta_xor_32, state_in_23, state_in_33, theta_xor_23, theta_xor_33 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

// i = 4
// theta_xor_42 ^ state_in_43 = theta_xor_43
#[THETA_XOR_43]
sel_no_error { bitwise_xor_op_id, theta_xor_42, state_in_43, theta_xor_43, tag_u64, tag_u64 } in
bitwise.sel_keccak { bitwise.op_id, bitwise.ia, bitwise.ib, bitwise.ic, bitwise.tag_a, bitwise.tag_b };

// --- Step 3 ---
// theta_xor_i3 ^ state_in_i4 = theta_xor_row_i

// i = 0,1
// [theta_xor_03, theta_xor_13] ^ [state_in_04, state_in_14] = [theta_xor_row_0, theta_xor_row_1]
#[THETA_XOR_ROW_SIMD_0]
sel_no_error { bitwise_xor_op_id, theta_xor_03, theta_xor_13, state_in_04, state_in_14, theta_xor_row_0, theta_xor_row_1 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

// i = 2,3
// [theta_xor_23, theta_xor_33] ^ [state_in_24, state_in_34] = [theta_xor_row_2, theta_xor_row_3]
#[THETA_XOR_ROW_SIMD_2]
sel_no_error { bitwise_xor_op_id, theta_xor_23, theta_xor_33, state_in_24, state_in_34, theta_xor_row_2, theta_xor_row_3 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

// i = 4
// theta_xor_43 ^ state_in_44 = theta_xor_row_4
#[THETA_XOR_ROW_4]
sel_no_error { bitwise_xor_op_id, theta_xor_43, state_in_44, theta_xor_row_4, tag_u64, tag_u64 } in
bitwise.sel_keccak { bitwise.op_id, bitwise.ia, bitwise.ib, bitwise.ic, bitwise.tag_a, bitwise.tag_b };


//#############################################################################
//                  Theta XOR ROTL1 Computation
//#############################################################################

// The theta_xor_row_i's need to be left rotated by 1.
// We denote them by theta_xor_row_rotl1_i.

// To perform a rotation by 1 the following must hold (we denote theta_xor_row_rotl1_i as θ)
// 1) θ = 2^63 * msb + low_63
// 2) Θ_rot = 2 * low_63 + msb
// Re-arranging (1) we get low_63 = θ - 2^63 * msb and we substitute this into (2)
// Θ_rot = 2 * low_63 + msb = 2 * (θ - msb * 2^63) + msb
// Θ_rot = 2θ - (msb * 2^64) + msb
// Θ_rot = 2θ - msb * (2^64 - 1) --> this term does not contain low_63

// Intuition for how this works.
// - if msb = 0 then Θ_rot = 2θ (which is the definition of rotate left)
// - if msb = 1 then Θ_rot = 2θ - 2^64 + 1
//   -> if msb = 1, then θ is a 64-bit value so 2θ is a 65-bit value.
//   -> Subtracting 2^64 clears the MSB
//   -> Adding 1 sets the LSB

// It is sufficient to enforce theta_xor_row_msb_i to be boolean.
// No other range check is required as long as theta_xor_row_i and theta_xor_row_rotl1_i are
// 64-bit range-checked through the use of bitwise 64-bit operations. theta_xor_row_i was range-checked
// as the output of #[THETA_XOR_ROW_i] and theta_xor_row_rotl1_i will be range-checked as part of
// a XOR computation (#[THETA_COMBINED_XOR_i]) to compute the state values after theta.
// These two range checks force msb to match the actual MSB of theta_xor_row_i:
// - If msb=0 but MSB is 1: rotl1 = 2*θ >= 2^64, fails the 64-bit range check on rotl1.
// - If msb=1 but MSB is 0: rotl1 = 2*θ - 2^64 + 1< 0 (over integers), this underflows the field and fails range check

// ##################### THETA_XOR_ROW_ROTL1_0 ##############################
pol commit theta_xor_row_msb_0;
#[THETA_XOR_ROW_MSB_0_BOOLEAN]
theta_xor_row_msb_0 * (1 - theta_xor_row_msb_0) = 0;
pol commit theta_xor_row_rotl1_0;
#[THETA_XOR_ROW_ROTL1_0]
theta_xor_row_rotl1_0 = 2 * theta_xor_row_0 - theta_xor_row_msb_0 * (2**64 - 1);

// ##################### THETA_XOR_ROW_ROTL1_1 ##############################
pol commit theta_xor_row_msb_1;
#[THETA_XOR_ROW_MSB_1_BOOLEAN]
theta_xor_row_msb_1 * (1 - theta_xor_row_msb_1) = 0;
pol commit theta_xor_row_rotl1_1;
#[THETA_XOR_ROW_ROTL1_1]
theta_xor_row_rotl1_1 = 2 * theta_xor_row_1 - theta_xor_row_msb_1 * (2**64 - 1);

// ##################### THETA_XOR_ROW_ROTL1_2 ##############################
pol commit theta_xor_row_msb_2;
#[THETA_XOR_ROW_MSB_2_BOOLEAN]
theta_xor_row_msb_2 * (1 - theta_xor_row_msb_2) = 0;
pol commit theta_xor_row_rotl1_2;
#[THETA_XOR_ROW_ROTL1_2]
theta_xor_row_rotl1_2 = 2 * theta_xor_row_2 - theta_xor_row_msb_2 * (2**64 - 1);

// ##################### THETA_XOR_ROW_ROTL1_3 ##############################
pol commit theta_xor_row_msb_3;
#[THETA_XOR_ROW_MSB_3_BOOLEAN]
theta_xor_row_msb_3 * (1 - theta_xor_row_msb_3) = 0;
pol commit theta_xor_row_rotl1_3;
#[THETA_XOR_ROW_ROTL1_3]
theta_xor_row_rotl1_3 = 2 * theta_xor_row_3 - theta_xor_row_msb_3 * (2**64 - 1);

// ##################### THETA_XOR_ROW_ROTL1_4 ##############################
pol commit theta_xor_row_msb_4;
#[THETA_XOR_ROW_MSB_4_BOOLEAN]
theta_xor_row_msb_4 * (1 - theta_xor_row_msb_4) = 0;
pol commit theta_xor_row_rotl1_4;
#[THETA_XOR_ROW_ROTL1_4]
theta_xor_row_rotl1_4 = 2 * theta_xor_row_4 - theta_xor_row_msb_4 * (2**64 - 1);

//#############################################################################
//                  Theta XOR between two rows
//#############################################################################
// For each row i, we need to compute the xor between theta_xor_row_{i-1} with theta_xor_row_rotl1_{i+1}
// We denote the result as: theta_combined_xor_i.

pol commit theta_combined_xor[5];
// theta_combined_xor[i] = theta_xor_row[(i+4)%5] XOR rotl1(theta_xor_row[(i+1)%5]).
// We group into SIMD-64 pairs:
// - theta_combined_xor[0] and theta_combined_xor[1] comutations
// - theta_combined_xor[2] and theta_combined_xor[3] computations
#[THETA_COMBINED_XOR_SIMD_0]
sel_no_error { bitwise_xor_op_id, theta_xor_row_4, theta_xor_row_0, theta_xor_row_rotl1_1, theta_xor_row_rotl1_2, theta_combined_xor[0], theta_combined_xor[1] } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[THETA_COMBINED_XOR_SIMD_2]
sel_no_error { bitwise_xor_op_id, theta_xor_row_1, theta_xor_row_2, theta_xor_row_rotl1_3, theta_xor_row_rotl1_4, theta_combined_xor[2], theta_combined_xor[3] } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[THETA_COMBINED_XOR_4]
sel_no_error { bitwise_xor_op_id, theta_xor_row_3, theta_xor_row_rotl1_0, theta_combined_xor[4], tag_u64, tag_u64 } in
bitwise.sel_keccak { bitwise.op_id, bitwise.ia, bitwise.ib, bitwise.ic, bitwise.tag_a, bitwise.tag_b };

//#############################################################################
//                  State after Theta
//#############################################################################
// The state after theta is obtained by XORing each state word with the corresponding
// theta_combined_xor value.
// state_theta_ij = state_in_ij ^ theta_combined_xor_i
pol commit state_theta_00, state_theta_01, state_theta_02, state_theta_03, state_theta_04,
           state_theta_10, state_theta_11, state_theta_12, state_theta_13, state_theta_14,
           state_theta_20, state_theta_21, state_theta_22, state_theta_23, state_theta_24,
           state_theta_30, state_theta_31, state_theta_32, state_theta_33, state_theta_34,
           state_theta_40, state_theta_41, state_theta_42, state_theta_43, state_theta_44;

// state_theta[i][j] = state_in[i][j] XOR theta_combined_xor[i].
// SIMD-64: the 25 lanes are paired in flat order idx = 5*i + j (lanes (idx, idx+1) share one row,
// lane 0 = low/ia/ib/ic, lane 1 = high/ia_simd/ib_simd/ic_simd); the last lane 24 (state index 44) stays scalar.
// We group into SIMD-64 pairs:
// - state_theta_00 and state_theta_01 computations
// - state_theta_02 and state_theta_03 computations
// - state_theta_04 and state_theta_10 computations
// - state_theta_11 and state_theta_12 computations
// - state_theta_13 and state_theta_14 computations
// - ....
// - state_theta_42 and state_theta_43 computations
#[STATE_THETA_SIMD_00]
sel_no_error { bitwise_xor_op_id, state_in_00, state_in_01, theta_combined_xor[0], theta_combined_xor[0], state_theta_00, state_theta_01 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_02]
sel_no_error { bitwise_xor_op_id, state_in_02, state_in_03, theta_combined_xor[0], theta_combined_xor[0], state_theta_02, state_theta_03 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_04]
sel_no_error { bitwise_xor_op_id, state_in_04, state_in_10, theta_combined_xor[0], theta_combined_xor[1], state_theta_04, state_theta_10 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_11]
sel_no_error { bitwise_xor_op_id, state_in_11, state_in_12, theta_combined_xor[1], theta_combined_xor[1], state_theta_11, state_theta_12 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_13]
sel_no_error { bitwise_xor_op_id, state_in_13, state_in_14, theta_combined_xor[1], theta_combined_xor[1], state_theta_13, state_theta_14 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_20]
sel_no_error { bitwise_xor_op_id, state_in_20, state_in_21, theta_combined_xor[2], theta_combined_xor[2], state_theta_20, state_theta_21 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_22]
sel_no_error { bitwise_xor_op_id, state_in_22, state_in_23, theta_combined_xor[2], theta_combined_xor[2], state_theta_22, state_theta_23 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_24]
sel_no_error { bitwise_xor_op_id, state_in_24, state_in_30, theta_combined_xor[2], theta_combined_xor[3], state_theta_24, state_theta_30 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_31]
sel_no_error { bitwise_xor_op_id, state_in_31, state_in_32, theta_combined_xor[3], theta_combined_xor[3], state_theta_31, state_theta_32 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_33]
sel_no_error { bitwise_xor_op_id, state_in_33, state_in_34, theta_combined_xor[3], theta_combined_xor[3], state_theta_33, state_theta_34 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_40]
sel_no_error { bitwise_xor_op_id, state_in_40, state_in_41, theta_combined_xor[4], theta_combined_xor[4], state_theta_40, state_theta_41 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_THETA_SIMD_42]
sel_no_error { bitwise_xor_op_id, state_in_42, state_in_43, theta_combined_xor[4], theta_combined_xor[4], state_theta_42, state_theta_43 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

// Odd lane out (state index 44): plain scalar U64 bitwise lookup.
#[STATE_THETA_44]
sel_no_error { bitwise_xor_op_id, state_in_44, theta_combined_xor[4], state_theta_44, tag_u64, tag_u64 } in
bitwise.sel_keccak { bitwise.op_id, bitwise.ia, bitwise.ib, bitwise.ic, bitwise.tag_a, bitwise.tag_b };

//#############################################################################
//                      Rho round function
//#############################################################################
// Rho function consists in some left circular bit rotation of each state. The rotation
// length is a constant depending on the state indices.
// Reference: https://keccak.team/keccak_specs_summary.html#rotationOffsets
//    j  0  1   2   3   4
// i  ####################
// 0  #  0  36   3  41  18
// 1  #  1  44  10  45   2
// 2  # 62   6  43  15  61
// 3  # 28  55  25  21  56
// 4  # 27  20  39   8  14

// #################### ROTATION RELATED CONSTANTS ######################################
// Only the used power alias is kept per index:
//   rot <= 32: POW_ROT_LEN (used when hi is range-checked)
//   rot > 32:  POW_ROT_64_MIN_LEN (used when low is range-checked)
pol ROT_LEN_01 = 36;    pol POW_ROT_64_MIN_LEN_01 = 2**28;
pol ROT_LEN_02 = 3;     pol POW_ROT_LEN_02 = 2**3;
pol ROT_LEN_03 = 41;    pol POW_ROT_64_MIN_LEN_03 = 2**23;
pol ROT_LEN_04 = 18;    pol POW_ROT_LEN_04 = 2**18;

pol ROT_LEN_10 = 1;     pol POW_ROT_LEN_10 = 2**1;
pol ROT_LEN_11 = 44;    pol POW_ROT_64_MIN_LEN_11 = 2**20;
pol ROT_LEN_12 = 10;    pol POW_ROT_LEN_12 = 2**10;
pol ROT_LEN_13 = 45;    pol POW_ROT_64_MIN_LEN_13 = 2**19;
pol ROT_LEN_14 = 2;     pol POW_ROT_LEN_14 = 2**2;

pol ROT_LEN_20 = 62;    pol POW_ROT_64_MIN_LEN_20 = 2**2;
pol ROT_LEN_21 = 6;     pol POW_ROT_LEN_21 = 2**6;
pol ROT_LEN_22 = 43;    pol POW_ROT_64_MIN_LEN_22 = 2**21;
pol ROT_LEN_23 = 15;    pol POW_ROT_LEN_23 = 2**15;
pol ROT_LEN_24 = 61;    pol POW_ROT_64_MIN_LEN_24 = 2**3;

pol ROT_LEN_30 = 28;    pol POW_ROT_LEN_30 = 2**28;
pol ROT_LEN_31 = 55;    pol POW_ROT_64_MIN_LEN_31 = 2**9;
pol ROT_LEN_32 = 25;    pol POW_ROT_LEN_32 = 2**25;
pol ROT_LEN_33 = 21;    pol POW_ROT_LEN_33 = 2**21;
pol ROT_LEN_34 = 56;    pol POW_ROT_64_MIN_LEN_34 = 2**8;

pol ROT_LEN_40 = 27;    pol POW_ROT_LEN_40 = 2**27;
pol ROT_LEN_41 = 20;    pol POW_ROT_LEN_41 = 2**20;
pol ROT_LEN_42 = 39;    pol POW_ROT_64_MIN_LEN_42 = 2**25;
pol ROT_LEN_43 = 8;     pol POW_ROT_LEN_43 = 2**8;
pol ROT_LEN_44 = 14;    pol POW_ROT_LEN_44 = 2**14;

// #################### STATE AFTER RHO #################################################
pol commit               state_rho_01, state_rho_02, state_rho_03, state_rho_04,
           state_rho_10, state_rho_11, state_rho_12, state_rho_13, state_rho_14,
           state_rho_20, state_rho_21, state_rho_22, state_rho_23, state_rho_24,
           state_rho_30, state_rho_31, state_rho_32, state_rho_33, state_rho_34,
           state_rho_40, state_rho_41, state_rho_42, state_rho_43, state_rho_44;

// state_rho_00 is state_theta_00 rotated by 0, so state_rho_00 = state_theta_00
pol STATE_RHO_00 = state_theta_00;

// Rotation by a bits: decompose X = hi * 2^(64-a) + low, result Y = low * 2^a + hi.
// We algebraically eliminate the non-range-checked limb by combining decomposition and rotation:
//   From Y = low * 2^a + hi, substitute hi = Y - low * 2^a into X = hi * 2^(64-a) + low:
//     X = (Y - low * 2^a) * 2^(64-a) + low = Y * 2^(64-a) - low * 2^64 + low
//     X = Y * 2^(64-a) - low * (2^64 - 1)
//   Or substitute low = X - hi * 2^(64-a) into Y = low * 2^a + hi:
//     Y = (X - hi * 2^(64-a)) * 2^a + hi = X * 2^a - hi * 2^64 + hi
//     Y = X * 2^a - hi * (2^64 - 1)
// Soundness:
// Over the integers, X being 64 bits, a and Y being fixed, for any low < 2^(64 - a) the only
// possible expression for Y * 2^(64-a) - low * (2^64 - 1) to have two values in range [0,2^64)
// is for 0 and 2^64 - 1. Let us examine Y * 2^(64-a) == low * (2^64 - 1) over the integers.
//
//   a < 64: The equality only happens if low == 0 because 2^64 - 1 is odd,
//     low < 2^(64 - a) and therefore low * (2^64 - 1) cannot be a multiple of 2^(64-a).
//     Then the only solution is when low == 0, Y == 0 and X == 0. If Y == 0, then any
//     positive value of low would lead to a negative X. This shows the unicity of low when
//     being constrained to (64-a) bits.
//   a == 64: By definition, low == 0 (constrained < 2^0) and Y == 0 which leads to a
//     unique solution.
//
// By symmetry, we only substitute a by 64 - a in the first proof and we get the same
// unicity result.
//
// For rot <= 32: hi is range-checked, low is eliminated.
//   state_rho = POW_ROT_LEN * state_theta - state_theta_hi * (2**64 - 1)
// For rot > 32: low is range-checked, hi is eliminated.
//   state_theta = POW_ROT_64_MIN_LEN * state_rho - state_theta_low * (2**64 - 1)

// hi columns (kept only for rot <= 32 indices: 02, 04, 10, 12, 14, 21, 23, 30, 32, 33, 40, 41, 43, 44)
pol commit state_theta_hi_02, state_theta_hi_04,
           state_theta_hi_10, state_theta_hi_12, state_theta_hi_14,
           state_theta_hi_21, state_theta_hi_23,
           state_theta_hi_30, state_theta_hi_32, state_theta_hi_33,
           state_theta_hi_40, state_theta_hi_41, state_theta_hi_43, state_theta_hi_44;

// low columns (kept only for rot > 32 indices: 01, 03, 11, 13, 20, 22, 24, 31, 34, 42)
pol commit state_theta_low_01, state_theta_low_03,
           state_theta_low_11, state_theta_low_13,
           state_theta_low_20, state_theta_low_22, state_theta_low_24,
           state_theta_low_31, state_theta_low_34,
           state_theta_low_42;


// rot > 32: state_theta = POW_ROT_64_MIN_LEN * state_rho - state_theta_low * (2**64 - 1)
#[STATE_RHO_01]
state_theta_01 = POW_ROT_64_MIN_LEN_01 * state_rho_01 - state_theta_low_01 * (2**64 - 1);

// rot <= 32: state_rho = POW_ROT_LEN * state_theta - state_theta_hi * (2**64 - 1)
#[STATE_RHO_02]
state_rho_02 = POW_ROT_LEN_02 * state_theta_02 - state_theta_hi_02 * (2**64 - 1);

// rot > 32
#[STATE_RHO_03]
state_theta_03 = POW_ROT_64_MIN_LEN_03 * state_rho_03 - state_theta_low_03 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_04]
state_rho_04 = POW_ROT_LEN_04 * state_theta_04 - state_theta_hi_04 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_10]
state_rho_10 = POW_ROT_LEN_10 * state_theta_10 - state_theta_hi_10 * (2**64 - 1);

// rot > 32
#[STATE_RHO_11]
state_theta_11 = POW_ROT_64_MIN_LEN_11 * state_rho_11 - state_theta_low_11 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_12]
state_rho_12 = POW_ROT_LEN_12 * state_theta_12 - state_theta_hi_12 * (2**64 - 1);

// rot > 32
#[STATE_RHO_13]
state_theta_13 = POW_ROT_64_MIN_LEN_13 * state_rho_13 - state_theta_low_13 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_14]
state_rho_14 = POW_ROT_LEN_14 * state_theta_14 - state_theta_hi_14 * (2**64 - 1);

// rot > 32
#[STATE_RHO_20]
state_theta_20 = POW_ROT_64_MIN_LEN_20 * state_rho_20 - state_theta_low_20 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_21]
state_rho_21 = POW_ROT_LEN_21 * state_theta_21 - state_theta_hi_21 * (2**64 - 1);

// rot > 32
#[STATE_RHO_22]
state_theta_22 = POW_ROT_64_MIN_LEN_22 * state_rho_22 - state_theta_low_22 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_23]
state_rho_23 = POW_ROT_LEN_23 * state_theta_23 - state_theta_hi_23 * (2**64 - 1);

// rot > 32
#[STATE_RHO_24]
state_theta_24 = POW_ROT_64_MIN_LEN_24 * state_rho_24 - state_theta_low_24 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_30]
state_rho_30 = POW_ROT_LEN_30 * state_theta_30 - state_theta_hi_30 * (2**64 - 1);

// rot > 32
#[STATE_RHO_31]
state_theta_31 = POW_ROT_64_MIN_LEN_31 * state_rho_31 - state_theta_low_31 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_32]
state_rho_32 = POW_ROT_LEN_32 * state_theta_32 - state_theta_hi_32 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_33]
state_rho_33 = POW_ROT_LEN_33 * state_theta_33 - state_theta_hi_33 * (2**64 - 1);

// rot > 32
#[STATE_RHO_34]
state_theta_34 = POW_ROT_64_MIN_LEN_34 * state_rho_34 - state_theta_low_34 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_40]
state_rho_40 = POW_ROT_LEN_40 * state_theta_40 - state_theta_hi_40 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_41]
state_rho_41 = POW_ROT_LEN_41 * state_theta_41 - state_theta_hi_41 * (2**64 - 1);

// rot > 32
#[STATE_RHO_42]
state_theta_42 = POW_ROT_64_MIN_LEN_42 * state_rho_42 - state_theta_low_42 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_43]
state_rho_43 = POW_ROT_LEN_43 * state_theta_43 - state_theta_hi_43 * (2**64 - 1);

// rot <= 32
#[STATE_RHO_44]
state_rho_44 = POW_ROT_LEN_44 * state_theta_44 - state_theta_hi_44 * (2**64 - 1);


// Range check constraints for the range-checked limb of the rotation.
// For a <= 32, we range check state_theta_hi < 2^a
// For a > 32, we range check state_theta_low < 2^(64-a)
// state_theta_ij's are 64-bit via [#STATE_THETA_ij] bitwise lookup.
// state_rho_ij's are 64-bit via bitwise lookups during chi.

// Rotations with length <= 32:
// Indices:  02, 04, 10, 12, 14, 21, 23, 30, 32, 33, 40, 41, 43, 44
// Length:    3, 18   1, 10,  2,  6, 15, 28, 25, 21, 27, 20,  8, 14
// Range check state_theta_hi_ij < 2^{ROT_LEN_ij}

pol commit rot_len_02;
sel * (rot_len_02 - ROT_LEN_02) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_02_RANGE]
sel_no_error { state_theta_hi_02, rot_len_02 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_04;
sel * (rot_len_04 - ROT_LEN_04) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_04_RANGE]
sel_no_error { state_theta_hi_04, rot_len_04 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_10;
sel * (rot_len_10 - ROT_LEN_10) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_10_RANGE]
sel_no_error { state_theta_hi_10, rot_len_10 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_12;
sel * (rot_len_12 - ROT_LEN_12) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_12_RANGE]
sel_no_error { state_theta_hi_12, rot_len_12 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_14;
sel * (rot_len_14 - ROT_LEN_14) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_14_RANGE]
sel_no_error { state_theta_hi_14, rot_len_14 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_21;
sel * (rot_len_21 - ROT_LEN_21) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_21_RANGE]
sel_no_error { state_theta_hi_21, rot_len_21 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_23;
sel * (rot_len_23 - ROT_LEN_23) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_23_RANGE]
sel_no_error { state_theta_hi_23, rot_len_23 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_30;
sel * (rot_len_30 - ROT_LEN_30) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_30_RANGE]
sel_no_error { state_theta_hi_30, rot_len_30 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_32;
sel * (rot_len_32 - ROT_LEN_32) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_32_RANGE]
sel_no_error { state_theta_hi_32, rot_len_32 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_33;
sel * (rot_len_33 - ROT_LEN_33) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_33_RANGE]
sel_no_error { state_theta_hi_33, rot_len_33 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_40;
sel * (rot_len_40 - ROT_LEN_40) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_40_RANGE]
sel_no_error { state_theta_hi_40, rot_len_40 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_41;
sel * (rot_len_41 - ROT_LEN_41) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_41_RANGE]
sel_no_error { state_theta_hi_41, rot_len_41 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_43;
sel * (rot_len_43 - ROT_LEN_43) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_43_RANGE]
sel_no_error { state_theta_hi_43, rot_len_43 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_len_44;
sel * (rot_len_44 - ROT_LEN_44) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_44_RANGE]
sel_no_error { state_theta_hi_44, rot_len_44 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

// Rotations with length > 32:
// Indices:  01, 03, 11, 13, 20, 22, 24, 31, 34, 42
// Length:   36, 41, 44, 45, 62, 43, 61, 55, 56, 39
// Range check state_theta_lo_ij < 2^{64 - ROT_LEN_ij}

pol commit rot_64_min_len_01;
sel * (rot_64_min_len_01 - (64 - ROT_LEN_01)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_01_RANGE]
sel_no_error { state_theta_low_01, rot_64_min_len_01 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_64_min_len_03;
sel * (rot_64_min_len_03 - (64 - ROT_LEN_03)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_03_RANGE]
sel_no_error { state_theta_low_03, rot_64_min_len_03 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_64_min_len_11;
sel * (rot_64_min_len_11 - (64 - ROT_LEN_11)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_11_RANGE]
sel_no_error { state_theta_low_11, rot_64_min_len_11 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_64_min_len_13;
sel * (rot_64_min_len_13 - (64 - ROT_LEN_13)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_13_RANGE]
sel_no_error { state_theta_low_13, rot_64_min_len_13 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_64_min_len_20;
sel * (rot_64_min_len_20 - (64 - ROT_LEN_20)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_20_RANGE]
sel_no_error { state_theta_low_20, rot_64_min_len_20 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_64_min_len_22;
sel * (rot_64_min_len_22 - (64 - ROT_LEN_22)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_22_RANGE]
sel_no_error { state_theta_low_22, rot_64_min_len_22 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_64_min_len_24;
sel * (rot_64_min_len_24 - (64 - ROT_LEN_24)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_24_RANGE]
sel_no_error { state_theta_low_24, rot_64_min_len_24 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_64_min_len_31;
sel * (rot_64_min_len_31 - (64 - ROT_LEN_31)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_31_RANGE]
sel_no_error { state_theta_low_31, rot_64_min_len_31 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_64_min_len_34;
sel * (rot_64_min_len_34 - (64 - ROT_LEN_34)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_34_RANGE]
sel_no_error { state_theta_low_34, rot_64_min_len_34 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

pol commit rot_64_min_len_42;
sel * (rot_64_min_len_42 - (64 - ROT_LEN_42)) = 0; // Lookup constant support: Can be removed when we support constants in lookups.
#[THETA_LIMB_42_RANGE]
sel_no_error { state_theta_low_42, rot_64_min_len_42 } in range_check.sel_keccak { range_check.value, range_check.rng_chk_bits };

//#############################################################################
//                      Pi round function
//#############################################################################
// Pi function is purely permuting the state rho elements among each other so that
// there is no constraints to be added here. Namely, we will have to re-map the
// state elements correctly for the next function chi.
// The permutation is defined as: OUT[j][(2*i + 3*j) % 5] = IN[i][j]
// The inverse operation is: OUT[i][j] = IN[(i + 3*j) % 5][i]
// If we apply this permutation to state_rho_ij and denote the output STATE_PI_ij, we get:

pol STATE_PI_00 = STATE_RHO_00;
pol STATE_PI_01 = state_rho_30;
pol STATE_PI_02 = state_rho_10;
pol STATE_PI_03 = state_rho_40;
pol STATE_PI_04 = state_rho_20;

pol STATE_PI_10 = state_rho_11;
pol STATE_PI_11 = state_rho_41;
pol STATE_PI_12 = state_rho_21;
pol STATE_PI_13 = state_rho_01;
pol STATE_PI_14 = state_rho_31;

pol STATE_PI_20 = state_rho_22;
pol STATE_PI_21 = state_rho_02;
pol STATE_PI_22 = state_rho_32;
pol STATE_PI_23 = state_rho_12;
pol STATE_PI_24 = state_rho_42;

pol STATE_PI_30 = state_rho_33;
pol STATE_PI_31 = state_rho_13;
pol STATE_PI_32 = state_rho_43;
pol STATE_PI_33 = state_rho_23;
pol STATE_PI_34 = state_rho_03;

pol STATE_PI_40 = state_rho_44;
pol STATE_PI_41 = state_rho_24;
pol STATE_PI_42 = state_rho_04;
pol STATE_PI_43 = state_rho_34;
pol STATE_PI_44 = state_rho_14;

//#############################################################################
//                      Chi round function
//#############################################################################
// For each i,j, Chi function computes:
// state_chi_ij = state_pi_ij ^ ((NOT state_pi_{i+1,j}) & state_pi_{i+2,j})
// Note: All indicies are performed mod 5.
//
// We will use the following intermediate states:
// state_pi_not_ij = ~state_pi_ij
// state_pi_and_ij = state_pi_not_{i+1,j} && state_pi_{i+2,j}
// state_chi_ij = state_pi_ij ^ state_pi_and_ij
//
//#################### NOT Computation ########################################
// NOT computation for a 64-bit integer x amounts to: 2^64 - 1 - x
pol POW_64_MIN_1 = 2**64 - 1;

pol commit state_pi_not_00, state_pi_not_01, state_pi_not_02, state_pi_not_03, state_pi_not_04,
           state_pi_not_10, state_pi_not_11, state_pi_not_12, state_pi_not_13, state_pi_not_14,
           state_pi_not_20, state_pi_not_21, state_pi_not_22, state_pi_not_23, state_pi_not_24,
           state_pi_not_30, state_pi_not_31, state_pi_not_32, state_pi_not_33, state_pi_not_34,
           state_pi_not_40, state_pi_not_41, state_pi_not_42, state_pi_not_43, state_pi_not_44;

// As state_pi_ij are not committed columns, the constraints need to be gated by sel_no_error
// so they are set to 0 when inactive.

#[STATE_PI_NOT_00]
state_pi_not_00 = sel_no_error * (POW_64_MIN_1 - STATE_PI_00);
#[STATE_PI_NOT_01]
state_pi_not_01 = sel_no_error * (POW_64_MIN_1 - STATE_PI_01);
#[STATE_PI_NOT_02]
state_pi_not_02 = sel_no_error * (POW_64_MIN_1 - STATE_PI_02);
#[STATE_PI_NOT_03]
state_pi_not_03 = sel_no_error * (POW_64_MIN_1 - STATE_PI_03);
#[STATE_PI_NOT_04]
state_pi_not_04 = sel_no_error * (POW_64_MIN_1 - STATE_PI_04);

#[STATE_PI_NOT_10]
state_pi_not_10 = sel_no_error * (POW_64_MIN_1 - STATE_PI_10);
#[STATE_PI_NOT_11]
state_pi_not_11 = sel_no_error * (POW_64_MIN_1 - STATE_PI_11);
#[STATE_PI_NOT_12]
state_pi_not_12 = sel_no_error * (POW_64_MIN_1 - STATE_PI_12);
#[STATE_PI_NOT_13]
state_pi_not_13 = sel_no_error * (POW_64_MIN_1 - STATE_PI_13);
#[STATE_PI_NOT_14]
state_pi_not_14 = sel_no_error * (POW_64_MIN_1 - STATE_PI_14);

#[STATE_PI_NOT_20]
state_pi_not_20 = sel_no_error * (POW_64_MIN_1 - STATE_PI_20);
#[STATE_PI_NOT_21]
state_pi_not_21 = sel_no_error * (POW_64_MIN_1 - STATE_PI_21);
#[STATE_PI_NOT_22]
state_pi_not_22 = sel_no_error * (POW_64_MIN_1 - STATE_PI_22);
#[STATE_PI_NOT_23]
state_pi_not_23 = sel_no_error * (POW_64_MIN_1 - STATE_PI_23);
#[STATE_PI_NOT_24]
state_pi_not_24 = sel_no_error * (POW_64_MIN_1 - STATE_PI_24);

#[STATE_PI_NOT_30]
state_pi_not_30 = sel_no_error * (POW_64_MIN_1 - STATE_PI_30);
#[STATE_PI_NOT_31]
state_pi_not_31 = sel_no_error * (POW_64_MIN_1 - STATE_PI_31);
#[STATE_PI_NOT_32]
state_pi_not_32 = sel_no_error * (POW_64_MIN_1 - STATE_PI_32);
#[STATE_PI_NOT_33]
state_pi_not_33 = sel_no_error * (POW_64_MIN_1 - STATE_PI_33);
#[STATE_PI_NOT_34]
state_pi_not_34 = sel_no_error * (POW_64_MIN_1 - STATE_PI_34);

#[STATE_PI_NOT_40]
state_pi_not_40 = sel_no_error * (POW_64_MIN_1 - STATE_PI_40);
#[STATE_PI_NOT_41]
state_pi_not_41 = sel_no_error * (POW_64_MIN_1 - STATE_PI_41);
#[STATE_PI_NOT_42]
state_pi_not_42 = sel_no_error * (POW_64_MIN_1 - STATE_PI_42);
#[STATE_PI_NOT_43]
state_pi_not_43 = sel_no_error * (POW_64_MIN_1 - STATE_PI_43);
#[STATE_PI_NOT_44]
state_pi_not_44 = sel_no_error * (POW_64_MIN_1 - STATE_PI_44);

//#################### AND Computation ########################################
// state_pi_and_ij = state_pi_not_{i+1,j} AND state_pi_{i+2,j}
//
// We do not support aliases in lookups and therefore we need to manually
// re-map the term state_pi_{i+2,j} as state_rho_XX accordingly.

pol commit state_pi_and_00, state_pi_and_01, state_pi_and_02, state_pi_and_03, state_pi_and_04,
           state_pi_and_10, state_pi_and_11, state_pi_and_12, state_pi_and_13, state_pi_and_14,
           state_pi_and_20, state_pi_and_21, state_pi_and_22, state_pi_and_23, state_pi_and_24,
           state_pi_and_30, state_pi_and_31, state_pi_and_32, state_pi_and_33, state_pi_and_34,
           state_pi_and_40, state_pi_and_41, state_pi_and_42, state_pi_and_43, state_pi_and_44;

// STATE_PI_20 = state_rho_22
// state_pi_and[i][j] = NOT(pi[(i+1)%5][j]) AND pi[(i+2)%5][j]. SIMD-64 pairs flat idx 5i+j; last lane 24 (state index 44) scalar.
// We group into SIMD-64 pairs:
// - state_pi_and_00 and state_pi_and_01 computations
// - state_pi_and_02 and state_pi_and_03 computations
// - state_pi_and_04 and state_pi_and_10 computations
// - state_pi_and_11 and state_pi_and_12 computations
// - state_pi_and_22 and state_pi_and_23 computations
// ....
// - state_pi_and_42 and state_pi_and_43 computations
#[STATE_PI_AND_SIMD_00]
sel_no_error { bitwise_and_op_id, state_pi_not_10, state_pi_not_11, state_rho_22, state_rho_02, state_pi_and_00, state_pi_and_01 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_02]
sel_no_error { bitwise_and_op_id, state_pi_not_12, state_pi_not_13, state_rho_32, state_rho_12, state_pi_and_02, state_pi_and_03 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_04]
sel_no_error { bitwise_and_op_id, state_pi_not_14, state_pi_not_20, state_rho_42, state_rho_33, state_pi_and_04, state_pi_and_10 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_11]
sel_no_error { bitwise_and_op_id, state_pi_not_21, state_pi_not_22, state_rho_13, state_rho_43, state_pi_and_11, state_pi_and_12 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_13]
sel_no_error { bitwise_and_op_id, state_pi_not_23, state_pi_not_24, state_rho_23, state_rho_03, state_pi_and_13, state_pi_and_14 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_20]
sel_no_error { bitwise_and_op_id, state_pi_not_30, state_pi_not_31, state_rho_44, state_rho_24, state_pi_and_20, state_pi_and_21 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_22]
sel_no_error { bitwise_and_op_id, state_pi_not_32, state_pi_not_33, state_rho_04, state_rho_34, state_pi_and_22, state_pi_and_23 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_24]
sel_no_error { bitwise_and_op_id, state_pi_not_34, state_pi_not_40, state_rho_14, state_theta_00, state_pi_and_24, state_pi_and_30 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_31]
sel_no_error { bitwise_and_op_id, state_pi_not_41, state_pi_not_42, state_rho_30, state_rho_10, state_pi_and_31, state_pi_and_32 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_33]
sel_no_error { bitwise_and_op_id, state_pi_not_43, state_pi_not_44, state_rho_40, state_rho_20, state_pi_and_33, state_pi_and_34 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_40]
sel_no_error { bitwise_and_op_id, state_pi_not_00, state_pi_not_01, state_rho_11, state_rho_41, state_pi_and_40, state_pi_and_41 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_SIMD_42]
sel_no_error { bitwise_and_op_id, state_pi_not_02, state_pi_not_03, state_rho_21, state_rho_01, state_pi_and_42, state_pi_and_43 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_PI_AND_44]
sel_no_error { bitwise_and_op_id, state_pi_not_04, state_rho_31, state_pi_and_44, tag_u64, tag_u64 } in
bitwise.sel_keccak { bitwise.op_id, bitwise.ia, bitwise.ib, bitwise.ic, bitwise.tag_a, bitwise.tag_b };

//#################### chi final XOR Computation ########################################
// state_chi_ij = state_pi_ij ^ state_pi_and_ij

pol commit state_chi_00, state_chi_01, state_chi_02, state_chi_03, state_chi_04,
           state_chi_10, state_chi_11, state_chi_12, state_chi_13, state_chi_14,
           state_chi_20, state_chi_21, state_chi_22, state_chi_23, state_chi_24,
           state_chi_30, state_chi_31, state_chi_32, state_chi_33, state_chi_34,
           state_chi_40, state_chi_41, state_chi_42, state_chi_43, state_chi_44;

// STATE_PI_00 = STATE_RHO_00 = state_theta_00
// state_chi[i][j] = pi[i][j] XOR state_pi_and[i][j]. SIMD-64 pairs flat idx 5i+j; last lane 24 (state index 44) scalar.
// We group into SIMD-64 pairs:
// - state_chi_00 and state_chi_01 computations
// - state_chi_02 and state_chi_03 computations
// - state_chi_04 and state_chi_10 computations
// - state_chi_11 and state_chi_12 computations
// - state_chi_13 and state_chi_14 computations
// - ....
// - state_chi_42 and state_chi_43 computations
#[STATE_CHI_SIMD_00]
sel_no_error { bitwise_xor_op_id, state_theta_00, state_rho_30, state_pi_and_00, state_pi_and_01, state_chi_00, state_chi_01 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_02]
sel_no_error { bitwise_xor_op_id, state_rho_10, state_rho_40, state_pi_and_02, state_pi_and_03, state_chi_02, state_chi_03 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_04]
sel_no_error { bitwise_xor_op_id, state_rho_20, state_rho_11, state_pi_and_04, state_pi_and_10, state_chi_04, state_chi_10 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_11]
sel_no_error { bitwise_xor_op_id, state_rho_41, state_rho_21, state_pi_and_11, state_pi_and_12, state_chi_11, state_chi_12 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_13]
sel_no_error { bitwise_xor_op_id, state_rho_01, state_rho_31, state_pi_and_13, state_pi_and_14, state_chi_13, state_chi_14 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_20]
sel_no_error { bitwise_xor_op_id, state_rho_22, state_rho_02, state_pi_and_20, state_pi_and_21, state_chi_20, state_chi_21 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_22]
sel_no_error { bitwise_xor_op_id, state_rho_32, state_rho_12, state_pi_and_22, state_pi_and_23, state_chi_22, state_chi_23 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_24]
sel_no_error { bitwise_xor_op_id, state_rho_42, state_rho_33, state_pi_and_24, state_pi_and_30, state_chi_24, state_chi_30 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_31]
sel_no_error { bitwise_xor_op_id, state_rho_13, state_rho_43, state_pi_and_31, state_pi_and_32, state_chi_31, state_chi_32 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_33]
sel_no_error { bitwise_xor_op_id, state_rho_23, state_rho_03, state_pi_and_33, state_pi_and_34, state_chi_33, state_chi_34 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_40]
sel_no_error { bitwise_xor_op_id, state_rho_44, state_rho_24, state_pi_and_40, state_pi_and_41, state_chi_40, state_chi_41 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_SIMD_42]
sel_no_error { bitwise_xor_op_id, state_rho_04, state_rho_34, state_pi_and_42, state_pi_and_43, state_chi_42, state_chi_43 } in
bitwise.sel_simd_64 { bitwise.op_id, bitwise.ia, bitwise.ia_simd, bitwise.ib, bitwise.ib_simd, bitwise.ic, bitwise.ic_simd };

#[STATE_CHI_44]
sel_no_error { bitwise_xor_op_id, state_rho_14, state_pi_and_44, state_chi_44, tag_u64, tag_u64 } in
bitwise.sel_keccak { bitwise.op_id, bitwise.ia, bitwise.ib, bitwise.ic, bitwise.tag_a, bitwise.tag_b };

//#############################################################################
//                      Iota round function
//#############################################################################
// Iota function XORs the state_chi_00 word with a round constant.
// state_iota_00 = state_chi_00 ^ round_cst
// round_cst depends on the round number and is fetched through a lookup from precomputed sub-trace.
// The other state words remain unchanged.
// state_iota_ij = state_chi_ij for (i,j) != (0,0)

pol commit round_cst;
pol commit state_iota_00;

#[ROUND_CST]
sel_no_error { round, round_cst } in precomputed.sel_keccak { precomputed.idx, precomputed.keccak_round_constant };

#[STATE_IOTA_00]
sel_no_error { bitwise_xor_op_id, state_chi_00, round_cst, state_iota_00, tag_u64, tag_u64 } in
bitwise.sel_keccak { bitwise.op_id, bitwise.ia, bitwise.ib, bitwise.ic, bitwise.tag_a, bitwise.tag_b };

//#############################################################################
//                      Next state Inputs OR Outputs
//#############################################################################
// If end == 1, state_iota_00 and state_chi_ij's for (i,j) != (0,0) are
// the output state, otherwise we set the next state_in values for the next round with the current state

#[NEXT_STATE_IN_00]
(1 - LATCH_CONDITION) * (state_in_00' - state_iota_00) = 0;
#[NEXT_STATE_IN_01]
(1 - LATCH_CONDITION) * (state_in_01' - state_chi_01) = 0;
#[NEXT_STATE_IN_02]
(1 - LATCH_CONDITION) * (state_in_02' - state_chi_02) = 0;
#[NEXT_STATE_IN_03]
(1 - LATCH_CONDITION) * (state_in_03' - state_chi_03) = 0;
#[NEXT_STATE_IN_04]
(1 - LATCH_CONDITION) * (state_in_04' - state_chi_04) = 0;

#[NEXT_STATE_IN_10]
(1 - LATCH_CONDITION) * (state_in_10' - state_chi_10) = 0;
#[NEXT_STATE_IN_11]
(1 - LATCH_CONDITION) * (state_in_11' - state_chi_11) = 0;
#[NEXT_STATE_IN_12]
(1 - LATCH_CONDITION) * (state_in_12' - state_chi_12) = 0;
#[NEXT_STATE_IN_13]
(1 - LATCH_CONDITION) * (state_in_13' - state_chi_13) = 0;
#[NEXT_STATE_IN_14]
(1 - LATCH_CONDITION) * (state_in_14' - state_chi_14) = 0;

#[NEXT_STATE_IN_20]
(1 - LATCH_CONDITION) * (state_in_20' - state_chi_20) = 0;
#[NEXT_STATE_IN_21]
(1 - LATCH_CONDITION) * (state_in_21' - state_chi_21) = 0;
#[NEXT_STATE_IN_22]
(1 - LATCH_CONDITION) * (state_in_22' - state_chi_22) = 0;
#[NEXT_STATE_IN_23]
(1 - LATCH_CONDITION) * (state_in_23' - state_chi_23) = 0;
#[NEXT_STATE_IN_24]
(1 - LATCH_CONDITION) * (state_in_24' - state_chi_24) = 0;

#[NEXT_STATE_IN_30]
(1 - LATCH_CONDITION) * (state_in_30' - state_chi_30) = 0;
#[NEXT_STATE_IN_31]
(1 - LATCH_CONDITION) * (state_in_31' - state_chi_31) = 0;
#[NEXT_STATE_IN_32]
(1 - LATCH_CONDITION) * (state_in_32' - state_chi_32) = 0;
#[NEXT_STATE_IN_33]
(1 - LATCH_CONDITION) * (state_in_33' - state_chi_33) = 0;
#[NEXT_STATE_IN_34]
(1 - LATCH_CONDITION) * (state_in_34' - state_chi_34) = 0;

#[NEXT_STATE_IN_40]
(1 - LATCH_CONDITION) * (state_in_40' - state_chi_40) = 0;
#[NEXT_STATE_IN_41]
(1 - LATCH_CONDITION) * (state_in_41' - state_chi_41) = 0;
#[NEXT_STATE_IN_42]
(1 - LATCH_CONDITION) * (state_in_42' - state_chi_42) = 0;
#[NEXT_STATE_IN_43]
(1 - LATCH_CONDITION) * (state_in_43' - state_chi_43) = 0;
#[NEXT_STATE_IN_44]
(1 - LATCH_CONDITION) * (state_in_44' - state_chi_44) = 0;

//#############################################################################
//                  Read-Write to memory slice and error handling
//#############################################################################
pol commit clk;
pol commit src_addr;
pol commit dst_addr;
pol commit space_id;
pol commit tag_error; // Constrained to be boolean in keccak_memory.pil
pol commit src_out_of_range_error; // Constrained to be boolean by the lookup into gt. (provided that start == 1).
pol commit dst_out_of_range_error; // Constrained to be boolean by the lookup into gt. (provided that start == 1).
pol commit error;

// Note that errors are only relevant at row where start == 1.
// On the other rows, they are underconstrained.

pol HIGHEST_SLICE_ADDRESS = constants.AVM_HIGHEST_MEM_ADDRESS - constants.AVM_KECCAKF1600_STATE_SIZE + 1;
// Lookup constant support: Can be removed when we support constants in lookups.
pol commit highest_slice_address;
start * (highest_slice_address - HIGHEST_SLICE_ADDRESS) = 0;

// Preconditions to `gt` gadget require both inputs to be bounded by 2^128.
// `src_addr` and `dst_addr` are addresses (< 2^32 by addressing resolution).
// In execution spec table, KECCAKF1600 has `num_addresses = 2`, so `rop[0] == dst_addr`
// and `rop[1] == src_addr` are addresses (< 2^32).
// `highest_slice_address` = AVM_HIGHEST_MEM_ADDRESS - AVM_KECCAKF1600_STATE_SIZE + 1 which is < 2^32.
// start == 1 ==> [src_out_of_range_error == 1 <==> src_addr > HIGHEST_SLICE_ADDRESS]
#[SRC_OUT_OF_RANGE_TOGGLE]
start { src_addr, highest_slice_address, src_out_of_range_error } in gt.sel_others { gt.input_a, gt.input_b, gt.res };

// start == 1 ==> [dst_out_of_range_error == 1 <==> dst_addr > HIGHEST_SLICE_ADDRESS]
#[DST_OUT_OF_RANGE_TOGGLE]
start { dst_addr, highest_slice_address, dst_out_of_range_error } in gt.sel_others { gt.input_a, gt.input_b, gt.res };

// error = src_out_of_range_error || dst_out_of_range_error || tag_error
// boolean by definition
// Even though tag_error is constrained to be boolean in keccak_memory.pil,
// there is no read/write slice permutation whenever src_out_of_range_error == 1
// or dst_out_of_range_error == 1. In this case, tag_error could take any value.
// It does not affect the value of error though.
#[ERROR]
error = 1 - (1 - src_out_of_range_error) * (1 - dst_out_of_range_error) * (1 - tag_error);

#[DST_ADDR_PROPAGATION]
(1 - LATCH_CONDITION) * (dst_addr' - dst_addr) = 0;
#[CLK_PROPAGATION]
(1 - LATCH_CONDITION) * (clk' - clk) = 0;
#[SPACE_ID_PROPAGATION]
(1 - LATCH_CONDITION) * (space_id' - space_id) = 0;

// It is crucial to propagate sel_no_error to the bottom (end == 1) as to properly
// activate the slice write lookup (see below).
#[SEL_NO_ERROR_PROPAGATION]
(1 - LATCH_CONDITION) * (sel_no_error' - sel_no_error) = 0;

// Note that we do not propagate src_out_of_range_error, dst_out_of_range_error, tag_error, error
// as they are not affecting constraints in the other rows. Error propagation to the caller
// is performed through a lookup with destination selector `start`.

// We disable slice read and write whenever the read or write slice is out of range.
// This means that state_in_ij's on start row are completely unconstrained. This does not
// matter as we return an error anyway. In this case, witness generation will fill these
// values with zeros.
pol commit sel_slice_read;
pol commit sel_slice_write;
#[SEL_SLICE_READ]
sel_slice_read = start * (1 - src_out_of_range_error) * (1 - dst_out_of_range_error);
#[SEL_SLICE_WRITE]
sel_slice_write = sel_no_error * end;

// Prevention of illegitimate writes to memory:
// sel_slice_write == 1 ==> round == 24 (by #[ROUND_COUNT_AT_WRITE])
// Since sel_slice_write = sel_no_error * end, we have `end == 1` and `sel_no_error == 1`.
// From #[SEL_ON_START_OR_END], `end == 1` implies `sel == 1`.
// This row must have `start == 0` because otherwise `round` would be equal to 1 instead of 24.
// As a consequence, the previous row must have `LATCH_CONDITION == 0` by #[START_AFTER_LATCH]
// which enforces a bottom-up propagation of `sel_no_error` and a decreasing counter for `round`
// by #[SEL_NO_ERROR_PROPAGATION] and #[KECCAK_ROUND_INCREMENT]. When the propagation reaches
// `round == 1`, we have two possible cases:
// 1) The row above is `precomputed.first_row == 1` which implies that `start == 1`.
// 2) Otherwise, by #[TRACE_CONTINUITY], the above row must be active (sel == 1)
//    and we cannot decrement `round` anymore (would be zero, contradicting `start * (round - 1) = 0`
//    and #[KECCAK_ROUND_INCREMENT]). As a consequence, the above row must have
//    `end == LATCH_CONDITION == 1` which implies that `start == 1` on the current row.
// This shows that any "slice write to memory" operation was triggered by a legitimate keccak permutation
// because `start` is the destination selector for the keccak permutation.

#[READ_TO_SLICE]
// Standard Keccak layout: memory[(y * 5) + x] = A[x][y]
// State columns ordered in column-major order (by x coordinate first, then y)
sel_slice_read { state_in_00, state_in_10, state_in_20, state_in_30, state_in_40,
                 state_in_01, state_in_11, state_in_21, state_in_31, state_in_41,
                 state_in_02, state_in_12, state_in_22, state_in_32, state_in_42,
                 state_in_03, state_in_13, state_in_23, state_in_33, state_in_43,
                 state_in_04, state_in_14, state_in_24, state_in_34, state_in_44,
                 clk, src_addr, space_id, tag_error }
is
keccak_memory.start_read { keccak_memory.val[0], keccak_memory.val[1], keccak_memory.val[2], keccak_memory.val[3], keccak_memory.val[4],
                           keccak_memory.val[5], keccak_memory.val[6], keccak_memory.val[7], keccak_memory.val[8], keccak_memory.val[9],
                           keccak_memory.val[10], keccak_memory.val[11], keccak_memory.val[12], keccak_memory.val[13], keccak_memory.val[14],
                           keccak_memory.val[15], keccak_memory.val[16], keccak_memory.val[17], keccak_memory.val[18], keccak_memory.val[19],
                           keccak_memory.val[20], keccak_memory.val[21], keccak_memory.val[22], keccak_memory.val[23], keccak_memory.val[24],
                           keccak_memory.clk, keccak_memory.addr, keccak_memory.space_id, keccak_memory.tag_error };


#[ROUND_COUNT_AT_WRITE]
sel_slice_write * (round - constants.AVM_KECCAKF1600_NUM_ROUNDS) = 0;

// Lookup constant support: Can be replaced with keccak_memory.num_rounds when we support constants in lookups.
#[WRITE_TO_SLICE]
// Standard Keccak layout: memory[(y * 5) + x] = A[x][y]
// Output state columns ordered in column-major order (by x coordinate first, then y)
sel_slice_write { state_iota_00, state_chi_10, state_chi_20, state_chi_30, state_chi_40,
                  state_chi_01,  state_chi_11, state_chi_21, state_chi_31, state_chi_41,
                  state_chi_02,  state_chi_12, state_chi_22, state_chi_32, state_chi_42,
                  state_chi_03,  state_chi_13, state_chi_23, state_chi_33, state_chi_43,
                  state_chi_04,  state_chi_14, state_chi_24, state_chi_34, state_chi_44,
                  clk, dst_addr, space_id }
is // Crucial to be a permutation to prevent any illegal write to memory in keccak_memory.pil.
keccak_memory.start_write { keccak_memory.val[0], keccak_memory.val[1], keccak_memory.val[2], keccak_memory.val[3], keccak_memory.val[4],
                            keccak_memory.val[5], keccak_memory.val[6], keccak_memory.val[7], keccak_memory.val[8], keccak_memory.val[9],
                            keccak_memory.val[10], keccak_memory.val[11], keccak_memory.val[12], keccak_memory.val[13], keccak_memory.val[14],
                            keccak_memory.val[15], keccak_memory.val[16], keccak_memory.val[17], keccak_memory.val[18], keccak_memory.val[19],
                            keccak_memory.val[20], keccak_memory.val[21], keccak_memory.val[22], keccak_memory.val[23], keccak_memory.val[24],
                            keccak_memory.clk, keccak_memory.addr, keccak_memory.space_id };
