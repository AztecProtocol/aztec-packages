include "range_check.pil";

// Important Precondition:
// Both inputs (input_a and input_b) must be bounded by p - 1 - 2^128
// and the asbolute difference between them must be less than 2^128. These
// properties need to be constrained by the caller.
// In the avm, we will use this gadget with both inputs bounded by 2^128.
// Note that simulation (gt.cpp) is taking uint128_t input values. Values of
// types FF use ff_gt gadget.
//
// Usage:
//
// sel { a, b, result } in gt.sel_XXX { gt.input_a, gt.input_b, gt.res };
// where gt.res is a boolean value that is true if input_a > input_b, false otherwise.
// sel_XXX is one of:
// - sel_sha256
// - sel_addressing
// - sel_alu
// - sel_gas
// - sel_others
namespace gt;

    pol commit sel; // @boolean
    sel * (1 - sel) = 0;

    // This is used to decouple generation of inverses of lookups into this trace.
    pol commit sel_sha256; // @boolean
    pol commit sel_addressing; // @boolean
    pol commit sel_alu; // @boolean
    pol commit sel_gas; // @boolean
    pol commit sel_others; // @boolean Any other lookup into this trace.
    sel_sha256 * (1 - sel_sha256) = 0;
    sel_addressing * (1 - sel_addressing) = 0;
    sel_alu * (1 - sel_alu) = 0;
    sel_gas * (1 - sel_gas) = 0;
    sel_others * (1 - sel_others) = 0;
    // If any of the above selectors is 1, then sel must be 1.
    (sel_sha256 + sel_addressing + sel_alu + sel_gas + sel_others) * (1 - sel) = 0;

    #[skippable_if]
    sel = 0;

    pol commit input_a;
    pol commit input_b;

    pol commit res; // @boolean
    res * (1 - res) = 0;

    // Below are two subtractions we constrain to not underflow via the constraints later in the file.
    pol A_LTE_B = input_b - input_a; // constrained to not underflow when a <= b
    pol A_GT_B = input_a - input_b - 1; // constrained to not underflow when a > b
    pol commit abs_diff; // this contains whichever of the above two subtractions is active on this row

    // num_bits is not directly constrained here. The range_check gadget (via GT_RANGE lookup below)
    // enforces abs_diff < 2^num_bits with num_bits <= 128, so any valid choice of num_bits proves
    // that abs_diff < 2^128 and therefore that the active subtraction (either A_LTE_B or A_GT_B)
    // didn't underflow.
    //
    // In trace generation, we pick num_bits as the smallest multiple of 16 such that 2^num_bits > abs_diff.
    // We use a multiple of 16 because range_check decomposes values into 16-bit limbs, so a tighter
    // non-multiple-of-16 would still activate the same number of limbs. Picking the smallest such multiple
    // reduces the number of activated limb range checks (performance optimization).
    //
    // This deterministic derivation of num_bits from abs_diff also ensures that whenever two identical
    // gt events deduplicate into one row, their range_check events deduplicate as well.
    pol commit num_bits;

    // GT_RESULT constrains two scenarios:
    //     When res = 1, it constrains that abs_diff = a - b - 1
    //     When res = 0, it constrains that abs_diff = b - a
    // 
    // And the GT_RANGE lookup into range_check enforces that in either case, abs_diff < 2^128, which means the subtraction didn't underflow.
    // 
    // Together these effectively constrain res as follows:
    //     When a > b, res = 1
    //     When a <= b, res = 0
    #[GT_RESULT]
    sel * ( (A_GT_B - A_LTE_B) * res + A_LTE_B - abs_diff ) = 0;
    #[GT_RANGE]
    sel { abs_diff, num_bits } in range_check.sel_gt { range_check.value, range_check.rng_chk_bits };
