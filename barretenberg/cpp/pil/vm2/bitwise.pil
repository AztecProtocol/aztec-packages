include "precomputed.pil";
include "constants_gen.pil";

/**
 * The bitwise trace performs AND/OR/XOR operations on non-FF types. It does
 * this by decomposing the inputs into 8-bit chunks and looks up the resulting
 * chunk of the operation in the precomputed bitwise table. The final output is
 * the accumulation of these result chunks.
 * The precomputed bitwise table contains the results of all combinations of
 * bitwise operations for 8-bit values. These values are stored as a tuple of
 * <input_a, input_b, output_and, output_or, output_xor>.
 * ERROR HANDLING:
 * The possible errors for this subtrace relate to the AVM memory tag:
 * 1) Either of the inputs tags is of type FF
 * 2) The inputs do not have the same tag.
 * In either case, we do not attempt to perform the bitwise operation.
 *
 * Error rows are single-row blocks (start=1, end=1, sel=1, err=1, ctr unconstrained).
 * Byte-level computation is gated by sel_compute = sel * (1 - err), so all
 * lookups and op_id dispatch are disabled on error rows. The error flag is
 * propagated back to the execution dispatch via the start-row lookup.
 *
 * Trace example for a AND b == c of type u32
 * a = 0x52488425
 * b = 0xC684486C
 * c = 0x42000024
 * +-----+-----+-------+-----+------------+------------+------------+---------+---------+---------+
 * | ctr | sel | start | end |   acc_ia   |   acc_ib   |   acc_ic   | ia_byte | ib_byte | ic_byte |
 * +-----+-----+-------+-----+------------+------------+------------+---------+---------+---------+
 * |   4 |   1 |     1 |   0 | 0x52488425 | 0xC684486C | 0x42000024 |    0x25 |    0x6C |    0x24 |
 * |   3 |   1 |     0 |   0 |   0x524884 |   0xC68448 |   0x420000 |    0x84 |    0x48 |    0x00 |
 * |   2 |   1 |     0 |   0 |     0x5248 |     0xC684 |     0x4200 |    0x48 |    0x84 |    0x00 |
 * |   1 |   1 |     0 |   1 |       0x52 |       0xC6 |       0x42 |    0x52 |    0xC6 |    0x42 |
 * +-----+-----+-------+-----+------------+------------+------------+---------+---------+---------+
 *
 * Trace example for an ERROR case (tag mismatch: a is U16, b is U32)
 * The error case generates a single row with start=1, end=1, sel=1, err=1.
 * Since sel_compute=0, the byte operations lookup and counter decrement are disabled.
 * The accumulator init constraint (end=1) still applies, requiring acc_* = *_byte.
 * +-----+-----+-------+-----+-----+----------------------+--------+-------+-------+-------+
 * | ctr | sel | start | end | err | sel_tag_mismatch_err | acc_ia | tag_a | tag_b | tag_c |
 * +-----+-----+-------+-----+-----+----------------------+--------+-------+-------+-------+
 * |  0  |  1  |   1   |  1  |  1  |          1           | a_val  |   3   |   4   | 0(FF) |
 * +-----+-----+-------+-----+-----+----------------------+--------+-------+-------+-------+
 *
 * ==============================
 * INVOCATION WITH ERROR HANDLING
 * ==============================
 * Used by execution dispatch #[DISPATCH_TO_BITWISE] in execution.pil for bitwise opcodes
 * and reads back the tag error flag.
 *
 * sel_exec_dispatch_bitwise {
 *    subtrace_operation_id, sel_opcode_error,
 *    register[0], mem_tag_reg[0],
 *    register[1], mem_tag_reg[1],
 *    register[2], mem_tag_reg[2]
 * } in bitwise.start {
 *    bitwise.op_id, bitwise.err,
 *    bitwise.acc_ia, bitwise.tag_a,
 *    bitwise.acc_ib, bitwise.tag_b,
 *    bitwise.acc_ic, bitwise.tag_c
 * };
 *
 * =================================
 * INVOCATION WITHOUT ERROR HANDLING
 * =================================
 *
 * Used by both `keccakf1600.pil` and `sha256.pil` sub-traces using their respective selectors:
 * `start_keccak` and `start_sha256`. It assumes that the bitwise operation is always performed
 * as tags of both inputs are known to be valid. Therefore, there is no error handling. However,
 * tracegen still needs to populate the trace to satisfy the constraints related to error handling.
 *
 * Usage is of the form:
 *
 * sel_XXX { a, b, c, xor_sel, tag, tag }
 * in
 * bitwise.start_XXX { bitwise.acc_ia, bitwise.acc_ib, bitwise.acc_ic, bitwise.op_id, bitwise.tag_a, bitwise.tag_b };
 *
 * where start_XXX is either start_keccak or start_sha256.
 * The caller passes the same tag column twice on the source side (u32_tag for sha256,
 * tag_u64 for keccak) so that the source tuple matches the (tag_a, tag_b) pair on the
 * destination. This constrains the target row's tag_b to equal tag_a, preventing a malicious
 * prover from aiming a valid-looking keccak/sha256 lookup at a bitwise error row (which
 * would otherwise match because its tag_b is unconstrained on the source side).
 * Note that the order of the tuple columns might differ though. As long as the correct columns
 * are passed, the usage is sound.
 *
 */

namespace bitwise;

////////////////////////////////////////////////
// Multi-row Computation Selectors (standard recipe)
////////////////////////////////////////////////

// Selector for active Bitwise block rows.
// In the standard recipe, sel=1 for ALL rows in a block, including error rows.
pol commit sel; // @boolean
sel * (1 - sel) = 0;

// No relations will be checked if this identity is satisfied.
#[skippable_if]
sel = 0;

// Follows the recipe documented in:
// https://github.com/AztecProtocol/aztec-packages/blob/next/barretenberg/cpp/pil/vm2/docs/recipes.md#contiguous-multi-rows-computation-trace

// NOTE on start selector:
// start=1 on non-first rows within a block. This is safe because:
// (1) The execution dispatch is a lookup INTO bitwise using bitwise.start as the destination
//     selector. Extra start=1 rows are just unclaimed destinations -- harmless.
// (2) Keccak/sha256 use separate selectors (start_keccak/start_sha256) which enforce that start=1.
// (3) Setting start=1 on a middle row triggers #[INTEGRAL_TAG_LENGTH] lookup, which would fail
//     because ctr at that row would not match the tag's byte length.
// The start of the computation, used as a selector by a caller.
pol commit start; // @boolean
start * (1 - start) = 0;

// The end of the computation.
pol commit end; // @boolean
end * (1 - end) = 0;

pol LATCH_CONDITION = end + precomputed.first_row;

// start=1 or end=1 implies sel=1.
#[SEL_ON_START_OR_END]
(start + end) * (1 - sel) = 0;

// Trace is contiguous: once sel = 0, it cannot be set to 1, can only be set to 0 at LATCH_CONDITION
#[TRACE_CONTINUITY]
(1 - LATCH_CONDITION) * (sel - sel') = 0;

// A new block of computation must start immediately after a latch.
#[START_AFTER_LATCH]
sel' * (start' - LATCH_CONDITION) = 0;

pol NOT_END = sel - end;

// This is used to decouple generation of inverses of lookups into this trace.
pol commit start_keccak; // @boolean
pol commit start_sha256; // @boolean
start_keccak * (1 - start_keccak) = 0;
start_sha256 * (1 - start_sha256) = 0;
// If any of the above selectors is 1, then start must be 1.
(start_keccak + start_sha256) * (1 - start) = 0;

// Crucial constraint to prevent the vulnerability described in PR #19875 consisting
// of maliciously setting start_keccak/start_sha256=1 on error rows (sel=1, err=1)
// and forging arbitrary bitwise operation results.
// keccak and sha256 only enforce that tag_a = U64/U32 respectively. An attacker is free to
// set tag_b to any tag value and use the resulting tag mismatch error to return an invalid result
// Note: sha256/keccak now invokes bitwise lookups with both input tags so that this
// relation is not required anymore but we keep it as a defensive measure.
#[BITW_NO_EXTERNAL_START_ON_ERROR]
(start_keccak + start_sha256) * err = 0;

// To support dynamically sized memory operands we use a counter against a lookup
// This decrementing counter goes from [TAG_LEN, 0] where TAG_LEN is the number of bytes in the
// corresponding integer. i.e. TAG_LEN is between 1 (U1/U8) and 16 (U128).
// Consistency can be achieved with a lookup table between the tag and precomputed.tag_byte_length
pol commit ctr;

// The error flags for this subtrace
pol commit sel_tag_ff_err; // @boolean
sel_tag_ff_err * (1 - sel_tag_ff_err) = 0;
pol commit sel_tag_mismatch_err; // @boolean
sel_tag_mismatch_err * (1 - sel_tag_mismatch_err) = 0;

// Consolidated error flag
pol commit err; // @boolean (by definition)
err = 1 - (1 - sel_tag_mismatch_err) * (1 - sel_tag_ff_err);
#[END_ON_ERROR] // end = 1 if err = 1
err * (end - 1) = 0;

// Error can only manifest on start rows (where tag checks are evaluated).
// Without this, a prover could set err=1 on the end row of a multi-row block,
// disabling sel_compute and the byte lookup on that row, which leaves ic_byte
// unconstrained and allows forging the bitwise result via the accumulator.
#[ERR_ONLY_ON_START]
(sel - start) * err = 0;

// Gate for byte-level computation. Disabled on error rows (sel=1, err=1).
// Must be committed because it is used as a lookup selector in #[BYTE_OPERATIONS].
pol commit sel_compute; // @boolean by definition
sel_compute = sel * (1 - err);

////////////////////////////////////////////////
// Tag Checking / Error Handling
////////////////////////////////////////////////
// The checks that need to be performed are: (1) the tags are not FF, and (2) that the input tags are the same.
// We can simplify (1) by just checking that tag_a != FF. It can be observed
// that we don't need to also check that tag_b != FF since it follows from the the tag check of (2)

// These are the tags {1,2,3,4,5,6} of the inputs (restricted to not be a field).
// @unconstrained-on-non-start: tag_a, tag_b, tag_c are only constrained when start=1
// (via tag checking relations and the execution dispatch lookup). On non-start rows,
// these columns are free. Tracegen sets them to 0 on non-start rows.
pol commit tag_a;
pol commit tag_b;
pol commit tag_c; // This is the tag of the result
// Sufficient to set tag_c == tag_a because we check that tag_a == tag_b
// If there is an error, we relax this constraint as we want the flexibility to set the register in execution to FF(0)
#[RES_TAG_SHOULD_MATCH_INPUT]
(1 - err) * start * (tag_c - tag_a) = 0;

// Check that tag_a is not FF
pol commit tag_a_inv;
// When start = 1: tag_a == 0 <==> sel_tag_ff_err = 1
// For more consistency and clarity we have this helper even though constants.MEM_TAG_FF = 0;
pol TAG_A_DIFF = tag_a - constants.MEM_TAG_FF;
#[INPUT_TAG_CANNOT_BE_FF]
start * (TAG_A_DIFF * (sel_tag_ff_err * (1 - tag_a_inv) + tag_a_inv) - 1 + sel_tag_ff_err) = 0;

// Check that the input tags match each other
pol TAG_AB_DIFF = tag_a - tag_b;
pol commit tag_ab_diff_inv;
// When start = 1:  TAG_AB_DIFF != 0 <==> sel_tag_mismatch_err = 1
#[INPUT_TAGS_SHOULD_MATCH]
start * (TAG_AB_DIFF * ((1 - sel_tag_mismatch_err) * (1 - tag_ab_diff_inv) + tag_ab_diff_inv) - sel_tag_mismatch_err) = 0;

////////////////////////////////////////////////
// Begin Executing Bitwise ops
////////////////////////////////////////////////
// Byte recomposition column, the value in these columns are part of the equivalence
// check to main wherever start is set to 1.
pol commit acc_ia;
pol commit acc_ib;
pol commit acc_ic;

// Little Endian bitwise decomposition of accumulators (which are processed top-down),
// constrained to be U8 via the #[BYTE_OPERATIONS] lookup (gated by sel_compute).
// @unconstrained-on-error: when sel_compute=0 (error rows), these columns are not range-checked to U8.
// This is safe because the byte lookup is disabled and the values only appear in
// #[BITW_INIT_*] (gated by end) to set acc_* values.
pol commit ia_byte;
pol commit ib_byte;
pol commit ic_byte;

// Selectors for bitwise operations, constrained from subtrace_operation_id from execution trace
pol commit op_id;

// Op Id is restricted to be the same during the same computation (i.e. between starts)
#[BITW_OP_ID_REL_CONTINUITY]
NOT_END * (op_id' - op_id) = 0;

#[BITW_CTR_DECREMENT]
NOT_END * (ctr - 1 - ctr') = 0;

// end == 1 <=> ctr == 1 (when computing, i.e. non-error rows)
// Gated by sel_compute because ctr is unconstrained on error rows (err=1).
pol commit ctr_min_one_inv;
#[BITW_END_FOR_CTR_ONE]
sel_compute * ((ctr - 1) * (end * (1 - ctr_min_one_inv) + ctr_min_one_inv) + end - 1) = 0;

// Forces accumulator to initialize with ia_byte, ib_byte, and ic_byte (the MSB)
#[BITW_INIT_A]
end * (acc_ia - ia_byte) = 0;
#[BITW_INIT_B]
end * (acc_ib - ib_byte) = 0;
#[BITW_INIT_C]
end * (acc_ic - ic_byte) = 0;

#[BITW_ACC_REL_A]
NOT_END * (acc_ia - ia_byte - 256 * acc_ia') = 0;
#[BITW_ACC_REL_B]
NOT_END * (acc_ib - ib_byte - 256 * acc_ib') = 0;
#[BITW_ACC_REL_C]
NOT_END * (acc_ic - ic_byte - 256 * acc_ic') = 0;

// If we encounter an error, we do not want to perform a lookup to retrieve ctr.
pol commit sel_get_ctr; // @boolean
sel_get_ctr = start * (1 - err);

// Lookup to verify that ctr matches the expected byte length for the given tag.
// Only active on non-error start rows
#[INTEGRAL_TAG_LENGTH]
sel_get_ctr { tag_a, ctr }
in
precomputed.sel_tag_parameters { precomputed.idx, precomputed.tag_byte_length };

pol commit sel_and;
pol commit sel_or;
pol commit sel_xor;
sel_and * (1 - sel_and) = 0;
sel_or * (1 - sel_or) = 0;
sel_xor * (1 - sel_xor) = 0;

// op_id dispatch for byte operations.
// Note: there is no explicit constraint sel_and + sel_or + sel_xor = 1 when sel_compute=1.
// Exclusivity is implicit because the constants {1, 2, 4} are distinct powers of 2,
// and sel_and, sel_or, sel_xor are booleans. Any multi-selector activation gives an op_id
// in {3, 5, 6, 7}, which cannot match the valid execution dispatch op_ids {1, 2, 4}.
sel_compute * op_id = sel_and * constants.AVM_BITWISE_AND_OP_ID
            + sel_or * constants.AVM_BITWISE_OR_OP_ID
            + sel_xor * constants.AVM_BITWISE_XOR_OP_ID;

// @unconstrained-on-error: when sel_compute=0 (error rows), these columns are not range-checked.
pol commit output_and;
pol commit output_or;
pol commit output_xor;

// We fetch all the byte operations in one lookup for efficiency purposes.
// This lookup constrains ia_byte, ib_byte to be U8 and output_and/or/xor to be the correct
// byte-level results for the given inputs. Only active when sel_compute=1 (non-error computation rows).
#[BYTE_OPERATIONS]
sel_compute {
     ia_byte, ib_byte,
     output_and, output_or, output_xor
} in precomputed.sel_range_16 {
     precomputed.bitwise_input_a, precomputed.bitwise_input_b,
     precomputed.bitwise_output_and, precomputed.bitwise_output_or, precomputed.bitwise_output_xor
};

// Dispatch the relevant output value to the output.
ic_byte = sel_and * output_and + sel_or * output_or + sel_xor * output_xor;

