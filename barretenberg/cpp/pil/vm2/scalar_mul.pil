include "ecc.pil";
include "to_radix.pil";
include "precomputed.pil";

/**
 * This subtrace supports scalar point multiplication over the Grumpkin curve (in SW form:  Y^2 = X^3 − 17).
 * Given a Grumpkin point P and scalar s, this trace computes sP = R using the double and add algorithm:
 *
 *      let bits = bit_representation(s)  # the vector of bits (from LSB to MSB) representing s
 *      let res = O # point at infinity
 *      let temp = P  # track doubled P val
 *      for bit in bits:
 *             if bit == 1:
 *              res = res + temp  # point add
 *             temp = temp + temp  # double
 *      return res
 *
 * The correctness of point addition (res + temp and temp + temp above) is constrained by a lookup into ecc.pil.
 *
 * PRECONDITIONS: Input P is a valid point on the Grumpkin curve, input s is FF (see below note).
 * Note: Grumpkin forms a 2-cycle with BN254, i.e the base field of one is the scalar field of the other and vice-versa,
 * so the scalar is actually a Fq value. We treat it as a Fr (FF tagged) value in circuit. Since r < q, we cannot use an
 * invalid scalar here.
 *
 * USAGE: This is a non-memory aware subtrace used to constrain scalar point multiplicationas defined above. Each point can
 *        be looked up by coordinates (lookup as defined in address_derivation.pil):
 *        #[PREADDRESS_SCALAR_MUL]
 *        sel {
 *          preaddress, // Scalar
 *          g1_x, g1_y, precomputed.zero, // Point P
 *          preaddress_public_key_x, preaddress_public_key_y, precomputed.zero // Point R
 *        } in scalar_mul.start {
 *          scalar_mul.scalar,
 *          scalar_mul.point_x, scalar_mul.point_y, scalar_mul.point_inf, // Point P
 *          scalar_mul.res_x, scalar_mul.res_y, scalar_mul.res_inf // Point R
 *        };
 *        Note that we do reverse aggregation; the start row contains the output R (= (res_x, res_y, res_inf)) so is the
 *        selector with which other subtraces will reference.
 *
 * TRACE SHAPE: 1 single row per bit of the scalar s. Since s is FF, each scalar mul operation has 254 rows:
 *
 * +-------+-----+-------------+-------------+--------+-----------+-----+---------+------------+------------+
 * | start | end | sel_not_end | point:Point | scalar | res:Point | bit | bit_idx | temp:Point | should_add |
 * +-------+-----+-------------+-------------+--------+-----------+-----+---------+------------+------------+
 * |     1 |   0 |       1     | p           | s      | res'      |   0 |     253 | temp'*2    |          0 | <= lookup
 * |     0 |   0 |       1     | p           | s      | res'+temp |   1 |     252 | temp'*2    |          1 |
 * ...
 * |     0 |   1 |       0     | p           | s      | p         |   1 |       0 | p          |          0 |
 * +-------+-----+-------------+-------------+--------+-----------+-----+---------+------------+------------+
 *
 * INTERACTIONS:
 *
 * This subtrace is looked up by:
 * - address_derivation.pil: To constrain that the preaddress public key is the result of the scalar multiplication of preaddress * G (#[PREADDRESS_SCALAR_MUL]).
 *
 * This subtrace looks up:
 * - ecc.pil: To retrieve the output points given by temp + temp (#[DOUBLE]) and res + temp (#[ADD]).
 * - to_radix.pil: To constrain the correctness of bit at bit_idx of the decomposed scalar (#[TO_RADIX]).
 *
*/


namespace scalar_mul;

    ////////////////////////////////////////////////
    // Set Up Columns
    ////////////////////////////////////////////////

    pol commit sel; // @boolean
    sel * (1 - sel) = 0;
    #[skippable_if]
    sel = 0;

    // The scalar s
    pol commit scalar;
    // Point P in affine form
    pol commit point_x;
    pol commit point_y;
    pol commit point_inf; // @boolean
    point_inf * (1 - point_inf) = 0;

    // Point R = sP in affine form
    pol commit res_x;
    pol commit res_y;
    pol commit res_inf; // @boolean (constrained to be @boolean by lookup in the ecc subtrace)

    ///////////////////////////////
    // Trace Shape
    ///////////////////////////////

    pol commit start; // @boolean
    start * (1 - start) = 0;
    pol commit end; // @boolean
    end * (1 - end) = 0;

    // LATCH_CONDITION is @boolean because both end and first_row are boolean and mutually exclusive
    pol LATCH_CONDITION = end + precomputed.first_row;

    // start can be 1 only after an end or the first row
    #[START_AFTER_LATCH]
    sel' * (start' - LATCH_CONDITION) = 0;

    // Selector must be 1 in a start or end row
    #[SELECTOR_ON_START_OR_END]
    (start + end) * (1 - sel) = 0;

    // Next selector must be current selector unless LATCH_CONDITION
    #[SELECTOR_CONSISTENCY]
    (sel' - sel) * (1 - LATCH_CONDITION) = 0;

    // Needs to be committed because it's used in the #[DOUBLE] lookup
    pol commit sel_not_end; // @boolean (since end and sel are boolean)
    // sel_not_end = sel & !end (since end ==> sel, sel * end == end and so sel * (1 - end) = sel - end)
    sel_not_end = sel - end;

    // Input consistency
    #[INPUT_CONSISTENCY_X]
    sel_not_end * (point_x - point_x') = 0;
    #[INPUT_CONSISTENCY_Y]
    sel_not_end * (point_y - point_y') = 0;
    #[INPUT_CONSISTENCY_INF]
    sel_not_end * (point_inf - point_inf') = 0;
    #[INPUT_CONSISTENCY_SCALAR]
    sel_not_end * (scalar - scalar') = 0;

    ///////////////////////////////
    // Bit Decomposition
    ///////////////////////////////
    // We lookup this row's bit value against the scalar's decomposition at bit_idx in #[TO_RADIX].
    // The bit index must be decremented each row, unless we are at end where it must equal 0.
    // From above, every active row has either end or sel_not_end. Since we start at bit_idx == 253, this
    // constrains that an end row must be 253 rows after start.

    pol commit bit; // @boolean (by lookup #[TO_RADIX], which links bit to #[LIMB_LESS_THAN_RADIX_RANGE], which constrains bit < radix for radix == 2)
    pol commit bit_idx;

    // We start with bit index 253
    start * (bit_idx - 253) = 0;
    // End can only be 1 when the bit index is 0. This does not imply that end will be 1 when bit_idx is zero. The prover can choose to not turn end on
    // but then they won't be able to reach an end again in the whole trace, rendering the trace invalid.
    end * bit_idx = 0;

    // Next bit index has to be 1 less except on end
    #[DECREMENT_INDEX]
    sel_not_end * (bit_idx - (bit_idx' + 1)) = 0;

    // Needs to be committed because it's used in the #[TO_RADIX] lookup
    pol commit const_two;
    sel * (const_two - 2) = 0;

    #[TO_RADIX]
    sel { scalar, bit, bit_idx, const_two /* = bit_radix */ }
    in
    to_radix.sel
        { to_radix.value, to_radix.limb, to_radix.limb_index, to_radix.radix };

    ///////////////////////////////
    // Temp Computation
    ///////////////////////////////
    // See double and add algorithm above. Temp starts as P, then is doubled for each iteration.
    // Since we do reverse aggregation, temp == P at end (bit_idx = 0), temp == 2P at the previous
    // row (bit_idx = 1), ..., == 2^254P at start (bit_idx = 253).

    pol commit temp_x;
    pol commit temp_y;
    pol commit temp_inf; // @boolean (constrained to be @boolean by lookup in the ecc subtrace)

    // If end, temp = point. Else, temp is constrained by the lookup #[DOUBLE] to be double temp'.
    end * (temp_x - point_x) = 0;
    end * (temp_y - point_y) = 0;
    end * (temp_inf - point_inf) = 0;

    // TODO(#AVM-212) Hack for bb-pilcom to see shifted temp columns
    temp_x' - temp_x' = 0;
    temp_y' - temp_y' = 0;
    temp_inf' - temp_inf' = 0;

    #[DOUBLE]
    sel_not_end { temp_x, temp_y, temp_inf, temp_x', temp_y', temp_inf', temp_x', temp_y', temp_inf' }
    in
    ecc.sel
        { ecc.r_x, ecc.r_y, ecc.r_is_inf, ecc.p_x, ecc.p_y, ecc.p_is_inf, ecc.q_x, ecc.q_y, ecc.q_is_inf };

    ///////////////////////////////
    // Result Computation
    ///////////////////////////////
    // See double and add algorithm above. Res starts as O (the point at infinity), then is added to temp if
    // the current bit is 1. At each row, res == bit ? res + temp : res.
    // Since we do reverse aggregation, res == bit ? P : O at end (bit_idx = 0), then res == bit ? res' + temp : res' at
    // the previous rows (bit_idx > 0).

    // If end is true, conditional assign res as (bit = 1) point or (bit = 0) infinity (mapped to (0,0)).
    // Else, conditional assign res as (bit = 1) res' + temp, constrained by the lookup #[ADD], or unchanged from the next row.
    end * (point_x * bit - res_x) = 0;
    end * (point_y * bit - res_y) = 0;
    end * ((point_inf - 1) * bit + 1 - res_inf) = 0;

    // Needs to be committed because it's used in the #[ADD] lookup
    pol commit should_add; // @boolean (since sel_not_end and bit are boolean)
    should_add - sel_not_end * bit = 0;
    pol SHOULD_PASS = sel_not_end * (1 - bit);
    SHOULD_PASS * (res_x - res_x') = 0;
    SHOULD_PASS * (res_y - res_y') = 0;
    SHOULD_PASS * (res_inf - res_inf') = 0;

    #[ADD]
    should_add { res_x, res_y, res_inf, res_x', res_y', res_inf', temp_x, temp_y, temp_inf }
    in
    ecc.sel
        { ecc.r_x, ecc.r_y, ecc.r_is_inf, ecc.p_x, ecc.p_y, ecc.p_is_inf, ecc.q_x, ecc.q_y, ecc.q_is_inf };




