include "../execution.pil";
include "../context.pil";
include "../internal_call_stack.pil";

// Virtual to execution.pil but specifically to house the constraints for internal call / return

// Internal call and return both interact with the internal call stack (see internal_call_stack.pil file for more details)
// The internal call context information (next id, id and return id) are reset at the start of each new context

// In this subtrace, we enforce constraints on the internal call stack, the "internal call" related IDs, and pc.
// - internal_call_id: the current internal call id
// - internal_call_return_id: the internal call id after an internal return (parent)
// - next_internal_call_id: the next internal call id after an internal call
// These IDs are defined in context.pil and their mutations are enforced in this subtrace except
// for the case of a non-erroring internal return/call (`SEL_INTERNAL_OP = 1` below).
// These IDs are used to track the internal call stack entries and ultimately serve to correctly
// enforce the next pc counter after an internal call/return.
// This subtrace constrains pc (on next row) after an internal return (see #[UNWIND_CALL_STACK] below)
// while pc (on next row) after an internal call is enforced in execution.pil (see #[PC_NEXT_ROW_INT_CALL_JUMP] below).

// Interactions with internal_call_stack.pil:
// - #[PUSH_CALL_STACK]: A permutation that pushes a new call stack entry to the stack when sel_execute_internal_call is 1.
// - #[UNWIND_CALL_STACK]: A lookup that reads the call stack when sel_execute_internal_return is 1 and sel_opcode_error is 0.

namespace execution;
    // sel_execute_internal_call and sel_execute_internal_return are boolean selectors defined in execution.pil
    // and are mutually exclusive.

    #[skippable_if]
    sel_execute_internal_call + sel_execute_internal_return = 0;

    // =============================
    // === Error Handling ====
    // =============================
    // Since we are already in the execution trace, we'll re-use the main execution error column from the "dispatch opcode" temporality group
    // Throw an error if we try to pop from an empty stack
    // In circuit that corresponds to calling internal_return while internal_call_return_id == 0
    // Guard the unwind call stack lookup with sel_opcode_error (commited since it's used in the lookup)
    pol commit sel_read_unwind_call_stack; // @boolean (by definition)
    sel_read_unwind_call_stack = sel_execute_internal_return * (1 - sel_opcode_error);
    pol commit internal_call_return_id_inv;
    // Guard the zero check with sel_execute_internal_return because `sel_opcode_error` should not necessarily be raised
    // when `internal_call_return_id` is 0.
    // If we do an internal_return, we raise `sel_opcode_error = 1` iff `internal_call_return_id = 0`.
    #[INTERNAL_RET_ERROR]
    sel_execute_internal_return * (internal_call_return_id * (sel_opcode_error * (1 - internal_call_return_id_inv) + internal_call_return_id_inv) - 1 + sel_opcode_error) = 0;

    // Alias for an INTERNAL_CALL or INTERNAL_RETURN opcode without error.
    // Note that if `sel_execute_internal_call == 1` no error can occur due to
    // #[INFALLIBLE_OPCODES_SUCCESS] in execution.pil.
    pol SEL_INTERNAL_OP = sel_execute_internal_call + sel_read_unwind_call_stack; // @boolean (by definition)

    // ===================================
    // === Non-Stack Related Mutations ===
    // ===================================

    // If we encounter a sel_execute_internal_call, the internal_call_id on next row is the current next_internal_call_id.
    #[NEW_CALL_ID_ON_CALL]
    sel_execute_internal_call * (internal_call_id' - next_internal_call_id) = 0;

    // If we encounter a sel_execute_internal_call, the next internal_call_return_id is the current internal_call_id
    #[NEW_RETURN_ID_ON_CALL]
    sel_execute_internal_call * (internal_call_return_id' - internal_call_id) = 0;

    #[INCR_NEXT_INT_CALL_ID]
    SEL_INTERNAL_OP * (next_internal_call_id' - (next_internal_call_id + sel_execute_internal_call)) = 0;

    // =============================
    // === Pushing to Call Stack ===
    // =============================
    // We store the current internal call pointer
    // Crucial to be a permutation to prevent malicious insertions in the internal call stack.
    // Note that the pair (context_id, entered_call_id) is used to uniquely identify a call stack entry.
    #[PUSH_CALL_STACK]
    sel_execute_internal_call {
        context_id, next_internal_call_id, internal_call_id, internal_call_return_id, next_pc
    } is internal_call_stack.sel {
        internal_call_stack.context_id, internal_call_stack.entered_call_id, internal_call_stack.call_id, internal_call_stack.return_call_id, internal_call_stack.return_pc
    };

    // =============================
    // === Popping from Call Stack ===
    // =============================
    // Retrieve the previous internal call ptr from the stack
    // When we unwind the call stack (i.e. sel_internal_return_call that does not error), we retrieve the next row values for
    // internal_call_id, internal_call_return_id, and pc from the stack based on the current (context_id, internal_call_id) pair.
    // This is gated by (1 - sel_opcode_error) so we don't enforce the constraint when the callstack is empty.
    // Fine to be a lookup since we are not modifying the stack (cannot be a permutation because an error might occur before the read).
    #[UNWIND_CALL_STACK]
    sel_read_unwind_call_stack {
        context_id, internal_call_id, internal_call_id', internal_call_return_id', pc'
    } in internal_call_stack.sel {
        internal_call_stack.context_id, internal_call_stack.entered_call_id, internal_call_stack.call_id, internal_call_stack.return_call_id, internal_call_stack.return_pc
    };
