include "constants_gen.pil";
include "gt.pil";
include "memory.pil";
include "precomputed.pil";
include "to_radix.pil";

/**
 * TO_RADIX_MEM - TORADIXBE Opcode Handler
 *
 * Implements the TORADIXBE opcode logic. This is not a reusable gadget — the only caller is the
 * execution trace (#[DISPATCH_TO_TO_RADIX] in execution.pil). Handles memory writes for a
 * big-endian radix decomposition. The actual decomposition is performed by the to_radix subtrace
 * in little endian; this trace reverses the output to big endian and writes each limb to memory
 * at addresses {dst_addr, dst_addr + 1, ..., dst_addr + num_limbs - 1}.
 *
 * The trace has a vertical layout where a single memory write is performed per row, due to the
 * dynamic number of writes. This allows a single permutation to the memory trace.
 *
 * PRECONDITIONS:
 * - Inputs are tag-validated by the execution trace: value is FF, radix is U32, num_limbs is U32,
 *   is_output_bits is U1. dst_addr is 32-bit (by addressing resolution in addressing.pil).
 * - This subtrace should not be used by other subtraces as it relies on assumptions provided by
 *   the execution trace.
 *
 * Opcode operands (relevant in EXECUTION when interacting with this gadget):
 * - rop[0]: value_addr, rop[1]: radix_addr, rop[2]: num_limbs_addr,
 *   rop[3]: is_output_bits_addr, rop[4]: dst_addr.
 *
 * Memory I/O:
 * - register[0..3]: Reads (value FF, radix U32, num_limbs U32, is_output_bits U1) — tag-checked
 *   by execution.
 * - M[dst_addr .. dst_addr + num_limbs - 1]: Output limbs (U8 or U1 per is_output_bits).
 *
 * USAGE:
 *
 * #[DISPATCH_TO_TO_RADIX_MEM]:
 * sel_exec_dispatch_to_radix {
 *     clk,
 *     context_id,
 *     register[0],
 *     register[1],
 *     register[2],
 *     register[3],
 *     rop[4],
 *     sel_opcode_error
 * } is to_radix_mem.start {
 *     to_radix_mem.execution_clk,
 *     to_radix_mem.space_id,
 *     to_radix_mem.value_to_decompose,
 *     to_radix_mem.radix,
 *     to_radix_mem.num_limbs,
 *     to_radix_mem.is_output_bits,
 *     to_radix_mem.dst_addr,
 *     to_radix_mem.err
 * };
 *
 * - Inputs:
 *   - `clk`: Clock cycle (32-bit row index of corresponding opcode in execution trace).
 *   - `context_id`: Context identifier (16-bit).
 *   - `register[0]`: value_to_decompose (FF value to be decomposed).
 *   - `register[1]`: radix (U32 radix to decompose by).
 *   - `register[2]`: num_limbs (U32 number of limbs).
 *   - `register[3]`: is_output_bits (boolean: U1 or U8 output).
 *   - `rop[4]`: dst_addr (destination address for the decomposition).
 * - Output: `sel_opcode_error` maps to `err`.
 * - Selector: Uses `start` for the permutation (one computation per permuted row).
 *
 * TRACE SHAPE:
 * Multi-row computation. If an error occurs or num_limbs is 0, a single row is produced.
 * Otherwise, num_limbs rows are produced per computation.
 *
 * ERROR HANDLING:
 * (1) sel_dst_out_of_range_err: Destination slice out of range (dst_addr + num_limbs > AVM_MEMORY_SIZE).
 * (2) sel_radix_lt_2_err: Radix < 2.
 * (3) sel_radix_gt_256_err: Radix > 256.
 * (4) sel_invalid_bitwise_radix: is_output_bits is 1 but radix != 2.
 * (5) SEL_INVALID_NUM_LIMBS_ERR: num_limbs is 0 while value != 0.
 * (6) SEL_TRUNCATION_ERROR: Value cannot be fully decomposed in the given number of limbs.
 *
 * Errors (1)-(5) are grouped as `input_validation_error`. The consolidated error flag is `err`
 * (any error from (1)-(6) sets it to 1).
 *
 * Note: The radix is also checked to be <= 256 in the execution trace for dynamic gas
 * computation; we do not currently take advantage of this partial check.
 * If num_limbs = 0 and value_to_decompose = 0 (valid inputs), no memory writes are performed.
 * Truncation is checked on the start row by verifying `value_found` from the to_radix subtrace.
 * Since to_radix is little endian, the start row of this trace corresponds to the last limb in
 * the LE decomposition — if it is not found, the number is truncated.
 *
 * INTERACTIONS:
 * - to_radix.pil: Performs the decomposition in little endian.
 * - memory.pil: Writes output limbs to memory.
 * - gt.pil: Error checks (destination address range, radix range).
 * - precomputed.pil: First row sentinel.
 */
namespace to_radix_mem;

    #[skippable_if]
    sel = 0;

    pol commit sel; // @boolean
    sel * (1 - sel) = 0;

    // ==== INPUTS ====

    // Memory inputs
    pol commit execution_clk;
    pol commit space_id;
    pol commit dst_addr; // 32-bit (guaranteed by addressing resolution constraints in addressing.pil)

    // To radix inputs
    pol commit value_to_decompose;
    pol commit radix; // U32 (by execution trace tag validation)
    pol commit num_limbs; // U32 (by execution trace tag validation)
    pol commit is_output_bits; // @boolean (U1 by execution trace tag validation)

    // ==== MULTI-ROW COMPUTATION SELECTORS ====
    // See recipe: https://github.com/AztecProtocol/aztec-packages/blob/next/barretenberg/cpp/pil/vm2/docs/recipes.md#contiguous-multi-rows-computation-trace
    // Here `end` is denoted as `last`.

    pol commit start; // @boolean
    start * (1 - start) = 0;
    pol commit last; // @boolean (constrained in the Control Flow section as it depends on error)
    last * (1 - last) = 0;

    pol LATCH_CONDITION = last + precomputed.first_row;

    #[SEL_ON_START_OR_END]
    (start + last) * (1 - sel) = 0;

    #[TRACE_CONTINUITY]
    (1 - LATCH_CONDITION) * (sel - sel') = 0;

    #[START_AFTER_LATCH]
    sel' * (start' - LATCH_CONDITION) = 0;

    // Continuity checks: these columns are constant within a computation block.
    #[EXEC_CLK_CONTINUITY]
    (1 - LATCH_CONDITION) * (execution_clk' - execution_clk) = 0;
    #[SPACE_ID_CONTINUITY]
    (1 - LATCH_CONDITION) * (space_id' - space_id) = 0;
    #[VALUE_CONTINUITY]
    (1 - LATCH_CONDITION) * (value_to_decompose' - value_to_decompose) = 0;
    #[RADIX_CONTINUITY]
    (1 - LATCH_CONDITION) * (radix' - radix) = 0;
    #[IS_OUTPUT_BITS_CONTINUITY]
    (1 - LATCH_CONDITION) * (is_output_bits' - is_output_bits) = 0;

    // ==== ERROR HANDLING - OUT OF RANGE MEMORY ACCESS ====

    pol commit sel_dst_out_of_range_err; // @boolean (by lookup into gt when start == 1)

    // Use the gt gadget to check: write_addr_upper_bound > max_mem_size.
    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit max_mem_size;
    start * (max_mem_size - constants.AVM_MEMORY_SIZE) = 0;

    pol commit write_addr_upper_bound;
    start * (write_addr_upper_bound - dst_addr - num_limbs) = 0;

    // gt gadget requires both inputs to be bounded by 2^128.
    // Both inputs (write_addr_upper_bound, max_mem_size) are smaller than 2^33 < 2^128.
    #[CHECK_DST_ADDR_IN_RANGE]
    start { write_addr_upper_bound, max_mem_size, sel_dst_out_of_range_err }
    in gt.sel_others { gt.input_a, gt.input_b, gt.res };

    // ==== ERROR HANDLING - RADIX VALIDITY ====

    // To check that 2 <= radix <= 256, we raise error flags if 2 > radix or radix > 256.
    // We formulate them like this since we have access to a GT gadget.
    pol commit sel_radix_lt_2_err; // @boolean (by lookup into gt when start == 1)
    pol commit sel_radix_gt_256_err; // @boolean (by lookup into gt when start == 1)

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit two;
    start * (two - 2) = 0;
    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit two_five_six;
    start * (two_five_six - 256) = 0;

    // gt gadget requires both inputs to be bounded by 2^128.
    // `radix` and `2` are bounded by 2^32 < 2^128.
    #[CHECK_RADIX_LT_2]
    start { two, radix, sel_radix_lt_2_err }
    in gt.sel_others { gt.input_a, gt.input_b, gt.res };

    // gt gadget requires both inputs to be bounded by 2^128.
    // `radix` and `256` are bounded by 2^32 < 2^128.
    #[CHECK_RADIX_GT_256]
    start { radix, two_five_six, sel_radix_gt_256_err }
    in gt.sel_others { gt.input_a, gt.input_b, gt.res };

    // Check whether radix == 2.
    pol commit sel_radix_eq_2; // @boolean
    sel_radix_eq_2 * (1 - sel_radix_eq_2) = 0;
    pol RADIX_MIN_TWO = radix - 2;
    // sel_radix_eq_2 == 1 iff RADIX_MIN_TWO == 0 (only on start == 1).
    pol commit radix_min_two_inv;
    // @zero-check
    start * (RADIX_MIN_TWO * (sel_radix_eq_2 * (1 - radix_min_two_inv) + radix_min_two_inv) - 1 + sel_radix_eq_2) = 0;

    // Radix != 2 && is_output_bits == 1.
    // sel_invalid_bitwise_radix is not defined as an alias to avoid `input_validation_error`
    // relation below having degree > 7.
    pol commit sel_invalid_bitwise_radix; // @boolean (by definition)
    // is_output_bits already guaranteed to be boolean by execution trace tag validation.
    #[IS_OUTPUT_BITS_IMPLY_RADIX_2]
    sel_invalid_bitwise_radix = start * is_output_bits * (1 - sel_radix_eq_2);

    // ==== ERROR HANDLING - NUM LIMBS AND VALUE VALIDITY ====

    // If num_limbs = 0 and value_to_decompose != 0, we throw an error.
    pol commit sel_num_limbs_is_zero; // @boolean (reused later when gating dispatch to the to_radix gadget)
    sel_num_limbs_is_zero * (1 - sel_num_limbs_is_zero) = 0;
    pol commit num_limbs_inv;
    // sel_num_limbs_is_zero = 1 iff num_limbs = 0.
    #[ZERO_CHECK_NUM_LIMBS]
    start * (num_limbs * (sel_num_limbs_is_zero * (1 - num_limbs_inv) + num_limbs_inv) - 1 + sel_num_limbs_is_zero) = 0;

    pol commit sel_value_is_zero; // @boolean
    sel_value_is_zero * (1 - sel_value_is_zero) = 0;
    pol commit value_inv;
    // sel_value_is_zero = 1 iff value_to_decompose = 0.
    #[ZERO_CHECK_VALUE]
    start * (value_to_decompose * (sel_value_is_zero * (1 - value_inv) + value_inv) - 1 + sel_value_is_zero) = 0;

    // SEL_INVALID_NUM_LIMBS_ERR = 1 iff num_limbs == 0 while value != 0.
    pol SEL_INVALID_NUM_LIMBS_ERR = sel_num_limbs_is_zero * (1 - sel_value_is_zero); // @boolean (by definition)

    // ==== DISPATCH TO TO_RADIX ====

    pol commit input_validation_error; // @boolean (only when start == 1)
    input_validation_error = 1 - (1 - sel_dst_out_of_range_err) * (1 - sel_radix_lt_2_err)
        * (1 - sel_radix_gt_256_err) * (1 - sel_invalid_bitwise_radix)
        * (1 - SEL_INVALID_NUM_LIMBS_ERR);

    pol commit limb_value;
    // In the to_radix gadget, `found == 1` means the number has been reconstructed with the current limbs.
    // Refer to the trace table in to_radix.pil for a visual example.
    pol commit value_found; // @boolean (by lookup into to_radix when sel_should_decompose == 1)
    // Boolean by definition (product of booleans) on start rows.
    // Propagated on active rows by #[SEL_SHOULD_DECOMPOSE_CONTINUITY].
    // Forced to zero on inactive rows by #[SHOULD_DECOMPOSE_ON_SEL].
    // Therefore, unconditionally boolean — required as a lookup source selector.
    pol commit sel_should_decompose; // @boolean

    #[SHOULD_DECOMPOSE_ON_SEL]
    (1 - sel) * sel_should_decompose = 0;

    // On the start row: sel_should_decompose = !input_validation_error && !num_limbs_is_zero.
    // We can't inline input_validation_error because of the degree.
    start * ((1 - input_validation_error) * (1 - sel_num_limbs_is_zero) - sel_should_decompose) = 0;

    // On following rows, propagate sel_should_decompose.
    #[SEL_SHOULD_DECOMPOSE_CONTINUITY]
    (1 - LATCH_CONDITION) * (sel_should_decompose' - sel_should_decompose) = 0;

    // Need this since we want big endian but the to_radix gadget is little endian.
    pol commit limb_index_to_lookup;
    limb_index_to_lookup = sel_should_decompose * (num_limbs - 1);

    // For sel_should_decompose == 1, radix lies in [2, 256] which satisfies the precondition
    // of the to_radix gadget.
    #[INPUT_OUTPUT_TO_RADIX]
    sel_should_decompose {
        value_to_decompose,
        limb_index_to_lookup,
        radix,
        limb_value,
        value_found
    } in to_radix.sel {
        to_radix.value,
        to_radix.limb_index,
        to_radix.radix,
        to_radix.limb,
        to_radix.found
    };

    // ==== ERROR HANDLING - TRUNCATION ====

    // A truncation error happens if on the start row, the to_radix lookup yields value_found == 0.
    // Since to_radix is little endian, the first row we look up is the last limb. If it is not found
    // at the last limb, the number is truncated with the given number of limbs.
    pol SEL_TRUNCATION_ERROR = sel_should_decompose * (1 - value_found); // @boolean (by definition)

    // ==== ERROR HANDLING - CONSOLIDATED ERROR FLAG ====

    pol commit err; // @boolean (by definition)
    // Crucial to gate by `start` because `input_validation_error` is only constrained on the start row.
    // This also prevents injecting an error on a non-start row and interrupting the computation.
    #[ERR_COMPUTATION]
    err = start * (1 - (1 - input_validation_error) * (1 - SEL_TRUNCATION_ERROR));

    // ==== CONTROL FLOW ====

    pol NOT_LAST = sel - last; // @boolean
    // Equivalent to sel * (1 - LATCH_CONDITION) because from #[SEL_ON_START_OR_END]
    // we have `last * (1 - sel) == 0`, i.e., `sel * last == last`
    // which implies `sel * (1 - LATCH_CONDITION) == sel - first_row * sel - last`
    // and since `first_row * sel == 0`, we have `sel * (1 - LATCH_CONDITION) == sel - last`.

    // As we process the results from to_radix, we decrement num_limbs and increment dst_addr.
    #[DECR_NUM_LIMBS]
    NOT_LAST * (num_limbs' - (num_limbs - 1)) = 0;
    #[INCR_DST_ADDRESS]
    NOT_LAST * (dst_addr' - (dst_addr + 1)) = 0;

    // Constraining `last` — the computation terminates when one of the following conditions is met:
    // 1) err == 1
    // 2) num_limbs == 0
    // 3) num_limbs == 1
    // Note: These conditions are not mutually exclusive.

    // last == 1 if err == 1 (can only occur on the start row).
    #[LAST_ROW_ERR_COMPUTATION]
    err * (last - 1) = 0;
    // The implication of the above is that LATCH_CONDITION = 1 if there is an error.

    // last == 1 if num_limbs == 0 (can only occur on the start row).
    // Crucial to gate by `start` because `sel_num_limbs_is_zero` is only constrained on the start row.
    #[LAST_ROW_NUM_LIMBS_ZERO]
    start * sel_num_limbs_is_zero * (last - 1) = 0;

    // Introduce a selector covering all active rows except the start row with an error or the
    // start row with num_limbs == 0.
    // start * (1 - err) = start - start * err = start - err (because err is defined with a factor `start`).
    // Similarly, sel * (1 - start) = sel - sel * start = sel - start (because start * (1 - sel) = 0).
    // Error can only occur on the start row.
    pol NO_ERR_NOR_NUM_LIMBS_ZERO = (start - err) * (1 - sel_num_limbs_is_zero) + (sel - start);
    pol NUM_LIMBS_MINUS_ONE = num_limbs - 1;
    pol commit num_limbs_minus_one_inv;

    // If [start == 1 && err == 0 && num_limbs != 0] || [start == 0], we constrain: last == 1 iff num_limbs == 1.
    #[LAST_ROW_VALID_COMPUTATION]
    NO_ERR_NOR_NUM_LIMBS_ZERO * (NUM_LIMBS_MINUS_ONE * (last * (1 - num_limbs_minus_one_inv) + num_limbs_minus_one_inv) - 1 + last) = 0;

    // ==== MEMORY WRITES ====

    pol commit sel_should_write_mem; // @boolean (by definition on start == 1, then by propagation)
    // On the start row: sel_should_write_mem = no error and num_limbs != 0.
    start * ((1 - err) * (1 - sel_num_limbs_is_zero) - sel_should_write_mem) = 0;
    // On following rows, propagate sel_should_write_mem.
    #[SEL_SHOULD_WRITE_MEM_CONTINUITY]
    (1 - LATCH_CONDITION) * (sel_should_write_mem' - sel_should_write_mem) = 0;
    // Force sel_should_write_mem to 0 when sel is 0 (prevents ghost row injection attacks).
    #[SEL_SHOULD_WRITE_MEM_REQUIRES_SEL]
    sel_should_write_mem * (1 - sel) = 0;

    // Conditional assignment: output_tag = is_output_bits ? MEM_TAG_U1 : MEM_TAG_U8.
    pol commit output_tag;
    output_tag = sel_should_write_mem * ((constants.MEM_TAG_U1 - constants.MEM_TAG_U8) * is_output_bits + constants.MEM_TAG_U8);

    #[WRITE_MEM]
    sel_should_write_mem {
        execution_clk,
        space_id,
        dst_addr,
        limb_value,
        /*mem_tag=*/output_tag,
        /*rw=1*/sel_should_write_mem
    } is memory.sel_to_radix_write {
        memory.clk,
        memory.space_id,
        memory.address,
        memory.value,
        memory.tag,
        memory.rw
    };
