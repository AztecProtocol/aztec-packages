include "merkle_check.pil";
include "../constants_gen.pil";

/**
 * This gadget checks if a message exists in the L1-to-L2 message tree. This is a read-only
 * operation: given a claimed message hash, a leaf index, and a tree root, the gadget verifies
 * Merkle membership for the leaf value at that index and returns whether it matches the message hash.
 *
 * Shape:
 * One row per read.
 *
 * Errors: None
 *
 * Usage:
 *     sel {
 *         msg_hash,
 *         leaf_index,
 *         l1_to_l2_message_tree_root,
 *         exists
 *     } in l1_to_l2_message_tree_check.sel {
 *         l1_to_l2_message_tree_check.msg_hash,    // Input
 *         l1_to_l2_message_tree_check.leaf_index,  // Input
 *         l1_to_l2_message_tree_check.root,        // Input
 *         l1_to_l2_message_tree_check.exists       // Output
 *     };
 *
 * Preconditions:
 * - leaf_index < 2^constants.L1_TO_L2_MSG_TREE_HEIGHT
 *
 * Interactions:
 * - merkle_check: To verify Merkle membership of the leaf value at the given index.
 *
**/
namespace l1_to_l2_message_tree_check;
    pol commit sel; // @boolean
    sel * (1 - sel) = 0;

    #[skippable_if]
    sel = 0;

    // Inputs to the gadget
    pol commit exists; // @boolean
    exists * (1 - exists) = 0;

    pol commit msg_hash;
    pol commit leaf_index;
    pol commit root;

    // ====== TREE CHECK ======
    // Hinted actual leaf value contained at the leaf index.
    pol commit leaf_value;

    // exists = leaf_value == msg_hash
    pol LEAF_VALUE_MSG_HASH_DIFF = leaf_value - msg_hash;
    pol commit leaf_value_msg_hash_diff_inv; // @zero-check
    sel * (LEAF_VALUE_MSG_HASH_DIFF * (exists * (1 - leaf_value_msg_hash_diff_inv) + leaf_value_msg_hash_diff_inv) - 1 + exists) = 0;

    // Lookup constant support: Can be removed when we support constants in lookups
    pol commit l1_to_l2_message_tree_height;
    sel * (constants.L1_TO_L2_MSG_TREE_HEIGHT - l1_to_l2_message_tree_height) = 0;

    // Per-tree merkle-node domain separator. The L1->L2 message tree is append-only and always
    // uses DOM_SEP__MERKLE_HASH. Bound internally so callers don't need to plumb a separator
    // column. Forwarded into merkle_check via #[MERKLE_CHECK].
    pol commit merkle_hash_separator;
    #[MERKLE_HASH_SEPARATOR_CONSTANT]
    sel * (merkle_hash_separator - constants.DOM_SEP__MERKLE_HASH) = 0;

    #[MERKLE_CHECK]
    sel {
        leaf_value,
        leaf_index,
        l1_to_l2_message_tree_height,
        root,
        merkle_hash_separator
    } in merkle_check.start {
        merkle_check.read_node,
        merkle_check.index,
        merkle_check.path_len,
        merkle_check.read_root,
        merkle_check.merkle_hash_separator
    };
