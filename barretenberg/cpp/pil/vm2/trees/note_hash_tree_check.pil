include "merkle_check.pil";
include "../constants_gen.pil";
include "../poseidon2_hash.pil";
include "../public_inputs.pil";
include "../precomputed.pil";

/**
 * This gadget reads or writes notes in the note hash tree. The note hash tree is an append only tree where the
 * leaves are unique note hashes. The computation of unique note hashes is done by:
 * - Siloing the original note hash with the emitter contract address
 * - Computing a nonce as the hash of the first nullifier and the index of the note hash
 * - Computing the unique note hash as the hash of the nonce and the siloed note hash
 * This gadget allows to conditionally write note hashes that can be raw, already siloed or already uniqued.
 * Note that if you ask the gadget to silo the note hash, you also need to ask it to make it unique.
 * For reading, we enforce that the note hash is already unique.
 *
 * Shape:
 * We'll generate just one row per read or write.
 *
 * Errors: None
 *
 * Usage:
 * Read usage:
 *     sel {
 *         precomputed.zero,
 *         unique_note_hash,
 *         leaf_index,
 *         note_hash_tree_root,
 *         exists
 *     } in note_hash_tree_check.sel {
 *         note_hash_tree_check.write,      // Input
 *         note_hash_tree_check.note_hash,  // Input
 *         note_hash_tree_check.leaf_index, // Input
 *         note_hash_tree_check.prev_root,  // Input
 *         note_hash_tree_check.exists      // Output
 *     };
 *
 * On the read variant, there is no need to pass sel_silo or sel_unique, as we force them to be 0.
 *
 * Write usage:
 *     sel {
 *         note_hash,
 *         note_hash_next_available_leaf_index,
 *         prev_note_hash_tree_root,
 *         sel_silo,
 *         address,
 *         sel_unique,
 *         note_hash_index,
 *         discard,
 *         next_note_hash_tree_root
 *     } in note_hash_tree_check.write {
 *         note_hash_tree_check.note_hash,       // Input
 *         note_hash_tree_check.leaf_index,      // Input
 *         note_hash_tree_check.prev_root,       // Input
 *         note_hash_tree_check.sel_silo,        // Input
 *         note_hash_tree_check.address,         // Input
 *         note_hash_tree_check.sel_unique,      // Input
 *         note_hash_tree_check.note_hash_index, // Input
 *         note_hash_tree_check.discard,         // Input
 *         note_hash_tree_check.next_root        // Output
 *     };
 *
 * As write variant usage, we should omit the address column whenever we pass sel_silo == 0, since tracegen will populate it with a 0.
 * On the contrary, `note_hash_index` should always be passed in, even when sel_unique == 0, as it's used for public input checks.
 * Note that we don't return the new size of the tree, since it can be trivially derived by the caller.
 *
 * Preconditions:
 * - leaf_index < 2^constants.NOTE_HASH_TREE_HEIGHT
 * - note_hash_index < constants.MAX_NOTE_HASHES_PER_TX
 *
 * Interactions:
 * - public_inputs:
 *   - To read the first nullifier when uniqueing
 *   - To write the unique note hash when writing
 * - poseidon2_hash:
 *   - To silo the note hash when sel_silo == 1.
 *   - To compute the nonce when sel_unique == 1.
 *   - To compute the unique note hash when sel_unique == 1.
 * - merkle_check: To check the Merkle tree membership when reading and to compute the new root when writing.
 *
**/
namespace note_hash_tree_check;
    pol commit sel; // @boolean
    sel * (1 - sel) = 0;

    #[skippable_if]
    sel = 0;

    // ====== INPUTS ======
    pol commit write; // @boolean
    write * (1 - write) = 0;
    pol READ = 1 - write; // @boolean (by definition)
    pol commit exists; // @boolean
    exists * (1 - exists) = 0;

    // Note hash input to the gadget. This will be passed through / uniqued / siloed+uniqued depending on input selectors.
    pol commit note_hash;
    pol commit leaf_index;
    pol commit prev_root;

    // ====== WRITE SPECIFIC INPUTS ======
    pol commit sel_silo; // @boolean
    sel_silo * (1 - sel_silo) = 0;

    pol commit address;

    pol commit sel_unique; // @boolean
    sel_unique * (1 - sel_unique) = 0;

    pol commit note_hash_index;

    pol commit discard; // @boolean
    discard * (1 - discard) = 0;

    // Tracegen must set it to zero on read (merkle check precondition).
    pol commit next_root;

    // Allows this gadget to be looked up by the write column
    write * (1 - sel) = 0;


    // ====== SILOING ======
    // If reading we should pass an already siloed note hash
    #[DISABLE_SILOING_ON_READ]
    READ * sel_silo = 0;

    // Asking the gadget to silo without asking it to unique is an error
    sel_silo * (1 - sel_unique) = 0;

    // siloed_note_hash = if sel_silo { silo(address, note_hash) } else { note_hash }
    pol commit siloed_note_hash;
    #[PASSTHROUGH_SILOING]
    sel * (1 - sel_silo) * (note_hash - siloed_note_hash) = 0;

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit siloing_separator;
    sel * (constants.DOM_SEP__SILOED_NOTE_HASH - siloing_separator) = 0;
    pol commit const_three;
    sel * (const_three - 3) = 0;

    #[SILO_POSEIDON2]
    sel_silo {
        siloing_separator, address, note_hash,
        siloed_note_hash, const_three
    } in poseidon2_hash.start {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2,
        poseidon2_hash.output, poseidon2_hash.input_len
    };

    // ====== UNIQUE ======
    // If reading we should pass an already unique note hash
    #[DISABLE_UNIQUENESS_ON_READ]
    READ * sel_unique = 0;

    // unique_note_hash = if sel_unique { unique(siloed_note_hash, make_nonce(note_hash_index)) } else { siloed_note_hash }
    pol commit unique_note_hash;
    #[PASSTHROUGH_UNIQUENESS]
    sel * (1 - sel_unique) * (siloed_note_hash - unique_note_hash) = 0;

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit first_nullifier_pi_index;
    sel * (constants.AVM_PUBLIC_INPUTS_PREVIOUS_NON_REVERTIBLE_ACCUMULATED_DATA_NULLIFIERS_ROW_IDX - first_nullifier_pi_index) = 0;

    pol commit first_nullifier;

    #[READ_FIRST_NULLIFIER]
    sel_unique {
        first_nullifier_pi_index,
        first_nullifier
    } in public_inputs.sel {
        precomputed.idx,
        public_inputs.cols[0]
    };

    pol commit nonce;

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit nonce_separator;
    sel * (constants.DOM_SEP__NOTE_HASH_NONCE - nonce_separator) = 0;

    #[NONCE_COMPUTATION_POSEIDON2]
    sel_unique {
        nonce_separator, first_nullifier, note_hash_index,
        nonce, const_three
    } in poseidon2_hash.start {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2,
        poseidon2_hash.output, poseidon2_hash.input_len
    };

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit unique_note_hash_separator;
    sel * (constants.DOM_SEP__UNIQUE_NOTE_HASH - unique_note_hash_separator) = 0;

    #[UNIQUE_NOTE_HASH_POSEIDON2]
    sel_unique {
        unique_note_hash_separator, nonce, siloed_note_hash,
        unique_note_hash, const_three
    } in poseidon2_hash.start {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2,
        poseidon2_hash.output, poseidon2_hash.input_len
    };

    // ====== TREE CHECK ======
    // We get a hint of the previous leaf value. We'll pass this to merkle check:
    // - If reading, prev_leaf_value will be compared to the unique note hash to determine exists.
    // - If writing, prev_leaf_value will be zero, ensuring we write to a never written leaf.
    pol commit prev_leaf_value;

    // exists = prev_leaf_value == unique_note_hash
    pol PREV_LEAF_VALUE_UNIQUE_NOTE_HASH_DIFF = prev_leaf_value - unique_note_hash;
    pol commit prev_leaf_value_unique_note_hash_diff_inv; // @zero-check
    sel * (PREV_LEAF_VALUE_UNIQUE_NOTE_HASH_DIFF * (exists * (1 - prev_leaf_value_unique_note_hash_diff_inv) + prev_leaf_value_unique_note_hash_diff_inv) - 1 + exists) = 0;

    // Hardening: should not be necessary if next available leaf indices are managed correctly, but it's cheap.
    write * prev_leaf_value = 0;

    pol commit next_leaf_value;
    // If reading, next_leaf_value is unconstrained. Tracegen must set it to zero (merkle check precondition).
    write * (unique_note_hash - next_leaf_value) = 0;

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit note_hash_tree_height;
    sel * (constants.NOTE_HASH_TREE_HEIGHT - note_hash_tree_height) = 0;

    // Per-tree merkle-node domain separator. The note hash tree is append-only and always
    // uses DOM_SEP__MERKLE_HASH. Bound internally so callers (tx.pil / opcodes) don't need
    // to plumb a separator column. Forwarded into merkle_check via #[MERKLE_CHECK].
    pol commit merkle_hash_separator;
    #[MERKLE_HASH_SEPARATOR_CONSTANT]
    sel * (merkle_hash_separator - constants.DOM_SEP__MERKLE_HASH) = 0;

    #[MERKLE_CHECK]
    sel {
        write, prev_leaf_value, next_leaf_value,
        leaf_index, note_hash_tree_height, prev_root, next_root,
        merkle_hash_separator
    } in merkle_check.start {
        merkle_check.write, merkle_check.read_node, merkle_check.write_node,
        merkle_check.index, merkle_check.path_len, merkle_check.read_root, merkle_check.write_root,
        merkle_check.merkle_hash_separator
    };


    // ====== WRITE TO PUBLIC INPUTS ======
    // ONE-WAY write: only the active rows [0, length) are constrained. Rows [length, MAX) are left
    // free by the AVM and are defensively zero-checked by the public base rollup
    // (validate_avm_accumulated_data_padding). See public_inputs.pil's NOTE ON NON-MALLEABILITY.
    pol commit sel_write_to_public_inputs;  // @boolean (by definition)
    write * (1 - discard) = sel_write_to_public_inputs;
    pol commit public_inputs_index;
    sel_write_to_public_inputs * (constants.AVM_PUBLIC_INPUTS_AVM_ACCUMULATED_DATA_NOTE_HASHES_ROW_IDX + note_hash_index - public_inputs_index) = 0;

    #[WRITE_NOTE_HASH_TO_PUBLIC_INPUTS]
    sel_write_to_public_inputs {
        public_inputs_index,
        unique_note_hash
    } in public_inputs.sel {
        precomputed.idx,
        public_inputs.cols[0]
    };
