include "merkle_check.pil";

include "../ff_gt.pil";
include "../poseidon2_hash.pil";
include "../constants_gen.pil";
include "../precomputed.pil";
include "../public_inputs.pil";
include "public_data_squash.pil";

/**
 * This gadget reads or writes in the public data tree. The public data tree is an indexed tree where leaves
 * have slot and value. Slot is the "key" and value is the stored data. When we read from the public data tree,
 * we assume that a slot that has not been written before has value zero.
 * For this we perform a low leaf membership proof and:
 *  - if the low leaf slot is equal to the slot, that means that slot has been written before, and we assert that
 *    the low leaf value is equal to the value we are reading.
 *  - if the low leaf slot is not equal to the slot, we assert that the low leaf is indeed a valid low leaf for the
 *    requested slot, proving non existence of the slot in the tree. In that case we check value to be zero.
 * In order to validate that a leaf is a low leaf of the slot, we need to check that the low_leaf.slot is < slot
 * and that low_leaf.next_slot is > slot. However, we need to consider the case where next_slot is zero, which
 * means "infinity". The highest slot inserted in the tree will point to infinity as the "next_slot".
 * In order to write, we perform the above, and also:
 * - We update the low leaf. If the slot has been written before, we update the value. Otherwise, we'll insert a new leaf
 *     so we update the pointers of the low leaf to the newly inserted leaf.
 * - We insert the new leaf if it was never written before.
 *
 * Note: Indexed trees start prefilled with at least two items, so we can assume that no low leaf will be all zeroes
 * and that there will always be a low leaf for any given value.
 *
 * This trace also performs siloing and lookups to public inputs.
 * In order to look up public inputs, it needs to squash the public data writes, which means that writes need to be looked up with clk.
 * We use a dedicated squashing subtrace for this.
 *
 * https://hackmd.io/luYtD3XVTpGCDFeeCYS_Uw?view#Storage
 *
 * Shape:
 * One row per read or write operation. Sorted by clk ascending (reads have clk=0 and appear first).
 *
 * Errors:
 * All validation failures (mismatched value, invalid low leaf, nonzero value for non-existing slot)
 * are fatal errors. No error handling in the trace.
 *
 * Preconditions:
 * - clk must be a 32-bit number (enforced by the caller).
 * - clk must not repeat for writes to the same slot (asserted by public_data_squash interaction)
 * - low_leaf_index < 2^PUBLIC_DATA_TREE_HEIGHT (Merkle check requirement).
 * - tree_size_before_write < 2^PUBLIC_DATA_TREE_HEIGHT (Merkle check requirement).
 * - The tree genesis state must have an irreproducible hash for uninitialized leaves (0). See note in indexed_tree_check.pil
 * - Rows on this trace must come from permutations if write=1
 *
 * Interactions (destinations):
 * - poseidon2_hash: Siloing (sel), low leaf hash (sel, 2-row), updated low leaf hash (write, 2-row),
 *                   new leaf hash (should_insert, 2-row). All use input_len = 3 or 4.
 * - merkle_check: Low leaf membership/update (sel), new leaf insertion (should_insert).
 * - ff_gt: Low leaf slot validation (leaf_not_exists), next slot validation (next_slot_is_nonzero).
 * - public_data_squash: Squashing permutation (non_discarded_write).
 * - public_inputs: Write public data (sel_write_to_public_inputs), write length (end).
 *
 * Read callers pass the `write` column in the tuple (with value precomputed.zero) so the
 * lookup against `public_data_check.sel` can only match read rows (write=0). This is required
 * for soundness: without it, a malicious prover could satisfy a read lookup by matching
 * against a write row.
 *
 * Write callers do not need to pass `write`. Completeness is preserved by two safeguards:
 * (1) the multi-permutation in tracegen uses `public_data_check.write` as its main destination
 *     table selector, so only rows with write=1 are indexed as candidates for the write
 *     permutations; and
 * (2) the `clk` column in the tuple is unique per write (preconditions), so each write source
 *     row matches exactly one destination row.
 *
 * Read usage:
 * sel {
 *    precomputed.zero,            // write = 0 (read)
 *    value,
 *    address,
 *    slot,
 *    public_data_tree_root
 * } in public_data_check.sel {
 *    public_data_check.write,     // Input
 *    public_data_check.value,     // Output
 *    public_data_check.address,   // Input
 *    public_data_check.slot,      // Input
 *    public_data_check.root       // Input
 * };
 *
 * Write usage:
 * sel {
 *   value,
 *   address,
 *   slot,
 *   discard,
 *   prev_public_data_tree_root,
 *   next_public_data_tree_root,
 *   prev_public_data_tree_size,
 *   next_public_data_tree_size,
 *   clk
 * } is public_data_check.sel_XXX {
 *   public_data_check.value,                   // Input
 *   public_data_check.address,                 // Input
 *   public_data_check.slot,                    // Input
 *   public_data_check.discard,                 // Input
 *   public_data_check.root,                    // Input
 *   public_data_check.write_root,              // Output
 *   public_data_check.tree_size_before_write,  // Input
 *   public_data_check.tree_size_after_write,   // Output
 *   public_data_check.clk                      // Input
 * };
 *
 * where sel_XXX = `protocol_write` or `non_protocol_write`.
 *
**/
namespace public_data_check;
    pol commit sel; // @boolean
    sel * (1 - sel) = 0;

    #[skippable_if]
    sel = 0;

    // ============ CONTIGUOUS TRACE ============

    // Next sel=1 implies current sel=1 or first_row=1
    // With this constraint, we can only have sel=1 for N rows after the first, where N could be zero.
    #[TRACE_CONTINUITY]
    (1 - sel - precomputed.first_row) * sel' = 0;

    pol commit not_end; // @boolean (by definition)
    not_end = sel * sel';

    pol commit end; // @boolean (by definition)
    #[END_CONDITION]
    end = sel - not_end;

    // ============ INPUTS ============
    pol commit value;
    pol commit slot;
    pol commit root;
    pol commit address;

    // Write specific inputs
    // The resulting root after the write
    pol commit write_root;
    pol commit tree_size_before_write;
    pol commit tree_size_after_write;

    // Whether the write is a protocol or non-protocol write (permutation selectors (sstore.pil, tx.pil))
    pol commit protocol_write;  // @boolean
    protocol_write * (1 - protocol_write) = 0;
    pol commit non_protocol_write; // @boolean
    non_protocol_write * (1 - non_protocol_write) = 0;

    pol commit write; // @boolean
    write * (1 - write) = 0;

    // Write implies sel, so this gadget can be safely permuted by protocol_write and non_protocol_write.
    write * (1 - sel) = 0;

    #[PROTOCOL_WRITE_CHECK]
    write = protocol_write + non_protocol_write;

    // Precondition: clk is a 32-bit number.
    pol commit clk;

    pol commit discard; // @boolean
    discard * (1 - discard) = 0;

    // ========= SORTING =========
    // If not the last row, clock must not decrease
    // but can be equal to the previous clock to support reads with clk=0
    pol CLK_DIFF = not_end * (clk' - clk);

    // Unconstrained on end=1
    pol commit clk_diff_lo;
    pol commit clk_diff_hi;
    #[CLK_DIFF_DECOMP]
    CLK_DIFF = clk_diff_lo + 2**16 * clk_diff_hi;

    #[CLK_DIFF_RANGE_LO]
    not_end { clk_diff_lo }
    in precomputed.sel_range_16 { precomputed.idx };

    #[CLK_DIFF_RANGE_HI]
    not_end { clk_diff_hi }
    in precomputed.sel_range_16 { precomputed.idx };

    // We enforce reads, which have non looked up clk, to have clk = 0
    // So tracegen must put them at the start of the trace
    (1 - write) * clk = 0;

    // ========= SILOING =========
    pol commit leaf_slot;

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit siloing_separator;
    sel * (constants.DOM_SEP__PUBLIC_LEAF_SLOT - siloing_separator) = 0;

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit const_three;
    sel * (const_three - 3) = 0;
    pol commit const_four;
    sel * (const_four - 4) = 0;
    // Per-tree merkle-node domain separator for the public-data tree.
    pol commit merkle_hash_separator;
    sel * (merkle_hash_separator - constants.DOM_SEP__PUBLIC_DATA_MERKLE) = 0;

    #[SILO_POSEIDON2]
    sel {
        siloing_separator, address, slot,
        leaf_slot, const_three
    } in poseidon2_hash.start {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2,
        poseidon2_hash.output, poseidon2_hash.input_len
    };

    // ========= LOW LEAF VALIDATION =========
    // Note: We don't validate that the low leaf is not empty. This is because we force hashing the low leaf for the
    // membership check. An empty leaf would pass the low leaf validation, but the membership check would fail,
    // since uninitialized leaves have hash 0, which is not the poseidon2 hash of an empty leaf.
    // It is expected that no circuit introduces an empty leaf with its proper hash ever into an indexed tree.
    // Doing so would break the tree as it'd be a valid low leaf for any insertion.
    pol commit low_leaf_slot;
    pol commit low_leaf_value;
    pol commit low_leaf_next_index;
    pol commit low_leaf_next_slot;

    // We commit leaf not exists instead of leaf exists since it'll be used as a selector for a lookup
    pol commit leaf_not_exists; // @boolean
    leaf_not_exists * (1 - leaf_not_exists) = 0;
    pol LEAF_EXISTS = 1 - leaf_not_exists;

    pol commit leaf_slot_low_leaf_slot_diff_inv; // @zero-check
    pol LEAF_SLOT_LOW_LEAF_SLOT_DIFF = leaf_slot - low_leaf_slot;

    // LEAF_SLOT_LOW_LEAF_SLOT_DIFF == 0 <==> LEAF_EXISTS == 1
    #[EXISTS_FLAG_CHECK]
    sel * (LEAF_SLOT_LOW_LEAF_SLOT_DIFF * (LEAF_EXISTS * (1 - leaf_slot_low_leaf_slot_diff_inv) + leaf_slot_low_leaf_slot_diff_inv) - 1 + LEAF_EXISTS) = 0;

    // If the leaf doesn't exist, we need to validate that the leaf slot is greater than the low leaf slot
    #[LOW_LEAF_SLOT_VALIDATION]
    leaf_not_exists { leaf_slot, low_leaf_slot, leaf_not_exists /* result=1 */ }
    in ff_gt.sel_gt { ff_gt.a, ff_gt.b, ff_gt.result };

    // If next leaf slot is not zero (which would be infinity), it has to be greater than the leafslot.
    // We commit next_slot_is_nonzero instead of next_slot_is_zero since it'll be used as a selector for a lookup
    // Unconstrained if leaf_not_exists=0
    pol commit next_slot_is_nonzero; // @boolean
    next_slot_is_nonzero * (1 - next_slot_is_nonzero) = 0;
    pol NEXT_SLOT_IS_ZERO = 1 - next_slot_is_nonzero;

    pol commit next_slot_inv; // @zero-check
    #[NEXT_SLOT_IS_ZERO_CHECK]
    leaf_not_exists * (low_leaf_next_slot * (NEXT_SLOT_IS_ZERO * (1 - next_slot_inv) + next_slot_inv) - 1 + NEXT_SLOT_IS_ZERO) = 0;

    #[LOW_LEAF_NEXT_SLOT_VALIDATION]
    next_slot_is_nonzero { low_leaf_next_slot, leaf_slot, next_slot_is_nonzero /* result=1 */ }
    in ff_gt.sel_gt { ff_gt.a, ff_gt.b, ff_gt.result };

    // ========= COMPUTE LOW LEAF UPDATE =========
    // Unconstrained if write=0
    pol commit updated_low_leaf_value;
    pol commit updated_low_leaf_next_index;
    pol commit updated_low_leaf_next_slot;

    // On write, if the leaf exists, we update the value. Otherwise, we'll insert so we update the pointers.
    #[LOW_LEAF_VALUE_UPDATE]
    write * ((low_leaf_value - value) * leaf_not_exists + value - updated_low_leaf_value) = 0;
    #[LOW_LEAF_NEXT_INDEX_UPDATE]
    write * ((tree_size_before_write - low_leaf_next_index) * leaf_not_exists + low_leaf_next_index - updated_low_leaf_next_index) = 0;
    #[LOW_LEAF_NEXT_SLOT_UPDATE]
    write * ((leaf_slot - low_leaf_next_slot) * leaf_not_exists + low_leaf_next_slot - updated_low_leaf_next_slot) = 0;

    // ========= LOW LEAF MEMBERSHIP =========
    pol commit low_leaf_hash;

    // Leaf preimage is (slot, value, next_slot, next_index) -- 4 inputs, 2-row chain.
    #[LOW_LEAF_POSEIDON2_0]
    sel {
        low_leaf_slot, low_leaf_value, low_leaf_next_slot,
        low_leaf_hash, const_four
    } in poseidon2_hash.start {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2,
        poseidon2_hash.output, poseidon2_hash.input_len
    };

    #[LOW_LEAF_POSEIDON2_1]
    sel {
        low_leaf_next_index, precomputed.zero, precomputed.zero, low_leaf_hash
    } in poseidon2_hash.end {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2, poseidon2_hash.output
    };

    // Unconstrained if write=0
    pol commit updated_low_leaf_hash;

    #[UPDATED_LOW_LEAF_POSEIDON2_0]
    write {
        low_leaf_slot, updated_low_leaf_value, updated_low_leaf_next_slot,
        updated_low_leaf_hash, const_four
    } in poseidon2_hash.start {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2,
        poseidon2_hash.output, poseidon2_hash.input_len
    };

    #[UPDATED_LOW_LEAF_POSEIDON2_1]
    write {
        updated_low_leaf_next_index, precomputed.zero, precomputed.zero, updated_low_leaf_hash
    } in poseidon2_hash.end {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2, poseidon2_hash.output
    };

    pol commit low_leaf_index;

    // The intermediate root is the root of the tree after the low leaf update but before the new leaf is inserted.
    // Unconstrained if write=0
    pol commit intermediate_root;

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit tree_height;
    sel * (tree_height - constants.PUBLIC_DATA_TREE_HEIGHT) = 0;

    #[LOW_LEAF_MERKLE_CHECK]
    sel {
        write, low_leaf_hash, updated_low_leaf_hash,
        low_leaf_index, tree_height, root, intermediate_root,
        merkle_hash_separator
    } in merkle_check.start {
        merkle_check.write, merkle_check.read_node, merkle_check.write_node,
        merkle_check.index, merkle_check.path_len, merkle_check.read_root, merkle_check.write_root,
        merkle_check.merkle_hash_separator
    };

    // ========= READ VALUE CHECK =========
    // When reading, value is an output. We constrain it to be the low leaf value if the leaf exists, otherwise 0.
    // if read { value = LEAF_EXISTS ? low_leaf_value : 0 }
    #[VALUE_IS_CORRECT]
    (1 - write) * (low_leaf_value * LEAF_EXISTS - value) = 0;

    // ========= COMPUTE FINAL SNAPSHOT =========
    pol commit should_insert; // @boolean (by definition)
    should_insert = leaf_not_exists * write;

    // Unconstrained if should_insert=0
    pol commit new_leaf_hash;

    #[NEW_LEAF_POSEIDON2_0]
    should_insert {
        leaf_slot, value, low_leaf_next_slot,
        new_leaf_hash, const_four
    } in poseidon2_hash.start {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2,
        poseidon2_hash.output, poseidon2_hash.input_len
    };

    #[NEW_LEAF_POSEIDON2_1]
    should_insert {
        low_leaf_next_index, precomputed.zero, precomputed.zero, new_leaf_hash
    } in poseidon2_hash.end {
        poseidon2_hash.input_0, poseidon2_hash.input_1, poseidon2_hash.input_2, poseidon2_hash.output
    };

    #[NEW_LEAF_MERKLE_CHECK]
    should_insert {
        should_insert, precomputed.zero /* read_node=0 */, new_leaf_hash,
        tree_size_before_write /* leaf_index */, tree_height, intermediate_root, write_root,
        merkle_hash_separator
    } in merkle_check.start {
        merkle_check.write, merkle_check.read_node, merkle_check.write_node,
        merkle_check.index, merkle_check.path_len, merkle_check.read_root, merkle_check.write_root,
        merkle_check.merkle_hash_separator
    };

    pol SHOULD_UPDATE = LEAF_EXISTS * write;
    // If we are writing:
    // If the leaf exists, we don't insert, so write_root is intermediate_root
    // Otherwise, the write root is already constrained by #[NEW_LEAF_MERKLE_CHECK]
    #[UPDATE_ROOT_VALIDATION]
    SHOULD_UPDATE * (write_root - intermediate_root) = 0;

    // If we inserted a new leaf, we have to increment the tree size.
    tree_size_after_write = tree_size_before_write + should_insert;

    // ========= WRITE TO PUBLIC INPUTS =========
    // This column will hold the index to write to public inputs. It should start at AVM_PUBLIC_INPUTS_AVM_ACCUMULATED_DATA_PUBLIC_DATA_WRITES_ROW_IDX
    // and be incremented every time we write.
    pol commit write_idx;
    // We'll record the squashed writes in the public inputs vector dedicated for accumulated public data writes.
    // We start at the row index where the public data writes start.
    #[WRITE_IDX_INITIAL_VALUE]
    sel' * (1 - sel) * (constants.AVM_PUBLIC_INPUTS_AVM_ACCUMULATED_DATA_PUBLIC_DATA_WRITES_ROW_IDX - write_idx') = 0;

    // If a write with discard = 0, we permute to the public data squash trace to get write to public inputs
    pol commit non_discarded_write; // @boolean (by definition)
    non_discarded_write = write * (1 - discard);

    pol commit sel_write_to_public_inputs; // @boolean (by public_data_squash or forced to 0)
    // If this is a read or a discarded write, write to public inputs must be zero
    (1 - non_discarded_write) * sel_write_to_public_inputs = 0;

    // We fetch the final value that will be written to this slot from the squashing trace.
    // This is because we need to write to public inputs in order of appearance, but with the last value.
    pol commit final_value;

    #[SQUASHING]
    non_discarded_write {
        leaf_slot,
        clk,
        sel_write_to_public_inputs,
        value,
        final_value
    } is public_data_squash.sel {
        public_data_squash.leaf_slot,
        public_data_squash.clk,
        public_data_squash.write_to_public_inputs,
        public_data_squash.value,
        public_data_squash.final_value
    };

    // We need to increment the write index by one so the next write will be looked up in the next index of the PI public data writes vector.
    #[WRITE_IDX_INCREMENT]
    not_end * (write_idx + sel_write_to_public_inputs - write_idx') = 0;

    #[WRITE_PUBLIC_DATA_TO_PUBLIC_INPUTS]
    sel_write_to_public_inputs {
        write_idx,
        leaf_slot,
        final_value
    } in public_inputs.sel {
        precomputed.idx,
        public_inputs.cols[0],
        public_inputs.cols[1]
    };

    // ========= ASSERT FINAL LENGTH =========
    // Every transaction we prove must have at least one public data write, the fee one.
    // Thanks to that, we can assert here that the length of the public data writes vector in public inputs
    // is the correct length, when this trace has end=1
    pol commit public_data_writes_length;
    // public_data_writes_length = (write_idx - AVM_PUBLIC_INPUTS_AVM_ACCUMULATED_DATA_PUBLIC_DATA_WRITES_ROW_IDX + sel_write_to_public_inputs)
    sel * (write_idx - constants.AVM_PUBLIC_INPUTS_AVM_ACCUMULATED_DATA_PUBLIC_DATA_WRITES_ROW_IDX + sel_write_to_public_inputs - public_data_writes_length) = 0;

    // Lookup constant support: Can be removed when we support constants in lookups.
    pol commit length_pi_idx;
    sel * (constants.AVM_PUBLIC_INPUTS_AVM_ACCUMULATED_DATA_ARRAY_LENGTHS_PUBLIC_DATA_WRITES_ROW_IDX - length_pi_idx) = 0;

    #[WRITE_WRITES_LENGTH_TO_PUBLIC_INPUTS]
    end {
        length_pi_idx,
        public_data_writes_length
    } in public_inputs.sel {
        precomputed.idx,
        public_inputs.cols[0]
    };
