{
  "name": "bb-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docs": "yarn preprocess && docusaurus start --host ${HOST:-localhost}",
    "dev": "HOST=0.0.0.0 ENV=dev yarn run docs",
    "dev:netlify": "yarn netlify dev",
    "build": "yarn clear && yarn preprocess && ./scripts/build_docs.sh && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "./scripts/clean.sh",
    "serve": "docusaurus serve",
    "typecheck": "yarn tsgo",
    "test": "NODE_NO_WARNINGS=1 node --experimental-vm-modules ./node_modules/.bin/jest",
    "preprocess": "node src/preprocess/index.js",
    "preprocess:clean": "node src/preprocess/index.js clean"
  },
  "dependencies": {
    "@aztec/bb.js": "0.87.9",
    "@docusaurus/core": "3.7.0",
    "@docusaurus/plugin-client-redirects": "3.7.0",
    "@docusaurus/plugin-ideal-image": "^3.7.0",
    "@docusaurus/preset-classic": "3.7.0",
    "@getbrevo/brevo": "^3.0.1",
    "@mdx-js/react": "^3.0.0",
    "@noir-lang/noir_js": "1.0.0-beta.8",
    "axios": "^1.13.6",
    "clsx": "^2.0.0",
    "fs-extra": "^11.3.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "serve": "^14.2.6",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.7.0",
    "@docusaurus/tsconfig": "3.7.0",
    "@docusaurus/types": "3.7.0",
    "@jest/globals": "^30.0.0",
    "@swc/core": "^1.10.0",
    "@swc/jest": "^0.2.37",
    "@types/jest": "^30.0.0",
    "@typescript/native-preview": "7.0.0-dev.20251126.1",
    "jest": "^30.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.6.2"
  },
  "jest": {
    "testRegex": "./examples/.*\\.test\\.ts$",
    "transform": {
      "^.+\\.tsx?$": [
        "@swc/jest"
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "testTimeout": 120000
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "resolutions": {
    "tar-fs": "^3.1.1",
    "@docusaurus/**/image-size": "1.2.1",
    "h3": "^1.15.5",
    "node-forge": "^1.3.2",
    "serve-handler": "^6.1.7",
    "serialize-javascript": "^7.0.3",
    "axios": "^1.13.6",
    "fastify": "5.8.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
