        s14 = s15 + xl15 * xl15 + qi * 5125u;
        s15 = s16 + w2 * xl16 + qi * 305u;
        s16 = s17 + w2 * xl17 + qi * 5015u;
        s17 = s18 + w2 * xl18 + qi * 6419u;
