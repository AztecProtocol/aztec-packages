fn montgomery_product_f8(x: array<u32, 8>, y: array<u32, 8>) -> array<u32, 8> {
    var x20: BigInt = unpack256_to_limbs(x);
    var y20: BigInt = unpack256_to_limbs(y);
    var r: BigInt = montgomery_product(&x20, &y20);
    return pack_limbs_to_256(&r);
}
