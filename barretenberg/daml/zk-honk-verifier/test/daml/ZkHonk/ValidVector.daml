validVkCommitments : [G1]
validVkCommitments = commitmentsFromFrs (drop 3 validVkFieldElements)

validVk : VerificationKey
validVk = VerificationKey with
  logCircuitSize = 6
  numPublicInputs = 9
  pubInputsOffset = 1
  precomputedCommitments = validVkCommitments
  expectedVkHash = validVkHash

commitmentsFromFrs : [Fr] -> [G1]
commitmentsFromFrs fields =
  case fields of
    [] -> []
    _ ->
      case commitmentFromFrs (take 4 fields) of
        Some commitment -> commitment :: commitmentsFromFrs (drop 4 fields)
        None -> error "invalid generated VK commitment"
