{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'FILE=$(jq -r \".tool_input.file_path\"); if [[ \"$FILE\" =~ \\.(ts|js|mjs|cjs|json)$ ]]; then \"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\" --write \"$FILE\" 2>/dev/null; fi'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "additionalDirectories": ["../", "/tmp"],
    "allow": [
      "Bash(yarn:*)",
      "Bash(forge:*)",
      "Bash(env LOG_LEVEL=* yarn *)",
      "Bash(./bootstrap.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git reflog:*)",
      "Bash(git worktree:*)",
      "Bash(git config:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(cd:*)",
      "Bash(grep:*)",
      "Bash(curl -XGET:*)",
      "Bash(.claude/scripts/extract-test-logs.sh:*)",
      "Bash(./ci.sh dlog:*)",
      "WebFetch(domain:ci.aztec-labs.com)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)"
    ],
    "deny": [],
    "ask": []
  }
}
