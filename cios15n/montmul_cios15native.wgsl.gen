  {   // ===== outer i=16 : fused multiply+reduce (deferred carries) =====
    let t: u32 = s0 + x16 * y0;
    let qi: u32 = (N0 * (t & 32767u)) & 32767u;
    let c: u32 = (t + qi * p0) >> 15u;
    s0 = s1 + x16 * y1 + qi * p1 + c;
    s1 = s2 + x16 * y2 + qi * p2;
