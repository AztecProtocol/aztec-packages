    s2 = s3 + x11 * y3 + qi * p3;
    s3 = s4 + x11 * y4 + qi * p4;
    s4 = s5 + x11 * y5 + qi * p5;
    s5 = s6 + x11 * y6 + qi * p6;
    s6 = s7 + x11 * y7 + qi * p7;
    s7 = s8 + x11 * y8 + qi * p8;
