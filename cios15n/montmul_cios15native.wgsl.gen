    s6 = s7 + x10 * y7 + qi * p7;
    s7 = s8 + x10 * y8 + qi * p8;
    s8 = s9 + x10 * y9 + qi * p9;
    s9 = s10 + x10 * y10 + qi * p10;
    s10 = s11 + x10 * y11 + qi * p11;
    s11 = s12 + x10 * y12 + qi * p12;
    s12 = s13 + x10 * y13 + qi * p13;
    s13 = s14 + x10 * y14 + qi * p14;
    s14 = s15 + x10 * y15 + qi * p15;
