    s10 = s11 + x11 * y11 + qi * p11;
    s11 = s12 + x11 * y12 + qi * p12;
    s12 = s13 + x11 * y13 + qi * p13;
    s13 = s14 + x11 * y14 + qi * p14;
    s14 = s15 + x11 * y15 + qi * p15;
    s15 = s16 + x11 * y16 + qi * p16;
    s16 = 0u;
  }
  {   // periodic carry normalize (K=2)
    var cn: u32 = 0u;
    { let v: u32 = s0 + cn; cn = v >> 15u; s0 = v & 32767u; }
    { let v: u32 = s1 + cn; cn = v >> 15u; s1 = v & 32767u; }
    { let v: u32 = s2 + cn; cn = v >> 15u; s2 = v & 32767u; }
    { let v: u32 = s3 + cn; cn = v >> 15u; s3 = v & 32767u; }
    { let v: u32 = s4 + cn; cn = v >> 15u; s4 = v & 32767u; }
    { let v: u32 = s5 + cn; cn = v >> 15u; s5 = v & 32767u; }
    { let v: u32 = s6 + cn; cn = v >> 15u; s6 = v & 32767u; }
    { let v: u32 = s7 + cn; cn = v >> 15u; s7 = v & 32767u; }
    { let v: u32 = s8 + cn; cn = v >> 15u; s8 = v & 32767u; }
    { let v: u32 = s9 + cn; cn = v >> 15u; s9 = v & 32767u; }
    { let v: u32 = s10 + cn; cn = v >> 15u; s10 = v & 32767u; }
    { let v: u32 = s11 + cn; cn = v >> 15u; s11 = v & 32767u; }
    { let v: u32 = s12 + cn; cn = v >> 15u; s12 = v & 32767u; }
    { let v: u32 = s13 + cn; cn = v >> 15u; s13 = v & 32767u; }
    { let v: u32 = s14 + cn; cn = v >> 15u; s14 = v & 32767u; }
    { let v: u32 = s15 + cn; cn = v >> 15u; s15 = v & 32767u; }
    s16 = cn;
  }
  {   // ===== outer i=12 : fused multiply+reduce (deferred carries) =====
    let t: u32 = s0 + x12 * y0;
    let qi: u32 = (N0 * (t & 32767u)) & 32767u;
    let c: u32 = (t + qi * p0) >> 15u;
    s0 = s1 + x12 * y1 + qi * p1 + c;
    s1 = s2 + x12 * y2 + qi * p2;
    s2 = s3 + x12 * y3 + qi * p3;
    s3 = s4 + x12 * y4 + qi * p4;
    s4 = s5 + x12 * y5 + qi * p5;
    s5 = s6 + x12 * y6 + qi * p6;
    s6 = s7 + x12 * y7 + qi * p7;
    s7 = s8 + x12 * y8 + qi * p8;
    s8 = s9 + x12 * y9 + qi * p9;
    s9 = s10 + x12 * y10 + qi * p10;
