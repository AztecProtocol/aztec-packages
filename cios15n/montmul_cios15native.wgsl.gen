    let c: u32 = (t + qi * p0) >> 15u;
    s0 = s1 + x13 * y1 + qi * p1 + c;
    s1 = s2 + x13 * y2 + qi * p2;
    s2 = s3 + x13 * y3 + qi * p3;
    s3 = s4 + x13 * y4 + qi * p4;
    s4 = s5 + x13 * y5 + qi * p5;
    s5 = s6 + x13 * y6 + qi * p6;
    s6 = s7 + x13 * y7 + qi * p7;
    s7 = s8 + x13 * y8 + qi * p8;
    s8 = s9 + x13 * y9 + qi * p9;
    s9 = s10 + x13 * y10 + qi * p10;
    s10 = s11 + x13 * y11 + qi * p11;
    s11 = s12 + x13 * y12 + qi * p12;
    s12 = s13 + x13 * y13 + qi * p13;
    s13 = s14 + x13 * y14 + qi * p14;
    s14 = s15 + x13 * y15 + qi * p15;
    s15 = s16 + x13 * y16 + qi * p16;
    s16 = 0u;
  }
  {   // periodic carry normalize (K=2)
    var cn: u32 = 0u;
    { let v: u32 = s0 + cn; cn = v >> 15u; s0 = v & 32767u; }
    { let v: u32 = s1 + cn; cn = v >> 15u; s1 = v & 32767u; }
    { let v: u32 = s2 + cn; cn = v >> 15u; s2 = v & 32767u; }
    { let v: u32 = s3 + cn; cn = v >> 15u; s3 = v & 32767u; }
    { let v: u32 = s4 + cn; cn = v >> 15u; s4 = v & 32767u; }
    { let v: u32 = s5 + cn; cn = v >> 15u; s5 = v & 32767u; }
    { let v: u32 = s6 + cn; cn = v >> 15u; s6 = v & 32767u; }
    { let v: u32 = s7 + cn; cn = v >> 15u; s7 = v & 32767u; }
