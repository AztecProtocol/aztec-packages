  { let v: u32 = s7 + cc; cc = v >> 15u; s7 = v & 32767u; }
  { let v: u32 = s8 + cc; cc = v >> 15u; s8 = v & 32767u; }
  { let v: u32 = s9 + cc; cc = v >> 15u; s9 = v & 32767u; }
  { let v: u32 = s10 + cc; cc = v >> 15u; s10 = v & 32767u; }
  { let v: u32 = s11 + cc; cc = v >> 15u; s11 = v & 32767u; }
  { let v: u32 = s12 + cc; cc = v >> 15u; s12 = v & 32767u; }
  { let v: u32 = s13 + cc; cc = v >> 15u; s13 = v & 32767u; }
  { let v: u32 = s14 + cc; cc = v >> 15u; s14 = v & 32767u; }
  { let v: u32 = s15 + cc; cc = v >> 15u; s15 = v & 32767u; }
  { let v: u32 = s16 + cc; cc = v >> 15u; s16 = v & 32767u; }
  // ---- final conditional subtract of p (native 15-bit) ----
  var out: BigInt;
  var borrow: i32 = 0;
  var dd: i32;
  dd = i32(s0) - 32071 - borrow; out.limbs[0] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s1) - 12537 - borrow; out.limbs[1] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s2) - 12379 - borrow; out.limbs[2] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s3) - 24836 - borrow; out.limbs[3] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s4) - 10451 - borrow; out.limbs[4] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s5) - 3641 - borrow; out.limbs[5] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s6) - 9306 - borrow; out.limbs[6] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s7) - 16565 - borrow; out.limbs[7] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s8) - 23959 - borrow; out.limbs[8] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s9) - 688 - borrow; out.limbs[9] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s10) - 23046 - borrow; out.limbs[10] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s11) - 557 - borrow; out.limbs[11] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s12) - 7045 - borrow; out.limbs[12] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s13) - 13317 - borrow; out.limbs[13] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s14) - 14412 - borrow; out.limbs[14] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s15) - 10041 - borrow; out.limbs[15] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  dd = i32(s16) - 12388 - borrow; out.limbs[16] = u32(dd) & 32767u; borrow = select(0, 1, dd < 0);
  out.limbs[0] = select(out.limbs[0], s0, borrow != 0);
  out.limbs[1] = select(out.limbs[1], s1, borrow != 0);
  out.limbs[2] = select(out.limbs[2], s2, borrow != 0);
  out.limbs[3] = select(out.limbs[3], s3, borrow != 0);
  out.limbs[4] = select(out.limbs[4], s4, borrow != 0);
  out.limbs[5] = select(out.limbs[5], s5, borrow != 0);
  out.limbs[6] = select(out.limbs[6], s6, borrow != 0);
  out.limbs[7] = select(out.limbs[7], s7, borrow != 0);
  out.limbs[8] = select(out.limbs[8], s8, borrow != 0);
  out.limbs[9] = select(out.limbs[9], s9, borrow != 0);
  out.limbs[10] = select(out.limbs[10], s10, borrow != 0);
  out.limbs[11] = select(out.limbs[11], s11, borrow != 0);
  out.limbs[12] = select(out.limbs[12], s12, borrow != 0);
  out.limbs[13] = select(out.limbs[13], s13, borrow != 0);
  out.limbs[14] = select(out.limbs[14], s14, borrow != 0);
  out.limbs[15] = select(out.limbs[15], s15, borrow != 0);
  out.limbs[16] = select(out.limbs[16], s16, borrow != 0);
  return out;
}