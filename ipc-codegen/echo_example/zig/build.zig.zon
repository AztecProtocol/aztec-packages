.{
    .name = .echo_zig,
    .version = "0.1.0",
    .fingerprint = 0x15539c02bc3573e2,
    .minimum_zig_version = "0.14.0",
    .dependencies = .{
        .zig_msgpack = .{
            .path = "vendor/zig-msgpack",
        },
        // ipc-runtime/zig: UDS + MPSC-SHM transport binding (compiles the
        // shared C++ sources via Zig's clang).
        .ipc_runtime = .{
            .path = "../../../ipc-runtime/zig",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}
