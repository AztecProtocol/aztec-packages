{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang20",
      "displayName": "Native build with clang 20 (zig)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "CC": "${sourceDir}/../../../ipc-runtime/cpp/scripts/zig-cc.sh",
        "CXX": "${sourceDir}/../../../ipc-runtime/cpp/scripts/zig-c++.sh",
        "CFLAGS": "-g0",
        "CXXFLAGS": "-g0"
      },
      "cacheVariables": {
        "CMAKE_AR": "${sourceDir}/../../../ipc-runtime/cpp/scripts/zig-ar.sh",
        "CMAKE_RANLIB": "${sourceDir}/../../../ipc-runtime/cpp/scripts/zig-ranlib.sh",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang20",
      "configurePreset": "clang20",
      "inheritConfigureEnvironment": true
    }
  ]
}
