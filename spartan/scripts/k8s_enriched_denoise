#!/usr/bin/env bash
# Wrapper around denoise that injects k8s context for the duration of the command.
# The k8s context injector runs inside the denoise subshell and exits when it exits.
#
# Usage: k8s_enriched_denoise <namespace> <command>
#
# Example:
#   k8s_enriched_denoise "$NAMESPACE" "yarn test ..."

set -euo pipefail

# Get absolute path to enricher (relative to this script's location)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENRICHER="$SCRIPT_DIR/k8s_enricher.ts"

NO_CD=1 source "$(git rev-parse --show-toplevel)/ci3/source"

namespace="${1:?namespace is required}"
shift
cmd="${1:?command is required}"

# Set display name so denoise shows the actual command, not the wrapper
export DENOISE_DISPLAY_NAME="$cmd"

# Wrap the command to start k8s enricher in background first
# When cmd exits, kill the enricher and propagate the exit code
enriched_cmd="
  FORCE_COLOR=1 node --experimental-strip-types --no-warnings '${ENRICHER}' '${namespace}' &
  enricher_pid=\$!
  ${cmd}
  code=\$?
  kill \$enricher_pid 2>/dev/null || true
  wait \$enricher_pid 2>/dev/null || true
  exit \$code
"

exec denoise "$enriched_cmd"
