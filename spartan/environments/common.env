# ============================================================
# common.env — Shared base defaults for all Aztec networks
# ============================================================
#
# This file is the SINGLE SOURCE OF TRUTH for protocol parameters
# and operational defaults. Per-network .env files (devnet.env,
# testnet.env, mainnet.env) source this file first, then override.
#
# These values are also used for code generation:
#   - yarn-project/cli/src/config/generated/networks.ts
#   - yarn-project/ethereum/src/generated/l1-contracts-defaults.ts
#   - yarn-project/slasher/src/generated/slasher-defaults.ts
#   - l1-contracts/generated/default.json
#
# After editing, regenerate with:
#   yarn-project/ethereum: yarn generate
#   yarn-project/slasher: yarn generate
#   yarn-project/cli: yarn generate
#   l1-contracts: ./bootstrap.sh

# ============================================================
# PROTOCOL PARAMETERS — L1 contract constants
# ============================================================
# These must match Solidity vm.envOr defaults in RollupConfiguration.sol.
# Changing these requires a rollup upgrade / redeployment.

# Timing
ETHEREUM_SLOT_DURATION=12
AZTEC_SLOT_DURATION=72
AZTEC_EPOCH_DURATION=32

# Validator set
AZTEC_TARGET_COMMITTEE_SIZE=48
AZTEC_LAG_IN_EPOCHS_FOR_VALIDATOR_SET=2
AZTEC_LAG_IN_EPOCHS_FOR_RANDAO=2
AZTEC_ACTIVATION_THRESHOLD=100e18
AZTEC_EJECTION_THRESHOLD=50e18
AZTEC_LOCAL_EJECTION_THRESHOLD=98e18
AZTEC_EXIT_DELAY_SECONDS=172800

# Proof & block
AZTEC_INBOX_LAG=1
AZTEC_PROOF_SUBMISSION_EPOCHS=1
AZTEC_MANA_TARGET=100000000
AZTEC_PROVING_COST_PER_MANA=100
AZTEC_INITIAL_ETH_PER_FEE_ASSET=10000000

# Slashing protocol (L1 contract params)
AZTEC_SLASHER_ENABLED=true
AZTEC_SLASHING_ROUND_SIZE_IN_EPOCHS=4
AZTEC_SLASHING_LIFETIME_IN_ROUNDS=5
AZTEC_SLASHING_EXECUTION_DELAY_IN_ROUNDS=0
AZTEC_SLASHING_OFFSET_IN_ROUNDS=2
AZTEC_SLASHING_VETOER=0x0000000000000000000000000000000000000000
AZTEC_SLASHING_DISABLE_DURATION=432000
AZTEC_SLASH_AMOUNT_SMALL=10e18
AZTEC_SLASH_AMOUNT_MEDIUM=20e18
AZTEC_SLASH_AMOUNT_LARGE=50e18

# Governance
AZTEC_GOVERNANCE_PROPOSER_ROUND_SIZE=300

# ============================================================
# SLASHER NODE DEFAULTS — operational behavior
# ============================================================
# Penalty calculation and offense tracking for the slasher node.

SLASH_OFFENSE_EXPIRATION_ROUNDS=4
SLASH_MAX_PAYLOAD_SIZE=80
SLASH_EXECUTE_ROUNDS_LOOK_BACK=4
SLASH_PRUNE_PENALTY=10e18
SLASH_DATA_WITHHOLDING_PENALTY=10e18
SLASH_INACTIVITY_TARGET_PERCENTAGE=0.9
SLASH_INACTIVITY_CONSECUTIVE_EPOCH_THRESHOLD=1
SLASH_INACTIVITY_PENALTY=10e18
SLASH_PROPOSE_INVALID_ATTESTATIONS_PENALTY=10e18
SLASH_ATTEST_DESCENDANT_OF_INVALID_PENALTY=10e18
SLASH_DUPLICATE_PROPOSAL_PENALTY=0
SLASH_DUPLICATE_ATTESTATION_PENALTY=0
SLASH_UNKNOWN_PENALTY=10e18
SLASH_INVALID_BLOCK_PENALTY=10e18
SLASH_GRACE_PERIOD_L2_SLOTS=0

# ============================================================
# OPERATIONAL DEFAULTS — node tuning knobs
# ============================================================
# Tunable per-deployment. Operators can override via env vars.

# P2P
P2P_ENABLED=true
P2P_GOSSIPSUB_D=6
P2P_GOSSIPSUB_DLO=4
P2P_GOSSIPSUB_DHI=12
P2P_TX_POOL_DELETE_TXS_AFTER_REORG=false
P2P_MAX_PENDING_TX_COUNT=1000

# Sequencer
SEQ_MIN_TX_PER_BLOCK=1
SEQ_BUILD_CHECKPOINT_IF_EMPTY=true
SEQ_BLOCK_DURATION_MS=6000
SEQ_L1_PUBLISHING_TIME_ALLOWANCE_IN_SLOT=36

# Database map sizes (in KB)
DATA_STORE_MAP_SIZE_KB=134217728
ARCHIVER_STORE_MAP_SIZE_KB=1073741824
NOTE_HASH_TREE_MAP_SIZE_KB=1073741824
NULLIFIER_TREE_MAP_SIZE_KB=1073741824
PUBLIC_DATA_TREE_MAP_SIZE_KB=1073741824

# Prover
PROVER_AGENT_POLL_INTERVAL_MS=1000

# Telemetry
PUBLIC_OTEL_INCLUDE_METRICS="aztec.validator,aztec.tx_collector,aztec.mempool,aztec.p2p.gossip.agg_,aztec.ivc_verifier.agg_"

# Monitoring
SENTINEL_ENABLED=true
LOG_LEVEL=info

# Genesis state (conservative defaults)
TEST_ACCOUNTS=false
SPONSORED_FPC=false
TRANSACTIONS_DISABLED=false

# Sync
BLOB_ALLOW_EMPTY_SOURCES=false

# Misc
ENABLE_VERSION_CHECK=true
