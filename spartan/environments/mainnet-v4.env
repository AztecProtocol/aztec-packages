NETWORK=${NETWORK:-mainnet}
L1_NETWORK=${L1_NETWORK:-mainnet}
ETHEREUM_CHAIN_ID=${ETHEREUM_CHAIN_ID:-1}

GCP_REGION=us-west1-a
CLUSTER=aztec-gke-public
RESOURCE_PROFILE=prod
NAMESPACE=${NAMESPACE:-mainnet-v4}

RPC_GATEWAY_ENABLED=false

CREATE_ROLLUP_CONTRACTS=false
VERIFY_CONTRACTS=false
DEPLOY_INTERNAL_BOOTNODE=false
VALIDATOR_REPLICAS=0
VALIDATOR_HA_REPLICAS=0
RPC_REPLICAS=0
FULL_NODE_REPLICAS=0
FISHERMAN_REPLICAS=0
BOT_TRANSFERS_REPLICAS=0
BOT_SWAPS_REPLICAS=0
BOT_CROSS_CHAIN_REPLICAS=0

PROVER_ENABLED=true
PROVER_REPLICAS=4
PROVER_AGENTS_PER_PROVER=1
PUBLISHERS_PER_PROVER=2
PROVER_PUBLISHER_MNEMONIC_START_INDEX=8000

# !!!
PROVER_NODE_DISABLE_PROOF_PUBLISH=false

PROVER_AGENT_KEDA_ENABLED=true
PROVER_AGENT_KEDA_PROMETHEUS_SERVER_ADDRESS=REPLACE_WITH_GCP_SECRET
PROVER_AGENT_KEDA_MIN_REPLICAS=32
PROVER_AGENT_KEDA_MAX_REPLICAS=100
PROVER_AGENT_KEDA_SCALING_BANDS='[
  {
    queueSize = 0
    replicas = 32
  },
  {
    queueSize = 200
    replicas = 80
  }
]'

RPC_RESOURCE_PROFILE=prod
PROVER_RESOURCE_PROFILE=prod-fat-agents

LOG_LEVEL=info
USE_NETWORK_CONFIG=true

PROVER_FAILED_PROOF_STORE=gs://aztec-develop/mainnet-v4/failed-proofs
L1_TX_FAILED_STORE=gs://aztec-develop/mainnet-v4/failed-l1-txs

ETHEREUM_RPC_URLS=REPLACE_WITH_GCP_SECRET
ETHEREUM_CONSENSUS_HOST_URLS=REPLACE_WITH_GCP_SECRET
ETHEREUM_CONSENSUS_HOST_API_KEYS=REPLACE_WITH_GCP_SECRET
ETHEREUM_CONSENSUS_HOST_API_KEY_HEADERS=REPLACE_WITH_GCP_SECRET
LABS_INFRA_MNEMONIC_SECRET_NAME=mainnet-labs-mainnet-v4-mnemonic
LABS_INFRA_MNEMONIC=REPLACE_WITH_GCP_SECRET
OTEL_COLLECTOR_ENDPOINT=REPLACE_WITH_GCP_SECRET
# intentionally left blank
FUNDING_PRIVATE_KEY=""
ROLLUP_DEPLOYMENT_PRIVATE_KEY=""

# Snapshots intentionally disabled: this deployment runs no RPC/full node
# (RPC_REPLICAS=0, FULL_NODE_REPLICAS=0), so there is nothing to snapshot.
# Leaving SNAPSHOT_BUCKET_DIRECTORY unset stops setup_gcp_secrets.sh from
# constructing STORE_SNAPSHOT_URL, which is what gates the aztec-snapshots cronjob.

BLOB_BUCKET_DIRECTORY=${BLOB_BUCKET_DIRECTORY:-mainnet/blobs}
BLOB_FILE_STORE_URLS=","

TX_FILE_STORE_ENABLED=true
TX_FILE_STORE_BUCKET_DIRECTORY=${TX_FILE_STORE_BUCKET_DIRECTORY:-mainnet/txs}
TX_COLLECTION_FILE_STORE_URLS="https://aztec-labs-snapshots.com/${TX_FILE_STORE_BUCKET_DIRECTORY}"

R2_ACCESS_KEY_ID=REPLACE_WITH_GCP_SECRET
R2_SECRET_ACCESS_KEY=REPLACE_WITH_GCP_SECRET
