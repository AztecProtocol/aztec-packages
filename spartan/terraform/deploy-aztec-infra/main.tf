        "service.p2p.nodePortEnabled"                 = var.P2P_NODEPORT_ENABLED
        "service.p2p.hostPortEnabled"                 = var.P2P_HOSTPORT_ENABLED
        "service.p2p.announcePort"                    = local.p2p_port_fisherman
        "service.p2p.port"                            = local.p2p_port_fisherman
