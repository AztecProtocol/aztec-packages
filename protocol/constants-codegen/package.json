{
  "name": "@aztec-foundation/constants-codegen",
  "version": "0.0.0",
  "description": "Generate Aztec protocol constants from Noir definitions",
  "license": "Apache-2.0",
  "type": "module",
  "bin": "./dest/cli.js",
  "files": [
    "dest",
    "!dest/*.test.d.ts",
    "!dest/*.test.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dest",
    "prepack": "yarn build",
    "test": "yarn build && node --test dest/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.10"
  },
  "packageManager": "yarn@4.13.0",
  "publishConfig": {
    "access": "public"
  }
}
