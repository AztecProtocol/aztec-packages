// Aggregator module for canonical contract address stamps.
//
// Each submodule is generated by a script under
// `yarn-project/canonical-contracts/src/scripts/`. The hand-written
// re-exports here keep downstream consumers using flat
// `canonical_addresses::FOO_ADDRESS` paths regardless of where the
// stamp is generated.

pub mod auth_registry;

pub use auth_registry::AUTH_REGISTRY_ADDRESS;
