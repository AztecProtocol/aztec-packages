mod test {
    use std::embedded_curve_ops::EmbeddedCurvePoint;
    use std::embedded_curve_ops::EmbeddedCurveScalar;

    #[test]
    unconstrained fn schnorr_pinned_vector_verifies() {
        let public_key: EmbeddedCurvePoint = EmbeddedCurvePoint::new(2869489990193505318247504503561162235936117579772139766175910861598344224166_Field, -9871363739164229838681394557164556324932462864077359284155516687483746466271_Field);
        let sig_s: EmbeddedCurveScalar = EmbeddedCurveScalar::new(323979760422270332501207172580698578938_Field, 11099167696576597734632403896567612749_Field);
        let sig_e: EmbeddedCurveScalar = EmbeddedCurveScalar::new(200746275036515961860487236901704932290_Field, 59705867264345988578988336846714080402_Field);
        let message: Field = 514631507721405306660750627004050553169894890361520731142054384109816726305_Field;
        assert(schnorr::verify_signature(public_key, (sig_s, sig_e), message));
    }
}

