    #[contract_library_method]
    fn _emit_public_log(context: PublicContext) {
        context.emit_public_log_unsafe(0_Field, [10_Field, 20_Field, 30_Field]);
        context.emit_public_log_unsafe(0_Field, "Hello, world!");
