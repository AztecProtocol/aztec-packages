    #[contract_library_method]
    fn _schnorr_verify_signature(pubkey_x: Field, pubkey_y: Field, sig_s_lo: Field, sig_s_hi: Field, sig_e_lo: Field, sig_e_hi: Field, message: Field) -> bool {
        let public_key: EmbeddedCurvePoint = EmbeddedCurvePoint::new(pubkey_x, pubkey_y);
        let sig_s: Scalar = Scalar::new(sig_s_lo, sig_s_hi);
        let sig_e: Scalar = Scalar::new(sig_e_lo, sig_e_hi);
        schnorr::verify_signature(public_key, (sig_s, sig_e), message)
    }

