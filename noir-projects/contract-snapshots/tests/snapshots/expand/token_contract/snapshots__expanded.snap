            let (env, token_contract_address, owner, recipient, _, proxy): (aztec::test::helpers::test_environment::TestEnvironment, aztec::protocol::address::AztecAddress, aztec::protocol::address::AztecAddress, aztec::protocol::address::AztecAddress, u128, aztec::protocol::address::AztecAddress) = utils::setup_and_mint_to_private_with_proxy();
