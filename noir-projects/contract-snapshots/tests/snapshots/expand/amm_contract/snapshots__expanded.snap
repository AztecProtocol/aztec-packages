        #[test(should_fail_with = "TOKEN_IN_IS_INVALID")]
        unconstrained fn swap_exact_tokens_invalid_token_in() {
            let (mut env, amm_address, _token0_address, token1_address, _liquidity_token_address, _minter): (aztec::test::helpers::test_environment::TestEnvironment, AztecAddress, AztecAddress, AztecAddress, AztecAddress, AztecAddress) = setup();
