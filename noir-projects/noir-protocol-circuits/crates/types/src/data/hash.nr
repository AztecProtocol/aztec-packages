use crate::{
    address::AztecAddress,
    constants::DOM_SEP__PUBLIC_LEAF_SLOT,
    traits::{FromField, ToField},
};

pub fn compute_public_data_leaf_slot(contract_address: AztecAddress, storage_slot: Field) -> Field {
    crate::hash::poseidon2_hash_with_separator(
        [contract_address.to_field(), storage_slot],
        DOM_SEP__PUBLIC_LEAF_SLOT,
    )
}

#[test]
unconstrained fn public_data_leaf_slot_matches_typescript() {
    let contract_address = AztecAddress::from_field(987);
    let storage_slot = 123;
    let hash = compute_public_data_leaf_slot(contract_address, storage_slot);

    // The following value was generated by `yarn-project/stdlib/src/hash/hash.test.ts`
    let public_data_leaf_slot_from_ts =
        0x2683061b3777be03ecc034934748ab2d7930d784a2a5bf47b5a6706b01719193;

    assert_eq(hash, public_data_leaf_slot_from_ts);
}
