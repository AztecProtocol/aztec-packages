use crate::{
    abis::{function_data::FunctionData, function_selector::FunctionSelector},
    constants::{FUNCTION_TREE_HEIGHT, MEGA_VK_LENGTH_IN_FIELDS},
    merkle_tree::MembershipWitness,
};

pub struct ContractFunction {
    pub data: FunctionData,
    pub vk_hash: Field,
    pub membership_witness: MembershipWitness<FUNCTION_TREE_HEIGHT>,
}

pub global default_vk: [Field; MEGA_VK_LENGTH_IN_FIELDS] = [0; MEGA_VK_LENGTH_IN_FIELDS];

